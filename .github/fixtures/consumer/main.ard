use cooper/box
use cooper/context
use cooper/paint
use cooper/style
use cooper/text

fn main() {
  let ctx = context::new()
  let root = box::new(
    ctx,
    initial_style: style::new(width: style::cells(4), height: style::cells(1)),
  )
  root.add(text::new(ctx, content: "okay"))
  ctx.compute_layout(root, 4, 1)

  let buffer = paint::new_buffer(4, 1)
  root.node().paint(buffer)
  if buffer.cell_at(0, 0).expect("consumer paint cell").grapheme != "o" {
    panic("Cooper dependency did not paint")
  }

  ctx.destroy()
}
