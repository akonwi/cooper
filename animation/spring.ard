use ard/unsafe

use go:math

struct Config {
  angular_frequency: Float64,
  damping_ratio: Float64,
  position_tolerance: Float64,
  velocity_tolerance: Float64,
}

fn config(
  angular_frequency: Float64?,
  damping_ratio: Float64?,
  position_tolerance: Float64?,
  velocity_tolerance: Float64?,
) Config {
  Config{
    angular_frequency: angular_frequency.or(12.0),
    damping_ratio: damping_ratio.or(0.7),
    position_tolerance: position_tolerance.or(0.001),
    velocity_tolerance: velocity_tolerance.or(0.001),
  }
}

struct Frame {
  value: Float64,
  velocity: Float64,
  target: Float64,
  delta: Int,
}

private enum Status {
  paused,
  playing,
  completed,
  destroyed,
}

private struct State {
  config: Config,
  value: Float64,
  velocity: Float64,
  target: Float64,
  status: Status,
  fresh: Bool,
  revision: Int,
  update: fn(Frame),
  on_complete: fn()?,
  wake: fn(),
}

struct Spring {
  internal: Any,
}

private fn state(value: Any) mut State {
  unsafe::cast<mut State>(value).expect("Spring must be created by Cooper")
}

private fn finite(value: Float64, name: Str) Float64 {
  if math::IsNaN(value) or math::IsInf(value, 0) {
    panic("{name} must be finite")
  }
  value
}

private fn positive(value: Float64, name: Str) {
  if finite(value, name) <= 0.0 {
    panic("{name} must be positive")
  }
}

private fn available(shared: mut State) {
  if shared.status == Status::destroyed {
    panic("Spring is unavailable after destruction")
  }
}

fn internal_new(value: Float64, update: fn(Frame), wake: fn(), options: Config?, on_complete: fn()?) mut Spring {
  let settings = options.or(config())
  positive(settings.angular_frequency, "spring angular frequency")
  positive(settings.position_tolerance, "spring position tolerance")
  positive(settings.velocity_tolerance, "spring velocity tolerance")
  if finite(settings.damping_ratio, "spring damping ratio") < 0.0 {
    panic("spring damping ratio must be non-negative")
  }
  let initial = finite(value, "spring value")
  let shared = mut State{
    config: settings,
    value: initial,
    velocity: 0.0,
    target: initial,
    status: Status::paused,
    fresh: true,
    revision: 0,
    update: update,
    on_complete: on_complete,
    wake: wake,
  }
  (mut Spring{internal: shared})
}

// Altered Ard port of Harmonica's spring solver (Charmbracelet, Inc., 2021).
// https://github.com/charmbracelet/harmonica/blob/v0.2.0/spring.go
// Uses actual elapsed time and a cancellation-resistant over-damped root.
//
