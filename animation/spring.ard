//    distribution.
private fn advance(shared: mut State, seconds: Float64) {
  let frequency = shared.config.angular_frequency
  let damping = shared.config.damping_ratio
  let decay = frequency * damping
  mut pp = 0.to_f64()
  mut pv = 0.to_f64()
  mut vp = 0.to_f64()
  mut vv = 0.to_f64()
  if damping > 1.0 {
    let root = math::Sqrt(damping * damping - 1.0)
    let fast = -frequency * (damping + root)
    let slow = -frequency / (damping + root)
    let fast_exp = math::Exp(fast * seconds)
    let slow_exp = math::Exp(slow * seconds)
    // Expm1 avoids subtracting nearly equal exponentials near critical damping.
    pv = slow_exp * -math::Expm1((fast - slow) * seconds) / (slow - fast)
    pp = slow_exp - slow * pv
    vp = slow * (pp - fast_exp)
    vv = fast_exp + slow * pv
  } else if damping < 1.0 {
    let alpha = frequency * math::Sqrt(1.0 - damping * damping)
    let envelope = math::Exp(-decay * seconds)
    let cosine = envelope * math::Cos(alpha * seconds)
    pv = envelope * math::Sin(alpha * seconds) / alpha
    pp = cosine + decay * pv
    vp = -frequency * (frequency * pv)
    vv = cosine - decay * pv
  } else {
    let envelope = math::Exp(-frequency * seconds)
    pv = seconds * envelope
    pp = envelope + frequency * pv
    vp = -frequency * (frequency * pv)
    vv = envelope - frequency * pv
  }
  let offset = shared.value - shared.target
  let velocity = shared.velocity
  let next_value = finite(offset * pp + velocity * pv + shared.target, "spring value")
  let next_velocity = finite(offset * vp + velocity * vv, "spring velocity")
  shared.value = next_value
  shared.velocity = next_velocity
}

impl Spring {
  fn value() Float64 {
    state(self.internal).value
  }

  fn velocity() Float64 {
    state(self.internal).velocity
  }

  fn target() Float64 {
    state(self.internal).target
  }

  fn is_playing() Bool {
    state(self.internal).status == Status::playing
  }

  fn is_complete() Bool {
    state(self.internal).status == Status::completed
  }

  fn mut set_target(value: Float64) Bool {
    let shared = state(self.internal)
    available(shared)
    let target = finite(value, "spring target")
    if target == shared.target {
      false
    } else {
      shared.target = target
      shared.fresh = shared.fresh or shared.status != Status::playing
      shared.status = Status::playing
      shared.revision =+ 1
      (shared.wake)()
      true
    }
  }

  fn mut play() Bool {
    let shared = state(self.internal)
    available(shared)
    if shared.status == Status::playing or shared.status == Status::completed {
      false
    } else {
      shared.status = Status::playing
      shared.fresh = true
      shared.revision =+ 1
      (shared.wake)()
      true
    }
  }

  fn mut pause() Bool {
    let shared = state(self.internal)
    available(shared)
    if shared.status != Status::playing {
      false
    } else {
      shared.status = Status::paused
      shared.revision =+ 1
      (shared.wake)()
      true
    }
  }

  fn mut destroy() {
    let shared = state(self.internal)
    if shared.status != Status::destroyed {
      shared.status = Status::destroyed
      shared.revision =+ 1
      shared.update = fn(frame: Frame) {}
      shared.on_complete = Maybe::new<fn()>()
      (shared.wake)()
    }
  }

  fn internal_destroyed() Bool {
    state(self.internal).status == Status::destroyed
  }

  fn mut internal_tick(delta: Int, allow: fn() Bool) Bool {
    if delta < 0 {
      panic("spring frame delta must be non-negative")
    }
    let shared = state(self.internal)
    if (not allow()) or shared.status != Status::playing {
      false
    } else if delta == 0 and not shared.fresh {
      false
    } else {
      let step = match shared.fresh {
        true => 0,
        false => delta,
      }
      shared.fresh = false
      let revision = shared.revision
      if step > 0 {
        advance(shared, step.to_f64() / 1000.0)
      }
      let settled = math::Abs(shared.value - shared.target) <= shared.config.position_tolerance and math::Abs(shared.velocity) <= shared.config.velocity_tolerance
      if settled {
        shared.value = shared.target
        shared.velocity = 0.0
      }
      (shared.update)(
        Frame{
          value: shared.value,
          velocity: shared.velocity,
          target: shared.target,
          delta: step,
        },
      )
      if allow() and shared.revision == revision and shared.status == Status::playing and settled {
        shared.status = Status::completed
        shared.revision =+ 1
        match shared.on_complete {
          complete => complete(),
          _ => (),
        }
      }
      true
    }
  }
}
