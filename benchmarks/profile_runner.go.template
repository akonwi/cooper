package main

import (
	"encoding/json"
	"flag"
	profile "github.com/akonwi/cooper/benchmarks/profile_layout"
	"os"
	"runtime"
	"runtime/pprof"
	"time"
)

func writeProfile(name, path string) {
	f, err := os.Create(path)
	if err != nil {
		panic(err)
	}
	defer f.Close()
	if err := pprof.Lookup(name).WriteTo(f, 0); err != nil {
		panic(err)
	}
}

func main() {
	phase := flag.String("phase", "render_update", "isolated operation")
	n := flag.Int("n", 1000, "operations")
	cpu := flag.String("cpu", "", "CPU profile path")
	alloc := flag.String("alloc", "", "allocation profile prefix")
	flag.Parse()
	if *alloc != "" {
		runtime.MemProfileRate = 4096
	}
	w := profile.Prepare(*phase)
	defer w.Close()
	for i := 0; i < 10; i++ {
		w.Run()
	}
	w.Verify()
	runtime.GC()
	if *alloc != "" {
		writeProfile("allocs", *alloc+".before")
	}
	if *cpu != "" {
		f, err := os.Create(*cpu)
		if err != nil {
			panic(err)
		}
		defer f.Close()
		if err := pprof.StartCPUProfile(f); err != nil {
			panic(err)
		}
	}
	var before, after runtime.MemStats
	runtime.ReadMemStats(&before)
	start := time.Now()
	for i := 0; i < *n; i++ {
		w.Run()
	}
	elapsed := time.Since(start)
	runtime.ReadMemStats(&after)
	if *cpu != "" {
		pprof.StopCPUProfile()
	}
	if *alloc != "" {
		runtime.GC()
		writeProfile("allocs", *alloc+".after")
	}
	w.Verify()
	json.NewEncoder(os.Stdout).Encode(map[string]any{
		"phase": *phase, "operations": *n, "verified": true,
		"ns_per_op":        float64(elapsed.Nanoseconds()) / float64(*n),
		"go_bytes_per_op":  float64(after.TotalAlloc-before.TotalAlloc) / float64(*n),
		"go_allocs_per_op": float64(after.Mallocs-before.Mallocs) / float64(*n),
		"gc_cycles":        after.NumGC - before.NumGC,
	})
}
