use cooper/box
use cooper/style
use cooper/testing as cooper_testing
use go:fmt
use go:time

private fn item_style(width: Int) style::Style {
  style::new(width: style::cells(width), height: style::cells(1), flex_shrink: 0.0)
}

private fn responsive_item_style() style::Style {
  style::new(width: style::percent(100.0), height: style::cells(1), flex_shrink: 0.0)
}

fn main() {
  let application = cooper_testing::new(80, 1000)
  let root = box::new(
    application.context,
    styles: style::new(
      flex_direction: style::FlexDirection::column,
      width: style::percent(100.0),
      height: style::percent(100.0),
      align_items: style::Align::start,
    ),
  )
  application.root.add(root)
  let children = mut List::new<mut box::Box>()

  let construction_started = time::Now()
  mut index = 0
  while index < 1000 {
    let child = box::new(application.context, styles: responsive_item_style())
    root.add(child)
    children.push(child)
    index =+ 1
  }
  let construction = time::Since(construction_started)

  let initial_started = time::Now()
  application.render()
  let initial_layout = time::Since(initial_started)

  let target = children.at(500).expect("benchmark midpoint")
  let update_started = time::Now()
  target.set_style(item_style(40))
  application.render()
  let single_update = time::Since(update_started)

  let resize_started = time::Now()
  application.resize(40, 800)
  let resize = time::Since(resize_started)

  fmt::Printf(
    "backend=tess_retained nodes=1001 construct_us=%d initial_layout_us=%d single_update_us=%d resize_us=%d observed=%d\n",
    construction.Microseconds(),
    initial_layout.Microseconds(),
    single_update.Microseconds(),
    resize.Microseconds(),
    root.layout().screen.width + root.layout().screen.height + target.layout().screen.width,
  )

  application.destroy()
}
