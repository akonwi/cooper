use cooper/box
use cooper/event
use cooper/style
use cooper/testing as cooper_testing
use cooper/text
use go:fmt
use go:time

private fn sized(width: Int, height: Int) style::Style {
  style::new(width: style::cells(width), height: style::cells(height), flex_shrink: 0.0)
}

private fn clipped(width: Int, height: Int) style::Style {
  let configured = mut sized(width, height)
  configured.overflow = style::Overflow::hidden
  configured.@
}

private fn pointer_move() mut event::MouseEvent {
  event::mouse(
    event::MouseEventType::move,
    event::MouseButton::none,
    1,
    1,
    event::Modifiers{shift: false, ctrl: false, alt: false, super: false},
  )
}

fn main() {
  let application = cooper_testing::new(80, 24)

  let mutation_root = box::new(application.context, styles: sized(80, 24))
  let mutation_child = box::new(application.context, styles: sized(80, 1))
  mutation_root.add(mutation_child)
  application.root.add(mutation_root)
  application.render()

  let mutation_started = time::Now()
  mut index = 0
  while index < 1000 {
    let removed = mutation_root.remove(mutation_child)
    if not removed {
      panic("stress child detach failed")
    }
    mutation_root.add(mutation_child)
    application.render()
    index =+ 1
  }
  let mutations = time::Since(mutation_started)
  let _ = application.root.remove(mutation_root)
  mutation_root.destroy(recursive: true)

  let deep_root = box::new(application.context, styles: clipped(80, 24))
  mut current = deep_root
  index = 0
  while index < 100 {
    let child = box::new(application.context, styles: clipped(80, 24))
    current.add(child)
    current = child
    index =+ 1
  }
  let leaf = box::new(application.context, styles: clipped(80, 24))
  leaf.add(text::new(application.context, content: "x"))
  mut observed_hits = 0
  let _ = leaf.on_mouse(fn(received: mut event::MouseEvent) {
    if received.event_type == event::MouseEventType::move {
      observed_hits =+ 1
    }
  })
  current.add(leaf)
  application.root.add(deep_root)

  let layout_started = time::Now()
  application.render()
  let deep_layout = time::Since(layout_started)

  let hit_started = time::Now()
  index = 0
  while index < 10000 {
    application.mouse(pointer_move())
    index =+ 1
  }
  let hits = time::Since(hit_started)
  if observed_hits != 10000 {
    panic("deep retained hit traversal did not reach the leaf")
  }

  let paint_started = time::Now()
  index = 0
  while index < 1000 {
    application.render()
    index =+ 1
  }
  let paints = time::Since(paint_started)
  if application.frame().cell(0, 0).expect("deep painted cell").grapheme != "x" {
    panic("deep retained paint traversal did not reach the leaf")
  }

  fmt::Printf(
    "backend=tess_stress attach_detach_layout_1000_us=%d deep_layout_us=%d deep_hit_10000_us=%d deep_paint_1000_us=%d observed_hits=%d observed_paint=x\n",
    mutations.Microseconds(),
    deep_layout.Microseconds(),
    hits.Microseconds(),
    paints.Microseconds(),
    observed_hits,
  )

  application.destroy()
}
