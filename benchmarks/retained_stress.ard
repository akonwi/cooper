use cooper/box
use cooper/context
use cooper/hit
use cooper/paint
use cooper/style
use cooper/text
use go:fmt
use go:time

private fn sized(width: Int, height: Int) style::Style {
  style::new(width: style::cells(width), height: style::cells(height), shrink: 0.0)
}

private fn clipped(width: Int, height: Int) style::Style {
  let configured = mut sized(width, height)
  configured.overflow = style::Overflow::hidden
  configured.@
}

fn main() {
  let ctx = context::new()

  let mutation_root = box::new(ctx, initial_style: sized(80, 24))
  let mutation_child = box::new(ctx, initial_style: sized(80, 1))
  mutation_root.add(mutation_child)
  ctx.compute_layout(mutation_root, 80, 24)

  let mutation_started = time::Now()
  mut index = 0
  while index < 1000 {
    let removed = mutation_root.remove(mutation_child)
    if not removed {
      panic("stress child detach failed")
    }
    mutation_root.add(mutation_child)
    ctx.compute_layout(mutation_root, 80, 24)
    index =+ 1
  }
  let mutations = time::Since(mutation_started)

  let deep_root = box::new(ctx, initial_style: clipped(80, 24))
  mut current = deep_root
  index = 0
  while index < 100 {
    let child = box::new(ctx, initial_style: clipped(80, 24))
    current.add(child)
    current = child
    index =+ 1
  }
  let leaf = text::new(ctx, content: "x", initial_style: sized(80, 24))
  leaf.node().set_pointer_enabled(true)
  current.add(leaf)

  let layout_started = time::Now()
  ctx.compute_layout(deep_root, 80, 24)
  let deep_layout = time::Since(layout_started)

  let hit_started = time::Now()
  mut observed_hits = 0
  index = 0
  while index < 10000 {
    match hit::test(deep_root, 1, 1) {
      found => {
        if found.target == leaf.node() {
          observed_hits =+ 1
        }
      },
      _ => (),
    }
    index =+ 1
  }
  let hits = time::Since(hit_started)
  if observed_hits != 10000 {
    panic("deep retained hit traversal did not reach the leaf")
  }

  let buffer = paint::new_buffer(80, 24)
  let paint_started = time::Now()
  index = 0
  while index < 1000 {
    deep_root.node().paint(buffer)
    index =+ 1
  }
  let paints = time::Since(paint_started)
  if buffer.cell_at(0, 0).expect("deep painted cell").grapheme != "x" {
    panic("deep retained paint traversal did not reach the leaf")
  }

  fmt::Printf(
    "backend=tess_stress attach_detach_layout_1000_us=%d deep_layout_us=%d deep_hit_10000_us=%d deep_paint_1000_us=%d observed_hits=%d observed_paint=x\n",
    mutations.Microseconds(),
    deep_layout.Microseconds(),
    hits.Microseconds(),
    paints.Microseconds(),
    observed_hits,
  )

  ctx.destroy()
}
