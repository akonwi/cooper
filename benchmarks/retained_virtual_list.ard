use cooper/ui/box
use cooper/ui/scroll_box
use cooper/ui/style
use cooper/testing as cooper_testing
use cooper/ui/text
use go:fmt
use go:time

private fn sized(width: Int, height: Int) style::Style {
  style::new(width: style::cells(width), height: style::cells(height), flex_shrink: 0.0)
}

private fn update_window(
  top: mut box::Box,
  bottom: mut box::Box,
  rows: [mut text::Text],
  data: [Str],
  start: Int,
) {
  top.set_style(sized(80, start))
  for row, index in rows {
    row.set_content(data.at(start + index).expect("virtual row data"))
  }
  bottom.set_style(sized(80, data.size() - start - rows.size()))
}

fn main() {
  let logical_started = time::Now()
  let data = mut List::new<Str>()
  mut index = 0
  while index < 10000 {
    data.push("row {index}")
    index =+ 1
  }
  let logical_construction = time::Since(logical_started)

  let retained_started = time::Now()
  let application = cooper_testing::new(80, 24)
  let content = box::new(
    application.context,
    styles: style::new(width: style::cells(80), align_items: style::Align::stretch),
  )
  let top = box::new(application.context, styles: sized(80, 0))
  let bottom = box::new(application.context, styles: sized(80, data.size() - 64))
  let rows = mut List::new<mut text::Text>()
  content.add(top)
  index = 0
  while index < 64 {
    let row = text::new(
      application.context,
      content: data.at(index).expect("initial virtual row"),
      styles: sized(80, 1),
    )
    rows.push(row)
    content.add(row)
    index =+ 1
  }
  content.add(bottom)
  let view = scroll_box::new(
    application.context,
    styles: style::new(
      width: style::percent(100.0),
      height: style::percent(100.0),
      flex_shrink: 0.0,
    ),
  )
  view.add(content)
  application.root.add(view)
  let retained_construction = time::Since(retained_started)

  let initial_started = time::Now()
  application.render()
  let initial_layout = time::Since(initial_started)

  let jump_started = time::Now()
  update_window(top, bottom, rows.@, data.@, 5000)
  let _ = view.scroll_to(5000)
  application.render()
  let jump_layout = time::Since(jump_started)

  let update_started = time::Now()
  rows.at(12).expect("visible update row").set_content("row 5012 changed")
  application.render()
  let single_row_update = time::Since(update_started)

  let shifts_started = time::Now()
  index = 0
  while index < 100 {
    let start = 5001 + index
    update_window(top, bottom, rows.@, data.@, start)
    let _ = view.scroll_to(start)
    application.render()
    index =+ 1
  }
  let shifts = time::Since(shifts_started)

  let resize_started = time::Now()
  application.resize(100, 40)
  let resize = time::Since(resize_started)

  let paint_started = time::Now()
  application.render()
  let painted = time::Since(paint_started)

  fmt::Printf(
    "backend=tess_virtual logical_rows=10000 retained_nodes=68 logical_construct_us=%d retained_construct_us=%d initial_layout_us=%d jump_layout_us=%d single_row_update_us=%d window_shift_avg_us=%d resize_us=%d paint_us=%d observed_width=%d observed_height=%d observed=%s\n",
    logical_construction.Microseconds(),
    retained_construction.Microseconds(),
    initial_layout.Microseconds(),
    jump_layout.Microseconds(),
    single_row_update.Microseconds(),
    shifts.Microseconds() / 100,
    resize.Microseconds(),
    painted.Microseconds(),
    view.layout().screen.width,
    view.layout().screen.height,
    application.frame().cell(0, 0).expect("painted virtual cell").grapheme,
  )

  application.destroy()
}
