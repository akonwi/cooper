use cooper/cooper
use cooper/event
use cooper/layout
use cooper/surface
use go:fmt
use go:time

private struct Item {
  width: Int,
}

impl cooper::Widget for Item {
  fn init(ctx: cooper::InitContext) {}

  fn render(ctx: surface::RenderContext) surface::Surface {
    surface::blank(ctx.constraints.constrain_width(self.width), ctx.constraints.constrain_height(1))
  }

  fn event(ctx: mut event::EventContext) event::EventResult {
    event::EventResult::ignored
  }
}

private fn render_observed(root: layout::Column, width: Int, height: Int) Int {
  let rendered = root.render(
    surface::RenderContext{constraints: surface::bounded(max_width: width, max_height: height)},
  )
  let target_width = rendered.children.at(500).expect("observed Surface child").surface.size.width
  rendered.size.width + rendered.size.height + target_width
}

fn main() {
  let items = mut List::new<mut Item>()
  let children = mut List::new<layout::FlexItem>()

  let construction_started = time::Now()
  mut index = 0
  while index < 1000 {
    let item = mut Item{width: 80}
    items.push(item)
    children.push(layout::flex_item(item))
    index =+ 1
  }
  let root = layout::column(children.@)
  let construction = time::Since(construction_started)

  let initial_started = time::Now()
  let initial_observed = render_observed(root, 80, 1000)
  let initial_layout = time::Since(initial_started)

  let target = items.at(500).expect("surface benchmark midpoint")
  let update_started = time::Now()
  target.width = 40
  let updated_observed = render_observed(root, 80, 1000)
  let single_update = time::Since(update_started)

  let resize_started = time::Now()
  let resized_observed = render_observed(root, 40, 800)
  let resize = time::Since(resize_started)

  fmt::Printf(
    "backend=ard_surface nodes=1001 construct_us=%d initial_layout_us=%d single_update_us=%d resize_us=%d observed=%d\n",
    construction.Microseconds(),
    initial_layout.Microseconds(),
    single_update.Microseconds(),
    resize.Microseconds(),
    initial_observed + updated_observed + resized_observed,
  )
}
