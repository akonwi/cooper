use ard/unsafe

use cooper/core/node
use cooper/event
use cooper/style
use go:go.rockorager.dev/vaxis

struct Context {
  dispatch: fn(fn()) Void!event::DispatchError,
  cancellation: Receiver<Void>,
  internal: Any,
}

private fn stopped_dispatch(action: fn()) Void!event::DispatchError {
  Result::err(event::DispatchError::stopped)
}

private fn open_cancellation() Receiver<Void> {
  Chan::new<Void>().receiver()
}

private fn no_op() {}

private fn ignore_url(url: Str) Void!Error {
  Result::ok(())
}

private fn reject_focus(target_id: Int) Bool {
  false
}

private fn ignore_blur(target_id: Int) {}

private fn reject_selection_start(target_id: Int, local_x: Int, local_y: Int) Bool {
  false
}

private fn reject_selection_update(target_id: Int, local_x: Int, local_y: Int, finish: Bool) Bool {
  false
}

private fn reject_selection_owns(target_id: Int) Bool {
  false
}

private fn default_width(text: Str) Int {
  mut width = 0
  for character in vaxis::Characters(text) {
    width = width + character.Width
  }
  width
}

struct InternalState {
  next_id: Int,
  context_token: mut node::ContextToken,
  nodes: [mut node::Node],
  destroyed: Bool,
  running: Bool,
  request_render: fn(),
  width_measurer: fn(Str) Int,
  focus_request: fn(Int) Bool,
  blur_request: fn(Int),
  selection_start: fn(Int, Int, Int) Bool,
  selection_update: fn(Int, Int, Int, Bool) Bool,
  selection_owns: fn(Int) Bool,
  selection_clear: fn(),
  open_url: fn(Str) Void!Error,
}

private fn new_state(
  request_render: fn()?,
  width_measurer: (fn(Str) Int)?,
  focus_request: (fn(Int) Bool)?,
  blur_request: (fn(Int))?,
  selection_start: (fn(Int, Int, Int) Bool)?,
  selection_update: (fn(Int, Int, Int, Bool) Bool)?,
  selection_owns: (fn(Int) Bool)?,
  selection_clear: (fn())?,
  open_url: (fn(Str) Void!Error)?,
) mut InternalState {
  (mut InternalState{
    next_id: 1,
    context_token: node::new_context_token(),
    nodes: [],
    destroyed: false,
    running: false,
    request_render: request_render.or(no_op),
    width_measurer: width_measurer.or(default_width),
    focus_request: focus_request.or(reject_focus),
    blur_request: blur_request.or(ignore_blur),
    selection_start: selection_start.or(reject_selection_start),
    selection_update: selection_update.or(reject_selection_update),
    selection_owns: selection_owns.or(reject_selection_owns),
    selection_clear: selection_clear.or(no_op),
    open_url: open_url.or(ignore_url),
  })
}

fn internal_new(
  request_render: fn()?,
  width_measurer: (fn(Str) Int)?,
  dispatch: (fn(fn()) Void!event::DispatchError)?,
  cancellation: Receiver<Void>?,
  focus_request: (fn(Int) Bool)?,
  blur_request: (fn(Int))?,
  selection_start: (fn(Int, Int, Int) Bool)?,
  selection_update: (fn(Int, Int, Int, Bool) Bool)?,
  selection_owns: (fn(Int) Bool)?,
  selection_clear: (fn())?,
  open_url: (fn(Str) Void!Error)?,
) mut Context {
  let retained = new_state(
    request_render,
    width_measurer,
    focus_request,
    blur_request,
    selection_start,
    selection_update,
    selection_owns,
    selection_clear,
    open_url,
  )
  (mut Context{
    dispatch: dispatch.or(stopped_dispatch),
    cancellation: cancellation.or(open_cancellation()),
    internal: retained,
  })
}

fn internal_state(ctx: mut Context) mut InternalState {
  unsafe::cast<mut InternalState>(ctx.internal).expect("Context must be created by Cooper")
}

impl Context {
  fn mut open_url(target: Str) Void!Error {
    let state = internal_state(self)
    if state.destroyed {
      Result::err(Error::new("cannot open a URL from a destroyed Context"))
    } else {
      state.open_url(target)
    }
  }
}

impl InternalState {
  fn mut create_node(initial_style: style::Style) mut node::Node {
    if self.destroyed {
      panic("cannot create a retained Node from a destroyed Context")
    }
    let created = node::create(
      self.next_id,
      self.context_token,
      initial_style,
      self.request_render,
      self.focus_request,
      self.blur_request,
      self.selection_start,
      self.selection_update,
      self.selection_owns,
      self.selection_clear,
      fn(destroyed_id: Int) {
        self.release(destroyed_id)
      },
    )
    self.next_id =+ 1
    self.nodes.push(created)
    created
  }

  private fn mut release(destroyed_id: Int) {
    let retained = mut List::new<mut node::Node>()
    for current in self.nodes {
      if current.id != destroyed_id {
        retained.push(current)
      }
    }
    self.nodes = retained.@
  }

  fn node_count() Int {
    self.nodes.size()
  }

  fn is_destroyed() Bool {
    self.destroyed
  }

  fn mut begin_run() {
    if self.destroyed or self.running {
      panic("retained Context is not available to run")
    }
    self.running = true
  }

  fn mut end_run() {
    self.running = false
  }

  fn measure_text(text: Str) Int {
    self.width_measurer(text)
  }

  fn mut compute_layout(root: mut node::Renderable, width: Int, height: Int) {
    if self.destroyed {
      panic("cannot lay out with a destroyed Context")
    }
    if root.node().context_token != self.context_token {
      panic("cannot lay out a retained tree from another Context")
    }
    if root.node().parent.is_some() {
      panic("only a detached retained root can be laid out")
    }
    root.node().compute(width, height)
  }

  fn mut destroy() {
    if self.running {
      panic("cannot destroy a running retained Context")
    }
    if not self.destroyed {
      self.destroyed = true
      let owned = self.nodes
      self.nodes = []
      for retained in owned {
        retained.destroy_from_context()
      }
    }
  }
}
