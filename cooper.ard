use cooper/event
use cooper/focus
use cooper/hit
use cooper/surface
use go:go.rockorager.dev/vaxis as raw

trait Widget {
  fn render(ctx: surface::RenderContext) surface::Surface

  fn mut event(ctx: mut event::EventContext, received: raw::Event) event::EventResult

  fn mut reveal(ctx: mut event::RevealContext) event::EventResult
}

private fn cursor_style(shape: surface::CursorShape) raw::CursorStyle {
  match shape {
    surface::CursorShape::default => raw::CursorStyle::from(raw::CursorDefault),
    surface::CursorShape::block => raw::CursorStyle::from(raw::CursorBlock),
    surface::CursorShape::underline => raw::CursorStyle::from(raw::CursorUnderline),
    surface::CursorShape::beam => raw::CursorStyle::from(raw::CursorBeam),
  }
}

private fn render_root(root: mut Widget, app: mut raw::Vaxis, focused_path: [Int]?) surface::Surface {
  let window = app.Window()
  root.render(
    surface::RenderContext{
      constraints: surface::bounded(max_width: window.Width, max_height: window.Height),
      width_measurer: fn(text: Str) Int {
        app.RenderedWidth(text)
      },
      focus_path: focused_path,
    },
  )
}

private fn paint_surface(rendered: surface::Surface, app: mut raw::Vaxis) {
  let window = app.Window()
  window.Clear()
  app.HideCursor()

  if rendered.size.width > 0 {
    for cell, index in rendered.cells {
      let x = index % rendered.size.width
      let y = index / rendered.size.width
      if cell.width > 0 and x < window.Width and cell.width <= window.Width - x and y < rendered.size.height and y < window.Height {
        window.SetCell(
          x,
          y,
          raw::Cell{Character: raw::Character{Grapheme: cell.grapheme, Width: cell.width}},
        )
      }
    }
  }

  match rendered.cursor {
    cursor => {
      if cursor.point.x >= 0 and cursor.point.x < rendered.size.width and cursor.point.x < window.Width and cursor.point.y >= 0 and cursor.point.y < rendered.size.height and cursor.point.y < window.Height {
        window.ShowCursor(cursor.point.x, cursor.point.y, cursor_style(cursor.shape))
      }
    },
    _ => (),
  }

  app.Render()
}

private fn reveal_focused_target(
  root: mut Widget,
  focus_state: focus::FocusState,
  rendered_tree: surface::Surface,
) Bool {
  let focused_path = try focus_state.current_path() -> _ { false }
  let geometry = try hit::route_geometry(rendered_tree, focused_path) -> _ { false }
  let ctx = mut event::new_reveal_context(
    focused_path,
    geometry.route_sizes,
    geometry.route_origins,
  )
  root.reveal(ctx) == event::EventResult::handled
}

private fn paint(
  root: mut Widget,
  app: mut raw::Vaxis,
  focus_state: mut focus::FocusState,
  reveal_focus: Bool,
) surface::Surface {
  mut rendered_tree = render_root(root, app, focus_state.current_path())
  mut should_reveal = reveal_focus
  if focus_state.reconcile(rendered_tree) {
    // Focus discovery and stale-path fallback must be visible in the frame being painted.
    rendered_tree = render_root(root, app, focus_state.current_path())
    let _ = focus_state.reconcile(rendered_tree)
    should_reveal = true
  }

  mut remaining_reveals = 0
  if should_reveal {
    match focus_state.current_path() {
      focused_path => { remaining_reveals = focused_path.size() + 1 },
      _ => (),
    }
  }
  while remaining_reveals > 0 {
    if reveal_focused_target(root, focus_state.@, rendered_tree) {
      rendered_tree = render_root(root, app, focus_state.current_path())
      if focus_state.reconcile(rendered_tree) {
        rendered_tree = render_root(root, app, focus_state.current_path())
      }
      remaining_reveals =- 1
    } else {
      remaining_reveals = 0
    }
  }

  let rendered = surface::flatten_focused(rendered_tree, focus_state.current_path())
  paint_surface(rendered, app)
  rendered_tree
}

private fn local_mouse(mouse: raw::Mouse, point: surface::Point) raw::Mouse {
  // Cell coordinates are target-local. Pixel coordinates remain terminal-relative
  // until Cooper exposes the terminal cell-pixel geometry needed to translate them.
  raw::Mouse{
    Button: mouse.Button,
    Row: point.y,
    Col: point.x,
    EventType: mouse.EventType,
    Modifiers: mouse.Modifiers,
    XPixel: mouse.XPixel,
    YPixel: mouse.YPixel,
  }
}

private fn is_global_key(key: raw::Key) Bool {
  key.EventType != raw::EventRelease and key.EventType != raw::EventPaste
}

fn run(root: mut Widget) Void!Error {
  let app = try raw::New(raw::Options{})
  defer app.Close()

  let focus_state = mut focus::new_state()
  mut rendered_tree = paint(root, app, focus_state, true)
  let events = app.Events()
  mut running = true

  while running {
    match events.recv() {
      received => {
        let ctx = mut event::new_context(
          route: focus_state.current_path(),
          width_measurer: fn(text: Str) Int {
            app.RenderedWidth(text)
          },
        )
        mut reveal_focus = false
        match received {
          raw::SyncFunc(action) => {
            action()
            ctx.request_redraw()
          },
          raw::Resize(size) => {
            app.Resize(size)
            ctx.request_redraw()
            reveal_focus = true
          },
          raw::Redraw(_) => ctx.request_redraw(),
          raw::QuitEvent(_) => ctx.request_quit(),
          raw::Mouse(mouse) => {
            match hit::hit_test(rendered_tree, surface::Point{x: mouse.Col, y: mouse.Row}) {
              target => {
                if mouse.Button == raw::MouseLeftButton and mouse.EventType == raw::EventPress {
                  match target.focus_path {
                    focus_path => {
                      if focus_state.focus(focus_path) {
                        ctx.request_redraw()
                        reveal_focus = true
                      }
                    },
                    _ => (),
                  }
                }
                ctx.retarget(target.route, target.route_sizes)
                let _ = root.event(ctx, local_mouse(mouse, target.local))
              },
              _ => (),
            }
          },
          raw::Key(key) => {
            if is_global_key(key) and key.MatchString("Shift+Tab") {
              if focus_state.previous() {
                ctx.request_redraw()
                reveal_focus = true
              }
            } else if is_global_key(key) and key.MatchString("Tab") {
              if focus_state.next() {
                ctx.request_redraw()
                reveal_focus = true
              }
            } else if is_global_key(key) and key.MatchString("Ctrl+c") {
              ctx.request_quit()
            } else {
              let _ = root.event(ctx, key)
            }
          },
          _ => {
            let _ = root.event(ctx, received)
          },
        }

        if ctx.redraw_requested() {
          rendered_tree = paint(root, app, focus_state, reveal_focus)
        }
        if ctx.quit_requested() {
          running = false
        }
      },
      _ => { running = false },
    }
  }

  Result::ok(())
}
