use ard/async

use cooper/clipboard
use cooper/color
use cooper/context
use cooper/core/focus
use cooper/core/node
use cooper/core/paint
use cooper/core/pointer
use cooper/core/router
use cooper/core/runtime
use cooper/core/selection_state
use cooper/event
use cooper/selection as public_selection
use cooper/terminal_progress
use go:github.com/akonwi/cooper/ffi/core/backend/clipboardbridge
use go:github.com/akonwi/cooper/ffi/core/backend/clock
use go:github.com/akonwi/cooper/ffi/core/backend/notificationbridge
use go:github.com/akonwi/cooper/ffi/core/backend/signalwatch
use go:github.com/akonwi/cooper/ffi/core/backend/urlopen
use go:github.com/akonwi/cooper/ffi/core/backend/vaxisbridge as bridge
use go:go.rockorager.dev/vaxis
use go:math
use go:sync

private fn vaxis_color(value: color::Color?) vaxis::Color {
  match value {
    color => {
      let packed = Uint32::from(color.red) * 65536 + Uint32::from(color.green) * 256 + Uint32::from(color.blue)
      vaxis::HexColor(packed)
    },
    _ => vaxis::ColorDefault,
  }
}

private fn vaxis_mouse_shape(cursor: event::MouseCursor) vaxis::MouseShape {
  match cursor {
    event::MouseCursor::pointer => vaxis::MouseShapeClickable,
    _ => vaxis::MouseShapeDefault,
  }
}

private fn terminal_progress_code(state: terminal_progress::State) Int {
  match state {
    terminal_progress::State::remove => 0,
    terminal_progress::State::normal => 1,
    terminal_progress::State::error => 2,
    terminal_progress::State::indeterminate => 3,
    terminal_progress::State::paused => 4,
  }
}

private fn vaxis_attributes(style: paint::CellStyle) vaxis::AttributeMask {
  mut attributes = vaxis::AttributeMask::from(0)
  if style.bold {
    attributes = attributes + vaxis::AttrBold
  }
  if style.dim {
    attributes = attributes + vaxis::AttrDim
  }
  if style.italic {
    attributes = attributes + vaxis::AttrItalic
  }
  if style.blink {
    attributes = attributes + vaxis::AttrBlink
  }
  if style.reverse {
    attributes = attributes + vaxis::AttrReverse
  }
  if style.strike {
    attributes = attributes + vaxis::AttrStrikethrough
  }
  if style.hidden {
    attributes = attributes + vaxis::AttrInvisible
  }
  attributes
}

private fn vaxis_style(style: paint::CellStyle) vaxis::Style {
  mut underline: vaxis::UnderlineStyle = vaxis::UnderlineOff
  if style.underline {
    underline = vaxis::UnderlineSingle
  }
  vaxis::Style{
    Hyperlink: style.hyperlink.or(""),
    Foreground: vaxis_color(style.foreground),
    Background: vaxis_color(style.background),
    UnderlineStyle: underline,
    Attribute: vaxis_attributes(style),
  }
}

private fn key_event_type(code: Int) event::KeyEventType {
  match code {
    1 => event::KeyEventType::repeat,
    2 => event::KeyEventType::release,
    _ => event::KeyEventType::press,
  }
}

private fn key_event(key: vaxis::Key) mut event::KeyEvent {
  let converted = bridge::Key(key)
  event::key(
    converted.Name,
    converted.Text,
    key_event_type(converted.EventType),
    event::Modifiers{
      shift: converted.Shift,
      ctrl: converted.Ctrl,
      alt: converted.Alt,
      super: converted.Super,
    },
  )
}

private fn mouse_event_type(code: Int) event::MouseEventType {
  match code {
    1 => event::MouseEventType::up,
    2 => event::MouseEventType::move,
    3 => event::MouseEventType::drag,
    4 => event::MouseEventType::drag_end,
    5 => event::MouseEventType::drop,
    6 => event::MouseEventType::over,
    7 => event::MouseEventType::out,
    8 => event::MouseEventType::scroll,
    _ => event::MouseEventType::down,
  }
}

private fn mouse_button(code: Int) event::MouseButton {
  match code {
    1 => event::MouseButton::left,
    2 => event::MouseButton::middle,
    3 => event::MouseButton::right,
    _ => event::MouseButton::none,
  }
}

private fn mouse_event(mouse: vaxis::Mouse) mut event::MouseEvent {
  let converted = bridge::Mouse(mouse)
  event::mouse(
    mouse_event_type(converted.EventType),
    mouse_button(converted.Button),
    converted.X,
    converted.Y,
    event::Modifiers{
      shift: converted.Shift,
      ctrl: converted.Ctrl,
      alt: converted.Alt,
      super: converted.Super,
    },
    scroll_x: converted.ScrollX,
    scroll_y: converted.ScrollY,
  )
}

private fn default_width(text: Str) Int {
  mut width = 0
  for character in vaxis::Characters(text) {
    width = width + character.Width
  }
  width
}

struct KeyListener {
  id: Int,
  handler: fn(mut event::KeyEvent),
}

struct PasteListener {
  id: Int,
  handler: fn(mut event::PasteEvent),
}

struct TerminalFocusListener {
  id: Int,
  handler: fn(event::TerminalFocus),
}

struct SelectionListener {
  id: Int,
  handler: fn(public_selection::Selection?),
}

struct PendingSelection {
  revision: Int,
  value: public_selection::Selection?,
}

struct State {
  terminal: (mut vaxis::Vaxis)?,
  clipboard_service: mut clipboard::Clipboard,
  notification_action: fn(Str, Str?) Bool,
  terminal_progress_action: fn(terminal_progress::State, Int?) Bool,
  terminal_progress_state: terminal_progress::State,
  terminal_progress_percent: Int?,
  terminal_io: mut sync::Mutex,
  terminal_suspended: Bool,
  terminal_closed: Bool,
  signal_watcher: (mut signalwatch::Watcher)?,
  system_wake: Chan<Bool>,
  pending_resize_cols: Int,
  pending_resize_rows: Int,
  lifecycle: mut sync::Mutex,
  // 0 ready, 1 running, 2 test, 3 destroyed, 4 destroying,
  // 5/6 suspended ready/running, 7/8 starting active/suspended,
  // 9/10 resuming ready/running, 11/12/13 suspending ready/running/starting,
  // 14/15 test suspended/resuming.
  phase: Int,
  resources_stopped: Bool,
  construction_committed: Bool,
  pump_started: Bool,
  test_flushing: Bool,
  shutdown: Chan<Bool>,
  wake: Chan<Bool>,
  updates: mut runtime::DispatchQueue,
  cancellation_signal: Chan<Void>,
  cancellation_closed: Bool,
  startup_done: Chan<Void>,
  startup_published: Bool,
  startup_error: Error?,
  completion_done: Chan<Void>,
  completion_published: Bool,
  completion_error: Error?,
  root_node: (mut node::Node)?,
  pointer: mut pointer::State,
  pointer_cursor: event::MouseCursor,
  pointer_cursor_initialized: Bool,
  selection: mut selection_state::State,
  focused: mut focus::State,
  has_frame: Bool,
  post_frame_quit: Bool,
  suppress_focus_reveal: Bool,
  exit_on_ctrl_c: Bool,
  auto_focus: Bool,
  headless: Bool,
  test_now_ms: Int64,
  headless_width: Int,
  headless_height: Int,
  last_frame: mut paint::Buffer,
  next_listener_id: Int,
  key_listeners: [KeyListener],
  paste_listeners: [PasteListener],
  terminal_focus_state: event::TerminalFocus?,
  terminal_focus_listeners: [TerminalFocusListener],
  selection_listeners: [SelectionListener],
  painted_selection: public_selection::Selection?,
  pending_selection: PendingSelection?,
  selection_notifying: Bool,
  selection_clear_queued: Bool,
}

private fn state(
  terminal: (mut vaxis::Vaxis)?,
  clipboard_service: mut clipboard::Clipboard,
  notification_action: fn(Str, Str?) Bool,
  terminal_progress_action: fn(terminal_progress::State, Int?) Bool,
  signal_watcher: (mut signalwatch::Watcher)?,
  exit_on_ctrl_c: Bool,
  auto_focus: Bool,
  width: Int,
  height: Int,
  construction_committed: Bool,
  headless: Bool,
) mut State {
  let terminal_io = mut sync::Mutex{}
  let lifecycle = mut sync::Mutex{}
  let updates = mut runtime::new_dispatch_queue()
  (mut State{
    terminal: terminal,
    clipboard_service: clipboard_service,
    notification_action: notification_action,
    terminal_progress_action: terminal_progress_action,
    terminal_progress_state: terminal_progress::State::remove,
    terminal_progress_percent: Maybe::new<Int>(),
    terminal_io: terminal_io,
    terminal_suspended: false,
    terminal_closed: not terminal.is_some(),
    signal_watcher: signal_watcher,
    system_wake: Chan::new<Bool>(1),
    pending_resize_cols: 0,
    pending_resize_rows: 0,
    lifecycle: lifecycle,
    phase: 0,
    resources_stopped: false,
    construction_committed: construction_committed,
    pump_started: false,
    test_flushing: false,
    shutdown: Chan::new<Bool>(1),
    wake: Chan::new<Bool>(1),
    updates: updates,
    cancellation_signal: Chan::new<Void>(),
    cancellation_closed: false,
    startup_done: Chan::new<Void>(),
    startup_published: false,
    startup_error: Maybe::new<Error>(),
    completion_done: Chan::new<Void>(),
    completion_published: false,
    completion_error: Maybe::new<Error>(),
    root_node: Maybe::new<mut node::Node>(),
    pointer: pointer::new(),
    pointer_cursor: event::MouseCursor::default_cursor,
    pointer_cursor_initialized: false,
    selection: selection_state::new(),
    focused: focus::new(),
    has_frame: false,
    post_frame_quit: false,
    suppress_focus_reveal: false,
    exit_on_ctrl_c: exit_on_ctrl_c,
    auto_focus: auto_focus,
    headless: headless,
    test_now_ms: 0,
    headless_width: width,
    headless_height: height,
    last_frame: paint::new_buffer(width, height),
    next_listener_id: 1,
    key_listeners: [],
    paste_listeners: [],
    terminal_focus_state: Maybe::new<event::TerminalFocus>(),
    terminal_focus_listeners: [],
    selection_listeners: [],
    painted_selection: Maybe::new<public_selection::Selection>(),
    pending_selection: Maybe::new<PendingSelection>(),
    selection_notifying: false,
    selection_clear_queued: false,
  })
}

fn new_live(exit_on_ctrl_c: Bool, auto_focus: Bool, use_mouse: Bool) (mut State)!Error {
  let watcher = signalwatch::New()
  match vaxis::New(vaxis::Options{DisableMouse: not use_mouse, NoSignals: true}) {
    ok(terminal) => {
      let backend = clipboardbridge::New(terminal)
      let clipboard_service = clipboard::internal_new(
        fn() Str!Error { backend.Read() },
        fn(value: Str) { backend.Write(value) },
        fn() { backend.Suspend() },
        fn() { backend.Resume() },
        fn() { backend.Cancel() },
      )
      let notification_backend = notificationbridge::New(terminal)
      let created = state(
        Maybe::new<mut vaxis::Vaxis>(terminal),
        clipboard_service,
        fn(message: Str, title: Str?) Bool {
          notification_backend.Notify(message, title.or(""))
        },
        fn(progress_state: terminal_progress::State, percent: Int?) Bool {
          notification_backend.SetProgress(
            terminal_progress_code(progress_state),
            percent.or(0),
            percent.is_some(),
          )
        },
        Maybe::new<mut signalwatch::Watcher>(watcher),
        exit_on_ctrl_c,
        auto_focus,
        0,
        0,
        false,
        false,
      )
      Result::ok(created)
    },
    err(error) => {
      watcher.Close()
      Result::err(error)
    },
  }
}

fn new_headless(
  width: Int,
  height: Int,
  notification_action: fn(Str, Str?) Bool,
  terminal_progress_action: fn(terminal_progress::State, Int?) Bool,
) mut State {
  if width < 0 or height < 0 {
    panic("headless application dimensions must be non-negative")
  }
  let created = state(
    Maybe::new<mut vaxis::Vaxis>(),
    clipboard::internal_memory(),
    notification_action,
    terminal_progress_action,
    Maybe::new<mut signalwatch::Watcher>(),
    true,
    true,
    width,
    height,
    true,
    true,
  )
  created
}

impl State {
  private fn now_ms() Int64 {
    if self.headless {
      self.test_now_ms
    } else {
      clock::Milliseconds()
    }
  }

  fn mouse_cursor() event::MouseCursor {
    self.terminal_io.Lock()
    let cursor = self.pointer_cursor
    self.terminal_io.Unlock()
    cursor
  }

  private fn mut update_pointer_cursor(root: mut node::Renderable) Bool {
    self.terminal_io.Lock()
    let next = self.pointer.mouse_cursor(root)
    mut changed = false
    if (not self.pointer_cursor_initialized) or next != self.pointer_cursor {
      self.pointer_cursor = next
      self.pointer_cursor_initialized = true
      if self.live_rendering() {
        match self.terminal {
          terminal => terminal.SetMouseShape(vaxis_mouse_shape(next)),
          _ => (),
        }
      }
      changed = true
    }
    self.terminal_io.Unlock()
    changed
  }

  fn mut advance_time_test(delta_ms: Int) {
    self.require_phase(2)
    if delta_ms < 0 {
      panic("headless time advance must be non-negative")
    }
    self.test_now_ms = self.test_now_ms + Int64::from(delta_ms)
  }

  fn mut bind_root(root: mut node::Node) {
    if self.root_node.is_some() {
      panic("application runtime Root is already bound")
    }
    self.root_node = Maybe::new<mut node::Node>(root)
  }

  private fn mut focus_node(target_id: Int) Bool {
    match self.root_node {
      root => {
        match root.find(target_id) {
          target => self.focused.focus(root.owner_as_renderable(), target),
          _ => false,
        }
      },
      _ => false,
    }
  }

  private fn mut blur_node(target_id: Int) {
    match self.focused.focused() {
      target => {
        if target.id == target_id {
          self.focused.blur(target)
        }
      },
      _ => (),
    }
  }

  fn mut focus_request() fn(Int) Bool {
    fn(target_id: Int) Bool {
      self.focus_node(target_id)
    }
  }

  fn mut blur_request() fn(Int) {
    fn(target_id: Int) {
      self.blur_node(target_id)
    }
  }

  private fn mut start_selection_node(target_id: Int, local_x: Int, local_y: Int) Bool {
    match self.root_node {
      root => {
        match root.find(target_id) {
          target => {
            let bounds = target.layout().screen
            let changed = self.selection.start(
              root.owner_as_renderable(),
              target,
              bounds.x + local_x,
              bounds.y + local_y,
            )
            if changed {
              (self.request_render())()
            }
            changed
          },
          _ => false,
        }
      },
      _ => false,
    }
  }

  private fn mut update_selection_node(
    target_id: Int,
    local_x: Int,
    local_y: Int,
    finish: Bool,
  ) Bool {
    match self.root_node {
      root => {
        match root.find(target_id) {
          target => {
            let bounds = target.layout().screen
            let generation = self.selection.generation()
            let changed = self.selection.update(
              Maybe::new<mut node::Node>(target),
              bounds.x + local_x,
              bounds.y + local_y,
            )
            if finish {
              match generation {
                expected => { let _ = self.selection.finish(expected) },
                _ => (),
              }
            }
            if changed {
              (self.request_render())()
            }
            changed
          },
          _ => false,
        }
      },
      _ => false,
    }
  }

  private fn selection_owned_by(target_id: Int) Bool {
    match self.root_node {
      root => {
        match root.find(target_id) {
          target => self.selection.owns(target),
          _ => false,
        }
      },
      _ => false,
    }
  }

  fn mut selection_start_request() fn(Int, Int, Int) Bool {
    fn(target_id: Int, local_x: Int, local_y: Int) Bool {
      self.start_selection_node(target_id, local_x, local_y)
    }
  }

  fn mut selection_update_request() fn(Int, Int, Int, Bool) Bool {
    fn(target_id: Int, local_x: Int, local_y: Int, finish: Bool) Bool {
      self.update_selection_node(target_id, local_x, local_y, finish)
    }
  }

  fn mut selection_owns_request() fn(Int) Bool {
    fn(target_id: Int) Bool {
      self.selection_owned_by(target_id)
    }
  }

  fn mut selection_clear_request() fn() {
    fn() {
      self.clear_selection()
    }
  }

  fn mut commit_construction() {
    self.lifecycle.Lock()
    if self.phase != 0 or self.construction_committed {
      self.lifecycle.Unlock()
      panic("application runtime construction cannot be committed")
    }
    self.construction_committed = true
    self.lifecycle.Unlock()
  }

  private fn mut close_cancellation() {
    self.lifecycle.Lock()
    let close = not self.cancellation_closed
    if close {
      self.cancellation_closed = true
    }
    self.lifecycle.Unlock()
    if close {
      self.cancellation_signal.close()
    }
  }

  private fn mut publish_startup(error: Error?) {
    self.lifecycle.Lock()
    let publish = not self.startup_published
    if publish {
      self.startup_published = true
      self.startup_error = error
    }
    self.lifecycle.Unlock()
    if publish {
      self.startup_done.close()
    }
  }

  private fn startup_result() Void!Error {
    self.startup_done.recv()
    self.lifecycle.Lock()
    let error = self.startup_error
    self.lifecycle.Unlock()
    match error {
      failure => Result::err(failure),
      _ => Result::ok(()),
    }
  }

  private fn mut publish_completion(error: Error?) {
    self.lifecycle.Lock()
    let publish = not self.completion_published
    if publish {
      self.completion_published = true
      self.completion_error = error
    }
    self.lifecycle.Unlock()
    if publish {
      self.completion_done.close()
    }
  }

  private fn completion_result() Void!Error {
    self.completion_done.recv()
    self.lifecycle.Lock()
    let error = self.completion_error
    self.lifecycle.Unlock()
    match error {
      failure => Result::err(failure),
      _ => Result::ok(()),
    }
  }

  fn mut rollback_construction() {
    self.lifecycle.Lock()
    let should_stop = self.phase == 0 and (not self.construction_committed) and (not self.resources_stopped)
    if should_stop {
      self.phase = 3
      self.resources_stopped = true
    }
    self.lifecycle.Unlock()

    if should_stop {
      self.updates.stop()
      self.key_listeners = []
      self.paste_listeners = []
      self.terminal_focus_listeners = []
      self.selection_listeners = []
      self.pointer.clear()
      self.selection.destroy()
      self.clipboard_service.internal_stop()
      self.close_cancellation()
      self.terminal_io.Lock()
      self.pointer_cursor = event::MouseCursor::default_cursor
      self.pointer_cursor_initialized = false
      match self.terminal {
        terminal => terminal.Close(),
        _ => (),
      }
      self.terminal_closed = true
      self.terminal_io.Unlock()
      match self.signal_watcher {
        watcher => watcher.Close(),
        _ => (),
      }
      self.publish_completion(Maybe::new<Error>())
    }
  }

  private fn mut begin_phase(expected_terminal: Bool, next_phase: Int) {
    self.lifecycle.Lock()
    let valid = self.phase == 0 and self.construction_committed and self.terminal.is_some() == expected_terminal
    if valid {
      self.phase = next_phase
    }
    self.lifecycle.Unlock()
    if not valid {
      panic("application runtime is not available to start")
    }
  }

  private fn require_phase(expected: Int) {
    self.lifecycle.Lock()
    let valid = self.phase == expected
    self.lifecycle.Unlock()
    if not valid {
      panic("application runtime is not active")
    }
  }

  private fn mut request_live_destroy() Bool {
    self.lifecycle.Lock()
    mut finish_now = false
    mut request_shutdown = false
    mut stop_dispatch = false
    if self.phase == 4 and (not self.pump_started) and (not self.resources_stopped) {
      finish_now = true
      stop_dispatch = true
    } else if (self.phase == 0 or self.phase == 5 or self.phase == 9 or self.phase == 11) and (not self.pump_started) {
      self.phase = 4
      finish_now = true
      stop_dispatch = true
    } else if self.phase == 1 or self.phase == 6 or self.phase == 7 or self.phase == 8 or self.phase == 9 or self.phase == 10 or self.phase == 11 or self.phase == 12 or self.phase == 13 {
      self.phase = 4
      request_shutdown = true
      stop_dispatch = true
    }
    self.lifecycle.Unlock()

    if stop_dispatch {
      self.clipboard_service.internal_cancel()
      self.updates.stop()
    }
    if request_shutdown {
      select {
        self.shutdown.send(true) => (),
        _ => (),
      }
    }
    finish_now
  }

  private fn mut claim_test_destroy() Bool {
    self.lifecycle.Lock()
    mut finish_now = false
    mut stop_dispatch = false
    if self.phase == 2 or self.phase == 14 or self.phase == 15 {
      stop_dispatch = true
      if self.test_flushing {
        self.phase = 4
      } else {
        self.phase = 3
        finish_now = true
      }
    }
    self.lifecycle.Unlock()
    if stop_dispatch {
      self.clipboard_service.internal_cancel()
      self.updates.stop()
    }
    finish_now
  }

  private fn test_stopping() Bool {
    self.lifecycle.Lock()
    let stopping = self.phase == 4
    self.lifecycle.Unlock()
    stopping
  }

  private fn test_active() Bool {
    self.lifecycle.Lock()
    let active = self.phase == 2
    self.lifecycle.Unlock()
    active
  }

  private fn callbacks_active() Bool {
    self.lifecycle.Lock()
    let active = self.phase == 1 or self.phase == 2
    self.lifecycle.Unlock()
    active
  }

  private fn mut begin_test_flush() {
    self.lifecycle.Lock()
    let valid = self.phase == 2 and (not self.test_flushing)
    if valid {
      self.test_flushing = true
    }
    self.lifecycle.Unlock()
    if not valid {
      panic("headless application runtime cannot flush")
    }
  }

  private fn mut end_test_flush() Bool {
    self.lifecycle.Lock()
    self.test_flushing = false
    let finish_destroy = self.phase == 4
    self.lifecycle.Unlock()
    finish_destroy
  }

  private fn live_rendering() Bool {
    self.lifecycle.Lock()
    let active = self.phase == 1
    self.lifecycle.Unlock()
    active
  }

  private fn live_stopping() Bool {
    self.lifecycle.Lock()
    let stopping = self.phase == 4
    self.lifecycle.Unlock()
    stopping
  }

  private fn mut finish_test(ctx: mut context::Context, root: mut node::Renderable) {
    root.node().unmount_root()
    context::internal_state(ctx).end_run()
    self.stop_resources(ctx)
  }

  private fn mut stop_resources(ctx: mut context::Context, error: Error?) {
    self.lifecycle.Lock()
    let should_stop = not self.resources_stopped
    if should_stop {
      self.resources_stopped = true
      self.phase = 3
    }
    self.lifecycle.Unlock()

    if should_stop {
      self.updates.stop()
      self.key_listeners = []
      self.paste_listeners = []
      self.terminal_focus_listeners = []
      self.selection_listeners = []
      self.pointer.clear()
      self.selection.destroy()
      self.clipboard_service.internal_stop()
      self.close_cancellation()
    }

    let final_error = self.release_terminal(error)
    if should_stop {
      context::internal_state(ctx).destroy()
      self.publish_completion(final_error)
    }
  }

  private fn mut release_terminal(error: Error?) Error? {
    mut final_error = error
    self.terminal_io.Lock()
    self.pointer_cursor = event::MouseCursor::default_cursor
    self.pointer_cursor_initialized = false
    if self.headless {
      self.clear_terminal_progress_locked()
    }
    if not self.terminal_closed {
      mut close_terminal = true
      match self.terminal {
        terminal => {
          if self.terminal_suspended {
            match terminal.Resume() {
              ok(_) => { self.terminal_suspended = false },
              err(resume_error) => {
                close_terminal = false
                if not final_error.is_some() {
                  final_error = Maybe::new<Error>(resume_error)
                }
              },
            }
          }
          if close_terminal {
            self.clear_terminal_progress_locked()
            terminal.Close()
            self.terminal_closed = true
          }
        },
        _ => { self.terminal_closed = true },
      }
    }
    let terminal_finished = self.terminal_closed
    self.terminal_io.Unlock()

    if terminal_finished {
      match self.signal_watcher {
        watcher => watcher.Close(),
        _ => (),
      }
    }
    final_error
  }

  private fn terminal_cleanup_pending() Bool {
    self.lifecycle.Lock()
    let cleanup_started = self.resources_stopped or (self.phase == 4 and (not self.pump_started))
    self.lifecycle.Unlock()
    self.terminal_io.Lock()
    let pending = cleanup_started and (not self.terminal_closed)
    self.terminal_io.Unlock()
    pending
  }

  private fn take_redraw_request() Bool {
    let pending = self.wake.receiver()
    select {
      pending.recv() => true,
      _ => false,
    }
  }

  private fn drain_redraw_requests() {
    let pending = self.wake.receiver()
    mut draining = true
    while draining {
      select {
        pending.recv() => (),
        _ => { draining = false },
      }
    }
  }

  private fn mut apply_pending_resize_locked(terminal: mut vaxis::Vaxis) Bool {
    self.lifecycle.Lock()
    let cols = self.pending_resize_cols
    let rows = self.pending_resize_rows
    self.pending_resize_cols = 0
    self.pending_resize_rows = 0
    self.lifecycle.Unlock()
    if cols > 0 and rows > 0 {
      let current = terminal.Size()
      terminal.Resize(vaxis::Resize{Cols: cols, Rows: rows, XPixel: current.XPixel, YPixel: current.YPixel})
      true
    } else {
      false
    }
  }

  private fn mut draw(ctx: mut context::Context, root: mut node::Renderable, width: Int, height: Int) mut paint::Buffer {
    context::internal_state(ctx).compute_layout(root, width, height)
    self.focused.reconcile(root)
    let focus_changed = self.focused.take_reveal_request()
    if focus_changed or (not self.suppress_focus_reveal) {
      match self.focused.focused() {
        target => {
          let _ = focus::reveal(root, target)
        },
        _ => (),
      }
    }
    self.suppress_focus_reveal = false
    self.selection.reconcile(root)
    let selected = self.selection.current()
    if not public_selection::internal_same(self.painted_selection, selected) {
      self.painted_selection = selected
      self.pending_selection = Maybe::new<PendingSelection>(
        PendingSelection{revision: self.selection.revision(), value: selected},
      )
    }
    let buffer = paint::new_buffer(width, height)
    root.node().paint(buffer)
    self.last_frame = buffer
    self.has_frame = true
    self.drain_redraw_requests()
    buffer
  }

  private fn mut present(terminal: mut vaxis::Vaxis, buffer: mut paint::Buffer) {
    let window = terminal.Window()
    window.Clear()
    terminal.HideCursor()
    if buffer.width > 0 {
      for cell, index in buffer.cells {
        if cell.width > 0 {
          let x = index % buffer.width
          let y = index / buffer.width
          window.SetCell(
            x,
            y,
            vaxis::Cell{
              Character: vaxis::Character{Grapheme: cell.grapheme, Width: cell.width},
              Style: vaxis_style(cell.style),
            },
          )
        }
      }
    }
    match buffer.cursor {
      cursor => {
        match buffer.cell_at(cursor.x, cursor.y) {
          cell => {
            if cell.width > 0 {
              window.ShowCursor(cursor.x, cursor.y, vaxis::CursorStyle::from(vaxis::CursorBeam))
            }
          },
          _ => (),
        }
      },
      _ => (),
    }
    terminal.Render()
  }

  private fn mut post_frame_pointer(root: mut node::Renderable) {
    let outcome = self.pointer.reconcile(root, self.focused)
    self.apply_outcome(outcome)
    let cursor_changed = self.update_pointer_cursor(root)
    if outcome.redraw or cursor_changed {
      (self.request_render())()
    }
    if outcome.quit {
      self.post_frame_quit = true
    }
  }

  private fn mut post_frame_selection() {
    mut deferred = false
    if self.pending_selection.is_some() and self.take_redraw_request() {
      deferred = true
      if self.callbacks_active() {
        (self.request_render())()
      }
    }
    if not deferred {
      match self.pending_selection {
        pending => {
          self.pending_selection = Maybe::new<PendingSelection>()
          if pending.revision == self.selection.revision() {
            let listeners = self.selection_listeners
            self.selection_notifying = true
            for listener in listeners {
              if self.callbacks_active() {
                listener.handler(pending.value)
              }
            }
            self.selection_notifying = false
            if self.selection_clear_queued {
              self.selection_clear_queued = false
              if self.callbacks_active() and self.selection.clear() {
                (self.request_render())()
              }
            }
          } else {
            (self.request_render())()
          }
        },
        _ => (),
      }
    }
  }

  private fn mut paint_live(ctx: mut context::Context, root: mut node::Renderable) {
    let terminal = self.terminal.expect("live application terminal")
    self.terminal_io.Lock()
    mut width = 0
    mut height = 0
    let active = self.live_rendering()
    if active {
      let window = terminal.Window()
      width = window.Width
      height = window.Height
    }
    self.terminal_io.Unlock()
    if active {
      let buffer = self.draw(ctx, root, width, height)
      self.terminal_io.Lock()
      let present = self.live_rendering()
      if present {
        self.present(terminal, buffer)
      }
      self.terminal_io.Unlock()
      if present {
        self.post_frame_pointer(root)
        self.post_frame_selection()
      }
    }
  }

  private fn mut paint_test(ctx: mut context::Context, root: mut node::Renderable) {
    let _ = self.draw(ctx, root, self.headless_width, self.headless_height)
    self.post_frame_pointer(root)
    self.post_frame_selection()
  }

  private fn mut apply_outcome(outcome: router::Outcome) {
    if outcome.preserve_focus_scroll {
      self.suppress_focus_reveal = true
    }
  }

  private fn mut drain_updates() Int {
    mut drained = 0
    mut draining = true
    while draining and drained < 64 {
      match self.updates.pop() {
        action => {
          action()
          drained =+ 1
        },
        _ => { draining = false },
      }
    }
    self.updates.wake_if_pending()
    drained
  }
}

impl State {
  private fn mut handle_system_shutdown(ctx: mut context::Context) {
    self.lifecycle.Lock()
    let defer_app_cleanup = (not self.pump_started) and (not self.resources_stopped) and (self.phase == 0 or self.phase == 4 or self.phase == 5 or self.phase == 9 or self.phase == 11)
    if defer_app_cleanup {
      self.phase = 4
    }
    self.lifecycle.Unlock()

    if defer_app_cleanup {
      self.updates.stop()
      self.clipboard_service.internal_stop()
      self.close_cancellation()
      let _ = self.release_terminal(Maybe::new<Error>())
    } else {
      self.destroy_live(ctx)
    }
  }

  fn mut start_signal_monitor(ctx: mut context::Context) {
    match self.signal_watcher {
      watcher => {
        async::start(fn() {
          let events = watcher.Events()
          mut watching = true
          while watching {
            match events.recv() {
              signaled => {
                mut draining = true
                while draining {
                  let received = watcher.Next()
                  if received.Kind == signalwatch::Shutdown {
                    self.handle_system_shutdown(ctx)
                    draining = false
                  } else if received.Kind == signalwatch::Resize {
                    self.lifecycle.Lock()
                    let available = self.phase != 3 and self.phase != 4
                    if available {
                      self.pending_resize_cols = received.Cols
                      self.pending_resize_rows = received.Rows
                    }
                    self.lifecycle.Unlock()
                    if available {
                      select {
                        self.system_wake.send(true) => (),
                        _ => (),
                      }
                    }
                  } else {
                    draining = false
                  }
                }
              },
              _ => { watching = false },
            }
          }
        })
      },
      _ => (),
    }
  }

  fn request_render() fn() {
    let wake = self.wake
    fn() {
      select {
        wake.send(true) => (),
        _ => (),
      }
    }
  }

  fn width_measurer() fn(Str) Int {
    match self.terminal {
      terminal => {
        let terminal_io = self.terminal_io
        fn(text: Str) Int {
          terminal_io.Lock()
          let width = terminal.RenderedWidth(text)
          terminal_io.Unlock()
          width
        }
      },
      _ => default_width,
    }
  }

  fn clipboard() mut clipboard::Clipboard {
    self.clipboard_service
  }

  fn mut notify(message: Str, title: Str?) Bool {
    self.lifecycle.Lock()
    defer self.lifecycle.Unlock()
    let active = self.phase == 0 or self.phase == 1 or self.phase == 2 or self.phase == 7
    mut accepted = false
    if active and (not self.resources_stopped) {
      accepted = (self.notification_action)(message, title)
    }
    accepted
  }

  fn mut progress(progress_state: terminal_progress::State, percent: Int?) Bool {
    self.lifecycle.Lock()
    defer self.lifecycle.Unlock()
    let active = self.phase == 0 or self.phase == 1 or self.phase == 2 or self.phase == 7
    mut accepted = false
    if active and (not self.resources_stopped) {
      accepted = (self.terminal_progress_action)(progress_state, percent)
      if accepted {
        self.terminal_progress_state = progress_state
        self.terminal_progress_percent = percent
      }
    }
    accepted
  }

  private fn mut clear_terminal_progress_locked() {
    if self.terminal_progress_state != terminal_progress::State::remove {
      self.terminal_progress_action(terminal_progress::State::remove)
    }
  }

  private fn mut restore_terminal_progress_locked() {
    if self.terminal_progress_state != terminal_progress::State::remove {
      self.terminal_progress_action(self.terminal_progress_state, self.terminal_progress_percent)
    }
  }

  private fn mut restore_terminal_progress_and_commit_phase(
    transition: Int,
    target: Int,
    reset_pointer: Bool,
  ) Bool {
    self.lifecycle.Lock()
    defer self.lifecycle.Unlock()
    let committed = self.phase == transition
    if committed {
      self.restore_terminal_progress_locked()
      self.phase = target
      if reset_pointer {
        self.pointer_cursor_initialized = false
      }
    }
    committed
  }

  fn open_url() fn(Str) Void!Error {
    fn(target: Str) Void!Error {
      urlopen::Open(target)
    }
  }

  fn dispatch() fn(fn()) Void!event::DispatchError {
    let updates = self.updates
    fn(action: fn()) Void!event::DispatchError {
      if updates.post(action) {
        Result::ok(())
      } else {
        Result::err(event::DispatchError::stopped)
      }
    }
  }

  fn cancellation() Receiver<Void> {
    self.cancellation_signal.receiver()
  }

  private fn mut next_listener() Int {
    self.lifecycle.Lock()
    let prestart_shutdown = self.phase == 4 and (not self.pump_started) and (not self.resources_stopped)
    let available = self.phase != 3 and (self.phase != 4 or prestart_shutdown) and self.next_listener_id < math::MaxInt
    mut id = 0
    if available {
      id = self.next_listener_id
      self.next_listener_id =+ 1
    }
    self.lifecycle.Unlock()
    if not available {
      panic("application listener registration is unavailable")
    }
    id
  }

  fn mut on_key(handler: fn(mut event::KeyEvent)) fn() {
    let id = self.next_listener()
    self.key_listeners.push(KeyListener{id: id, handler: handler})
    fn() { self.remove_key_listener(id) }
  }

  private fn mut remove_key_listener(id: Int) {
    let retained = mut List::new<KeyListener>()
    for listener in self.key_listeners {
      if listener.id != id {
        retained.push(listener)
      }
    }
    self.key_listeners = retained.@
  }

  fn mut on_paste(handler: fn(mut event::PasteEvent)) fn() {
    let id = self.next_listener()
    self.paste_listeners.push(PasteListener{id: id, handler: handler})
    fn() { self.remove_paste_listener(id) }
  }

  private fn mut remove_paste_listener(id: Int) {
    let retained = mut List::new<PasteListener>()
    for listener in self.paste_listeners {
      if listener.id != id {
        retained.push(listener)
      }
    }
    self.paste_listeners = retained.@
  }

  fn terminal_focus() event::TerminalFocus? {
    self.terminal_focus_state
  }

  fn mut on_terminal_focus(handler: fn(event::TerminalFocus)) fn() {
    let id = self.next_listener()
    self.terminal_focus_listeners.push(TerminalFocusListener{id: id, handler: handler})
    fn() { self.remove_terminal_focus_listener(id) }
  }

  private fn mut remove_terminal_focus_listener(id: Int) {
    let retained = mut List::new<TerminalFocusListener>()
    for listener in self.terminal_focus_listeners {
      if listener.id != id {
        retained.push(listener)
      }
    }
    self.terminal_focus_listeners = retained.@
  }

  private fn mut set_terminal_focus(value: event::TerminalFocus) {
    mut changed = true
    match self.terminal_focus_state {
      current => { changed = current != value },
      _ => (),
    }
    if changed {
      self.terminal_focus_state = Maybe::new<event::TerminalFocus>(value)
      let listeners = self.terminal_focus_listeners
      for listener in listeners {
        listener.handler(value)
      }
    }
  }

  fn current_selection() public_selection::Selection? {
    self.selection.current()
  }

  fn mut clear_selection() {
    if self.selection_notifying {
      self.selection_clear_queued = true
    } else if self.selection.clear() {
      (self.request_render())()
    }
  }

  fn mut on_selection_change(handler: fn(public_selection::Selection?)) fn() {
    let id = self.next_listener()
    self.selection_listeners.push(SelectionListener{id: id, handler: handler})
    fn() { self.remove_selection_listener(id) }
  }

  private fn mut remove_selection_listener(id: Int) {
    let retained = mut List::new<SelectionListener>()
    for listener in self.selection_listeners {
      if listener.id != id {
        retained.push(listener)
      }
    }
    self.selection_listeners = retained.@
  }

  private fn emit_key(received: mut event::KeyEvent) {
    let listeners = self.key_listeners
    for listener in listeners {
      if not received.is_propagation_stopped() {
        listener.handler(received)
      }
    }
  }

  private fn emit_paste(received: mut event::PasteEvent) {
    let listeners = self.paste_listeners
    for listener in listeners {
      if not received.is_propagation_stopped() {
        listener.handler(received)
      }
    }
  }

  fn mut suspend_live() Void!Error {
    self.terminal_io.Lock()
    self.lifecycle.Lock()
    mut previous = -1
    mut transition = -1
    mut suspended = -1
    mut available = true
    mut already_suspended = false
    if self.phase == 0 {
      previous = 0
      transition = 11
      suspended = 5
      self.phase = transition
    } else if self.phase == 1 {
      previous = 1
      transition = 12
      suspended = 6
      self.phase = transition
    } else if self.phase == 7 {
      previous = 7
      transition = 13
      suspended = 8
      self.phase = transition
    } else if self.phase == 5 or self.phase == 6 or self.phase == 8 {
      already_suspended = true
    } else {
      available = false
    }
    self.lifecycle.Unlock()

    mut outcome: Void!Error = Result::ok(())
    if available and (not already_suspended) {
      if not self.clipboard_service.internal_suspend() {
        self.lifecycle.Lock()
        if self.phase == transition {
          self.phase = previous
        }
        self.lifecycle.Unlock()
        outcome = Result::err(
          Error::new("application cannot suspend while a clipboard read is active"),
        )
      } else {
        let terminal = self.terminal.expect("live application terminal")
        self.clear_terminal_progress_locked()
        terminal.SetMouseShape(vaxis::MouseShapeDefault)
        terminal.Render()
        outcome = terminal.Suspend()
        match outcome {
          ok(_) => {
            self.terminal_suspended = true
            let events = terminal.Events()
            mut draining = true
            while draining {
              select {
                events.recv() => (),
                _ => { draining = false },
              }
            }
            self.lifecycle.Lock()
            let committed = self.phase == transition
            if committed {
              self.phase = suspended
            }
            self.lifecycle.Unlock()
            if not committed {
              outcome = Result::err(Error::new("application was destroyed while suspending"))
            }
          },
          err(error) => {
            self.clipboard_service.internal_resume()
            let _ = self.restore_terminal_progress_and_commit_phase(
              transition,
              previous,
              false,
            )
            outcome = Result::err(error)
          },
        }
      }
    }
    self.terminal_io.Unlock()

    if not available {
      Result::err(Error::new("application runtime is not available to suspend"))
    } else {
      outcome
    }
  }

  fn mut resume_live() Void!Error {
    self.terminal_io.Lock()
    self.lifecycle.Lock()
    mut suspended = -1
    mut transition = -1
    mut resumed = -1
    mut available = true
    mut already_active = false
    if self.phase == 5 {
      suspended = 5
      transition = 9
      resumed = 0
      self.phase = transition
    } else if self.phase == 6 {
      suspended = 6
      transition = 10
      resumed = 1
      self.phase = transition
    } else if self.phase == 0 or self.phase == 1 or self.phase == 7 {
      already_active = true
    } else {
      available = false
    }
    self.lifecycle.Unlock()

    mut outcome: Void!Error = Result::ok(())
    if available and (not already_active) {
      let terminal = self.terminal.expect("live application terminal")
      outcome = terminal.Resume()
      match outcome {
        ok(_) => {
          self.terminal_suspended = false
          let _ = self.apply_pending_resize_locked(terminal)
          let committed = self.restore_terminal_progress_and_commit_phase(
            transition,
            resumed,
            true,
          )
          if committed {
            self.clipboard_service.internal_resume()
            (self.request_render())()
          } else {
            outcome = Result::err(Error::new("application was destroyed while resuming"))
          }
        },
        err(error) => {
          self.lifecycle.Lock()
          if self.phase == transition {
            self.phase = suspended
          }
          self.lifecycle.Unlock()
          outcome = Result::err(error)
        },
      }
    }
    self.terminal_io.Unlock()

    if not available {
      Result::err(Error::new("application runtime is not available to resume"))
    } else {
      outcome
    }
  }

  fn mut start_live(ctx: mut context::Context, root: mut node::Renderable) Void!Error {
    self.terminal_io.Lock()
    self.lifecycle.Lock()
    mut launch = false
    mut finish_shutdown = false
    mut available = true
    if self.phase == 0 {
      self.phase = 7
      self.pump_started = true
      launch = true
    } else if self.phase == 5 {
      self.phase = 8
      self.pump_started = true
      launch = true
    } else if self.phase == 1 or self.phase == 6 or self.phase == 7 or self.phase == 8 or self.phase == 9 or self.phase == 10 {
      available = self.pump_started
    } else {
      finish_shutdown = self.phase == 4 and (not self.pump_started) and (not self.resources_stopped)
      available = false
    }
    self.lifecycle.Unlock()
    self.terminal_io.Unlock()

    if not available {
      if finish_shutdown {
        self.stop_resources(ctx)
      }
      Result::err(Error::new("application runtime is not available to start"))
    } else {
      if launch {
        async::start(fn() {
          self.live_pump(ctx, root)
        })
      }
      self.startup_result()
    }
  }

  fn wait_live() Void!Error {
    self.lifecycle.Lock()
    let available = self.pump_started
    self.lifecycle.Unlock()
    if not available {
      Result::err(Error::new("application runtime has not started"))
    } else {
      self.completion_result()
    }
  }

  fn mut run(ctx: mut context::Context, root: mut node::Renderable) Void!Error {
    try self.start_live(ctx, root)
    self.wait_live()
  }

  private fn mut live_pump(ctx: mut context::Context, root: mut node::Renderable) {
    context::internal_state(ctx).begin_run()
    defer self.stop_resources(ctx)
    defer context::internal_state(ctx).end_run()
    defer self.publish_startup(Maybe::new<Error>(Error::new("application startup did not complete")))
    root.node().mount_root(self.dispatch())
    defer root.node().unmount_root()

    self.terminal_io.Lock()
    self.lifecycle.Lock()
    mut started = false
    mut active = false
    if self.phase == 7 {
      self.phase = 1
      started = true
      active = true
    } else if self.phase == 8 {
      self.phase = 6
      started = true
    }
    self.lifecycle.Unlock()

    if active {
      let terminal = self.terminal.expect("live application terminal")
      if self.live_rendering() {
        if not self.apply_pending_resize_locked(terminal) {
          terminal.Resize(terminal.Size())
        }
      }
    }
    self.terminal_io.Unlock()
    if active {
      self.paint_live(ctx, root)
    }

    self.lifecycle.Lock()
    let startup_valid = started and self.phase != 4 and self.phase != 3
    self.lifecycle.Unlock()
    if startup_valid {
      self.publish_startup(Maybe::new<Error>())
      self.live_event_loop(ctx, root)
    } else {
      self.publish_startup(Maybe::new<Error>(Error::new("application was destroyed during startup")))
    }

    if not self.live_stopping() {
      let _ = self.request_live_destroy()
    }
  }

  private fn mut live_event_loop(ctx: mut context::Context, root: mut node::Renderable) {
    let terminal = self.terminal.expect("live application terminal")
    let events = terminal.Events()
    let redraws = self.wake.receiver()
    let update_events = self.updates.events()
    let shutdowns = self.shutdown.receiver()
    let system_events = self.system_wake.receiver()
    mut running = true
    while running and (not self.live_stopping()) and (not self.post_frame_quit) {
      if self.live_rendering() {
        select {
        shutdowns.recv() => { running = false },
        system_events.recv() => {
          self.terminal_io.Lock()
          mut resized = false
          if self.live_rendering() {
            resized = self.apply_pending_resize_locked(terminal)
          }
          self.terminal_io.Unlock()
          if resized {
            self.paint_live(ctx, root)
          }
        },
        redraws.recv() => {
          if self.live_rendering() {
            self.paint_live(ctx, root)
          }
        },
        update_events.recv() => {
          let _ = self.drain_updates()
          if self.take_redraw_request() and self.live_rendering() {
            self.paint_live(ctx, root)
          }
        },
        let posted = events.recv() => {
          match posted {
            received => {
              if self.live_stopping() {
                running = false
              } else {
                match received {
                  vaxis::QuitEvent(_) => { running = false },
                  _ => {
                    if self.live_rendering() {
                      if self.take_redraw_request() {
                        self.paint_live(ctx, root)
                      } else {
                        self.focused.reconcile(root)
                      }
                      match received {
                      vaxis::Resize(size) => {
                        self.terminal_io.Lock()
                        if self.live_rendering() {
                          terminal.Resize(size)
                        }
                        self.terminal_io.Unlock()
                        self.paint_live(ctx, root)
                      },
                      vaxis::Redraw(_) => self.paint_live(ctx, root),
                      vaxis::SyncFunc(action) => {
                        action()
                        if self.take_redraw_request() {
                          self.paint_live(ctx, root)
                        }
                      },
                      vaxis::FocusIn(_) => {
                        self.set_terminal_focus(event::TerminalFocus::gained)
                        if self.take_redraw_request() {
                          self.paint_live(ctx, root)
                        }
                      },
                      vaxis::FocusOut(_) => {
                        self.set_terminal_focus(event::TerminalFocus::lost)
                        if self.take_redraw_request() {
                          self.paint_live(ctx, root)
                        }
                      },
                      vaxis::Mouse(mouse) => {
                        let converted = mouse_event(mouse)
                        let outcome = self.pointer.process(root, converted, self.focused, self.selection, self.auto_focus, self.now_ms())
                        self.apply_outcome(outcome)
                        let cursor_changed = self.update_pointer_cursor(root)
                        if outcome.redraw or cursor_changed or self.take_redraw_request() {
                          self.paint_live(ctx, root)
                        }
                        if outcome.quit or self.post_frame_quit {
                          running = false
                        }
                      },
                      vaxis::Key(key) => {
                        if key.EventType == vaxis::EventPaste {
                          let converted = event::paste(key.Text)
                          self.emit_paste(converted)
                          self.focused.reconcile(root)
                          match self.focused.focused() {
                            target => {
                              if not converted.is_propagation_stopped() {
                                let outcome = router::dispatch_paste(target, converted, self.focused)
                                self.apply_outcome(outcome)
                                if outcome.redraw {
                                  self.paint_live(ctx, root)
                                }
                                if outcome.quit {
                                  running = false
                                }
                              }
                            },
                            _ => (),
                          }
                        } else {
                          let converted = key_event(key)
                          self.emit_key(converted)
                          self.focused.reconcile(root)
                          if self.exit_on_ctrl_c and converted.event_type != event::KeyEventType::release and converted.matches("c", ctrl: true) and (not converted.is_default_prevented()) and (not converted.is_propagation_stopped()) {
                            running = false
                          } else {
                            match self.focused.focused() {
                              target => {
                                if not converted.is_propagation_stopped() {
                                  let outcome = router::dispatch_key(target, converted, self.focused)
                                  self.apply_outcome(outcome)
                                  if outcome.redraw {
                                    self.paint_live(ctx, root)
                                  }
                                  if outcome.quit {
                                    running = false
                                  }
                                }
                              },
                              _ => (),
                            }
                          }
                        }
                      },
                      _ => (),
                      }
                    }
                  },
                }
              }
            },
            _ => { running = false },
          }
        },
        }
      } else {
        select {
          shutdowns.recv() => { running = false },
          system_events.recv() => {
            self.terminal_io.Lock()
            mut resized = false
            if self.live_rendering() {
              resized = self.apply_pending_resize_locked(terminal)
            }
            self.terminal_io.Unlock()
            if resized {
              self.paint_live(ctx, root)
            }
          },
          redraws.recv() => {
            if self.live_rendering() {
              self.paint_live(ctx, root)
            }
          },
          update_events.recv() => {
            let _ = self.drain_updates()
            if self.take_redraw_request() and self.live_rendering() {
              self.paint_live(ctx, root)
            }
          },
        }
      }
    }
  }

  fn mut destroy_live(ctx: mut context::Context) {
    let finish_now = self.request_live_destroy()
    if finish_now or self.terminal_cleanup_pending() {
      self.stop_resources(ctx)
    }
  }

  fn mut start_test(ctx: mut context::Context, root: mut node::Renderable) {
    self.begin_phase(false, 2)
    context::internal_state(ctx).begin_run()
    root.node().mount_root(self.dispatch())
  }

  fn mut render_test(ctx: mut context::Context, root: mut node::Renderable) {
    self.require_phase(2)
    self.paint_test(ctx, root)
  }

  fn mut key_test(ctx: mut context::Context, root: mut node::Renderable, received: mut event::KeyEvent) {
    self.require_phase(2)
    self.emit_key(received)
    self.focused.reconcile(root)
    mut redraw = false
    match self.focused.focused() {
      target => {
        if not received.is_propagation_stopped() {
          let outcome = router::dispatch_key(target, received, self.focused)
          self.apply_outcome(outcome)
          redraw = outcome.redraw
        }
      },
      _ => (),
    }
    if self.test_active() and (redraw or self.take_redraw_request()) {
      self.paint_test(ctx, root)
    }
  }

  fn mut paste_test(ctx: mut context::Context, root: mut node::Renderable, received: mut event::PasteEvent) {
    self.require_phase(2)
    self.emit_paste(received)
    self.focused.reconcile(root)
    mut redraw = false
    match self.focused.focused() {
      target => {
        if not received.is_propagation_stopped() {
          let outcome = router::dispatch_paste(target, received, self.focused)
          self.apply_outcome(outcome)
          redraw = outcome.redraw
        }
      },
      _ => (),
    }
    if self.test_active() and (redraw or self.take_redraw_request()) {
      self.paint_test(ctx, root)
    }
  }

  fn mut mouse_test(ctx: mut context::Context, root: mut node::Renderable, received: mut event::MouseEvent) {
    self.require_phase(2)
    mut precommit = not self.has_frame
    if self.take_redraw_request() {
      precommit = true
    }
    if precommit {
      self.paint_test(ctx, root)
    } else {
      self.focused.reconcile(root)
    }
    let outcome = self.pointer.process(root, received, self.focused, self.selection, self.auto_focus, self.now_ms())
    self.apply_outcome(outcome)
    let cursor_changed = self.update_pointer_cursor(root)
    if self.test_active() and (outcome.redraw or cursor_changed or self.take_redraw_request()) {
      self.paint_test(ctx, root)
    }
  }

  fn mut terminal_focus_test(
    ctx: mut context::Context,
    root: mut node::Renderable,
    value: event::TerminalFocus,
  ) {
    self.require_phase(2)
    self.set_terminal_focus(value)
    if self.test_active() and self.take_redraw_request() {
      self.paint_test(ctx, root)
    }
  }

  fn mut flush_test(ctx: mut context::Context, root: mut node::Renderable, limit: Int) Int {
    self.require_phase(2)
    if limit < 0 {
      panic("headless flush limit must be non-negative")
    }
    self.begin_test_flush()
    mut drained = 0
    mut reading = true
    while reading and drained < limit {
      match self.updates.pop() {
        action => {
          action()
          drained =+ 1
          if self.test_stopping() {
            reading = false
          }
        },
        _ => { reading = false },
      }
    }
    if self.test_stopping() {
      if self.take_redraw_request() {
        self.paint_test(ctx, root)
      }
    } else {
      self.updates.wake_if_pending()
      if self.take_redraw_request() {
        self.paint_test(ctx, root)
      }
    }
    if self.end_test_flush() {
      self.finish_test(ctx, root)
    }
    drained
  }

  fn mut suspend_test() Bool {
    self.terminal_io.Lock()
    defer self.terminal_io.Unlock()
    self.lifecycle.Lock()
    let available = self.phase == 2
    if available {
      self.phase = 14
    }
    self.lifecycle.Unlock()
    if available {
      self.clear_terminal_progress_locked()
      self.terminal_suspended = true
    }
    available
  }

  fn mut resume_test() Bool {
    self.terminal_io.Lock()
    defer self.terminal_io.Unlock()
    self.lifecycle.Lock()
    let available = self.phase == 14
    if available {
      self.phase = 15
    }
    self.lifecycle.Unlock()
    if not available {
      false
    } else {
      self.terminal_suspended = false
      self.restore_terminal_progress_and_commit_phase(15, 2, false)
    }
  }

  fn mut resize_test(width: Int, height: Int) {
    self.require_phase(2)
    if width < 0 or height < 0 {
      panic("headless application dimensions must be non-negative")
    }
    if self.headless_width != width or self.headless_height != height {
      self.headless_width = width
      self.headless_height = height
      (self.request_render())()
    }
  }

  fn frame() paint::Buffer {
    self.last_frame.@
  }

  fn mut destroy_test(ctx: mut context::Context, root: mut node::Renderable) {
    if self.claim_test_destroy() {
      self.finish_test(ctx, root)
    }
  }
}
