use cooper/core/node
use cooper/style
use go:math

private fn collect_node(current: mut node::Node, targets: mut [mut node::Node]) {
  if (not current.is_destroyed()) and current.style().display != style::Display::none {
    if current.is_focusable() {
      targets.push(current)
    }
    for child in current.children {
      collect_node(child, targets)
    }
  }
}

fn targets(root: mut node::Renderable) [mut node::Node] {
  let retained = root.node()
  if retained.parent.is_some() {
    panic("retained focus lookup requires a detached root")
  }
  let found = mut List::new<mut node::Node>()
  collect_node(retained, found)
  found.@
}

struct AutoFocusCandidate {
  root: mut node::Node,
  target: mut node::Node,
  target_generation: Int,
  ancestor: mut node::Node,
  ancestor_generation: Int,
}

fn capture_autofocus(root: mut node::Renderable, target: mut node::Node) AutoFocusCandidate? {
  let root_node = root.node()
  mut current = Maybe::new<mut node::Node>(target)
  mut ancestor = Maybe::new<mut node::Node>()
  mut found_root = false
  mut scanning = true
  while scanning {
    match current {
      retained => {
        if (not ancestor.is_some()) and retained.is_focusable() {
          ancestor = Maybe::new<mut node::Node>(retained)
        }
        if retained == root_node {
          found_root = true
          scanning = false
        } else {
          current = retained.parent
        }
      },
      _ => { scanning = false },
    }
  }
  match ancestor {
    candidate => {
      if found_root {
        Maybe::new<AutoFocusCandidate>(
          AutoFocusCandidate{
            root: root_node,
            target: target,
            target_generation: target.attachment_generation(),
            ancestor: candidate,
            ancestor_generation: candidate.attachment_generation(),
          },
        )
      } else {
        Maybe::new<AutoFocusCandidate>()
      }
    },
    _ => Maybe::new<AutoFocusCandidate>(),
  }
}

private fn autofocus_is_current(candidate: AutoFocusCandidate) Bool {
  if (not candidate.target.is_mounted()) or candidate.target.attachment_generation() != candidate.target_generation or (not candidate.ancestor.is_mounted()) or candidate.ancestor.attachment_generation() != candidate.ancestor_generation {
    false
  } else {
    mut current = Maybe::new<mut node::Node>(candidate.target)
    mut found_ancestor = false
    mut found_root = false
    mut scanning = true
    while scanning {
      match current {
        retained => {
          if not retained.pointer_route_visible() {
            scanning = false
          } else {
            if retained == candidate.ancestor {
              found_ancestor = true
            }
            if retained == candidate.root {
              found_root = true
              scanning = false
            } else {
              current = retained.parent
            }
          }
        },
        _ => { scanning = false },
      }
    }
    found_ancestor and found_root
  }
}

private fn saturating_add(left: Int, right: Int) Int {
  if right > 0 and left > math::MaxInt - right {
    math::MaxInt
  } else if right < 0 and left < math::MinInt - right {
    math::MinInt
  } else {
    left + right
  }
}

private fn saturating_subtract(left: Int, right: Int) Int {
  if right > 0 and left < math::MinInt + right {
    math::MinInt
  } else if right < 0 and left > math::MaxInt + right {
    math::MaxInt
  } else {
    left - right
  }
}

fn reveal(root: mut node::Renderable, target: mut node::Node) Bool {
  let root_node = root.node()
  mut ancestor = target.parent
  mut moved = false
  mut scanning = true
  while scanning {
    match ancestor {
      current => {
        if current.style().overflow == style::Overflow::scroll {
          let viewport = current.layout().screen
          let target_bounds = target.focus_reveal_bounds()
          if viewport.width > 0 {
            mut requested = current.scroll_x()
            if target_bounds.x < viewport.x {
              let distance = saturating_subtract(viewport.x, target_bounds.x)
              requested = saturating_subtract(requested, distance)
            } else if target_bounds.width >= viewport.width {
              if target_bounds.x > viewport.x {
                let distance = saturating_subtract(target_bounds.x, viewport.x)
                requested = saturating_add(requested, distance)
              }
            } else {
              let target_right = saturating_add(target_bounds.x, target_bounds.width)
              let viewport_right = saturating_add(viewport.x, viewport.width)
              if target_right > viewport_right {
                let distance = saturating_subtract(target_right, viewport_right)
                requested = saturating_add(requested, distance)
              }
            }
            if current.set_scroll_x(requested) {
              moved = true
            }
          }
          if viewport.height > 0 {
            mut requested = current.scroll_y()
            if target_bounds.y < viewport.y {
              let distance = saturating_subtract(viewport.y, target_bounds.y)
              requested = saturating_subtract(requested, distance)
            } else if target_bounds.height >= viewport.height {
              if target_bounds.y > viewport.y {
                let distance = saturating_subtract(target_bounds.y, viewport.y)
                requested = saturating_add(requested, distance)
              }
            } else {
              let target_bottom = saturating_add(target_bounds.y, target_bounds.height)
              let viewport_bottom = saturating_add(viewport.y, viewport.height)
              if target_bottom > viewport_bottom {
                let distance = saturating_subtract(target_bottom, viewport_bottom)
                requested = saturating_add(requested, distance)
              }
            }
            if current.set_scroll_y(requested) {
              moved = true
            }
          }
        }

        if current == root_node {
          scanning = false
        } else {
          ancestor = current.parent
        }
      },
      _ => { scanning = false },
    }
  }
  moved
}

struct State {
  focused_node: (mut node::Node)?,
  reveal_requested: Bool,
}

fn new() mut State {
  (mut State{
    focused_node: Maybe::new<mut node::Node>(),
    reveal_requested: false,
  })
}

impl State {
  fn focused() (mut node::Node)? {
    self.focused_node
  }

  fn is_focused(target: mut node::Node) Bool {
    match self.focused_node {
      current => current == target,
      _ => false,
    }
  }

  private fn mut change(next: (mut node::Node)?) {
    mut changed = true
    match self.focused_node {
      current => {
        match next {
          candidate => { changed = current != candidate },
          _ => (),
        }
      },
      _ => {
        if not next.is_some() {
          changed = false
        }
      },
    }

    if changed {
      let previous = self.focused_node
      self.focused_node = next
      self.reveal_requested = next.is_some()
      match previous {
        prior => prior.set_focused(false),
        _ => (),
      }
      match next {
        intended => {
          if self.is_focused(intended) and intended.is_focusable() {
            intended.set_focused(true)
          }
        },
        _ => (),
      }
    }
  }

  fn mut clear() {
    self.change(Maybe::new<mut node::Node>())
  }

  fn mut blur(target: mut node::Node) {
    if self.is_focused(target) {
      self.clear()
    }
  }

  fn mut autofocus(root: mut node::Renderable, candidate: AutoFocusCandidate) Bool {
    if root.node() == candidate.root and autofocus_is_current(candidate) {
      self.focus(root, candidate.ancestor)
    } else {
      false
    }
  }

  fn mut focus(root: mut node::Renderable, target: mut node::Node) Bool {
    mut accepted = false
    for candidate in targets(root) {
      if candidate == target {
        accepted = true
      }
    }
    if accepted {
      self.change(Maybe::new<mut node::Node>(target))
      mut retained = false
      for candidate in targets(root) {
        if candidate == target {
          retained = true
        }
      }
      if self.is_focused(target) and retained {
        self.reveal_requested = true
      } else if self.is_focused(target) {
        self.clear()
      }
    }
    self.is_focused(target)
  }

  fn mut reconcile(root: mut node::Renderable) {
    match self.focused_node {
      current => {
        mut retained = false
        for candidate in targets(root) {
          if candidate == current {
            retained = true
          }
        }
        if not retained {
          self.clear()
        }
      },
      _ => (),
    }
  }

  fn mut take_reveal_request() Bool {
    let requested = self.reveal_requested
    self.reveal_requested = false
    requested
  }
}
