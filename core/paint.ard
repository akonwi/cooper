use cooper/ui/color
use cooper/ui/geometry
use go:go.rockorager.dev/vaxis

struct CellStyle {
  foreground: color::Color?,
  background: color::Color?,
  bold: Bool,
  dim: Bool,
  italic: Bool,
  underline: Bool,
  blink: Bool,
  reverse: Bool,
  strike: Bool,
  hidden: Bool,
  hyperlink: Str?,
}

fn style(
  foreground: color::Color?,
  background: color::Color?,
  bold: Bool?,
  dim: Bool?,
  italic: Bool?,
  underline: Bool?,
  blink: Bool?,
  reverse: Bool?,
  strike: Bool?,
  hidden: Bool?,
  hyperlink: Str?,
) CellStyle {
  CellStyle{
    foreground: foreground,
    background: background,
    bold: bold.or(false),
    dim: dim.or(false),
    italic: italic.or(false),
    underline: underline.or(false),
    blink: blink.or(false),
    reverse: reverse.or(false),
    strike: strike.or(false),
    hidden: hidden.or(false),
    hyperlink: hyperlink,
  }
}

struct Cell {
  grapheme: Str,
  width: Int,
  style: CellStyle,
}

private fn blank_cell(foreground: color::Color?, background: color::Color?) Cell {
  Cell{
    grapheme: " ",
    width: 1,
    style: style(foreground: foreground, background: background),
  }
}

private fn continuation(style: CellStyle) Cell {
  Cell{
    grapheme: "",
    width: 0,
    style: style,
  }
}

struct Cursor {
  x: Int,
  y: Int,
}

struct Buffer {
  width: Int,
  height: Int,
  cells: [Cell],
  cursor: Cursor?,
}

fn new_buffer(width: Int, height: Int) mut Buffer {
  if width < 0 or height < 0 {
    panic("retained paint buffer dimensions must be non-negative")
  }
  let cells = mut List::new<Cell>()
  mut index = 0
  while index < width * height {
    cells.push(blank_cell())
    index =+ 1
  }
  (mut Buffer{
    width: width,
    height: height,
    cells: cells.@,
    cursor: Maybe::new<Cursor>(),
  })
}

impl Buffer {
  private fn index(x: Int, y: Int) Int? {
    if x >= 0 and y >= 0 and x < self.width and y < self.height {
      Maybe::new<Int>(y * self.width + x)
    } else {
      Maybe::new<Int>()
    }
  }

  fn cell_at(x: Int, y: Int) Cell? {
    let index = try self.index(x, y) -> _ { Maybe::new<Cell>() }
    self.cells.at(index)
  }

  private fn mut put(x: Int, y: Int, cell: Cell) {
    match self.index(x, y) {
      index => self.cells.set(index, cell),
      _ => (),
    }
  }

  private fn foreground_at(x: Int, y: Int) color::Color? {
    match self.cell_at(x, y) {
      cell => cell.style.foreground,
      _ => Maybe::new<color::Color>(),
    }
  }

  private fn background_at(x: Int, y: Int) color::Color? {
    match self.cell_at(x, y) {
      cell => cell.style.background,
      _ => Maybe::new<color::Color>(),
    }
  }

  private fn mut clear_span_at(x: Int, y: Int) {
    let existing = try self.cell_at(x, y) -> _ { () }
    mut start = x
    if existing.width == 0 {
      mut scanning = x - 1
      mut found = false
      while scanning >= 0 and not found {
        match self.cell_at(scanning, y) {
          candidate => {
            if candidate.width > 0 {
              if scanning + candidate.width > x {
                start = scanning
              }
              found = true
            }
          },
          _ => { found = true },
        }
        scanning =- 1
      }
    }

    let lead = try self.cell_at(start, y) -> _ { () }
    mut span = lead.width
    if span < 1 {
      span = 1
    }
    match self.cursor {
      cursor => {
        if cursor.y == y and cursor.x >= start and cursor.x < start + span {
          self.cursor = Maybe::new<Cursor>()
        }
      },
      _ => (),
    }
    mut part = 0
    while part < span {
      let target_x = start + part
      self.put(
        target_x,
        y,
        blank_cell(self.foreground_at(target_x, y), self.background_at(target_x, y)),
      )
      part =+ 1
    }
  }

  private fn mut write_grapheme(x: Int, y: Int, grapheme: Str, width: Int, style: CellStyle) {
    mut part = 0
    while part < width {
      self.clear_span_at(x + part, y)
      part =+ 1
    }
    self.put(
      x,
      y,
      Cell{
        grapheme: grapheme,
        width: width,
        style: style,
      },
    )
    part = 1
    while part < width {
      self.put(x + part, y, continuation(style))
      part =+ 1
    }
  }

  fn mut clear() {
    self.cursor = Maybe::new<Cursor>()
    mut index = 0
    while index < self.cells.size() {
      self.cells.set(index, blank_cell())
      index =+ 1
    }
  }
}

struct Context {
  buffer: mut Buffer,
  bounds: geometry::Rect,
  clip: geometry::Rect,
  foreground: color::Color?,
  background: color::Color?,
}

impl Context {
  private fn inherited_colors(requested: CellStyle) CellStyle {
    let painted = mut requested
    if not painted.foreground.is_some() {
      painted.foreground = self.foreground
    }
    if not painted.background.is_some() {
      painted.background = self.background
    }
    painted.@
  }

  fn mut fill(text_style: CellStyle?) {
    let applied_style = text_style.or(style())
    let visible = geometry::intersect(self.bounds, self.clip)
    mut target_y = visible.y
    while target_y < visible.y + visible.height {
      mut target_x = visible.x
      while target_x < visible.x + visible.width {
        self.buffer.write_grapheme(
          target_x,
          target_y,
          " ",
          1,
          self.inherited_colors(applied_style),
        )
        target_x =+ 1
      }
      target_y =+ 1
    }
  }

  fn mut show_cursor(x: Int, y: Int) {
    let target_x = self.bounds.x + x
    let target_y = self.bounds.y + y
    if geometry::contains(self.clip, target_x, target_y) {
      self.buffer.cursor = Maybe::new<Cursor>(Cursor{x: target_x, y: target_y})
    }
  }

  fn mut write(x: Int, y: Int, text: Str, text_style: CellStyle?) {
    self.write_measured(
      x,
      y,
      text,
      fn(grapheme: Str) Int {
        mut width = 0
        for character in vaxis::Characters(grapheme) {
          width = width + character.Width
        }
        width
      },
      text_style: text_style,
    )
  }

  fn mut write_overlay(x: Int, y: Int, text: Str, text_style: CellStyle?) {
    let applied_style = text_style.or(style())
    let target_y = self.bounds.y + y
    mut target_x = self.bounds.x + x
    for character in vaxis::Characters(text) {
      let width = character.Width
      mut visible = width > 0
      mut part = 0
      while part < width {
        if not geometry::contains(self.clip, target_x + part, target_y) {
          visible = false
        }
        part =+ 1
      }
      if visible {
        self.buffer.write_grapheme(
          target_x,
          target_y,
          character.Grapheme,
          width,
          self.inherited_colors(applied_style),
        )
      }
      target_x = target_x + width
    }
  }

  fn mut write_measured(x: Int, y: Int, text: Str, measure_width: fn(Str) Int, text_style: CellStyle?) {
    let applied_style = text_style.or(style())
    let target_y = self.bounds.y + y
    mut target_x = self.bounds.x + x
    for character in vaxis::Characters(text) {
      let width = measure_width(character.Grapheme)
      mut visible = width > 0
      mut part = 0
      while part < width {
        if not geometry::contains(self.clip, target_x + part, target_y) {
          visible = false
        }
        part =+ 1
      }

      if visible {
        self.buffer.write_grapheme(
          target_x,
          target_y,
          character.Grapheme,
          width,
          self.inherited_colors(applied_style),
        )
      } else {
        part = 0
        while part < width {
          if geometry::contains(self.clip, target_x + part, target_y) {
            self.buffer.clear_span_at(target_x + part, target_y)
          }
          part =+ 1
        }
      }
      target_x = target_x + width
    }
  }
}
