use cooper/animation
use cooper/core/runtime as scopes
use cooper/event
use cooper/keymap
use cooper/runtime
use cooper/theme
use cooper/ui/selection

// Capture this value before starting a worker. Only dispatched callbacks may
// access mutable component state. Cancellation is signaled before unmounting.
struct Context {
  dispatch: fn(fn()) Void!event::DispatchError,
  cancellation: Receiver<Void>,
  // UI-thread-only escape hatch for callbacks that change ancestor/shared state.
  // Local dispatch and animation updates otherwise refresh only this subtree.
  invalidate_root: fn(),
  // UI-thread-only Runtime subscriptions; removal on unmount is automatic.
  // Returned functions optionally unsubscribe early and are idempotent.
  on_terminal_focus: fn(fn(event::TerminalFocus)) fn(),
  on_theme_changed: fn(fn(theme::Theme)) fn(),
  on_selection_change: fn(fn(selection::Selection?)) fn(),
  on_key: fn(fn(mut event::KeyEvent)) fn(),
  on_paste: fn(fn(mut event::PasteEvent)) fn(),
  bind_keys: fn(mut keymap::Layer) fn(),
  on_keys_change: fn(fn()) fn(),
  shortcuts: fn() [keymap::Shortcut],
  commands: fn() [keymap::Command],
  terminal_focus: fn() event::TerminalFocus?,
  theme: fn() theme::Theme,
  current_selection: fn() selection::Selection?,
  // Framework-only: settle lazy descendants between layout and painting.
  internal_layout: fn(fn() Bool) fn(),
  // Framework-only: application notifications after a committed frame.
  internal_commit: fn(fn()) fn(),
  internal_animate: fn(Int, fn(animation::Frame), animation::Easing) fn(),
  // Framework-only: one UI-thread attempt after pending commits, before painting.
  internal_focus: fn(fn()) fn(),
}

impl Context {
  // UI-thread-only, including the returned idempotent cancellation function.
  // Duration is positive milliseconds. Frames automatically invalidate CUI.
  // An unmounted context cannot start new work. Completion releases callbacks.
  fn animate(duration: Int, update: fn(animation::Frame), ease: animation::Easing?) fn() {
    if duration <= 0 {
      panic("animation duration must be positive")
    }
    (self.internal_animate)(duration, update, ease.or(animation::linear))
  }
}

fn internal_new(
  runtime: mut runtime::Runtime,
  base: fn(fn()) Void!event::DispatchError,
  scope: mut scopes::MountScope,
  invalidate: fn(),
  invalidate_root: fn(),
  layout: fn(fn() Bool) fn(),
) Context {
  let deliver = scopes::scoped_dispatch(base, scope)
  Context{
    dispatch: fn(work: fn()) Void!event::DispatchError {
      deliver(fn() {
        work()
        invalidate()
      })
    },
    cancellation: scope.cancellation(),
    internal_focus: fn(work: fn()) fn() {
      let subscription = scope.subscription()
      if subscription.active {
        subscription.remove_listener = runtime.internal_on_layout(fn() Bool {
          if subscription.active {
            subscription.cancel()
            work()
          }
          false
        })
        invalidate()
      }
      fn() {
        subscription.cancel()
      }
    },
    internal_layout: fn(work: fn() Bool) fn() {
      let subscription = scope.subscription()
      if subscription.active {
        subscription.remove_listener = layout(fn() Bool {
          subscription.active and work()
        })
      }
      fn() {
        subscription.cancel()
      }
    },
    internal_commit: fn(work: fn()) fn() {
      let subscription = scope.subscription()
      if subscription.active {
        subscription.remove_listener = runtime.internal_on_commit(fn() {
          if subscription.active {
            work()
          }
        })
      }
      fn() {
        subscription.cancel()
      }
    },
    invalidate_root: fn() {
      if not scope.is_cancelled() {
        invalidate_root()
      }
    },
    on_terminal_focus: fn(handler: fn(event::TerminalFocus)) fn() {
      let subscription = scope.subscription()
      if subscription.active {
        subscription.remove_listener = runtime.on_terminal_focus(fn(value: event::TerminalFocus) {
          if subscription.active {
            handler(value)
            invalidate()
          }
        })
      }
      fn() {
        subscription.cancel()
      }
    },
    on_theme_changed: fn(handler: fn(theme::Theme)) fn() {
      let subscription = scope.subscription()
      if subscription.active {
        subscription.remove_listener = runtime.on_theme_changed(fn(value: theme::Theme) {
          if subscription.active {
            handler(value)
            invalidate()
          }
        })
      }
      fn() {
        subscription.cancel()
      }
    },
    on_selection_change: fn(handler: fn(selection::Selection?)) fn() {
      let subscription = scope.subscription()
      if subscription.active {
        subscription.remove_listener = runtime.on_selection_change(fn(value: selection::Selection?) {
          if subscription.active {
            handler(value)
            invalidate()
          }
        })
      }
      fn() {
        subscription.cancel()
      }
    },
    on_key: fn(handler: fn(mut event::KeyEvent)) fn() {
      let subscription = scope.subscription()
      if subscription.active {
        subscription.remove_listener = runtime.on_key(fn(value: mut event::KeyEvent) {
          if subscription.active {
            handler(value)
            invalidate()
          }
        })
      }
      fn() {
        subscription.cancel()
      }
    },
    on_paste: fn(handler: fn(mut event::PasteEvent)) fn() {
      let subscription = scope.subscription()
      if subscription.active {
        subscription.remove_listener = runtime.on_paste(fn(value: mut event::PasteEvent) {
          if subscription.active {
            handler(value)
            invalidate()
          }
        })
      }
      fn() {
        subscription.cancel()
      }
    },
    bind_keys: fn(layer: mut keymap::Layer) fn() {
      let subscription = scope.subscription()
      if subscription.active {
        let after = layer.internal_after_run
        layer.internal_after_run = fn() {
          after()
          if subscription.active {
            invalidate()
          }
        }
        subscription.remove_listener = keymap::register(runtime, layer)
      }
      fn() {
        subscription.cancel()
      }
    },
    on_keys_change: fn(handler: fn()) fn() {
      let subscription = scope.subscription()
      if subscription.active {
        subscription.remove_listener = keymap::on_change(runtime, fn() {
          if subscription.active {
            handler()
            invalidate()
          }
        })
      }
      fn() {
        subscription.cancel()
      }
    },
    shortcuts: fn() [keymap::Shortcut] {
      if scope.is_cancelled() {
        []
      } else {
        keymap::shortcuts(runtime)
      }
    },
    commands: fn() [keymap::Command] {
      if scope.is_cancelled() {
        []
      } else {
        keymap::commands(runtime)
      }
    },
    terminal_focus: fn() event::TerminalFocus? {
      if scope.is_cancelled() {
        Maybe::new<event::TerminalFocus>()
      } else {
        runtime.terminal_focus()
      }
    },
    theme: fn() theme::Theme {
      runtime.current_theme()
    },
    current_selection: fn() selection::Selection? {
      if scope.is_cancelled() {
        Maybe::new<selection::Selection>()
      } else {
        runtime.current_selection()
      }
    },
    internal_animate: fn(duration: Int, update: fn(animation::Frame), ease: animation::Easing) fn() {
      if scope.is_cancelled() {
        fn() {}
      } else {
        let timeline = runtime.timeline(duration)
        scope.own_animation(timeline)
        timeline.add(
          duration,
          fn(frame: animation::Frame) {
            if not scope.is_cancelled() {
              update(frame)
              invalidate()
            }
          },
          ease: ease,
          on_complete: fn() {
            timeline.destroy()
          },
        )
        let _ = timeline.play()
        fn() {
          timeline.destroy()
        }
      }
    },
  }
}
