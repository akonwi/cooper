use ard/unsafe

use cooper/cui/context
use cooper/event
use cooper/ui

// CUI components retain their state across matching view descriptions.
trait Component {
  fn mut render() View
}

trait Lifecycle {
  fn mut mounted(ctx: context::Context)

  fn mut unmounting(ctx: context::Context)
}

struct Instance {
  concrete: Any,
  component: mut Component,
  receive: fn(Any),
  mounted: Bool,
}

struct Specification {
  props: Any,
  matches: fn(Any, Any) Bool,
  create: fn() mut Instance,
}

enum Kind {
  box,
  scroll,
  text,
  input,
  text_area,
  select_input,
  tab_select,
  component,
}

// A ref does not own its control. It is cleared when the view is removed.
struct InputRef {
  current: (mut ui::Input)?,
}

fn input_ref() mut InputRef {
  (mut InputRef{current: Maybe::new<mut ui::Input>()})
}

struct TextAreaRef {
  current: (mut ui::TextArea)?,
}
fn text_area_ref() mut TextAreaRef {
  (mut TextAreaRef{current: Maybe::new<mut ui::TextArea>()})
}

// TabSelect is the same retained control with a different presentation.
struct SelectRef {
  current: (mut ui::Select)?,
}
fn select_ref() mut SelectRef {
  (mut SelectRef{current: Maybe::new<mut ui::Select>()})
}

struct BoxRef {
  current: (mut ui::Box)?,
}

fn box_ref() mut BoxRef {
  (mut BoxRef{current: Maybe::new<mut ui::Box>()})
}

struct ScrollBoxRef {
  current: (mut ui::ScrollBox)?,
}

fn scroll_box_ref() mut ScrollBoxRef {
  (mut ScrollBoxRef{current: Maybe::new<mut ui::ScrollBox>()})
}

struct View {
  internal: Any,
}

// Keep recursive descriptions behind an opaque value: generic callback
// substitution in Ard 0.42 cannot traverse a directly recursive View safely.
struct Description {
  kind: Kind,
  key: Str?,
  styles: ui::Style,
  children: [View],
  content: ui::TextContent,
  text_style: ui::TextStyle,
  wrap: ui::TextWrap,
  overflow: ui::TextOverflow,
  selectable: Bool,
  title: Str,
  value: Str,
  placeholder: Str,
  placeholder_style: ui::TextStyle,
  scrollbar_options: ui::ScrollbarOptions,
  options: [ui::SelectOption],
  select_config: ui::SelectConfig,
  tab_config: ui::SelectTabConfig,
  appearance: ui::SelectAppearance,
  selected_index: Int?,
  highlighted_index: Int?,
  on_highlight: fn(ui::SelectSelection, context::Context)?,
  on_change: fn(ui::SelectSelection, context::Context)?,
  on_select_submit: fn(ui::SelectSelection, context::Context)?,
  focused: Bool?,
  on_input: fn(Str, context::Context)?,
  on_submit: fn(Str, context::Context)?,
  on_key: fn(mut event::KeyEvent, context::Context)?,
  on_mouse: fn(mut event::MouseEvent, context::Context)?,
  input_ref: (mut InputRef)?,
  text_area_ref: (mut TextAreaRef)?,
  select_ref: (mut SelectRef)?,
  box_ref: (mut BoxRef)?,
  scroll_ref: (mut ScrollBoxRef)?,
  component: Specification?,
}

fn describe(value: View) Description {
  unsafe::cast<Description>(value.internal).expect("View must be created by a constructor")
}

private fn base(kind: Kind, key: Str?, styles: ui::Style?) Description {
  Description{
    kind: kind,
    key: key,
    styles: styles.or(ui::style()),
    children: [],
    content: "",
    text_style: ui::text_style(),
    wrap: ui::TextWrap::word,
    overflow: ui::TextOverflow::clip,
    selectable: true,
    title: "",
    value: "",
    placeholder: "",
    placeholder_style: ui::text_style(dim: true),
    scrollbar_options: ui::scrollbar_options(),
    options: [],
    select_config: ui::select_config(),
    tab_config: ui::select_tab_config(),
    appearance: ui::select_appearance(),
    selected_index: Maybe::new<Int>(),
    highlighted_index: Maybe::new<Int>(),
    on_highlight: Maybe::new<fn(ui::SelectSelection, context::Context)>(),
    on_change: Maybe::new<fn(ui::SelectSelection, context::Context)>(),
    on_select_submit: Maybe::new<fn(ui::SelectSelection, context::Context)>(),
    focused: Maybe::new<Bool>(),
    on_input: Maybe::new<fn(Str, context::Context)>(),
    on_submit: Maybe::new<fn(Str, context::Context)>(),
    on_key: Maybe::new<fn(mut event::KeyEvent, context::Context)>(),
    on_mouse: Maybe::new<fn(mut event::MouseEvent, context::Context)>(),
    input_ref: Maybe::new<mut InputRef>(),
    text_area_ref: Maybe::new<mut TextAreaRef>(),
    select_ref: Maybe::new<mut SelectRef>(),
    box_ref: Maybe::new<mut BoxRef>(),
    scroll_ref: Maybe::new<mut ScrollBoxRef>(),
    component: Maybe::new<Specification>(),
  }
}

fn text(
  content: ui::TextContent,
  key: Str?,
  styles: ui::Style?,
  text_style: ui::TextStyle?,
  wrap: ui::TextWrap?,
  overflow: ui::TextOverflow?,
  selectable: Bool?,
) View {
  let result = mut base(Kind::text, key, styles)
  result.content = content
  result.text_style = text_style.or(ui::text_style())
  result.wrap = wrap.or(ui::TextWrap::word)
  result.overflow = overflow.or(ui::TextOverflow::clip)
  result.selectable = selectable.or(true)
  View{internal: result.@}
}

fn box(
  children: [View],
  key: Str?,
  styles: ui::Style?,
  title: Str?,
  focused: Bool?,
  on_key: fn(mut event::KeyEvent, context::Context)?,
  on_mouse: fn(mut event::MouseEvent, context::Context)?,
  ref: (mut BoxRef)?,
) View {
  let result = mut base(Kind::box, key, styles)
  result.children = children
  result.title = title.or("")
  result.focused = focused
  result.on_key = on_key
  result.on_mouse = on_mouse
  result.box_ref = ref
  View{internal: result.@}
}

fn scroll_box(
  children: [View],
  key: Str?,
  styles: ui::Style?,
  scrollbar_options: ui::ScrollbarOptions?,
  on_key: fn(mut event::KeyEvent, context::Context)?,
  on_mouse: fn(mut event::MouseEvent, context::Context)?,
  ref: (mut ScrollBoxRef)?,
) View {
  let result = mut base(Kind::scroll, key, styles)
  result.children = children
  result.scrollbar_options = scrollbar_options.or(ui::scrollbar_options())
  result.on_key = on_key
  result.on_mouse = on_mouse
  result.scroll_ref = ref
  View{internal: result.@}
}

fn input(
  value: Str,
  key: Str?,
  styles: ui::Style?,
  placeholder: Str?,
  focused: Bool?,
  on_input: fn(Str, context::Context)?,
  on_submit: fn(Str, context::Context)?,
  on_key: fn(mut event::KeyEvent, context::Context)?,
  on_mouse: fn(mut event::MouseEvent, context::Context)?,
  ref: (mut InputRef)?,
) View {
  let result = mut base(Kind::input, key, styles)
  result.value = value
  result.placeholder = placeholder.or("")
  result.focused = focused
  result.on_input = on_input
  result.on_submit = on_submit
  result.on_key = on_key
  result.on_mouse = on_mouse
  result.input_ref = ref
  View{internal: result.@}
}

fn text_area(
  value: Str,
  key: Str?,
  styles: ui::Style?,
  placeholder: Str?,
  wrap: ui::TextWrap?,
  text_style: ui::TextStyle?,
  placeholder_style: ui::TextStyle?,
  selectable: Bool?,
  scrollbar_options: ui::ScrollbarOptions?,
  focused: Bool?,
  on_input: fn(Str, context::Context)?,
  on_key: fn(mut event::KeyEvent, context::Context)?,
  on_mouse: fn(mut event::MouseEvent, context::Context)?,
  ref: (mut TextAreaRef)?,
) View {
  let result = mut base(Kind::text_area, key, styles)
  result.value = value
  result.placeholder = placeholder.or("")
  result.wrap = wrap.or(ui::TextWrap::word)
  result.text_style = text_style.or(ui::text_style())
  result.placeholder_style = placeholder_style.or(ui::text_style(dim: true))
  result.selectable = selectable.or(true)
  result.scrollbar_options = scrollbar_options.or(ui::scrollbar_options())
  result.focused = focused
  result.on_input = on_input
  result.on_key = on_key
  result.on_mouse = on_mouse
  result.text_area_ref = ref
  View{internal: result.@}
}

fn select_input(
  options: [ui::SelectOption],
  selected_index: Int?,
  highlighted_index: Int?,
  config: ui::SelectConfig?,
  appearance: ui::SelectAppearance?,
  key: Str?,
  styles: ui::Style?,
  focused: Bool?,
  on_highlight: fn(ui::SelectSelection, context::Context)?,
  on_change: fn(ui::SelectSelection, context::Context)?,
  on_submit: fn(ui::SelectSelection, context::Context)?,
  on_key: fn(mut event::KeyEvent, context::Context)?,
  on_mouse: fn(mut event::MouseEvent, context::Context)?,
  ref: (mut SelectRef)?,
) View {
  let result = mut base(Kind::select_input, key, styles)
  result.options = options
  result.selected_index = selected_index
  result.highlighted_index = highlighted_index
  result.select_config = config.or(ui::select_config())
  result.appearance = appearance.or(ui::select_appearance())
  result.focused = focused
  result.on_highlight = on_highlight
  result.on_change = on_change
  result.on_select_submit = on_submit
  result.on_key = on_key
  result.on_mouse = on_mouse
  result.select_ref = ref
  View{internal: result.@}
}

fn tab_select(
  options: [ui::SelectOption],
  selected_index: Int?,
  highlighted_index: Int?,
  config: ui::SelectTabConfig?,
  appearance: ui::SelectAppearance?,
  key: Str?,
  styles: ui::Style?,
  focused: Bool?,
  on_highlight: fn(ui::SelectSelection, context::Context)?,
  on_change: fn(ui::SelectSelection, context::Context)?,
  on_submit: fn(ui::SelectSelection, context::Context)?,
  on_key: fn(mut event::KeyEvent, context::Context)?,
  on_mouse: fn(mut event::MouseEvent, context::Context)?,
  ref: (mut SelectRef)?,
) View {
  let result = mut describe(
    select_input(
      options,
      selected_index: selected_index,
      highlighted_index: highlighted_index,
      appearance: appearance,
      key: key,
      styles: styles,
      focused: focused,
      on_highlight: on_highlight,
      on_change: on_change,
      on_submit: on_submit,
      on_key: on_key,
      on_mouse: on_mouse,
      ref: ref,
    ),
  )
  result.kind = Kind::tab_select
  result.tab_config = config.or(ui::select_tab_config())
  View{internal: result.@}
}

fn child(specification: Specification, key: Str?) View {
  let result = mut base(Kind::component, key, Maybe::new(ui::style(display: ui::Display::contents)))
  result.component = Maybe::new(specification)
  View{internal: result.@}
}
