use cooper/core/node
use cooper/core/virtual_extent
use cooper/cui/context
use cooper/cui/view
use cooper/event
use cooper/ui

enum Alignment {
  start,
  center,
  end,
  nearest,
}
enum Edge {
  start,
  end,
}
enum Direction {
  toward_start,
  toward_end,
}
struct Range {
  start: Int,
  end: Int,
}
struct State {
  following_edge: Edge?,
  first_item_visible: Bool,
  last_item_visible: Bool,
  visible_range: Range,
  scroll_top: Int,
  maximum_scroll_top: Int,
  total_height: Int,
  viewport_height: Int,
}
struct Update {
  state: State,
  initial: Bool,
  user_scroll: Direction?,
  moved: Bool,
}
struct Ref {
  current: (mut VirtualList)?,
}
fn ref() mut Ref {
  (mut Ref{current: Maybe::new<mut VirtualList>()})
}

// One source object per application render, not per scroll/layout pass.
struct Source {
  keys: [Str],
  build: fn(Int) view::View,
  estimate: Int,
  overscan: Int,
  row_height: Int?,
  scrollbar_options: ui::ScrollbarOptions,
  styles: ui::Style,
  ref: (mut Ref)?,
  on_key: fn(mut event::KeyEvent, context::Context)?,
  on_mouse: fn(mut event::MouseEvent, context::Context)?,
  sticky_scroll: Edge?,
  on_update: fn(Update, context::Context)?,
}
struct Props {
  source: mut Source,
}
struct Row {
  key: Str,
  ref: mut view::BoxRef,
}

struct VirtualList {
  props: mut Props,
  source: mut Source,
  index: mut virtual_extent::Index,
  scroll: mut view::ScrollBoxRef,
  rows: [Row],
  width: Int,
  height: Int,
  sample_height: Int,
  top: Int,
  anchor: Str?,
  delta: Int,
  restore: Bool,
  pending: Str?,
  alignment: Alignment,
  enabled_edge: Edge?,
  following_edge: Edge?,
  settling_edge: Edge?,
  refresh: Bool,
  active: Bool,
  bound_ref: (mut Ref)?,
  pending_state: State?,
  delivered_state: State?,
  pending_user_scroll: Direction?,
  pending_user_start: Int?,
}

fn new(props: mut Props) mut VirtualList {
  let source = props.source
  (mut VirtualList{
    props: props,
    source: source,
    index: virtual_extent::new(source.keys, source.row_height.or(source.estimate)),
    scroll: view::scroll_box_ref(),
    rows: [],
    width: 0,
    height: 1,
    sample_height: source.row_height.or(source.estimate),
    top: 0,
    anchor: source.keys.at(0),
    delta: 0,
    restore: false,
    pending: Maybe::new<Str>(),
    alignment: Alignment::nearest,
    enabled_edge: source.sticky_scroll,
    following_edge: source.sticky_scroll,
    settling_edge: Maybe::new<Edge>(),
    refresh: false,
    active: false,
    bound_ref: Maybe::new<mut Ref>(),
    pending_state: Maybe::new<State>(),
    delivered_state: Maybe::new<State>(),
    pending_user_scroll: Maybe::new<Direction>(),
    pending_user_start: Maybe::new<Int>(),
  })
}

private fn focused(target: mut node::Node) Bool {
  mut found = target.is_focused()
  for child in target.children {
    if focused(child) {
      found = true
    }
  }
  found
}
private fn nonnegative(value: Int) Int {
  if value < 0 {
    0
  } else {
    value
  }
}

private fn same_edge(left: Edge?, right: Edge?) Bool {
  match left {
    left_edge => {
      match right {
        right_edge => left_edge == right_edge,
        _ => false,
      }
    },
    _ => right.is_none(),
  }
}

private fn same_state(left: State, right: State) Bool {
  same_edge(left.following_edge, right.following_edge) and left.first_item_visible == right.first_item_visible and left.last_item_visible == right.last_item_visible and left.visible_range.start == right.visible_range.start and left.visible_range.end == right.visible_range.end and left.scroll_top == right.scroll_top and left.maximum_scroll_top == right.maximum_scroll_top and left.total_height == right.total_height and left.viewport_height == right.viewport_height
}

impl VirtualList {
  fn scroll_top() Int {
    self.top
  }

  fn total_height() Int {
    self.index.total()
  }

  fn is_following_edge() Bool {
    self.following_edge.is_some()
  }

  fn first_item_visible() Bool {
    self.index.count() > 0 and self.index.prefix(1) > self.top and self.height > 0
  }

  fn last_item_visible() Bool {
    let count = self.index.count()
    count > 0 and self.index.prefix(count - 1) < self.top + self.height and self.index.total() > self.top
  }

  private fn edge_enabled(edge: Edge) Bool {
    match self.enabled_edge {
      enabled => enabled == edge,
      _ => false,
    }
  }

  private fn edge_following(edge: Edge) Bool {
    match self.following_edge {
      followed => followed == edge,
      _ => false,
    }
  }

  private fn edge_settling(edge: Edge) Bool {
    match self.settling_edge {
      settling => settling == edge,
      _ => false,
    }
  }

  fn mounted_count() Int {
    self.rows.size()
  }

  fn mut focus() Bool {
    self.scroll.current.map(fn(scroll) Bool {
      scroll.focus()
    }).or(false)
  }

  fn visible_range() Range {
    let first = self.index.index_at(self.top)
    mut end = first
    if self.height > 0 and first < self.index.count() {
      end = self.index.index_at(self.top + self.height - 1)
      if end < self.index.count() {
        end =+ 1
      }
    }
    Range{start: first, end: end}
  }

  private fn state(maximum_scroll_top: Int) State {
    State{
      following_edge: self.following_edge,
      first_item_visible: self.first_item_visible(),
      last_item_visible: self.last_item_visible(),
      visible_range: self.visible_range(),
      scroll_top: self.top,
      maximum_scroll_top: maximum_scroll_top,
      total_height: self.index.total(),
      viewport_height: self.height,
    }
  }

  private fn mut record_user_scroll(direction: Direction, start: Int) {
    if self.pending_user_start.is_none() {
      self.pending_user_start = Maybe::new(start)
    }
    self.pending_user_scroll = Maybe::new(direction)
  }

  private fn mut publish(ctx: context::Context) {
    let user_scroll = self.pending_user_scroll
    let user_start = self.pending_user_start
    self.pending_user_scroll = Maybe::new<Direction>()
    self.pending_user_start = Maybe::new<Int>()
    match self.pending_state {
      state => {
        let initial = self.delivered_state.is_none()
        let changed = match self.delivered_state {
          previous => not same_state(previous, state),
          _ => true,
        }
        if changed or user_scroll.is_some() {
          match self.source.on_update {
            handler => {
              self.delivered_state = Maybe::new(state)
              self.pending_state = Maybe::new<State>()
              handler(
                Update{
                  state: state,
                  initial: initial,
                  user_scroll: user_scroll,
                  moved: user_scroll.is_some() and state.scroll_top != user_start.or(state.scroll_top),
                },
                ctx,
              )
              (ctx.invalidate_root)()
            },
            _ => (),
          }
        } else {
          self.pending_state = Maybe::new<State>()
        }
      },
      _ => (),
    }
  }

  private fn mut cancel_pending_position() {
    self.settling_edge = Maybe::new<Edge>()
    self.pending = Maybe::new<Str>()
    self.restore = false
    let _ = self.scroll.current.map(fn(scroll) {
      self.top = scroll.scroll_top()
    })
    self.capture_anchor(self.top)
  }

  // Bool means the key exists and the request was accepted. Unmeasured targets
  // settle to their measured alignment before the next frame is painted.
  fn mut scroll_to_key(key: Str, alignment: Alignment?) Bool {
    if self.active and self.index.position(key).is_some() {
      self.cancel_pending_position()
      self.pending = Maybe::new(key)
      self.alignment = alignment.or(Alignment::start)
      let _ = self.scroll.current.map(fn(scroll) {
        scroll.node_ref.request_redraw()
      })
      true
    } else {
      false
    }
  }

  fn mut reveal(key: Str) Bool {
    self.scroll_to_key(key, Alignment::nearest)
  }

  // Jump to a logical edge. Sticky behavior defaults to true so later changes
  // remain pinned there; pass false for a one-shot jump.
  fn mut scroll_to_edge(edge: Edge, sticky: Bool?) Bool {
    if not self.active {
      false
    } else {
      if sticky.or(true) {
        if not self.edge_enabled(edge) {
          self.enabled_edge = Maybe::new(edge)
          self.refresh = true
        }
        self.following_edge = Maybe::new(edge)
      } else {
        self.following_edge = Maybe::new<Edge>()
      }
      self.settling_edge = Maybe::new(edge)
      self.pending = Maybe::new<Str>()
      self.top = match edge {
        Edge::start => 0,
        Edge::end => self.clamp_top(self.index.total() - self.height),
      }
      self.capture_anchor(self.top)
      self.restore = true
      let _ = self.scroll.current.map(fn(scroll) {
        scroll.node_ref.request_redraw()
      })
      true
    }
  }

  fn mut stop_following() {
    if self.active {
      self.cancel_pending_position()
      self.following_edge = Maybe::new<Edge>()
    }
  }

  fn mut scroll_by(cells: Int) Bool {
    self.cancel_pending_position()
    if self.edge_following(Edge::start) and cells > 0 or self.edge_following(Edge::end) and cells < 0 {
      self.stop_following()
    }
    self.scroll.current.map(fn(scroll) Bool {
      let moved = scroll.scroll_by(cells)
      if self.edge_enabled(Edge::start) and cells < 0 and scroll.scroll_top() == 0 {
        self.following_edge = Maybe::new(Edge::start)
      } else if self.edge_enabled(Edge::end) and cells > 0 and scroll.scroll_top() == scroll.maximum_scroll_top() {
        self.following_edge = Maybe::new(Edge::end)
      }
      moved
    }).or(false)
  }

  private fn mut note_vertical_intent(delta: Int) {
    self.cancel_pending_position()
    self.record_user_scroll(
      match delta < 0 {
        true => Direction::toward_start,
        false => Direction::toward_end,
      },
      self.top,
    )
    if self.edge_following(Edge::start) and delta > 0 or self.edge_following(Edge::end) and delta < 0 {
      self.stop_following()
    } else {
      let _ = self.scroll.current.map(fn(scroll) {
        if self.edge_enabled(Edge::start) and delta < 0 and scroll.scroll_top() == 0 {
          self.following_edge = Maybe::new(Edge::start)
        } else if self.edge_enabled(Edge::end) and delta > 0 and scroll.scroll_top() == scroll.maximum_scroll_top() {
          self.following_edge = Maybe::new(Edge::end)
        }
        ()
      })
    }
  }

  private fn mut handle_key(key: mut event::KeyEvent, ctx: context::Context) {
    let vertical = key.event_type != event::KeyEventType::release and (not key.modifiers.shift) and (not key.modifiers.ctrl) and (not key.modifiers.alt) and (not key.modifiers.super)
    if vertical {
      if key.name == "up" or key.name == "page_up" or key.name == "home" {
        self.note_vertical_intent(-1)
      } else if key.name == "down" or key.name == "page_down" or key.name == "end" {
        self.note_vertical_intent(1)
      }
    }
    match self.source.on_key {
      handler => handler(key, ctx),
      _ => (),
    }
  }

  private fn mut handle_mouse(mouse: mut event::MouseEvent, ctx: context::Context) {
    if mouse.event_type == event::MouseEventType::down or mouse.event_type == event::MouseEventType::drag {
      self.cancel_pending_position()
    } else if mouse.event_type == event::MouseEventType::scroll {
      if (not mouse.modifiers.shift) and mouse.scroll_y != 0 {
        self.note_vertical_intent(mouse.scroll_y)
      } else {
        self.cancel_pending_position()
      }
    }
    match self.source.on_mouse {
      handler => handler(mouse, ctx),
      _ => (),
    }
  }

  fn mut invalidate_item(key: Str) Bool {
    mut position = Maybe::new<Int>()
    if self.active {
      position = self.index.position(key)
    }
    match position {
      index => {
        self.capture_anchor(self.top)
        let _ = self.index.set_height(index, self.source.row_height.or(self.source.estimate))
        self.restore = true
        let _ = self.scroll.current.map(fn(scroll) {
          scroll.node_ref.request_redraw()
        })
        true
      },
      _ => false,
    }
  }

  private fn mut capture_anchor(top: Int) {
    let position = self.index.index_at(top)
    if position < self.index.count() {
      self.anchor = Maybe::new(self.index.key(position))
      self.delta = top - self.index.prefix(position)
    } else {
      self.anchor = Maybe::new<Str>()
      self.delta = 0
    }
  }

  private fn anchor_top() Int {
    match self.anchor {
      key => {
        match self.index.position(key) {
          index => {
            let start = self.index.prefix(index)
            let height = self.index.prefix(index + 1) - start
            mut delta = self.delta
            if delta >= height {
              delta = height - 1
            }
            start + nonnegative(delta)
          },
          _ => self.top,
        }
      },
      _ => self.top,
    }
  }

  private fn clamp_top(top: Int) Int {
    let maximum = nonnegative(self.index.total() - self.height)
    if top > maximum {
      maximum
    } else {
      nonnegative(top)
    }
  }

  private fn indices() [Int] {
    let indices = mut List::new<Int>()
    let selected = mut Map::new<Bool>()
    mut first = self.index.index_at(nonnegative(self.top - self.source.overscan))
    mut edge = self.top + self.height + self.source.overscan
    if (self.edge_following(Edge::end) or self.edge_settling(Edge::end)) and self.index.count() > 0 {
      first = self.index.count()
      mut remaining = self.height + self.source.overscan
      while first > 0 and remaining > 0 {
        first =- 1
        remaining =- self.index.measured.get(self.index.key(first)).or(self.sample_height)
      }
      edge = self.index.total()
    }
    mut cursor = self.index.prefix(first)
    // Use observed heights to size the next materialization batch. A wildly
    // high initial estimate must not require one layout pass per new row.
    while first < self.index.count() and cursor < edge {
      indices.push(first)
      selected.set(self.index.key(first), true)
      cursor =+ self.index.measured.get(self.index.key(first)).or(self.sample_height)
      first =+ 1
    }
    // Focus is the only automatic keep-alive exception. A far-away focused row
    // is retained separately; intervening rows are not materialized.
    for row in self.rows {
      if not selected.get(row.key).or(false) {
        match row.ref.current {
          control => {
            if focused(control.node_ref) {
              let _ = self.index.position(
                row.key,
              ).map(fn(index: Int) {
                indices.push(index)
              })
            }
          },
          _ => (),
        }
      }
    }
    indices.@
  }

  private fn mut bind_ref() {
    match self.bound_ref {
      ref => { ref.current = Maybe::new<mut VirtualList>() },
      _ => (),
    }
    self.bound_ref = self.source.ref
    match self.bound_ref {
      ref => {
        match ref.current {
          other => {
            if other != self {
              panic("VirtualListRef is already mounted")
            }
          },
          _ => (),
        }
        ref.current = Maybe::new(self)
      },
      _ => (),
    }
  }

  private fn mut sync_source() {
    if self.source != self.props.source {
      // An event may scroll and rerender the owner before the next layout pass.
      // Preserve that new position rather than restoring the previous frame.
      if not self.restore {
        let _ = self.scroll.current.map(fn(scroll) {
          self.top = scroll.scroll_top()
        })
      }
      self.capture_anchor(self.top)
      let old_keys = self.source.keys
      let old_position = self.index.index_at(self.top)
      let old_height = self.source.row_height
      let old_sticky_scroll = self.source.sticky_scroll
      self.source = self.props.source
      if old_sticky_scroll != self.source.sticky_scroll {
        self.cancel_pending_position()
        self.enabled_edge = self.source.sticky_scroll
        self.following_edge = self.source.sticky_scroll
      }
      self.index.replace(self.source.keys, self.source.row_height.or(self.source.estimate))
      if old_height != self.source.row_height {
        self.index.reset(self.source.row_height.or(self.source.estimate))
      }
      match self.anchor {
        key => {
          if self.index.position(key).is_none() {
            self.anchor = Maybe::new<Str>()
            mut index = old_position + 1
            while index < old_keys.size() and self.anchor.is_none() {
              let candidate = old_keys.at(index).expect("old successor")
              if self.index.position(candidate).is_some() {
                self.anchor = Maybe::new(candidate)
              }
              index =+ 1
            }
            index = old_position - 1
            while index >= 0 and self.anchor.is_none() {
              let candidate = old_keys.at(index).expect("old predecessor")
              if self.index.position(candidate).is_some() {
                self.anchor = Maybe::new(candidate)
              }
              index =- 1
            }
            self.delta = 0
          }
        },
        _ => (),
      }
      self.top = self.clamp_top(self.anchor_top())
      self.restore = true
      if self.active {
        self.bind_ref()
      }
    }
  }

  private fn mut settle() Bool {
    match self.scroll.current {
      scroll => {
        let viewport = scroll.viewport_geometry().screen
        if viewport.width <= 0 or viewport.height <= 0 {
          false
        } else {
          mut changed = self.refresh
          self.refresh = false
          let resized = self.width != viewport.width
          let height_changed = self.height != viewport.height
          self.height = viewport.height
          if not self.restore and not resized and not height_changed {
            let observed = scroll.scroll_top()
            if self.top != observed {
              changed = true
              self.top = observed
              self.following_edge = Maybe::new<Edge>()
              match self.enabled_edge {
                edge => {
                  match edge {
                    Edge::start => {
                      if self.top == 0 {
                        self.following_edge = Maybe::new(Edge::start)
                      }
                    },
                    Edge::end => {
                      if self.top == self.clamp_top(self.index.total() - self.height) {
                        self.following_edge = Maybe::new(Edge::end)
                      }
                    },
                  }
                },
                _ => (),
              }
            }
            self.capture_anchor(self.top)
          }
          if resized {
            self.width = viewport.width
            self.index.reset(self.source.row_height.or(self.source.estimate))
            changed = true
          }
          if height_changed {
            changed = true
          }
          mut measured = 0
          mut measured_count = 0
          for row in self.rows {
            match row.ref.current {
              control => {
                match self.index.position(row.key) {
                  index => {
                    let height = control.layout().local.height
                    if height > 0 {
                      measured =+ height
                      measured_count =+ 1
                    }
                    if height > 0 and self.index.set_height(index, self.source.row_height.or(height)) {
                      changed = true
                    }
                  },
                  _ => (),
                }
              },
              _ => (),
            }
          }
          if measured_count > 0 {
            self.sample_height = self.source.row_height.or(measured / measured_count)
          }
          mut desired = self.anchor_top()
          match self.pending {
            key => {
              match self.index.position(key) {
                index => {
                  let start = self.index.prefix(index)
                  let end = self.index.prefix(index + 1)
                  desired = match self.alignment {
                    Alignment::start => start,
                    Alignment::center => {
                      let row_height = end - start
                      let remaining = self.height - row_height
                      let inset = remaining / 2
                      start - inset
                    },
                    Alignment::end => end - self.height,
                    Alignment::nearest => {
                      if start < self.top {
                        start
                      } else if end > self.top + self.height {
                        if end - start > self.height {
                          start
                        } else {
                          end - self.height
                        }
                      } else {
                        self.top
                      }
                    },
                  }
                },
                _ => { self.pending = Maybe::new<Str>() },
              }
            },
            _ => (),
          }
          match self.following_edge {
            edge => {
              match edge {
                Edge::start => { desired = 0 },
                Edge::end => { desired = self.index.total() - self.height },
              }
            },
            _ => (),
          }
          match self.settling_edge {
            edge => {
              match edge {
                Edge::start => { desired = 0 },
                Edge::end => { desired = self.index.total() - self.height },
              }
            },
            _ => (),
          }
          desired = self.clamp_top(desired)
          if desired != self.top {
            changed = true
          }
          self.top = desired
          if changed {
            self.restore = true
          } else if self.restore or self.pending.is_some() {
            changed = scroll.scroll_to(self.top)
            self.restore = false
          }
          let indices = self.indices()
          if indices.size() != self.rows.size() {
            changed = true
          }
          for index, slot in indices {
            match self.rows.at(slot) {
              row => {
                if row.key != self.index.key(index) {
                  changed = true
                }
              },
              _ => { changed = true },
            }
          }
          if not changed {
            self.settling_edge = Maybe::new<Edge>()
            self.pending = Maybe::new<Str>()
            self.capture_anchor(self.top)
            self.pending_state = Maybe::new(self.state(scroll.maximum_scroll_top()))
          }
          changed
        }
      },
      _ => false,
    }
  }
}

impl view::Component for VirtualList {
  fn mut render() view::View {
    self.sync_source()
    let inset = match self.edge_enabled(Edge::end) {
      true => nonnegative(self.height - self.index.total()),
      false => 0,
    }
    let rows = mut List::new<Row>()
    let children = mut List::new<view::View>()
    for index in self.indices() {
      let key = self.index.key(index)
      mut ref = view::box_ref()
      for old in self.rows {
        if old.key == key {
          ref = old.ref
        }
      }
      children.push(
        view::box(
          [(self.source.build)(index)],
          key: key,
          ref: ref,
          styles: ui::style(
            position: ui::Position::absolute,
            top: ui::cells(inset + self.index.prefix(index)),
            left: ui::cells(0),
            width: ui::percent(100.0),
            min_height: ui::cells(1),
            overflow: ui::Overflow::hidden,
            height: self.source.row_height.map(fn(height: Int) ui::Length {
              ui::cells(height)
            }),
          ),
        ),
      )
      rows.push(Row{key: key, ref: ref})
    }
    self.rows = rows.@
    view::scroll_box(
      [
        view::box(
          children.@,
          styles: ui::style(
            height: ui::cells(inset + self.index.total()),
            width: ui::percent(100.0),
            flex_shrink: 0.0,
          ),
        ),
      ],
      styles: self.source.styles,
      scrollbar_options: self.source.scrollbar_options,
      ref: self.scroll,
      on_key: fn(key: mut event::KeyEvent, ctx: context::Context) {
        self.handle_key(key, ctx)
      },
      on_mouse: fn(mouse: mut event::MouseEvent, ctx: context::Context) {
        self.handle_mouse(mouse, ctx)
      },
    )
  }
}
impl view::Lifecycle for VirtualList {
  fn mut mounted(ctx: context::Context) {
    self.active = true
    self.bind_ref()
    let _ = self.scroll.current.map(fn(scroll) {
      scroll.internal_on_vertical_scrollbar_change(fn(position: Int) {
        let start = self.top
        self.cancel_pending_position()
        if position < start {
          self.record_user_scroll(Direction::toward_start, start)
          if self.edge_following(Edge::end) {
            self.following_edge = Maybe::new<Edge>()
          }
        } else if position > start {
          self.record_user_scroll(Direction::toward_end, start)
          if self.edge_following(Edge::start) {
            self.following_edge = Maybe::new<Edge>()
          }
        }
        if self.edge_enabled(Edge::start) and position == 0 {
          self.following_edge = Maybe::new(Edge::start)
        } else if self.edge_enabled(Edge::end) and position == scroll.maximum_scroll_top() {
          self.following_edge = Maybe::new(Edge::end)
        }
      })
    })
    let _ = ctx.internal_layout(fn() Bool {
      self.settle()
    })
    let _ = ctx.internal_commit(fn() {
      if self.active {
        self.publish(ctx)
      }
    })
  }

  fn mut unmounting(ctx: context::Context) {
    self.active = false
    let _ = self.bound_ref.map(fn(ref) {
      ref.current = Maybe::new<mut VirtualList>()
    })
    self.bound_ref = Maybe::new<mut Ref>()
  }
}
