use ard/unsafe

private struct PropagationState {
  propagation_stopped: Bool,
  default_prevented: Bool,
  deferred_defaults: [fn()],
  timestamp_ms: Int64,
  press_serial: Int,
  click_epoch: Int,
}

private fn new_propagation_state() mut PropagationState {
  (mut PropagationState{
    propagation_stopped: false,
    default_prevented: false,
    deferred_defaults: [],
    timestamp_ms: 0,
    press_serial: 0,
    click_epoch: 0,
  })
}

private fn propagation_state(value: Any) mut PropagationState {
  unsafe::cast<mut PropagationState>(value).expect("event state must be created by Cooper")
}

enum DispatchError {
  stopped,
}

enum TerminalFocus {
  gained,
  lost,
}

enum KeyEventType {
  press,
  repeat,
  release,
}

struct Modifiers {
  shift: Bool,
  ctrl: Bool,
  alt: Bool,
  super: Bool,
}

struct KeyEvent {
  name: Str,
  text: Str,
  event_type: KeyEventType,
  modifiers: Modifiers,
  internal_state: Any,
}

fn key(
  name: Str,
  text: Str,
  event_type: KeyEventType,
  modifiers: Modifiers,
) mut KeyEvent {
  (mut KeyEvent{
    name: name,
    text: text,
    event_type: event_type,
    modifiers: modifiers,
    internal_state: new_propagation_state(),
  })
}

impl KeyEvent {
  fn mut stop_propagation() {
    propagation_state(self.internal_state).propagation_stopped = true
  }

  fn mut prevent_default() {
    propagation_state(self.internal_state).default_prevented = true
  }

  fn is_propagation_stopped() Bool {
    propagation_state(self.internal_state).propagation_stopped
  }

  fn is_default_prevented() Bool {
    propagation_state(self.internal_state).default_prevented
  }

  fn matches(
    name: Str,
    shift: Bool?,
    ctrl: Bool?,
    alt: Bool?,
    super: Bool?,
  ) Bool {
    self.name == name and self.modifiers.shift == shift.or(false) and self.modifiers.ctrl == ctrl.or(false) and self.modifiers.alt == alt.or(false) and self.modifiers.super == super.or(false)
  }
}

struct PasteEvent {
  text: Str,
  internal_state: Any,
}

fn paste(text: Str) mut PasteEvent {
  (mut PasteEvent{text: text, internal_state: new_propagation_state()})
}

impl PasteEvent {
  fn mut stop_propagation() {
    propagation_state(self.internal_state).propagation_stopped = true
  }

  fn mut prevent_default() {
    propagation_state(self.internal_state).default_prevented = true
  }

  fn is_propagation_stopped() Bool {
    propagation_state(self.internal_state).propagation_stopped
  }

  fn is_default_prevented() Bool {
    propagation_state(self.internal_state).default_prevented
  }
}

enum MouseEventType {
  down,
  up,
  move,
  drag,
  drag_end,
  drop,
  over,
  out,
  scroll,
}

enum MouseButton {
  none,
  left,
  middle,
  right,
}

struct MouseEvent {
  event_type: MouseEventType,
  button: MouseButton,
  x: Int,
  y: Int,
  local_x: Int,
  local_y: Int,
  modifiers: Modifiers,
  scroll_x: Int,
  scroll_y: Int,
  is_dragging: Bool,
  internal_state: Any,
}

fn mouse(
  event_type: MouseEventType,
  button: MouseButton,
  x: Int,
  y: Int,
  modifiers: Modifiers,
  scroll_x: Int?,
  scroll_y: Int?,
  is_dragging: Bool?,
) mut MouseEvent {
  (mut MouseEvent{
    event_type: event_type,
    button: button,
    x: x,
    y: y,
    local_x: x,
    local_y: y,
    modifiers: modifiers,
    scroll_x: scroll_x.or(0),
    scroll_y: scroll_y.or(0),
    is_dragging: is_dragging.or(false),
    internal_state: new_propagation_state(),
  })
}

fn internal_defer_default(received: mut MouseEvent, action: fn()) {
  propagation_state(received.internal_state).deferred_defaults.push(action)
}

fn internal_run_deferred_defaults(received: mut MouseEvent) {
  let state = propagation_state(received.internal_state)
  let actions = state.deferred_defaults
  state.deferred_defaults = []
  if not state.default_prevented {
    for action in actions {
      action()
    }
  }
}

fn internal_discard_deferred_defaults(received: mut MouseEvent) {
  propagation_state(received.internal_state).deferred_defaults = []
}

fn internal_set_timestamp(received: mut MouseEvent, timestamp_ms: Int64) {
  propagation_state(received.internal_state).timestamp_ms = timestamp_ms
}

fn internal_timestamp(received: mut MouseEvent) Int64 {
  propagation_state(received.internal_state).timestamp_ms
}

fn internal_set_press_serial(received: mut MouseEvent, serial: Int) {
  propagation_state(received.internal_state).press_serial = serial
}

fn internal_press_serial(received: mut MouseEvent) Int {
  propagation_state(received.internal_state).press_serial
}

fn internal_set_click_epoch(received: mut MouseEvent, epoch: Int) {
  propagation_state(received.internal_state).click_epoch = epoch
}

fn internal_click_epoch(received: mut MouseEvent) Int {
  propagation_state(received.internal_state).click_epoch
}

impl MouseEvent {
  fn mut stop_propagation() {
    propagation_state(self.internal_state).propagation_stopped = true
  }

  fn mut prevent_default() {
    propagation_state(self.internal_state).default_prevented = true
  }

  fn is_propagation_stopped() Bool {
    propagation_state(self.internal_state).propagation_stopped
  }

  fn is_default_prevented() Bool {
    propagation_state(self.internal_state).default_prevented
  }
}
