use cooper/surface

enum EventResult {
  ignored,
  handled,
}

struct EventContext {
  redraw: Bool,
  quit: Bool,
  route: [Int]?,
  route_depth: Int,
  target_size: surface::Size?,
  width_measurer: (fn(Str) Int)?,
}

private fn copy_route(route: [Int]?) [Int]? {
  match route {
    path => {
      let copied = mut List::new<Int>()
      for part in path {
        copied.push(part)
      }
      Maybe::new<[Int]>(copied.@)
    },
    _ => Maybe::new<[Int]>(),
  }
}

fn new_context(route: [Int]?, target_size: surface::Size?, width_measurer: (fn(Str) Int)?) EventContext {
  EventContext{
    redraw: false,
    quit: false,
    route: copy_route(route),
    route_depth: 0,
    target_size: target_size,
    width_measurer: width_measurer,
  }
}

impl EventContext {
  fn mut request_redraw() {
    self.redraw = true
  }

  fn mut request_quit() {
    self.quit = true
  }

  fn redraw_requested() Bool {
    self.redraw
  }

  fn quit_requested() Bool {
    self.quit
  }

  fn mut retarget(route: [Int], target_size: surface::Size) {
    self.route = copy_route(route)
    self.route_depth = 0
    self.target_size = target_size
  }

  fn next_route_index() Int? {
    match self.route {
      path => path.at(self.route_depth),
      _ => Maybe::new<Int>(),
    }
  }

  fn mut enter_child() {
    self.route_depth =+ 1
  }

  fn mut leave_child() {
    if self.route_depth > 0 {
      self.route_depth =- 1
    }
  }
}
