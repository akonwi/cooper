use go:go.rockorager.dev/vaxis

enum EventResult {
  ignored,
  handled,
}

enum EventPhase {
  idle,
  capture,
  target,
  bubble,
}

enum DispatchError {
  stopped,
}

private fn stopped_dispatch(action: fn()) Void!DispatchError {
  Result::err(DispatchError::stopped)
}

private fn reject_focus() Bool {
  false
}

struct State {
  propagation_stopped: Bool,
  handled: Bool,
  redraw: Bool,
  quit: Bool,
  preserve_focus_scroll: Bool,
}

fn new_state() mut State {
  (mut State{
    propagation_stopped: false,
    handled: false,
    redraw: false,
    quit: false,
    preserve_focus_scroll: false,
  })
}

struct Context {
  phase: EventPhase,
  terminal_event: vaxis::Event,
  local_x: Int?,
  local_y: Int?,
  focused: Bool,
  state: mut State,
  focus_request: fn() Bool,
  dispatch: fn(fn()) Void!DispatchError,
}

fn context(
  phase: EventPhase,
  terminal_event: vaxis::Event,
  local_x: Int?,
  local_y: Int?,
  focused: Bool,
  state: mut State,
  focus_request: (fn() Bool)?,
  dispatch: (fn(fn()) Void!DispatchError)?,
) mut Context {
  (mut Context{
    phase: phase,
    terminal_event: terminal_event,
    local_x: local_x,
    local_y: local_y,
    focused: focused,
    state: state,
    focus_request: focus_request.or(reject_focus),
    dispatch: dispatch.or(stopped_dispatch),
  })
}

impl Context {
  fn stop_propagation() {
    self.state.propagation_stopped = true
  }

  fn request_redraw() {
    self.state.redraw = true
  }

  fn request_quit() {
    self.state.quit = true
  }

  fn request_focus() Bool {
    self.focus_request()
  }

  fn was_handled() Bool {
    self.state.handled
  }

  fn preserve_focus_scroll() {
    self.state.preserve_focus_scroll = true
  }

  fn mark_handled() {
    self.state.handled = true
  }
}
