use ard/unsafe

private struct PropagationState {
  propagation_stopped: Bool,
  default_prevented: Bool,
}

private fn new_propagation_state() mut PropagationState {
  (mut PropagationState{propagation_stopped: false, default_prevented: false})
}

private fn propagation_state(value: Any) mut PropagationState {
  unsafe::cast<mut PropagationState>(value).expect("event state must be created by Cooper")
}

enum DispatchError {
  stopped,
}

enum TerminalFocus {
  gained,
  lost,
}

enum KeyEventType {
  press,
  repeat,
  release,
}

struct Modifiers {
  shift: Bool,
  ctrl: Bool,
  alt: Bool,
  super: Bool,
}

struct KeyEvent {
  name: Str,
  text: Str,
  event_type: KeyEventType,
  modifiers: Modifiers,
  internal_state: Any,
}

fn key(
  name: Str,
  text: Str,
  event_type: KeyEventType,
  modifiers: Modifiers,
) mut KeyEvent {
  (mut KeyEvent{
    name: name,
    text: text,
    event_type: event_type,
    modifiers: modifiers,
    internal_state: new_propagation_state(),
  })
}

impl KeyEvent {
  fn mut stop_propagation() {
    propagation_state(self.internal_state).propagation_stopped = true
  }

  fn mut prevent_default() {
    propagation_state(self.internal_state).default_prevented = true
  }

  fn is_propagation_stopped() Bool {
    propagation_state(self.internal_state).propagation_stopped
  }

  fn is_default_prevented() Bool {
    propagation_state(self.internal_state).default_prevented
  }

  fn matches(
    name: Str,
    shift: Bool?,
    ctrl: Bool?,
    alt: Bool?,
    super: Bool?,
  ) Bool {
    self.name == name and self.modifiers.shift == shift.or(false) and self.modifiers.ctrl == ctrl.or(false) and self.modifiers.alt == alt.or(false) and self.modifiers.super == super.or(false)
  }
}

struct PasteEvent {
  text: Str,
  internal_state: Any,
}

fn paste(text: Str) mut PasteEvent {
  (mut PasteEvent{text: text, internal_state: new_propagation_state()})
}

impl PasteEvent {
  fn mut stop_propagation() {
    propagation_state(self.internal_state).propagation_stopped = true
  }

  fn mut prevent_default() {
    propagation_state(self.internal_state).default_prevented = true
  }

  fn is_propagation_stopped() Bool {
    propagation_state(self.internal_state).propagation_stopped
  }

  fn is_default_prevented() Bool {
    propagation_state(self.internal_state).default_prevented
  }
}

enum MouseEventType {
  down,
  up,
  move,
  drag,
  drag_end,
  drop,
  over,
  out,
  scroll,
}

enum MouseButton {
  none,
  left,
  middle,
  right,
}

struct MouseEvent {
  event_type: MouseEventType,
  button: MouseButton,
  x: Int,
  y: Int,
  local_x: Int,
  local_y: Int,
  modifiers: Modifiers,
  scroll_x: Int,
  scroll_y: Int,
  is_dragging: Bool,
  internal_state: Any,
}

fn mouse(
  event_type: MouseEventType,
  button: MouseButton,
  x: Int,
  y: Int,
  modifiers: Modifiers,
  scroll_x: Int?,
  scroll_y: Int?,
  is_dragging: Bool?,
) mut MouseEvent {
  (mut MouseEvent{
    event_type: event_type,
    button: button,
    x: x,
    y: y,
    local_x: x,
    local_y: y,
    modifiers: modifiers,
    scroll_x: scroll_x.or(0),
    scroll_y: scroll_y.or(0),
    is_dragging: is_dragging.or(false),
    internal_state: new_propagation_state(),
  })
}

impl MouseEvent {
  fn mut stop_propagation() {
    propagation_state(self.internal_state).propagation_stopped = true
  }

  fn mut prevent_default() {
    propagation_state(self.internal_state).default_prevented = true
  }

  fn is_propagation_stopped() Bool {
    propagation_state(self.internal_state).propagation_stopped
  }

  fn is_default_prevented() Bool {
    propagation_state(self.internal_state).default_prevented
  }
}
