use cooper
use cooper/animation
use cooper/ui

private struct FrameCount {
  value: Int,
}

fn main() {
  let application = cooper::app().expect("create animation example")
  defer application.destroy()
  let root = ui::box(
    application.context,
    styles: ui::style(width: ui::percent(100.0), height: ui::percent(100.0)),
  )
  let marker = ui::text(
    application.context,
    content: "●",
    selectable: false,
    styles: ui::style(
      position: ui::Position::absolute,
      left: ui::cells(0),
      top: ui::cells(0),
    ),
  )
  let status = ui::text(
    application.context,
    content: "START",
    selectable: false,
    styles: ui::style(
      position: ui::Position::absolute,
      left: ui::cells(0),
      top: ui::cells(2),
    ),
  )
  root.add(marker)
  root.add(status)
  application.root.add(root)

  let rendered_frames = mut FrameCount{value: 0}
  let timeline = application.context.timeline(800, on_complete: fn() {
    status.set_content("DONE frames={rendered_frames.value}")
  })
  defer timeline.destroy()
  timeline.add(
    800,
    fn(frame: animation::Frame) {
      rendered_frames.value =+ 1
      let applied = mut marker.style()
      applied.left = ui::cells(animation::lerp_int(0, 20, frame.progress))
      marker.set_style(applied.@)
    },
    ease: animation::in_out_quad,
  )
  timeline.call(
    fn() {
      status.set_content("MIDPOINT")
    },
    at: 400,
  )
  let _ = timeline.play()

  application.run().expect("run animation example")
}
