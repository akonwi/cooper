use ard/async

use cooper/app
use cooper/style
use cooper/text
use go:time

fn main() {
  let application = app::new().expect("create Cooper app")
  let status = text::new(
    application.context,
    content: "Loading asynchronously...",
    styles: style::new(width: style::percent(100.0), height: style::percent(100.0)),
  )
  application.root.add(status)

  let cancellation = application.context.cancellation
  let dispatch = application.context.dispatch
  async::start(fn() {
    select {
      cancellation.recv() => (),
      time::After(300 * time::Millisecond).recv() => {
        let _ = dispatch(fn() {
          status.set_content("Loaded on the UI thread.")
          application.destroy()
        })
      },
    }
  })

  application.run().expect("run Cooper async example")
  application.destroy()
}
