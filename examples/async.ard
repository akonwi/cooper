use ard/async

use cooper
use cooper/event
use cooper/surface
use cooper/text
use go:time

struct AsyncStatus {
  message: Str,
}

fn new() AsyncStatus {
  AsyncStatus{message: "Loading asynchronously..."}
}

impl cooper::Widget for AsyncStatus {
  fn mut init(ctx: cooper::InitContext) {
    async::start(fn() {
      select {
        ctx.cancellation.recv() => (),
        time::After(2 * time::Second).recv() => {
          let _ = ctx.dispatch(fn() {
            self.message = "Loaded on the UI thread. Press Ctrl+C to quit."
          })
        },
      }
    })
  }

  fn render(ctx: surface::RenderContext) surface::Surface {
    let label = text::new(content: self.message)
    label.render(ctx)
  }

  fn mut event(ctx: mut event::EventContext) event::EventResult {
    event::EventResult::ignored
  }
}

fn main() {
  let status = mut new()
  cooper::run(status).expect("run Cooper async example")
}
