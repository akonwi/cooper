use cooper
use cooper/ui

struct Marker {
  view: mut ui::Text,
  x: Int,
  y: Int,
  visible: Bool,
}

struct Card {
  name: Str,
  panel: mut ui::Box,
  specimen: mut ui::Text,
  label: mut ui::Text,
  default_label: Str,
  latched: Bool,
  x: Int,
  y: Int,
  home_x: Int,
  home_y: Int,
  width: Int,
  height: Int,
  z: Int,
  fill: ui::Color,
  drag_fill: ui::Color,
  border: ui::Color,
}

struct DemoState {
  trail_cursor: Int,
  trail_count: Int,
  activation_cursor: Int,
  activation_count: Int,
  dragging: Int,
  drag_offset_x: Int,
  drag_offset_y: Int,
  moved: Bool,
  next_z: Int,
  last_event: Str,
  cursor: mut Marker,
  trails: [mut Marker],
  activations: [mut Marker],
}

private fn clamp(value: Int, minimum: Int, maximum: Int) Int {
  mut ceiling = maximum
  if ceiling < minimum {
    ceiling = minimum
  }
  if value < minimum {
    minimum
  } else if value > ceiling {
    ceiling
  } else {
    value
  }
}

private fn marker_style(x: Int, y: Int, z: Int, visible: Bool) ui::Style {
  mut display = ui::Display::none
  if visible {
    display = ui::Display::flex
  }
  ui::style(
    display: display,
    position: ui::Position::absolute,
    left: ui::cells(x),
    top: ui::cells(y),
    width: ui::cells(1),
    height: ui::cells(1),
    z_index: z,
  )
}

private fn make_marker(ctx: mut cooper::Runtime, z: Int) mut Marker {
  let view = ui::text(
    ctx,
    content: "",
    styles: marker_style(0, 0, z, false),
    selectable: false,
    wrap: ui::TextWrap::none,
    overflow: ui::TextOverflow::clip,
  )
  let marker = mut Marker{
    view: view,
    x: 0,
    y: 0,
    visible: false,
  }
  marker
}

private fn show_marker(marker: mut Marker, x: Int, y: Int, z: Int, glyph: Str, tint: ui::Color) {
  marker.x = x
  marker.y = y
  marker.visible = true
  marker.view.set_content(glyph)
  marker.view.set_text_style(ui::text_style(foreground: tint, bold: true))
  marker.view.set_style(marker_style(x, y, z, true))
}

private fn hide_marker(marker: mut Marker, z: Int) {
  marker.visible = false
  marker.view.set_content("")
  marker.view.set_style(marker_style(marker.x, marker.y, z, false))
}

private fn card_style(card: mut Card, dragging: Bool) ui::Style {
  mut fill = card.fill
  mut border = card.border
  if dragging {
    fill = card.drag_fill
    border = ui::hex("#F8FAFC")
  }
  ui::style(
    background: fill,
    border: ui::Border::rounded,
    border_color: border,
    position: ui::Position::absolute,
    left: ui::cells(card.x),
    top: ui::cells(card.y),
    width: ui::cells(card.width),
    height: ui::cells(card.height),
    z_index: card.z,
    align_items: ui::Align::center,
    justify_content: ui::Justify::center,
    overflow: ui::Overflow::hidden,
  )
}

private fn apply_card(card: mut Card, dragging: Bool) {
  card.panel.set_style(card_style(card, dragging))
  card.panel.set_title(card.name)
}

private fn make_card(
  ctx: mut cooper::Runtime,
  name: Str,
  x: Int,
  y: Int,
  width: Int,
  height: Int,
  fill: ui::Color,
  drag_fill: ui::Color,
  border: ui::Color,
  specimen_text: Str,
  default_label: Str,
) mut Card {
  let specimen = ui::text(
    ctx,
    content: specimen_text,
    styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
    selectable: false,
    wrap: ui::TextWrap::none,
    overflow: ui::TextOverflow::clip,
    text_style: ui::text_style(foreground: ui::hex("#FFFFFF"), bold: true),
  )
  let label = ui::text(
    ctx,
    content: default_label,
    styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
    selectable: false,
    wrap: ui::TextWrap::none,
    overflow: ui::TextOverflow::ellipsis,
    text_style: ui::text_style(foreground: ui::hex("#E2E8F0")),
  )
  let placeholder = mut Card{
    name: name,
    panel: ui::box(ctx),
    specimen: specimen,
    label: label,
    default_label: default_label,
    latched: false,
    x: x,
    y: y,
    home_x: x,
    home_y: y,
    width: width,
    height: height,
    z: 100,
    fill: fill,
    drag_fill: drag_fill,
    border: border,
  }
  placeholder.panel.set_style(card_style(placeholder, false))
  placeholder.panel.set_title(name)
  placeholder.panel.add(specimen)
  placeholder.panel.add(label)
  placeholder
}

private fn reset_card(card: mut Card) {
  card.x = card.home_x
  card.y = card.home_y
  card.z = 100
  card.latched = false
  apply_card(card, false)
  card.label.set_content(card.default_label)
}

private fn reset_cards(cards: [mut Card]) {
  for card in cards {
    reset_card(card)
  }
}

private fn update_status(state: mut DemoState, status: mut ui::Text) {
  status.set_content(
    "{state.last_event} · trails {state.trail_count}/{state.trails.size()} · cells {state.activation_count} · C clear · R reset · Ctrl+C quit",
  )
}

private fn stage_point(stage: mut ui::Box, received: mut cooper::MouseEvent) ui::Point {
  let screen = stage.layout().screen
  ui::Point{x: received.x - screen.x - 1, y: received.y - screen.y - 1}
}

private fn drop_target(cards: [mut Card], source: Int, stage: mut ui::Box, x: Int, y: Int) Int {
  let stage_screen = stage.layout().screen
  let inside_stage = x > stage_screen.x and x < stage_screen.x + stage_screen.width - 1 and y > stage_screen.y and y < stage_screen.y + stage_screen.height - 1
  mut found = -1
  for card, index in cards {
    if inside_stage and index != source {
      let screen = card.panel.layout().screen
      let inside = x >= screen.x and x < screen.x + screen.width and y >= screen.y and y < screen.y + screen.height
      if inside {
        if found < 0 or card.z >= cards.at(found).expect("drop candidate").z {
          found = index
        }
      }
    }
  }
  found
}

private fn add_trail(
  state: mut DemoState,
  stage: mut ui::Box,
  received: mut cooper::MouseEvent,
  dragging: Bool,
) {
  if state.trails.size() > 0 {
    let point = stage_point(stage, received)
    let screen = stage.layout().screen
    let x = clamp(point.x, 0, screen.width - 3)
    let y = clamp(point.y, 0, screen.height - 3)
    let marker = state.trails.at(state.trail_cursor).expect("trail marker")
    mut glyph = "·"
    mut tint = ui::hex("#2DD4BF")
    if dragging {
      glyph = "•"
      tint = ui::hex("#FB923C")
    }
    show_marker(marker, x, y, 1, glyph, tint)
    show_marker(state.cursor, x, y, 3, "+", ui::hex("#FFFFFF"))
    state.trail_cursor = (state.trail_cursor + 1) % state.trails.size()
    if state.trail_count < state.trails.size() {
      state.trail_count =+ 1
    }
  }
}

private fn toggle_activation(
  state: mut DemoState,
  stage: mut ui::Box,
  received: mut cooper::MouseEvent,
) {
  let point = stage_point(stage, received)
  let screen = stage.layout().screen
  let x = clamp(point.x, 0, screen.width - 3)
  let y = clamp(point.y, 0, screen.height - 3)
  mut existing = -1
  for marker, index in state.activations {
    if marker.visible and marker.x == x and marker.y == y {
      existing = index
    }
  }

  if existing >= 0 {
    hide_marker(state.activations.at(existing).expect("active cell"), 2)
    state.activation_count =- 1
    state.last_event = "cell off at {x},{y}"
  } else if state.activations.size() > 0 {
    mut slot = -1
    for marker, index in state.activations {
      if slot < 0 and not marker.visible {
        slot = index
      }
    }
    if slot < 0 {
      slot = state.activation_cursor
    } else {
      state.activation_count =+ 1
    }
    show_marker(
      state.activations.at(slot).expect("activation marker"),
      x,
      y,
      2,
      "█",
      ui::hex("#F43F8C"),
    )
    state.activation_cursor = (slot + 1) % state.activations.size()
    state.last_event = "cell on at {x},{y}"
  }
}

private fn clear_marks(state: mut DemoState) {
  hide_marker(state.cursor, 3)
  for marker in state.trails {
    hide_marker(marker, 1)
  }
  for marker in state.activations {
    hide_marker(marker, 2)
  }
  state.trail_cursor = 0
  state.trail_count = 0
  state.activation_cursor = 0
  state.activation_count = 0
}

fn main() {
  let application = cooper::app().expect("create Cooper mouse interaction demo")
  defer application.destroy()
  let ctx = application.context

  let root = ui::box(
    ctx,
    styles: ui::style(
      background: ui::hex("#0F0F23"),
      width: ui::percent(100.0),
      height: ui::percent(100.0),
      gap: ui::cells(1),
    ),
  )

  let header = ui::box(
    ctx,
    styles: ui::style(
      background: ui::hex("#0F172A"),
      border: ui::Border::heavy,
      border_color: ui::hex("#48D1CC"),
      width: ui::percent(100.0),
      height: ui::cells(4),
      flex_shrink: 0.0,
      align_items: ui::Align::center,
      justify_content: ui::Justify::center,
    ),
  )
  header.add(
    ui::text(
      ctx,
      content: "MOUSE INTERACTION DEMO",
      selectable: false,
      text_style: ui::text_style(foreground: ui::hex("#48D1CC"), bold: true),
    ),
  )
  header.add(
    ui::text(
      ctx,
      content: "Scroll boxes · Move: cyan trail + cursor · Drag: orange trail · Click empty cells: pink",
      styles: ui::style(height: ui::cells(1), max_width: ui::percent(100.0)),
      selectable: false,
      wrap: ui::TextWrap::none,
      overflow: ui::TextOverflow::ellipsis,
      text_style: ui::text_style(foreground: ui::hex("#B0C4DE")),
    ),
  )

  let stage = ui::box(
    ctx,
    title: "DRAGGABLE OBJECTS",
    styles: ui::style(
      background: ui::hex("#0F0F23"),
      border: ui::Border::rounded,
      border_color: ui::hex("#334155"),
      position: ui::Position::relative,
      width: ui::percent(100.0),
      height: ui::cells(1),
      flex_grow: 1.0,
      flex_shrink: 1.0,
      overflow: ui::Overflow::hidden,
    ),
  )

  let prepared_trails = mut List::new<mut Marker>()
  mut trail_index = 0
  while trail_index < 32 {
    let marker = make_marker(ctx, 1)
    prepared_trails.push(marker)
    stage.add(marker.view)
    trail_index =+ 1
  }
  let prepared_activations = mut List::new<mut Marker>()
  mut activation_index = 0
  while activation_index < 24 {
    let marker = make_marker(ctx, 2)
    prepared_activations.push(marker)
    stage.add(marker.view)
    activation_index =+ 1
  }
  let cursor = make_marker(ctx, 3)
  stage.add(cursor.view)

  let cards: [mut Card] = [
    make_card(
      ctx,
      "BOX 1",
      3,
      1,
      18,
      6,
      ui::hex("#7C2D5A"),
      ui::hex("#3F1D35"),
      ui::hex("#F9A8D4"),
      "BOX 1",
      "drag me",
    ),
    make_card(
      ctx,
      "BOX 2",
      18,
      3,
      18,
      6,
      ui::hex("#166534"),
      ui::hex("#123524"),
      ui::hex("#86EFAC"),
      "BOX 2",
      "drag me",
    ),
    make_card(
      ctx,
      "BOX 3",
      34,
      5,
      18,
      6,
      ui::hex("#4338CA"),
      ui::hex("#29245F"),
      ui::hex("#C4B5FD"),
      "BOX 3",
      "drag me",
    ),
    make_card(
      ctx,
      "BOX 4 · O HIDDEN",
      12,
      7,
      18,
      6,
      ui::hex("#854D0E"),
      ui::hex("#422006"),
      ui::hex("#FDE68A"),
      "This should be cut off to the right",
      "overflow hidden",
    ),
  ]
  let overflow_label = cards.at(3).expect("overflow card").specimen
  overflow_label.set_style(
    ui::style(
      width: ui::cells(27),
      height: ui::cells(1),
      flex_shrink: 0.0,
      align_self: ui::Align::start,
    ),
  )
  overflow_label.set_wrap(ui::TextWrap::none)
  overflow_label.set_overflow(ui::TextOverflow::clip)
  for card in cards {
    stage.add(card.panel)
  }

  let footer = ui::box(
    ctx,
    styles: ui::style(
      background: ui::hex("#0F172A"),
      border: ui::Border::single,
      border_color: ui::hex("#334155"),
      width: ui::percent(100.0),
      height: ui::cells(3),
      flex_shrink: 0.0,
      align_items: ui::Align::center,
      justify_content: ui::Justify::center,
    ),
  )
  let status = ui::text(
    ctx,
    content: "",
    styles: ui::style(height: ui::cells(1), max_width: ui::percent(100.0)),
    selectable: false,
    wrap: ui::TextWrap::none,
    overflow: ui::TextOverflow::ellipsis,
    text_style: ui::text_style(foreground: ui::hex("#E2E8F0"), bold: true),
  )
  footer.add(status)

  root.add(header)
  root.add(stage)
  root.add(footer)
  application.root.add(root)

  let state = mut DemoState{
    trail_cursor: 0,
    trail_count: 0,
    activation_cursor: 0,
    activation_count: 0,
    dragging: -1,
    drag_offset_x: 0,
    drag_offset_y: 0,
    moved: false,
    next_z: 101,
    last_event: "ready",
    cursor: cursor,
    trails: prepared_trails.@,
    activations: prepared_activations.@,
  }

  for card, index in cards {
    let target = card
    let target_index = index
    let target_name = card.name
    let _ = card.panel.on_mouse(fn(received: mut cooper::MouseEvent) {
      if received.event_type == cooper::MouseEventType::down and received.button == cooper::MouseButton::left {
        for candidate in cards {
          apply_card(candidate, false)
        }
        state.dragging = target_index
        state.drag_offset_x = received.local_x
        state.drag_offset_y = received.local_y
        state.moved = false
        target.latched = false
        target.z = state.next_z
        state.next_z =+ 1
        apply_card(target, true)
        target.label.set_content("picked up")
        state.last_event = "{target_name} picked up"
        update_status(state, status)
        received.stop_propagation()
      } else if received.event_type == cooper::MouseEventType::drag and received.button == cooper::MouseButton::left and state.dragging == target_index {
        let screen = stage.layout().screen
        target.x = clamp(
          received.x - screen.x - 1 - state.drag_offset_x,
          0,
          screen.width - target.width - 2,
        )
        target.y = clamp(
          received.y - screen.y - 1 - state.drag_offset_y,
          0,
          screen.height - target.height - 2,
        )
        apply_card(target, true)
        target.label.set_content("dragging {target.x},{target.y}")
        state.moved = true
        state.last_event = "{target_name} drag at {received.x},{received.y}"
        add_trail(state, stage, received, true)
        update_status(state, status)
        received.stop_propagation()
      } else if received.event_type == cooper::MouseEventType::drag_end and received.button == cooper::MouseButton::left and state.dragging == target_index {
        let destination = drop_target(cards, target_index, stage, received.x, received.y)
        target.z = 100
        apply_card(target, false)
        match cards.at(destination) {
          dropped_on => {
            dropped_on.panel.set_border_color(ui::hex("#F8FAFC"))
            dropped_on.label.set_content("got {target_name}")
            dropped_on.latched = true
            target.label.set_content("dropped on {dropped_on.name}")
            target.latched = true
            state.last_event = "{target_name} dropped on {dropped_on.name}"
          },
          _ => {
            target.label.set_content("released here")
            target.latched = true
            state.last_event = "{target_name} released"
          },
        }
        state.dragging = -1
        update_status(state, status)
        received.stop_propagation()
      } else if received.event_type == cooper::MouseEventType::up and received.button == cooper::MouseButton::left and state.dragging == target_index {
        if not state.moved {
          target.label.set_content("clicked")
          target.latched = true
          state.last_event = "{target_name} clicked"
          state.dragging = -1
          apply_card(target, false)
          update_status(state, status)
        }
      } else if received.event_type == cooper::MouseEventType::move {
        received.stop_propagation()
      } else if received.event_type == cooper::MouseEventType::over and not target.latched {
        target.label.set_content("pointer over")
      } else if received.event_type == cooper::MouseEventType::out and state.dragging != target_index and (not target.latched) {
        target.label.set_content("pointer out")
      } else if received.event_type == cooper::MouseEventType::scroll {
        mut direction = "down"
        if received.scroll_y < 0 {
          direction = "up"
        } else if received.scroll_y == 0 and received.scroll_x < 0 {
          direction = "left"
        } else if received.scroll_y == 0 and received.scroll_x > 0 {
          direction = "right"
        }
        target.label.set_content("scroll {direction}")
        target.latched = true
        state.last_event = "{target_name} scroll {direction}"
        update_status(state, status)
        received.stop_propagation()
      }
    })
  }

  let _ = stage.on_mouse(fn(received: mut cooper::MouseEvent) {
    if received.event_type == cooper::MouseEventType::move {
      add_trail(state, stage, received, false)
      update_status(state, status)
    } else if received.event_type == cooper::MouseEventType::drag {
      add_trail(state, stage, received, true)
      state.last_event = "drag at {received.x},{received.y}"
      update_status(state, status)
    } else if received.event_type == cooper::MouseEventType::down and received.button == cooper::MouseButton::left {
      toggle_activation(state, stage, received)
      update_status(state, status)
    }
  })

  let _ = application.on_key(fn(received: mut cooper::KeyEvent) {
    if received.event_type != cooper::KeyEventType::release {
      if received.matches("c") {
        clear_marks(state)
        state.last_event = "trails and cells cleared"
        update_status(state, status)
        received.prevent_default()
      } else if received.matches("r") {
        clear_marks(state)
        reset_cards(cards)
        state.dragging = -1
        state.moved = false
        state.next_z = 101
        state.last_event = "scene reset"
        update_status(state, status)
        received.prevent_default()
      }
    }
  })

  update_status(state, status)
  application.run().expect("run Cooper mouse interaction demo")
}
