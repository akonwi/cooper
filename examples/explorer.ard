use ard/async

use cooper
use cooper/ui
use go:os
use go:path/filepath
use go:strings

private fn row_style() ui::Style {
  ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0)
}

private fn entry_row(
  ctx: mut cooper::Runtime,
  label: Str,
  activate: fn(Str),
) mut ui::Box {
  let row = ui::box(ctx, styles: row_style())
  let label_text = ui::text(ctx, content: "  {label}", styles: row_style())
  row.add(label_text)
  row.set_focusable(true)
  let _ = row.on_focus(fn() {
    label_text.set_content("> {label}")
    label_text.set_text_style(ui::text_style(bold: true, reverse: true))
  })
  let _ = row.on_blur(fn() {
    label_text.set_content("  {label}")
    label_text.set_text_style(ui::text_style())
  })
  let _ = row.on_key(fn(received: mut cooper::KeyEvent) {
    if received.event_type != cooper::KeyEventType::release and received.matches("return") {
      activate(label)
      received.prevent_default()
    }
  })
  let _ = row.on_mouse(fn(received: mut cooper::MouseEvent) {
    if received.event_type == cooper::MouseEventType::down and received.button == cooper::MouseButton::left {
      activate(label)
    }
  })
  row
}

private fn alphabetic(left: Str, right: Str) Bool {
  strings::Compare(strings::ToLower(left), strings::ToLower(right)) < 0
}

private fn read_names(path: Str) [Str]!Error {
  let entries = try os::ReadDir(path)
  let names = mut List::new<Str>()
  for entry in entries {
    mut suffix = ""
    if entry.IsDir() {
      suffix = "/"
    }
    names.push("{entry.Name()}{suffix}")
  }
  names.sort(alphabetic)
  Result::ok(names.@)
}

private fn start_directory_load(
  ctx: mut cooper::Runtime,
  path: Str,
  listing: mut ui::ScrollBox,
  loading: mut ui::Text,
  selection: mut ui::Text,
  rows: mut [mut ui::Box],
) {
  let cancellation = ctx.cancellation
  let dispatch = ctx.dispatch
  async::start(fn() {
    let cancelled_before = select {
      cancellation.recv() => true,
      _ => false,
    }
    if not cancelled_before {
      let loaded = read_names(path)
      let cancelled_after = select {
        cancellation.recv() => true,
        _ => false,
      }
      if not cancelled_after {
        let _ = dispatch(fn() {
          let _ = listing.remove(loading)
          loading.destroy()
          let activate = fn(name: Str) {
            selection.set_content("Selected: {name}")
          }
          match loaded {
            ok(names) => {
              for name in names {
                let row = entry_row(ctx, name, activate)
                rows.push(row)
                listing.add(row)
              }
            },
            err(_) => listing.add(ui::text(ctx, content: "Unable to read directory")),
          }
        })
      }
    }
  })
}

fn main() {
  let application = cooper::app().expect("create Cooper explorer app")
  let ctx = application.context
  let cwd = filepath::Abs(
    os::Getwd().expect("read current directory"),
  ).expect("resolve current directory")

  let root = ui::box(
    ctx,
    styles: ui::style(
      width: ui::percent(100.0),
      height: ui::percent(100.0),
      align_items: ui::Align::stretch,
      gap: ui::cells(1),
    ),
  )
  let title = ui::text(
    ctx,
    content: "Cooper Explorer — {cwd}",
    styles: ui::style(height: ui::cells(1), flex_shrink: 0.0),
    text_style: ui::text_style(foreground: ui::rgb(90, 170, 255), bold: true),
  )
  let search = ui::input(
    ctx,
    placeholder: "Filter",
    styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
  )
  let panes = ui::box(
    ctx,
    styles: ui::style(
      flex_direction: ui::FlexDirection::row,
      width: ui::percent(100.0),
      height: ui::cells(1),
      flex_grow: 1.0,
      align_items: ui::Align::stretch,
      gap: ui::cells(2),
    ),
  )
  let details_style = mut ui::style(
    width: ui::percent(50.0),
    height: ui::percent(100.0),
    flex_grow: 1.0,
    align_items: ui::Align::start,
  )
  details_style.overflow = ui::Overflow::hidden
  let details = ui::box(ctx, styles: details_style.@)
  let details_title = ui::text(
    ctx,
    content: "Details",
    text_style: ui::text_style(bold: true, underline: true),
  )
  let selection = ui::text(ctx, content: "Select an entry with Enter or the mouse.")
  details.add(details_title)
  details.add(selection)

  let listing = ui::scroll_box(
    ctx,
    styles: ui::style(
      width: ui::percent(50.0),
      height: ui::percent(100.0),
      flex_grow: 1.0,
    ),
  )
  let loading = ui::text(ctx, content: "Loading directory…", styles: row_style())
  listing.add(loading)
  let rows = mut List::new<mut ui::Box>()
  start_directory_load(ctx, cwd, listing, loading, selection, rows)

  panes.add(listing)
  panes.add(details)
  root.add(title)
  root.add(search)
  root.add(panes)
  application.root.add(root)

  search.focus()
  let _ = application.on_key(fn(received: mut cooper::KeyEvent) {
    if received.event_type != cooper::KeyEventType::release and received.matches("tab") and search.is_focused() {
      match rows.at(0) {
        row => { let _ = row.focus() },
        _ => (),
      }
      received.prevent_default()
    }
  })
  application.run().expect("run Cooper explorer app")
}
