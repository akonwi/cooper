use ard/async

use cooper/app
use cooper/box
use cooper/color
use cooper/context
use cooper/event
use cooper/input
use cooper/scroll_box
use cooper/style
use cooper/text
use go:os
use go:path/filepath
use go:strings

private fn row_style() style::Style {
  style::new(width: style::percent(100.0), height: style::cells(1), flex_shrink: 0.0)
}

private fn entry_row(
  ctx: mut context::Context,
  label: Str,
  activate: fn(Str),
) mut box::Box {
  let row = box::new(ctx, styles: row_style())
  let label_text = text::new(ctx, content: "  {label}", styles: row_style())
  row.add(label_text)
  row.set_focusable(true)
  let _ = row.on_focus(fn() {
    label_text.set_content("> {label}")
    label_text.set_text_style(text::style(bold: true, reverse: true))
  })
  let _ = row.on_blur(fn() {
    label_text.set_content("  {label}")
    label_text.set_text_style(text::style())
  })
  let _ = row.on_key(fn(received: mut event::KeyEvent) {
    if received.event_type != event::KeyEventType::release and received.matches("return") {
      activate(label)
      received.prevent_default()
    }
  })
  let _ = row.on_mouse(fn(received: mut event::MouseEvent) {
    if received.event_type == event::MouseEventType::down and received.button == event::MouseButton::left {
      activate(label)
    }
  })
  row
}

private fn alphabetic(left: Str, right: Str) Bool {
  strings::Compare(strings::ToLower(left), strings::ToLower(right)) < 0
}

private fn read_names(path: Str) [Str]!Error {
  let entries = try os::ReadDir(path)
  let names = mut List::new<Str>()
  for entry in entries {
    mut suffix = ""
    if entry.IsDir() {
      suffix = "/"
    }
    names.push("{entry.Name()}{suffix}")
  }
  names.sort(alphabetic)
  Result::ok(names.@)
}

private fn start_directory_load(
  ctx: mut context::Context,
  path: Str,
  listing: mut scroll_box::ScrollBox,
  loading: mut text::Text,
  selection: mut text::Text,
  rows: mut [mut box::Box],
) {
  let cancellation = ctx.cancellation
  let dispatch = ctx.dispatch
  async::start(fn() {
    let cancelled_before = select {
      cancellation.recv() => true,
      _ => false,
    }
    if not cancelled_before {
      let loaded = read_names(path)
      let cancelled_after = select {
        cancellation.recv() => true,
        _ => false,
      }
      if not cancelled_after {
        let _ = dispatch(fn() {
          let _ = listing.remove(loading)
          loading.destroy()
          let activate = fn(name: Str) {
            selection.set_content("Selected: {name}")
          }
          match loaded {
            ok(names) => {
              for name in names {
                let row = entry_row(ctx, name, activate)
                rows.push(row)
                listing.add(row)
              }
            },
            err(_) => listing.add(text::new(ctx, content: "Unable to read directory")),
          }
        })
      }
    }
  })
}

fn main() {
  let application = app::new().expect("create Cooper explorer app")
  let ctx = application.context
  let cwd = filepath::Abs(
    os::Getwd().expect("read current directory"),
  ).expect("resolve current directory")

  let root = box::new(
    ctx,
    styles: style::new(
      width: style::percent(100.0),
      height: style::percent(100.0),
      align_items: style::Align::stretch,
      gap: style::cells(1),
    ),
  )
  let title = text::new(
    ctx,
    content: "Cooper Explorer — {cwd}",
    styles: style::new(height: style::cells(1), flex_shrink: 0.0),
    text_style: text::style(foreground: color::rgb(90, 170, 255), bold: true),
  )
  let search = input::new(
    ctx,
    placeholder: "Filter",
    styles: style::new(width: style::percent(100.0), height: style::cells(1), flex_shrink: 0.0),
  )
  let panes = box::new(
    ctx,
    styles: style::new(
      flex_direction: style::FlexDirection::row,
      width: style::percent(100.0),
      height: style::cells(1),
      flex_grow: 1.0,
      align_items: style::Align::stretch,
      gap: style::cells(2),
    ),
  )
  let details_style = mut style::new(
    width: style::percent(50.0),
    height: style::percent(100.0),
    flex_grow: 1.0,
    align_items: style::Align::start,
  )
  details_style.overflow = style::Overflow::hidden
  let details = box::new(ctx, styles: details_style.@)
  let details_title = text::new(
    ctx,
    content: "Details",
    text_style: text::style(bold: true, underline: true),
  )
  let selection = text::new(ctx, content: "Select an entry with Enter or the mouse.")
  details.add(details_title)
  details.add(selection)

  let listing = scroll_box::new(
    ctx,
    styles: style::new(
      width: style::percent(50.0),
      height: style::percent(100.0),
      flex_grow: 1.0,
    ),
  )
  let loading = text::new(ctx, content: "Loading directory…", styles: row_style())
  listing.add(loading)
  let rows = mut List::new<mut box::Box>()
  start_directory_load(ctx, cwd, listing, loading, selection, rows)

  panes.add(listing)
  panes.add(details)
  root.add(title)
  root.add(search)
  root.add(panes)
  application.root.add(root)

  search.focus()
  let _ = application.on_key(fn(received: mut event::KeyEvent) {
    if received.event_type != event::KeyEventType::release and received.matches("tab") and search.is_focused() {
      match rows.at(0) {
        row => { let _ = row.focus() },
        _ => (),
      }
      received.prevent_default()
    }
  })
  application.run().expect("run Cooper explorer app")
}
