use ard/async

use cooper
use cooper/ui
use go:time

fn main() {
  let application = cooper::app().expect("create Cooper app")
  let status = ui::text(
    application.context,
    content: "Loading asynchronously...",
    styles: ui::style(width: ui::percent(100.0), height: ui::percent(100.0)),
  )
  application.root.add(status)

  let cancellation = application.context.cancellation
  let dispatch = application.context.dispatch
  async::start(fn() {
    select {
      cancellation.recv() => (),
      time::After(300 * time::Millisecond).recv() => {
        let _ = dispatch(fn() {
          status.set_content("Loaded on the UI thread.")
        })
        time::Sleep(100 * time::Millisecond)
        let _ = dispatch(fn() {
          application.destroy()
        })
      },
    }
  })

  application.run().expect("run Cooper async example")
  application.destroy()
}
