use cooper
use cooper/ui

// PTY fixture preserving the contract that terminal focus reporting remains
// available when application mouse handling is disabled.
fn main() {
  let application = cooper::app(use_mouse: false).expect("create mouse-disabled focus probe")
  defer application.destroy()
  let status = ui::text(
    application.context,
    content: "terminal: unknown",
    styles: ui::style(width: ui::percent(100.0), height: ui::cells(1)),
    selectable: false,
  )
  application.root.add(status)
  let _ = application.on_terminal_focus(fn(value: cooper::TerminalFocus) {
    if value == cooper::TerminalFocus::gained {
      status.set_content("terminal: focused")
    } else {
      status.set_content("terminal: blurred")
    }
  })
  application.run().expect("run mouse-disabled focus probe")
}
