use cooper
use cooper/ui

fn main() {
  let application = cooper::app().expect("create Cooper horizontal scroll fixture")
  defer application.destroy()
  let viewport = ui::scroll_box(
    application.context,
    styles: ui::style(width: ui::percent(100.0), height: ui::percent(100.0)),
    horizontal_scrollbar_options: ui::scrollbar_options(),
  )
  let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz01234567"
  mut index = 0
  while index < 8 {
    viewport.add(
      ui::text(
        application.context,
        content: "{index}:{alphabet}",
        wrap: ui::TextWrap::none,
        styles: ui::style(width: ui::cells(60), height: ui::cells(1), flex_shrink: 0.0),
      ),
    )
    index =+ 1
  }
  application.root.add(viewport)
  viewport.focus()
  application.run().expect("run Cooper horizontal scroll fixture")
}
