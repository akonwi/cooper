use cooper
use cooper/ui

private fn line() ui::Style {
  ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0)
}

fn main() {
  let application = cooper::app().expect("create Cooper app")
  let ctx = application.context
  let root = ui::box(
    ctx,
    styles: ui::style(
      width: ui::percent(100.0),
      height: ui::percent(100.0),
      align_items: ui::Align::stretch,
    ),
  )
  let title = ui::text(ctx, content: "Scrollable retained form", styles: line())
  let viewport = ui::scroll_box(
    ctx,
    styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_grow: 1.0),
  )
  let fields = mut List::new<mut ui::Input>()
  mut index = 1
  while index <= 8 {
    let field = ui::input(ctx, placeholder: "value {index}", styles: line())
    fields.push(field)
    viewport.add(ui::text(ctx, content: "Field {index}", styles: line()))
    viewport.add(field)
    index =+ 1
  }
  root.add(title)
  root.add(viewport)

  application.root.add(root)
  fields.at(0).expect("first field").focus()
  let _ = application.on_key(fn(received: mut cooper::KeyEvent) {
    if received.event_type != cooper::KeyEventType::release and received.matches("tab") {
      mut current = -1
      for field, field_index in fields {
        if field.is_focused() {
          current = field_index
        }
      }
      let next = (current + 1) % fields.size()
      fields.at(next).expect("next field").focus()
      received.prevent_default()
    }
  })
  application.run().expect("run Cooper scrolling form")
}
