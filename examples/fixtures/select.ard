use cooper
use cooper/ui

private fn options(count: Int) [ui::SelectOption] {
  let values = mut List::new<ui::SelectOption>()
  let labels = [
    "Home",
    "Profile",
    "Settings",
    "Users",
    "Security",
    "Notifications",
    "Billing",
    "Integrations",
    "API",
    "Logs",
    "Backup",
    "About",
  ]
  mut index = 0
  while index < count {
    let label = labels.at(index).expect("fixture option")
    values.push(
      ui::select_option(label, description: "{label} description", value: "value-{index}"),
    )
    index =+ 1
  }
  values.@
}

fn main() {
  let application = cooper::app().expect("create Cooper Select fixture")
  defer application.destroy()
  let ctx = application.context
  let root = ui::box(
    ctx,
    styles: ui::style(
      background: ui::hex("#001122"),
      width: ui::percent(100.0),
      height: ui::percent(100.0),
      gap: ui::cells(1),
      overflow: ui::Overflow::hidden,
    ),
  )
  root.add(
    ui::text(
      ctx,
      content: "BUILT-IN SELECTS · Tab switches focus · Ctrl+C quits",
      styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
      selectable: false,
      text_style: ui::text_style(foreground: ui::hex("#38BDF8"), bold: true),
    ),
  )

  let control_appearance = ui::select_appearance(
    normal: ui::span_style(foreground: ui::hex("#E2E8F0")),
    description: ui::span_style(foreground: ui::hex("#94A3B8")),
    highlighted: ui::span_style(background: ui::hex("#2D3748"), bold: true),
    selected: ui::span_style(
      foreground: ui::hex("#FFFFFF"),
      background: ui::hex("#3B82F6"),
      reverse: false,
      bold: true,
    ),
    selected_description: ui::span_style(foreground: ui::hex("#DBEAFE")),
    indicator: ui::span_style(foreground: ui::hex("#CBD5E1")),
  )

  let tabs = ui::tab_select(
    ctx,
    options(12),
    config: ui::select_tab_config(tab_width: 12),
    appearance: control_appearance,
    styles: ui::style(width: ui::percent(100.0), flex_shrink: 0.0),
  )
  root.add(tabs)

  let list = ui::select_input(
    ctx,
    options(12),
    config: ui::select_config(show_indicator: true),
    appearance: control_appearance,
    styles: ui::style(
      width: ui::percent(100.0),
      height: ui::cells(1),
      flex_grow: 1.0,
      flex_shrink: 1.0,
    ),
  )
  root.add(list)

  let status = ui::text(
    ctx,
    content: "Ready",
    styles: ui::style(width: ui::percent(100.0), height: ui::cells(2), flex_shrink: 0.0),
    selectable: false,
    text_style: ui::text_style(foreground: ui::hex("#FDE047")),
  )
  root.add(status)
  application.root.add(root)

  let _ = tabs.on_highlight(fn(value: ui::SelectSelection) {
    status.set_content("Tab highlight: {value.option.label} · index {value.index}")
  })
  let _ = tabs.on_change(fn(value: ui::SelectSelection) {
    status.set_content("Tab selected: {value.option.label} · {value.option.value.or("")}")
  })
  let _ = tabs.on_submit(fn(value: ui::SelectSelection) {
    status.set_content("Tab submitted: {value.option.label} · index {value.index}")
  })
  let _ = list.on_highlight(fn(value: ui::SelectSelection) {
    status.set_content("Select highlight: {value.option.label} · index {value.index}")
  })
  let _ = list.on_change(fn(value: ui::SelectSelection) {
    status.set_content("Select selected: {value.option.label} · {value.option.value.or("")}")
  })
  let _ = list.on_submit(fn(value: ui::SelectSelection) {
    status.set_content("Select submitted: {value.option.label} · index {value.index}")
  })

  let _ = application.on_key(fn(received: mut cooper::KeyEvent) {
    if received.event_type != cooper::KeyEventType::release and received.matches("tab") {
      if tabs.is_focused() {
        list.focus()
        status.set_content("Focus: Select")
      } else {
        tabs.focus()
        status.set_content("Focus: tabs")
      }
      received.prevent_default()
      received.stop_propagation()
    }
  })

  tabs.focus()
  application.run().expect("run Cooper Select fixture")
}
