use cooper
use cooper/ui
use go:strings

fn main() {
  let application = cooper::app().expect("create TextArea fixture")
  let ctx = application.context
  let root = ui::box(
    ctx,
    styles: ui::style(
      width: ui::percent(100.0),
      height: ui::percent(100.0),
      align_items: ui::Align::start,
      gap: ui::cells(1),
      padding: ui::edges(ui::cells(1)),
    ),
  )
  let title = ui::text(
    ctx,
    content: "TEXTAREA — Tab focus · Ctrl+Enter submit · Ctrl+C quit",
    selectable: false,
  )
  let frame = ui::box(
    ctx,
    title: "EDITOR",
    styles: ui::style(
      border: ui::Border::single,
      width: ui::cells(42),
      height: ui::cells(7),
      flex_shrink: 0.0,
    ),
  )
  let area = ui::text_area(
    ctx,
    placeholder: "Write multiple lines…",
    styles: ui::style(
      width: ui::percent(100.0),
      height: ui::percent(100.0),
    ),
  )
  let status = ui::text(ctx, content: "status: ready", selectable: false)
  frame.add(area)
  root.add(title)
  root.add(frame)
  root.add(status)
  application.root.add(root)

  let _ = area.on_input(fn(value: Str) {
    status.set_content("value: {strings::ReplaceAll(value, "\n", "↵")}")
  })
  let _ = area.on_key(fn(received: mut cooper::KeyEvent) {
    if received.matches("return", ctrl: true) {
      received.prevent_default()
      status.set_content("submit: {strings::ReplaceAll(area.value(), "\n", "↵")}")
    }
  })
  let _ = application.on_key(fn(received: mut cooper::KeyEvent) {
    if received.matches("tab") {
      received.prevent_default()
      let _ = area.focus()
      status.set_content("status: focused")
    }
  })

  application.run().expect("run TextArea fixture")
}
