use cooper/app
use cooper/box
use cooper/input
use cooper/style
use cooper/text

private fn line() style::Style {
  style::new(width: style::percent(100.0), height: style::cells(1), shrink: 0.0)
}

fn main() {
  let application = app::new().expect("create Cooper app")
  let ctx = application.context()
  let root = box::new(
    ctx,
    initial_style: style::new(
      width: style::percent(100.0),
      height: style::percent(100.0),
      align_items: style::Align::start,
    ),
  )
  root.add(
    text::new(
      ctx,
      content: "Only the focused field receives keyboard input.",
      initial_style: line(),
    ),
  )
  root.add(text::new(ctx, content: "Name", initial_style: line()))
  root.add(input::new(ctx, placeholder: "name", initial_style: line()))
  root.add(text::new(ctx, content: "Email", initial_style: line()))
  root.add(input::new(ctx, placeholder: "email", initial_style: line()))
  root.add(text::new(ctx, content: "City", initial_style: line()))
  root.add(input::new(ctx, placeholder: "city", initial_style: line()))

  application.run(root).expect("run Cooper form")
}
