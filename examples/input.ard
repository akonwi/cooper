use cooper/app
use cooper/input
use cooper/style

fn main() {
  let application = app::new().expect("create Cooper app")
  let ctx = application.context
  let field = input::new(
    ctx,
    placeholder: "Type here, then press Ctrl+C to quit",
    styles: style::new(width: style::percent(100.0), height: style::cells(1), flex_shrink: 0.0),
  )
  application.root.add(field)
  field.focus()
  application.run().expect("run Cooper input")
}
