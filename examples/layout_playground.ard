use cooper
use cooper/ui

enum Preset {
  horizontal,
  vertical,
  wrapped,
  centered,
  spaced,
  reversed,
  overlay,
}

impl Preset {
  fn next() Preset {
    match self {
      Preset::horizontal => Preset::vertical,
      Preset::vertical => Preset::wrapped,
      Preset::wrapped => Preset::centered,
      Preset::centered => Preset::spaced,
      Preset::spaced => Preset::reversed,
      Preset::reversed => Preset::overlay,
      Preset::overlay => Preset::horizontal,
    }
  }

  fn number() Int {
    match self {
      Preset::horizontal => 1,
      Preset::vertical => 2,
      Preset::wrapped => 3,
      Preset::centered => 4,
      Preset::spaced => 5,
      Preset::reversed => 6,
      Preset::overlay => 7,
    }
  }

  fn label() Str {
    match self {
      Preset::horizontal => "HORIZONTAL FLOW",
      Preset::vertical => "VERTICAL STACK",
      Preset::wrapped => "RESPONSIVE WRAP",
      Preset::centered => "CENTERED GROUP",
      Preset::spaced => "SPACE BETWEEN",
      Preset::reversed => "REVERSED FLOW",
      Preset::overlay => "ABSOLUTE OVERLAY",
    }
  }

  fn summary() Str {
    match self {
      Preset::horizontal => "row · flex-grow 1 · stretch",
      Preset::vertical => "column · 25% heights · no gap",
      Preset::wrapped => "row + wrap · 45% cards · two lines",
      Preset::centered => "fixed cells · align center · justify center",
      Preset::spaced => "fixed cells · justify space-between",
      Preset::reversed => "row-reverse · retained child order",
      Preset::overlay => "absolute offsets · sibling overlap · z-index",
    }
  }
}

private fn stage_style(preset: Preset) ui::Style {
  let next = mut ui::style(
    background: ui::hex("#0B1220"),
    border: ui::Border::rounded,
    border_color: ui::hex("#475569"),
    width: ui::percent(100.0),
    height: ui::cells(1),
    flex_grow: 1.0,
    flex_shrink: 1.0,
    overflow: ui::Overflow::hidden,
    gap: ui::cells(1),
  )

  match preset {
    Preset::horizontal => {
      next.flex_direction = ui::FlexDirection::row
      next.align_items = ui::Align::stretch
    },
    Preset::vertical => {
      next.flex_direction = ui::FlexDirection::column
      next.gap = ui::cells(0)
    },
    Preset::wrapped => {
      next.flex_direction = ui::FlexDirection::row
      next.flex_wrap = ui::FlexWrap::wrap
      next.align_items = ui::Align::stretch
    },
    Preset::centered => {
      next.flex_direction = ui::FlexDirection::row
      next.align_items = ui::Align::center
      next.justify_content = ui::Justify::center
    },
    Preset::spaced => {
      next.flex_direction = ui::FlexDirection::row
      next.align_items = ui::Align::center
      next.justify_content = ui::Justify::space_between
    },
    Preset::reversed => {
      next.flex_direction = ui::FlexDirection::row_reverse
      next.align_items = ui::Align::stretch
    },
    Preset::overlay => (),
  }

  next.@
}

private fn card_color(index: Int) ui::Color {
  match index {
    0 => ui::hex("#2563EB"),
    1 => ui::hex("#7C3AED"),
    2 => ui::hex("#059669"),
    _ => ui::hex("#D97706"),
  }
}

private fn card_border(index: Int) ui::Color {
  match index {
    0 => ui::hex("#93C5FD"),
    1 => ui::hex("#C4B5FD"),
    2 => ui::hex("#6EE7B7"),
    _ => ui::hex("#FCD34D"),
  }
}

private fn card_z_index(index: Int) Int {
  match index {
    0 => 10,
    _ => index,
  }
}

private fn card_style(preset: Preset, index: Int) ui::Style {
  let next = mut ui::style(
    background: card_color(index),
    border: ui::Border::single,
    border_color: card_border(index),
    width: ui::cells(13),
    height: ui::cells(7),
    flex_shrink: 0.0,
    align_items: ui::Align::center,
    justify_content: ui::Justify::center,
  )

  match preset {
    Preset::horizontal => {
      next.width = ui::cells(10)
      next.height = ui::percent(100.0)
      next.flex_grow = 1.0
      next.flex_shrink = 1.0
    },
    Preset::vertical => {
      next.width = ui::percent(100.0)
      next.height = ui::percent(25.0)
      next.flex_shrink = 1.0
    },
    Preset::wrapped => {
      next.width = ui::percent(45.0)
      next.height = ui::percent(45.0)
      next.flex_grow = 1.0
      next.flex_shrink = 1.0
    },
    Preset::reversed => {
      next.width = ui::cells(10)
      next.height = ui::percent(100.0)
      next.flex_grow = 1.0
      next.flex_shrink = 1.0
    },
    Preset::overlay => {
      next.position = ui::Position::absolute
      next.left = ui::cells(2 + index * 8)
      next.top = ui::cells(index * 2)
      next.width = ui::cells(22)
      next.height = ui::cells(7)
      next.z_index = card_z_index(index)
    },
    _ => (),
  }

  next.@
}

private fn make_card(ctx: mut cooper::Runtime, index: Int, name: Str) mut ui::Box {
  let card = ui::box(ctx, title: "{index + 1}")
  card.add(
    ui::text(
      ctx,
      content: name,
      selectable: false,
      text_style: ui::text_style(foreground: ui::hex("#FFFFFF"), bold: true),
    ),
  )
  card
}

private fn apply_preset(
  preset: Preset,
  stage: mut ui::Box,
  cards: [mut ui::Box],
  subtitle: mut ui::Text,
) {
  stage.set_style(stage_style(preset))
  stage.set_title("{preset.label()}")
  for card, index in cards {
    card.set_style(card_style(preset, index))
  }
  subtitle.set_content("Preset {preset.number()}/7 · {preset.summary()}")
}

private fn preset_for_key(key: mut cooper::KeyEvent, current: Preset) Preset? {
  if key.matches("1") {
    Maybe::new(Preset::horizontal)
  } else if key.matches("2") {
    Maybe::new(Preset::vertical)
  } else if key.matches("3") {
    Maybe::new(Preset::wrapped)
  } else if key.matches("4") {
    Maybe::new(Preset::centered)
  } else if key.matches("5") {
    Maybe::new(Preset::spaced)
  } else if key.matches("6") {
    Maybe::new(Preset::reversed)
  } else if key.matches("7") {
    Maybe::new(Preset::overlay)
  } else if key.matches("space") {
    Maybe::new(current.next())
  } else {
    Maybe::new<Preset>()
  }
}

fn main() {
  let application = cooper::app().expect("create Cooper layout playground")
  defer application.destroy()
  let ctx = application.context

  let root = ui::box(
    ctx,
    styles: ui::style(
      background: ui::hex("#020617"),
      width: ui::percent(100.0),
      height: ui::percent(100.0),
      gap: ui::cells(1),
    ),
  )

  let header = ui::box(
    ctx,
    styles: ui::style(
      background: ui::hex("#0F172A"),
      border: ui::Border::single,
      border_color: ui::hex("#38BDF8"),
      width: ui::percent(100.0),
      height: ui::cells(4),
      flex_shrink: 0.0,
      align_items: ui::Align::center,
      justify_content: ui::Justify::center,
    ),
  )
  header.add(
    ui::text(
      ctx,
      content: "COOPER LAYOUT PLAYGROUND",
      selectable: false,
      text_style: ui::text_style(foreground: ui::hex("#7DD3FC"), bold: true),
    ),
  )
  let subtitle = ui::text(
    ctx,
    content: "",
    styles: ui::style(height: ui::cells(1), max_width: ui::percent(100.0)),
    selectable: false,
    overflow: ui::TextOverflow::ellipsis,
    text_style: ui::text_style(foreground: ui::hex("#94A3B8")),
  )
  header.add(subtitle)

  let stage = ui::box(ctx, title: "HORIZONTAL FLOW")
  let cards: [mut ui::Box] = [
    make_card(ctx, 0, "ALPHA"),
    make_card(ctx, 1, "BRAVO"),
    make_card(ctx, 2, "CHARLIE"),
    make_card(ctx, 3, "DELTA"),
  ]
  for card in cards {
    stage.add(card)
  }

  let footer = ui::box(
    ctx,
    styles: ui::style(
      background: ui::hex("#0F172A"),
      border: ui::Border::single,
      border_color: ui::hex("#334155"),
      width: ui::percent(100.0),
      height: ui::cells(3),
      flex_shrink: 0.0,
      align_items: ui::Align::center,
      justify_content: ui::Justify::center,
    ),
  )
  footer.add(
    ui::text(
      ctx,
      content: ui::styled_text(
        [
          ui::span("1–7", style: ui::span_style(foreground: ui::hex("#FBBF24"), bold: true)),
          ui::span(" preset  ·  "),
          ui::span("Space", style: ui::span_style(foreground: ui::hex("#FBBF24"), bold: true)),
          ui::span(" next  ·  "),
          ui::span("Q", style: ui::span_style(foreground: ui::hex("#FBBF24"), bold: true)),
          ui::span(" quit  ·  resize to reflow"),
        ],
      ),
      styles: ui::style(height: ui::cells(1), max_width: ui::percent(100.0)),
      selectable: false,
      wrap: ui::TextWrap::none,
      overflow: ui::TextOverflow::ellipsis,
      text_style: ui::text_style(foreground: ui::hex("#CBD5E1")),
    ),
  )

  root.add(header)
  root.add(stage)
  root.add(footer)
  application.root.add(root)

  mut current = Preset::horizontal
  apply_preset(current, stage, cards, subtitle)

  let _ = application.on_key(fn(received: mut cooper::KeyEvent) {
    if received.event_type == cooper::KeyEventType::press {
      if received.matches("q") {
        received.prevent_default()
        application.destroy()
      } else {
        match preset_for_key(received, current) {
          selected => {
            current = selected
            apply_preset(current, stage, cards, subtitle)
            received.prevent_default()
          },
          _ => (),
        }
      }
    }
  })

  application.run().expect("run Cooper layout playground")
}
