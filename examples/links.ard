  ui::styled_text(
    [
      ui::span(
        "♥ Project Info\n\n",
        style: ui::span_style(foreground: ui::hex("#F472B6"), bold: true),
      ),
      ui::span("Source: ", style: ui::span_style(foreground: ui::hex("#E2E8F0"))),
      ui::span(
        "GitHub Repository",
        style: ui::span_style(foreground: ui::hex("#38BDF8"), underline: true),
        link: "https://github.com/akonwi/cooper",
      ),
      ui::span("\nWeb:    ", style: ui::span_style(foreground: ui::hex("#E2E8F0"))),
      ui::span(
        "Ard Website",
        style: ui::span_style(foreground: ui::hex("#34D399"), underline: true),
        link: "https://ard.run",
      ),
      ui::span("\nLicense: ", style: ui::span_style(foreground: ui::hex("#E2E8F0"))),
      ui::span(
        "MIT",
        style: ui::span_style(foreground: ui::hex("#FBBF24"), underline: true),
        link: "https://github.com/akonwi/cooper/blob/main/LICENSE",
      ),
    ],
  )
}

private fn documentation_content() ui::StyledText {
  ui::styled_text(
    [
      ui::span(
        "📚 Documentation\n\n",
        style: ui::span_style(foreground: ui::hex("#A78BFA"), bold: true),
      ),
      ui::span("Get started with:\n", style: ui::span_style(foreground: ui::hex("#CBD5E1"))),
      ui::span("• ", style: ui::span_style(foreground: ui::hex("#CBD5E1"))),
      ui::span(
        "Quick Start",
        style: ui::span_style(foreground: ui::hex("#FFFFFF"), bold: true),
        link: "https://github.com/akonwi/cooper#application-shape",
      ),
      ui::span("\n• ", style: ui::span_style(foreground: ui::hex("#CBD5E1"))),
      ui::span(
        "Examples",
        style: ui::span_style(foreground: ui::hex("#FFFFFF")),
        link: "https://github.com/akonwi/cooper/tree/main/examples",
      ),
      ui::span("\n• ", style: ui::span_style(foreground: ui::hex("#CBD5E1"))),
      ui::span(
        "Application API",
        style: ui::span_style(foreground: ui::hex("#FFFFFF")),
        link: "https://github.com/akonwi/cooper/blob/main/docs/adrs/0002-define-application-api.md",
      ),
    ],
  )
}

private fn connect_content() ui::StyledText {
  ui::styled_text(
    [
      ui::span(
        "👋 Connect\n\n",
        style: ui::span_style(foreground: ui::hex("#2DD4BF"), bold: true),
      ),
      ui::span(
        "Cooper Issues",
        style: ui::span_style(foreground: ui::hex("#60A5FA")),
        link: "https://github.com/akonwi/cooper/issues",
      ),
      ui::span("\n"),
      ui::span(
        "Author on GitHub",
        style: ui::span_style(foreground: ui::hex("#818CF8")),
        link: "https://github.com/akonwi",
      ),
    ],
  )
}

fn main() {
  let application = cooper::app().expect("create Cooper interactive link demo")
  defer application.destroy()
  let ctx = application.context

  let container = ui::box(
    ctx,
    styles: ui::style(
      background: ui::hex("#0F172A"),
      position: ui::Position::relative,
      width: ui::percent(100.0),
      height: ui::percent(100.0),
      overflow: ui::Overflow::hidden,
    ),
  )
  application.root.add(container)

  let state = mut DemoState{
    drag_enabled: false,
    next_z: 103,
    link_activity: "OSC 8 metadata emitted; link activation is handled by Cooper",
  }
  let header = ui::text(
    ctx,
    content: header_content(state.drag_enabled, state.link_activity),
    styles: ui::style(
      position: ui::Position::absolute,
      left: ui::cells(2),
      top: ui::cells(1),
      width: ui::cells(80),
      height: ui::cells(4),
      z_index: 10,
    ),
    selectable: false,
    overflow: ui::TextOverflow::clip,
  )
  container.add(header)

  let cards: [mut DraggableCard] = [
    make_card(ctx, project_content(), 5, 6, 40, 8, 100, ui::hex("#1E293B")),
    make_card(ctx, documentation_content(), 50, 8, 35, 9, 101, ui::hex("#334155")),
    make_card(ctx, connect_content(), 20, 16, 30, 7, 102, ui::hex("#0F766E")),
  ]
  for card in cards {
    container.add(card.panel)
    let _ = card.content.on_link(fn(received: mut ui::LinkEvent) {
      if state.drag_enabled {
        state.link_activity = "Drag mode blocked: {received.url}"
        received.prevent_default()
      } else {
        state.link_activity = "Opening: {received.url}"
      }
      header.set_content(header_content(state.drag_enabled, state.link_activity))
    })
  }

  for card in cards {
    let target = card
    let _ = card.panel.on_mouse(fn(received: mut cooper::MouseEvent) {
      if state.drag_enabled and received.event_type == cooper::MouseEventType::down and received.button == cooper::MouseButton::left {
        for candidate in cards {
          candidate.dragging = false
        }
        target.dragging = true
        target.drag_offset_x = received.local_x
        target.drag_offset_y = received.local_y
        target.z = state.next_z
        state.next_z =+ 1
        target.panel.set_style(card_style(target))
        received.stop_propagation()
      } else if state.drag_enabled and received.event_type == cooper::MouseEventType::drag and received.button == cooper::MouseButton::left and target.dragging {
        let screen = container.layout().screen
        target.x = clamp(
          received.x - screen.x - target.drag_offset_x,
          0,
          screen.width - target.width,
        )
        target.y = clamp(
          received.y - screen.y - target.drag_offset_y,
          0,
          screen.height - target.height,
        )
        target.panel.set_style(card_style(target))
        received.stop_propagation()
      } else if state.drag_enabled and received.event_type == cooper::MouseEventType::drag_end and received.button == cooper::MouseButton::left and target.dragging {
        target.dragging = false
        received.stop_propagation()
      } else if received.event_type == cooper::MouseEventType::up and received.button == cooper::MouseButton::left {
        target.dragging = false
      }
    })
  }

  let _ = application.on_key(fn(received: mut cooper::KeyEvent) {
    if received.event_type == cooper::KeyEventType::press and received.matches("d") {
      state.drag_enabled = not state.drag_enabled
      if not state.drag_enabled {
        for card in cards {
          card.dragging = false
        }
      }
      header.set_content(header_content(state.drag_enabled, state.link_activity))
      received.prevent_default()
    }
  })

  application.run().expect("run Cooper interactive link demo")
}
