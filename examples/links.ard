use cooper
use cooper/ui

struct DemoState {
  drag_enabled: Bool,
  next_z: Int,
  link_activity: Str,
}

struct DraggableCard {
  panel: mut ui::Box,
  content: mut ui::Text,
  x: Int,
  y: Int,
  width: Int,
  height: Int,
  z: Int,
  dragging: Bool,
  drag_offset_x: Int,
  drag_offset_y: Int,
  background: ui::Color,
}

private fn clamp(value: Int, minimum: Int, maximum: Int) Int {
  mut ceiling = maximum
  if ceiling < minimum {
    ceiling = minimum
  }
  if value < minimum {
    minimum
  } else if value > ceiling {
    ceiling
  } else {
    value
  }
}

// Cooper's border consumes layout rows, so horizontal-only padding preserves
// OpenTUI's five-line project card within the same 40x8 outer dimensions.
private fn horizontal_padding() ui::Edges {
  let padding = mut ui::edges()
  padding.left = ui::cells(1)
  padding.right = ui::cells(1)
  padding.@
}

private fn card_style(card: mut DraggableCard) ui::Style {
  ui::style(
    background: card.background,
    border: ui::Border::rounded,
    border_color: ui::hex("#FFFFFF"),
    position: ui::Position::absolute,
    left: ui::cells(card.x),
    top: ui::cells(card.y),
    width: ui::cells(card.width),
    height: ui::cells(card.height),
    z_index: card.z,
    padding: horizontal_padding(),
    flex_direction: ui::FlexDirection::column,
    overflow: ui::Overflow::hidden,
  )
}

private fn make_card(
  ctx: mut cooper::Runtime,
  content: ui::StyledText,
  x: Int,
  y: Int,
  width: Int,
  height: Int,
  z: Int,
  background: ui::Color,
) mut DraggableCard {
  let content_view = ui::text(
    ctx,
    content: content,
    styles: ui::style(
      width: ui::percent(100.0),
      height: ui::percent(100.0),
      flex_shrink: 0.0,
      overflow: ui::Overflow::hidden,
    ),
    selectable: false,
    overflow: ui::TextOverflow::clip,
  )
  let card = mut DraggableCard{
    panel: ui::box(ctx),
    content: content_view,
    x: x,
    y: y,
    width: width,
    height: height,
    z: z,
    dragging: false,
    drag_offset_x: 0,
    drag_offset_y: 0,
    background: background,
  }
  card.panel.set_style(card_style(card))
  card.panel.add(content_view)
  card
}

private fn header_content(drag_enabled: Bool, link_activity: Str) ui::StyledText {
  mut status = ui::span(
    "OFF",
    style: ui::span_style(foreground: ui::hex("#F87171"), bold: true),
  )
  if drag_enabled {
    status = ui::span(
      "ON",
      style: ui::span_style(foreground: ui::hex("#34D399"), bold: true),
    )
  }
  ui::styled_text(
    [
      ui::span(
        "Cooper Interactive Link Demo\n",
        style: ui::span_style(foreground: ui::hex("#38BDF8"), bold: true),
      ),
      ui::span(
        "Click the links to open them. ",
        style: ui::span_style(foreground: ui::hex("#94A3B8")),
      ),
      ui::span("Press ", style: ui::span_style(foreground: ui::hex("#64748B"))),
      ui::span("d", style: ui::span_style(foreground: ui::hex("#FBBF24"), bold: true)),
      ui::span(" to toggle drag mode: ", style: ui::span_style(foreground: ui::hex("#64748B"))),
      status,
      ui::span("\n"),
      ui::span(
        "({link_activity})",
        style: ui::span_style(foreground: ui::hex("#64748B"), italic: true),
      ),
    ],
  )
}

