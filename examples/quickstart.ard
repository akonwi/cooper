use cooper
use cooper/ui

fn main() {
  let application = cooper::app().expect("create Cooper app")
  let ctx = application.context

  let background = ui::box(
    ctx,
    styles: ui::style(
      background: ui::hex("#1131E9"),
      width: ui::percent(100.0),
      height: ui::percent(100.0),
      align_items: ui::Align::start,
    ),
  )
  let panel = ui::box(
    ctx,
    styles: ui::style(
      background: ui::hex("#1131E9"),
      width: ui::cells(42),
      height: ui::cells(9),
      align_items: ui::Align::center,
      justify_content: ui::Justify::center,
    ),
  )
  let content = ui::box(
    ctx,
    styles: ui::style(
      background: ui::hex("#2947F0"),
      width: ui::cells(38),
      height: ui::cells(7),
      padding: ui::edges(ui::cells(1)),
      flex_direction: ui::FlexDirection::column,
      gap: ui::cells(1),
      align_items: ui::Align::center,
    ),
  )

  mut count = 0
  let counter = ui::text(
    ctx,
    content: "Count  {count}",
    styles: ui::style(foreground: ui::hex("#FFFFFF")),
  )
  content.add(
    ui::text(
      ctx,
      content: "Hello, Cooper!",
      styles: ui::style(foreground: ui::hex("#DCE3FF")),
    ),
  )
  content.add(counter)
  content.add(
    ui::text(
      ctx,
      content: "left/right change | q quit",
      styles: ui::style(foreground: ui::hex("#AEBBFF")),
    ),
  )
  panel.add(content)
  background.add(panel)
  application.root.add(background)

  let _ = application.on_key(fn(received: mut cooper::KeyEvent) {
    if received.event_type != cooper::KeyEventType::release {
      if received.matches("q") {
        application.destroy()
      } else if received.matches("left") {
        count =- 1
        counter.set_content("Count  {count}")
      } else if received.matches("right") {
        count =+ 1
        counter.set_content("Count  {count}")
      }
    }
  })

  application.run().expect("run Cooper quickstart")
}
