use cooper/app
use cooper/box
use cooper/input
use cooper/scroll
use cooper/style
use cooper/text

private fn line() style::Style {
  style::new(width: style::percent(100.0), height: style::cells(1), shrink: 0.0)
}

fn main() {
  let application = app::new().expect("create Cooper app")
  let ctx = application.context()
  let root = box::new(
    ctx,
    initial_style: style::new(
      width: style::percent(100.0),
      height: style::percent(100.0),
      align_items: style::Align::stretch,
    ),
  )
  let title = text::new(ctx, content: "Scrollable retained form", initial_style: line())
  let content = box::new(
    ctx,
    initial_style: style::new(width: style::percent(100.0), align_items: style::Align::stretch),
  )
  mut index = 1
  while index <= 8 {
    content.add(text::new(ctx, content: "Field {index}", initial_style: line()))
    content.add(input::new(ctx, placeholder: "value {index}", initial_style: line()))
    index =+ 1
  }
  let viewport = scroll::new(
    ctx,
    content,
    initial_style: style::new(width: style::percent(100.0), height: style::cells(1), grow: 1.0),
    wheel_step: 2,
  )
  root.add(title)
  root.add(viewport)

  application.run(root).expect("run Cooper scrolling form")
}
