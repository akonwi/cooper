use ard/async

use cooper
use cooper/ui
use go:time

struct Layer {
  name: Str,
  group: mut ui::Box,
  panel: mut ui::Box,
  x: Int,
  y: Int,
  z: Int,
  home_x: Int,
  home_y: Int,
  fill: ui::Color,
  border: ui::Color,
}

struct StackingState {
  active: Int,
  autoplay: Bool,
  last_hit: Str,
  hits: Int,
}

private fn clamp(value: Int, minimum: Int, maximum: Int) Int {
  if value < minimum {
    minimum
  } else if value > maximum {
    maximum
  } else {
    value
  }
}

private fn group_style(x: Int, y: Int, z: Int) ui::Style {
  ui::style(
    position: ui::Position::absolute,
    left: ui::cells(x),
    top: ui::cells(y),
    width: ui::cells(31),
    height: ui::cells(8),
    overflow: ui::Overflow::visible,
    z_index: z,
  )
}

private fn shadow_style() ui::Style {
  ui::style(
    background: ui::hex("#030712"),
    position: ui::Position::absolute,
    left: ui::cells(1),
    top: ui::cells(1),
    width: ui::cells(30),
    height: ui::cells(7),
    z_index: 0,
  )
}

private fn panel_style(fill: ui::Color, border: ui::Color) ui::Style {
  ui::style(
    background: fill,
    border: ui::Border::rounded,
    border_color: border,
    position: ui::Position::absolute,
    left: ui::cells(0),
    top: ui::cells(0),
    width: ui::cells(30),
    height: ui::cells(7),
    overflow: ui::Overflow::visible,
    z_index: 1,
    align_items: ui::Align::center,
    justify_content: ui::Justify::center,
  )
}

private fn badge_style(fill: ui::Color) ui::Style {
  ui::style(
    background: fill,
    border: ui::Border::heavy,
    border_color: ui::hex("#F8FAFC"),
    position: ui::Position::absolute,
    left: ui::cells(17),
    top: ui::cells(4),
    width: ui::cells(13),
    height: ui::cells(3),
    z_index: 99,
    align_items: ui::Align::center,
    justify_content: ui::Justify::center,
  )
}

private fn make_layer(
  ctx: mut cooper::Runtime,
  name: Str,
  x: Int,
  y: Int,
  z: Int,
  fill: ui::Color,
  border: ui::Color,
  badge_fill: ui::Color,
) mut Layer {
  let group = ui::box(ctx, styles: group_style(x, y, z))
  let shadow = ui::box(ctx, styles: shadow_style())
  let panel = ui::box(ctx, title: name, styles: panel_style(fill, border))
  panel.add(
    ui::text(
      ctx,
      content: "{name}\nparent context",
      selectable: false,
      text_style: ui::text_style(foreground: ui::hex("#FFFFFF"), bold: true),
    ),
  )
  let badge = ui::box(ctx, title: "CHILD", styles: badge_style(badge_fill))
  badge.add(
    ui::text(
      ctx,
      content: "z = 99",
      selectable: false,
      text_style: ui::text_style(foreground: ui::hex("#FFFFFF"), bold: true),
    ),
  )
  panel.add(badge)
  group.add(shadow)
  group.add(panel)
  group.set_focusable(true)

  let layer = mut Layer{
    name: name,
    group: group,
    panel: panel,
    x: x,
    y: y,
    z: z,
    home_x: x,
    home_y: y,
    fill: fill,
    border: border,
  }
  layer
}

private fn apply_layer(layer: mut Layer, active: Bool) {
  mut applied_border = layer.border
  if active {
    applied_border = ui::hex("#F8FAFC")
  }
  layer.group.set_style(group_style(layer.x, layer.y, layer.z))
  layer.panel.set_style(panel_style(layer.fill, applied_border))
  layer.panel.set_title("{layer.name} · parent z={layer.z}")
}

private fn refresh(layers: [mut Layer], active: Int) {
  for layer, index in layers {
    apply_layer(layer, index == active)
  }
}

private fn raise_layer(layers: [mut Layer], index: Int) {
  match layers.at(index) {
    selected => {
      let previous_z = selected.z
      for layer in layers {
        if layer.z > previous_z {
          layer.z =- 1
        }
      }
      selected.z = layers.size() - 1
    },
    _ => (),
  }
}

private fn move_layer(layer: mut Layer, delta_x: Int, delta_y: Int) {
  layer.x = clamp(layer.x + delta_x, 0, 30)
  layer.y = clamp(layer.y + delta_y, 0, 6)
}

private fn reset_layers(layers: [mut Layer]) {
  for layer, index in layers {
    layer.x = layer.home_x
    layer.y = layer.home_y
    layer.z = index
  }
}

private fn name_at_z(layers: [mut Layer], z: Int) Str {
  mut found = "?"
  for layer in layers {
    if layer.z == z {
      found = layer.name
    }
  }
  found
}

private fn inspector_content(layers: [mut Layer], active: Int, autoplay: Bool) ui::StyledText {
  let selected = layers.at(active).expect("active stacking layer")
  let label = ui::hex("#94A3B8")
  let accent = ui::hex("#67E8F9")
  let value = ui::hex("#F8FAFC")
  mut auto_color = ui::hex("#FBBF24")
  mut auto_label = "OFF"
  if autoplay {
    auto_color = ui::hex("#4ADE80")
    auto_label = "ON"
  }
  ui::styled_text(
    [
      ui::span("ACTIVE\n", style: ui::span_style(foreground: label, bold: true)),
      ui::span("{selected.name}\n\n", style: ui::span_style(foreground: accent, bold: true)),
      ui::span("BACK → FRONT\n", style: ui::span_style(foreground: label, bold: true)),
      ui::span(
        "{name_at_z(layers, 0)} · {name_at_z(layers, 1)} · {name_at_z(layers, 2)}\n\n",
        style: ui::span_style(foreground: value),
      ),
      ui::span("CHILD Z\n", style: ui::span_style(foreground: label, bold: true)),
      ui::span(
        "99 (inside each parent)\n\n",
        style: ui::span_style(foreground: ui::hex("#F472B6")),
      ),
      ui::span("AUTOPLAY  ", style: ui::span_style(foreground: label, bold: true)),
      ui::span(auto_label, style: ui::span_style(foreground: auto_color, bold: true)),
    ],
  )
}

private fn update_status(
  layers: [mut Layer],
  active: Int,
  autoplay: Bool,
  last_hit: Str,
  hits: Int,
  inspector: mut ui::Text,
  status: mut ui::Text,
) {
  let selected = layers.at(active).expect("active stacking layer")
  inspector.set_content(inspector_content(layers, active, autoplay))
  mut auto_label = "OFF"
  if autoplay {
    auto_label = "ON"
  }
  status.set_content(
    "Active: {selected.name} · Parent z: {selected.z} · Position: {selected.x},{selected.y} · Auto: {auto_label} · Hit: {last_hit}#{hits}",
  )
}

fn main() {
  let application = cooper::app().expect("create Cooper stacking demo")
  defer application.destroy()
  let ctx = application.context

  let root = ui::box(
    ctx,
    styles: ui::style(
      background: ui::hex("#020617"),
      width: ui::percent(100.0),
      height: ui::percent(100.0),
      gap: ui::cells(1),
    ),
  )

  let header = ui::box(
    ctx,
    styles: ui::style(
      background: ui::hex("#0F172A"),
      border: ui::Border::heavy,
      border_color: ui::hex("#F472B6"),
      width: ui::percent(100.0),
      height: ui::cells(4),
      flex_shrink: 0.0,
      align_items: ui::Align::center,
      justify_content: ui::Justify::center,
    ),
  )
  header.add(
    ui::text(
      ctx,
      content: "COOPER STACKING CONTEXTS",
      selectable: false,
      text_style: ui::text_style(foreground: ui::hex("#F9A8D4"), bold: true),
    ),
  )
  header.add(
    ui::text(
      ctx,
      content: "A high-z child cannot escape its lower-z parent subtree",
      styles: ui::style(height: ui::cells(1), max_width: ui::percent(100.0)),
      selectable: false,
      wrap: ui::TextWrap::none,
      overflow: ui::TextOverflow::ellipsis,
      text_style: ui::text_style(foreground: ui::hex("#94A3B8")),
    ),
  )

  let body = ui::box(
    ctx,
    styles: ui::style(
      width: ui::percent(100.0),
      height: ui::cells(1),
      flex_grow: 1.0,
      flex_shrink: 1.0,
      flex_direction: ui::FlexDirection::row,
      gap: ui::cells(1),
      overflow: ui::Overflow::hidden,
    ),
  )
  let stage = ui::box(
    ctx,
    title: "NESTED LAYERS — CLICK EXPOSED EDGES",
    styles: ui::style(
      background: ui::hex("#0B1220"),
      border: ui::Border::rounded,
      border_color: ui::hex("#475569"),
      position: ui::Position::relative,
      width: ui::percent(68.0),
      height: ui::percent(100.0),
      flex_shrink: 0.0,
      overflow: ui::Overflow::hidden,
    ),
  )
  let stage_clip = ui::box(
    ctx,
    styles: ui::style(
      width: ui::percent(100.0),
      height: ui::percent(100.0),
      overflow: ui::Overflow::hidden,
    ),
  )
  let inspector_panel = ui::box(
    ctx,
    title: "STACK INSPECTOR",
    styles: ui::style(
      background: ui::hex("#0B1220"),
      border: ui::Border::rounded,
      border_color: ui::hex("#22D3EE"),
      width: ui::cells(1),
      height: ui::percent(100.0),
      flex_grow: 1.0,
      flex_shrink: 1.0,
      overflow: ui::Overflow::hidden,
    ),
  )
  let inspector_clip = ui::box(
    ctx,
    styles: ui::style(
      width: ui::percent(100.0),
      height: ui::percent(100.0),
      overflow: ui::Overflow::hidden,
    ),
  )
  let inspector = ui::text(
    ctx,
    content: "",
    wrap: ui::TextWrap::none,
    styles: ui::style(width: ui::percent(95.0), height: ui::percent(100.0)),
    selectable: false,
    overflow: ui::TextOverflow::clip,
    text_style: ui::text_style(foreground: ui::hex("#E2E8F0")),
  )
  inspector_clip.add(inspector)
  inspector_panel.add(inspector_clip)

  let layers: [mut Layer] = [
    make_layer(
      ctx,
      "ALPHA",
      2,
      1,
      0,
      ui::hex("#1D4ED8"),
      ui::hex("#60A5FA"),
      ui::hex("#1E40AF"),
    ),
    make_layer(
      ctx,
      "BRAVO",
      11,
      3,
      1,
      ui::hex("#6D28D9"),
      ui::hex("#C4B5FD"),
      ui::hex("#5B21B6"),
    ),
    make_layer(
      ctx,
      "CHARLIE",
      20,
      4,
      2,
      ui::hex("#047857"),
      ui::hex("#6EE7B7"),
      ui::hex("#065F46"),
    ),
  ]
  for layer in layers {
    stage_clip.add(layer.group)
  }
  stage.add(stage_clip)

  body.add(stage)
  body.add(inspector_panel)

  let footer = ui::box(
    ctx,
    styles: ui::style(
      background: ui::hex("#0F172A"),
      border: ui::Border::single,
      border_color: ui::hex("#334155"),
      width: ui::percent(100.0),
      height: ui::cells(4),
      flex_shrink: 0.0,
      align_items: ui::Align::center,
      justify_content: ui::Justify::center,
    ),
  )
  let status = ui::text(
    ctx,
    content: "",
    styles: ui::style(height: ui::cells(1), max_width: ui::percent(100.0)),
    selectable: false,
    wrap: ui::TextWrap::none,
    overflow: ui::TextOverflow::ellipsis,
    text_style: ui::text_style(foreground: ui::hex("#93C5FD"), bold: true),
  )
  footer.add(status)
  footer.add(
    ui::text(
      ctx,
      content: ui::styled_text(
        [
          ui::span("1–3/Space", style: ui::span_style(foreground: ui::hex("#FBBF24"), bold: true)),
          ui::span(" raise  ·  "),
          ui::span("Arrows", style: ui::span_style(foreground: ui::hex("#FBBF24"), bold: true)),
          ui::span(" move  ·  "),
          ui::span("A", style: ui::span_style(foreground: ui::hex("#FBBF24"), bold: true)),
          ui::span(" auto  ·  "),
          ui::span("R", style: ui::span_style(foreground: ui::hex("#FBBF24"), bold: true)),
          ui::span(" reset  ·  "),
          ui::span("Q", style: ui::span_style(foreground: ui::hex("#FBBF24"), bold: true)),
          ui::span(" quit"),
        ],
      ),
      styles: ui::style(height: ui::cells(1), max_width: ui::percent(100.0)),
      selectable: false,
      wrap: ui::TextWrap::none,
      overflow: ui::TextOverflow::ellipsis,
      text_style: ui::text_style(foreground: ui::hex("#CBD5E1")),
    ),
  )

  root.add(header)
  root.add(body)
  root.add(footer)
  application.root.add(root)

  let state = mut StackingState{
    active: 2,
    autoplay: false,
    last_hit: "none",
    hits: 0,
  }
  refresh(layers, state.active)
  update_status(layers, state.active, state.autoplay, state.last_hit, state.hits, inspector, status)

  let activate = fn(index: Int) {
    if index >= 0 and index < layers.size() {
      state.active = index
      raise_layer(layers, index)
      refresh(layers, state.active)
      update_status(
        layers,
        state.active,
        state.autoplay,
        state.last_hit,
        state.hits,
        inspector,
        status,
      )
    }
  }

  for layer, index in layers {
    let target_index = index
    let hit_name = layer.name
    let _ = layer.group.on_mouse(fn(received: mut cooper::MouseEvent) {
      if received.event_type == cooper::MouseEventType::down and received.button == cooper::MouseButton::left {
        state.last_hit = hit_name
        state.hits =+ 1
        activate(target_index)
      }
    })
  }

  let _ = application.on_key(fn(received: mut cooper::KeyEvent) {
    if received.event_type == cooper::KeyEventType::press {
      if received.matches("q") {
        received.prevent_default()
        application.destroy()
      } else if received.matches("1") {
        activate(0)
        received.prevent_default()
      } else if received.matches("2") {
        activate(1)
        received.prevent_default()
      } else if received.matches("3") {
        activate(2)
        received.prevent_default()
      } else if received.matches("space") {
        activate((state.active + 1) % layers.size())
        received.prevent_default()
      } else if received.matches("left") or received.matches("h") {
        move_layer(layers.at(state.active).expect("active layer"), -1, 0)
        refresh(layers, state.active)
        update_status(
          layers,
          state.active,
          state.autoplay,
          state.last_hit,
          state.hits,
          inspector,
          status,
        )
        received.prevent_default()
      } else if received.matches("right") or received.matches("l") {
        move_layer(layers.at(state.active).expect("active layer"), 1, 0)
        refresh(layers, state.active)
        update_status(
          layers,
          state.active,
          state.autoplay,
          state.last_hit,
          state.hits,
          inspector,
          status,
        )
        received.prevent_default()
      } else if received.matches("up") or received.matches("k") {
        move_layer(layers.at(state.active).expect("active layer"), 0, -1)
        refresh(layers, state.active)
        update_status(
          layers,
          state.active,
          state.autoplay,
          state.last_hit,
          state.hits,
          inspector,
          status,
        )
        received.prevent_default()
      } else if received.matches("down") or received.matches("j") {
        move_layer(layers.at(state.active).expect("active layer"), 0, 1)
        refresh(layers, state.active)
        update_status(
          layers,
          state.active,
          state.autoplay,
          state.last_hit,
          state.hits,
          inspector,
          status,
        )
        received.prevent_default()
      } else if received.matches("a") {
        state.autoplay = not state.autoplay
        update_status(
          layers,
          state.active,
          state.autoplay,
          state.last_hit,
          state.hits,
          inspector,
          status,
        )
        received.prevent_default()
      } else if received.matches("r") {
        state.autoplay = false
        state.active = 2
        state.last_hit = "none"
        state.hits = 0
        reset_layers(layers)
        refresh(layers, state.active)
        update_status(
          layers,
          state.active,
          state.autoplay,
          state.last_hit,
          state.hits,
          inspector,
          status,
        )
        received.prevent_default()
      }
    }
  })

  let autoplay_step = fn() {
    if state.autoplay {
      activate((state.active + 1) % layers.size())
    }
  }
  let cancellation = ctx.cancellation
  let dispatch = ctx.dispatch
  async::start(fn() {
    mut running = true
    while running {
      select {
        cancellation.recv() => { running = false },
        time::After(900 * time::Millisecond).recv() => {
          if dispatch(autoplay_step).is_err() {
            running = false
          }
        },
      }
    }
  })

  application.run().expect("run Cooper stacking demo")
}
