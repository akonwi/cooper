use ard/list

use cooper
use cooper/ui
use go:math
use go:time

struct FocusState {
  focus_known: Bool,
  focused: Bool,
  mouse_x: Int,
  mouse_y: Int,
  mouse_events: Int,
  focus_count: Int,
  blur_count: Int,
  resume_count: Int,
  awaiting_resume: Bool,
  last_focus_time: Str,
  last_blur_time: Str,
  last_mouse_time: Str,
  rows: [mut ui::Text],
}

private fn timestamp() Str {
  time::Now().Format("15:04:05")
}

private fn top_margin() ui::Edges {
  let margin = mut ui::edges()
  margin.top = ui::cells(1)
  margin.@
}

private fn row_style() ui::Style {
  ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0)
}

private fn append_log(
  ctx: mut cooper::Runtime,
  viewport: mut ui::ScrollBox,
  state: mut FocusState,
  message: Str,
  tint: ui::Color,
) {
  let row = ui::text(
    ctx,
    content: "[{timestamp()}] {message}",
    styles: row_style(),
    selectable: false,
    wrap: ui::TextWrap::none,
    overflow: ui::TextOverflow::ellipsis,
    text_style: ui::text_style(foreground: tint),
  )
  viewport.add(row)
  state.rows.push(row)
  if state.rows.size() > 20 {
    match state.rows.at(0) {
      oldest => {
        let _ = viewport.remove(oldest)
        oldest.destroy()
        state.rows = list::drop(state.rows, 1)
      },
      _ => (),
    }
  }
  let _ = viewport.scroll_to(math::MaxInt)
}

private fn display_time(value: Str) Str {
  if value.is_empty() {
    "--"
  } else {
    value
  }
}

private fn physical_pointer_event(received: mut cooper::MouseEvent) Bool {
  received.event_type == cooper::MouseEventType::move or received.event_type == cooper::MouseEventType::drag
}

private fn update_display(
  state: mut FocusState,
  focus_status: mut ui::Text,
  mouse_status: mut ui::Text,
  counters_status: mut ui::Text,
  timestamp_status: mut ui::Text,
) {
  if not state.focus_known {
    if state.mouse_events >= 3 {
      focus_status.set_content("Focus: UNKNOWN  (no reports; terminal may not support them)")
    } else {
      focus_status.set_content("Focus: UNKNOWN  (waiting for terminal report)")
    }
    focus_status.set_text_style(ui::text_style(foreground: ui::rgb(255, 200, 90), bold: true))
  } else if state.focused {
    if state.awaiting_resume {
      focus_status.set_content("Focus: YES  (awaiting physical mouse input)")
    } else {
      focus_status.set_content("Focus: YES  (mouse tracking active)")
    }
    focus_status.set_text_style(ui::text_style(foreground: ui::rgb(126, 231, 135), bold: true))
  } else {
    focus_status.set_content("Focus: NO   (modes may be stripped by terminal)")
    focus_status.set_text_style(ui::text_style(foreground: ui::rgb(255, 100, 100), bold: true))
  }
  mouse_status.set_content(
    "Mouse: ({state.mouse_x}, {state.mouse_y}) | Move events: {state.mouse_events}",
  )
  counters_status.set_content(
    "Focus-in: {state.focus_count} | Focus-out: {state.blur_count} | Mouse resumes: {state.resume_count}",
  )
  timestamp_status.set_content(
    "Last focus: {display_time(state.last_focus_time)} | Last blur: {display_time(state.last_blur_time)} | Last mouse: {display_time(state.last_mouse_time)}",
  )
}

fn main() {
  let application = cooper::app().expect("create Cooper focus restore demo")
  defer application.destroy()
  let ctx = application.context

  let root = ui::box(
    ctx,
    styles: ui::style(
      background: ui::hex("#0D1117"),
      width: ui::percent(100.0),
      height: ui::percent(100.0),
      padding: ui::edges(ui::cells(1)),
      flex_direction: ui::FlexDirection::column,
      overflow: ui::Overflow::hidden,
    ),
  )

  let title = ui::text(
    ctx,
    content: "Focus Restore Demo - Mouse Tracking + Terminal Mode Restore",
    styles: ui::style(width: ui::percent(100.0), height: ui::cells(2), flex_shrink: 0.0),
    selectable: false,
    text_style: ui::text_style(foreground: ui::rgb(72, 209, 204), bold: true),
  )
  root.add(title)

  let instructions = ui::text(
    ctx,
    content: "Move mouse to see tracking. Alt-tab away and back. Mouse should resume.\nMinimize and restore. Move again after returning. Ctrl+C to exit.",
    styles: ui::style(width: ui::percent(100.0), height: ui::cells(3), flex_shrink: 0.0),
    selectable: false,
    text_style: ui::text_style(foreground: ui::rgb(160, 160, 180)),
  )
  root.add(instructions)

  let status_box = ui::box(
    ctx,
    title: "Terminal State",
    styles: ui::style(
      border: ui::Border::rounded,
      border_color: ui::hex("#4ECDC4"),
      width: ui::percent(100.0),
      height: ui::cells(8),
      flex_shrink: 0.0,
      padding: ui::edges(ui::cells(1)),
      margin: top_margin(),
      flex_direction: ui::FlexDirection::column,
      overflow: ui::Overflow::hidden,
    ),
  )
  let focus_status = ui::text(ctx, content: "", styles: row_style(), selectable: false)
  let mouse_status = ui::text(
    ctx,
    content: "",
    styles: row_style(),
    selectable: false,
    text_style: ui::text_style(foreground: ui::rgb(165, 214, 255)),
  )
  let counters_status = ui::text(
    ctx,
    content: "",
    styles: row_style(),
    selectable: false,
    text_style: ui::text_style(foreground: ui::rgb(210, 168, 255)),
  )
  let timestamp_status = ui::text(
    ctx,
    content: "",
    styles: row_style(),
    selectable: false,
    wrap: ui::TextWrap::none,
    overflow: ui::TextOverflow::ellipsis,
    text_style: ui::text_style(foreground: ui::rgb(139, 148, 158)),
  )
  status_box.add(focus_status)
  status_box.add(mouse_status)
  status_box.add(counters_status)
  status_box.add(timestamp_status)
  root.add(status_box)

  let log_box = ui::box(
    ctx,
    title: "Event Log (latest 20)",
    styles: ui::style(
      border: ui::Border::rounded,
      border_color: ui::hex("#6BCF7F"),
      width: ui::percent(100.0),
      height: ui::cells(1),
      flex_grow: 1.0,
      flex_shrink: 1.0,
      padding: ui::edges(ui::cells(1)),
      margin: top_margin(),
      overflow: ui::Overflow::hidden,
    ),
  )
  let log_viewport = ui::scroll_box(
    ctx,
    styles: ui::style(
      width: ui::percent(100.0),
      height: ui::percent(100.0),
      flex_grow: 1.0,
      flex_shrink: 1.0,
    ),
  )
  log_box.add(log_viewport)
  root.add(log_box)
  application.root.add(root)

  let state = mut FocusState{
    focus_known: false,
    focused: false,
    mouse_x: 0,
    mouse_y: 0,
    mouse_events: 0,
    focus_count: 0,
    blur_count: 0,
    resume_count: 0,
    awaiting_resume: false,
    last_focus_time: "",
    last_blur_time: "",
    last_mouse_time: "",
    rows: [],
  }

  let _ = root.on_mouse(fn(received: mut cooper::MouseEvent) {
    if physical_pointer_event(received) {
      state.mouse_x = received.x
      state.mouse_y = received.y
      state.mouse_events =+ 1
      state.last_mouse_time = timestamp()
      if state.awaiting_resume {
        state.awaiting_resume = false
        state.resume_count =+ 1
        append_log(
          ctx,
          log_viewport,
          state,
          "MOUSE RESUMED - tracking active after focus #{state.focus_count}",
          ui::rgb(165, 214, 255),
        )
      }
      update_display(state, focus_status, mouse_status, counters_status, timestamp_status)
    }
  })

  let _ = application.on_terminal_focus(fn(value: cooper::TerminalFocus) {
    if value == cooper::TerminalFocus::gained {
      state.focus_known = true
      state.focused = true
      state.focus_count =+ 1
      state.last_focus_time = timestamp()
      state.awaiting_resume = true
      append_log(
        ctx,
        log_viewport,
        state,
        "FOCUS IN #{state.focus_count} - waiting for physical mouse input",
        ui::rgb(126, 231, 135),
      )
    } else {
      state.focus_known = true
      state.focused = false
      state.blur_count =+ 1
      state.last_blur_time = timestamp()
      state.awaiting_resume = false
      append_log(
        ctx,
        log_viewport,
        state,
        "FOCUS OUT #{state.blur_count} - terminal may strip input modes",
        ui::rgb(255, 165, 0),
      )
    }
    update_display(state, focus_status, mouse_status, counters_status, timestamp_status)
  })

  append_log(
    ctx,
    log_viewport,
    state,
    "Demo started. Move mouse, then alt-tab away and back.",
    ui::rgb(165, 214, 255),
  )
  update_display(state, focus_status, mouse_status, counters_status, timestamp_status)
  application.run().expect("run Cooper focus restore demo")
}
