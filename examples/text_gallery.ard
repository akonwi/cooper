use cooper
use cooper/ui
use go:strings

private fn sample(number: Int) Str {
  match number {
    0 => "Text wraps cleanly across terminal.",
    1 => "supercalifragilistic/without-breaks",
    _ => "你好世界🙂 Cooper élan wraps grapheme-safe.",
  }
}

private fn sample_for_key(key: mut cooper::KeyEvent, current: Int) Int? {
  if key.matches("1") {
    Maybe::new(0)
  } else if key.matches("2") {
    Maybe::new(1)
  } else if key.matches("3") {
    Maybe::new(2)
  } else if key.matches("space") {
    Maybe::new((current + 1) % 3)
  } else {
    Maybe::new<Int>()
  }
}

private fn selection_patch(value: mut ui::TextStyle) {
  value.background = Maybe::new(ui::hex("#1D4ED8"))
  value.foreground = Maybe::new(ui::hex("#FFFFFF"))
  value.bold = true
}

private fn specimen_content() ui::StyledText {
  let label = ui::hex("#67E8F9")
  ui::styled_text(
    [
      ui::span("BOLD      ", style: ui::span_style(foreground: label, bold: true)),
      ui::span("confident\n", style: ui::span_style(bold: true)),
      ui::span("DIM       ", style: ui::span_style(foreground: label, bold: true)),
      ui::span("secondary\n", style: ui::span_style(dim: true)),
      ui::span("ITALIC    ", style: ui::span_style(foreground: label, bold: true)),
      ui::span("emphasis\n", style: ui::span_style(italic: true)),
      ui::span("UNDERLINE ", style: ui::span_style(foreground: label, bold: true)),
      ui::span("actionable\n", style: ui::span_style(underline: true)),
      ui::span("BLINK     ", style: ui::span_style(foreground: label, bold: true)),
      ui::span("attention\n", style: ui::span_style(blink: true)),
      ui::span("REVERSE   ", style: ui::span_style(foreground: label, bold: true)),
      ui::span("inverted\n", style: ui::span_style(reverse: true)),
      ui::span("STRIKE    ", style: ui::span_style(foreground: label, bold: true)),
      ui::span("retired\n", style: ui::span_style(strike: true)),
      ui::span("HIDDEN    ", style: ui::span_style(foreground: label, bold: true)),
      ui::span("concealed\n", style: ui::span_style(hidden: true)),
      ui::span("FG + BG   ", style: ui::span_style(foreground: label, bold: true)),
      ui::span(
        " BADGE ",
        style: ui::span_style(
          foreground: ui::hex("#082F49"),
          background: ui::hex("#FDE047"),
          bold: true,
        ),
      ),
    ],
  )
}

private fn grapheme_content() ui::StyledText {
  ui::styled_text(
    [
      ui::span("GRAPHEMES  ", style: ui::span_style(foreground: ui::hex("#67E8F9"), bold: true)),
      ui::span("élan · 你好世界 · 👩🏽\u200d💻 · 🏳️\u200d🌈 · 🇯🇵"),
    ],
  )
}

private fn badge_content() ui::StyledText {
  ui::styled_text(
    [
      ui::span("SPANS      ", style: ui::span_style(foreground: ui::hex("#67E8F9"), bold: true)),
      ui::span(
        " READY ",
        style: ui::span_style(
          foreground: ui::hex("#052E16"),
          background: ui::hex("#4ADE80"),
          bold: true,
        ),
      ),
      ui::span(" "),
      ui::span(
        " WARN ",
        style: ui::span_style(
          foreground: ui::hex("#422006"),
          background: ui::hex("#FACC15"),
          bold: true,
        ),
      ),
      ui::span(" "),
      ui::span(
        " ERROR ",
        style: ui::span_style(
          foreground: ui::hex("#450A0A"),
          background: ui::hex("#F87171"),
          bold: true,
        ),
      ),
    ],
  )
}

private fn horizontal_padding() ui::Edges {
  let padding = mut ui::edges()
  padding.left = ui::cells(1)
  padding.right = ui::cells(1)
  padding.@
}

private fn content_clip(ctx: mut cooper::Runtime, inset: Bool) mut ui::Box {
  let applied = mut ui::style(
    width: ui::percent(100.0),
    height: ui::percent(100.0),
    overflow: ui::Overflow::hidden,
  )
  if inset {
    applied.padding = horizontal_padding()
  }
  ui::box(ctx, styles: applied.@)
}

private fn make_wrap_card(ctx: mut cooper::Runtime, title: Str, border_color: ui::Color) mut ui::Box {
  ui::box(
    ctx,
    title: title,
    styles: ui::style(
      background: ui::hex("#111827"),
      border: ui::Border::single,
      border_color: border_color,
      width: ui::cells(8),
      height: ui::percent(100.0),
      flex_grow: 1.0,
      flex_shrink: 1.0,
      overflow: ui::Overflow::hidden,
    ),
  )
}

private fn overflow_label(ellipsis: Bool) Str {
  if ellipsis {
    "ELLIPSIS"
  } else {
    "CLIP"
  }
}

private fn apply_sample(
  number: Int,
  ellipsis: Bool,
  wrap_lab: mut ui::Box,
  word_text: mut ui::Text,
  character_text: mut ui::Text,
  single_line_text: mut ui::Text,
) {
  let content = sample(number)
  word_text.set_content(content)
  character_text.set_content(content)
  single_line_text.set_content(content)
  if ellipsis {
    single_line_text.set_overflow(ui::TextOverflow::ellipsis)
  } else {
    single_line_text.set_overflow(ui::TextOverflow::clip)
  }
  wrap_lab.set_title("WRAP LAB · SAMPLE {number + 1}/3 · {overflow_label(ellipsis)}")
}

fn main() {
  let application = cooper::app().expect("create Cooper text gallery")
  defer application.destroy()
  let ctx = application.context

  let root = ui::box(
    ctx,
    styles: ui::style(
      background: ui::hex("#020617"),
      width: ui::percent(100.0),
      height: ui::percent(100.0),
      gap: ui::cells(1),
    ),
  )

  let header = ui::box(
    ctx,
    styles: ui::style(
      background: ui::hex("#0F172A"),
      border: ui::Border::single,
      border_color: ui::hex("#A78BFA"),
      width: ui::percent(100.0),
      height: ui::cells(4),
      flex_shrink: 0.0,
      align_items: ui::Align::center,
      justify_content: ui::Justify::center,
    ),
  )
  header.add(
    ui::text(
      ctx,
      content: "COOPER TEXT GALLERY",
      selectable: false,
      text_style: ui::text_style(foreground: ui::hex("#C4B5FD"), bold: true),
    ),
  )
  header.add(
    ui::text(
      ctx,
      content: "Styled spans · Unicode graphemes · wrapping · overflow · selection",
      styles: ui::style(height: ui::cells(1), max_width: ui::percent(100.0)),
      selectable: false,
      wrap: ui::TextWrap::none,
      overflow: ui::TextOverflow::ellipsis,
      text_style: ui::text_style(foreground: ui::hex("#94A3B8")),
    ),
  )

  let body = ui::box(
    ctx,
    styles: ui::style(
      width: ui::percent(100.0),
      height: ui::cells(1),
      flex_grow: 1.0,
      flex_shrink: 1.0,
      flex_direction: ui::FlexDirection::row,
      gap: ui::cells(1),
      overflow: ui::Overflow::hidden,
    ),
  )

  let specimens = ui::box(
    ctx,
    title: "STYLE SPECIMENS",
    styles: ui::style(
      background: ui::hex("#0B1220"),
      border: ui::Border::rounded,
      border_color: ui::hex("#22D3EE"),
      width: ui::percent(34.0),
      height: ui::percent(100.0),
      flex_shrink: 0.0,
    ),
  )
  let specimen_clip = content_clip(ctx, true)
  specimen_clip.add(
    ui::text(
      ctx,
      content: specimen_content(),
      wrap: ui::TextWrap::none,
      styles: ui::style(width: ui::percent(100.0), height: ui::percent(100.0)),
      text_style: ui::text_style(foreground: ui::hex("#E2E8F0")),
      selection_style: selection_patch,
      overflow: ui::TextOverflow::ellipsis,
    ),
  )
  specimens.add(specimen_clip)

  let right = ui::box(
    ctx,
    styles: ui::style(
      width: ui::cells(1),
      height: ui::percent(100.0),
      flex_grow: 1.0,
      flex_shrink: 1.0,
      gap: ui::cells(1),
      overflow: ui::Overflow::hidden,
    ),
  )

  let wrap_lab = ui::box(
    ctx,
    title: "WRAP LAB",
    styles: ui::style(
      background: ui::hex("#0B1220"),
      border: ui::Border::rounded,
      border_color: ui::hex("#8B5CF6"),
      width: ui::percent(100.0),
      height: ui::cells(8),
      flex_shrink: 0.0,
      flex_direction: ui::FlexDirection::row,
      gap: ui::cells(1),
      overflow: ui::Overflow::hidden,
    ),
  )

  let word_card = make_wrap_card(ctx, "WORD", ui::hex("#60A5FA"))
  let word_text = ui::text(
    ctx,
    content: "",
    wrap: ui::TextWrap::word,
    styles: ui::style(width: ui::percent(80.0), height: ui::cells(4)),
    text_style: ui::text_style(foreground: ui::hex("#BFDBFE")),
    selection_style: selection_patch,
  )
  let word_clip = content_clip(ctx, false)
  word_clip.add(word_text)
  word_card.add(word_clip)

  let character_card = make_wrap_card(ctx, "CHAR", ui::hex("#34D399"))
  let character_text = ui::text(
    ctx,
    content: "",
    wrap: ui::TextWrap::character,
    styles: ui::style(width: ui::percent(80.0), height: ui::cells(4)),
    text_style: ui::text_style(foreground: ui::hex("#A7F3D0")),
    selection_style: selection_patch,
  )
  let character_clip = content_clip(ctx, false)
  character_clip.add(character_text)
  character_card.add(character_clip)

  let single_line_card = make_wrap_card(ctx, "NONE", ui::hex("#FBBF24"))
  let single_line_text = ui::text(
    ctx,
    content: "",
    wrap: ui::TextWrap::none,
    styles: ui::style(width: ui::percent(80.0), height: ui::cells(4)),
    text_style: ui::text_style(foreground: ui::hex("#FDE68A")),
    selection_style: selection_patch,
    overflow: ui::TextOverflow::ellipsis,
  )
  let single_line_clip = content_clip(ctx, false)
  single_line_clip.add(single_line_text)
  single_line_card.add(single_line_clip)

  wrap_lab.add(word_card)
  wrap_lab.add(character_card)
  wrap_lab.add(single_line_card)

  let unicode_panel = ui::box(
    ctx,
    title: "RICH TEXT & UNICODE",
    styles: ui::style(
      background: ui::hex("#0B1220"),
      border: ui::Border::rounded,
      border_color: ui::hex("#F472B6"),
      width: ui::percent(100.0),
      height: ui::cells(1),
      flex_grow: 1.0,
      flex_shrink: 1.0,
    ),
  )
  let unicode_clip = content_clip(ctx, false)
  unicode_clip.add(
    ui::text(
      ctx,
      content: grapheme_content(),
      wrap: ui::TextWrap::none,
      styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
      overflow: ui::TextOverflow::ellipsis,
      text_style: ui::text_style(foreground: ui::hex("#FCE7F3")),
      selection_style: selection_patch,
    ),
  )
  unicode_clip.add(
    ui::text(
      ctx,
      content: badge_content(),
      wrap: ui::TextWrap::none,
      styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
      overflow: ui::TextOverflow::ellipsis,
      text_style: ui::text_style(foreground: ui::hex("#FCE7F3")),
      selection_style: selection_patch,
    ),
  )
  let link_line = ui::text(
    ctx,
    content: ui::styled_text(
      [
        ui::span("LINK       ", style: ui::span_style(foreground: ui::hex("#67E8F9"), bold: true)),
        ui::span(
          "Cooper source",
          style: ui::span_style(foreground: ui::hex("#7DD3FC"), bold: true, underline: true),
          link: "https://github.com/akonwi/cooper",
        ),
      ],
    ),
    wrap: ui::TextWrap::none,
    styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
    overflow: ui::TextOverflow::ellipsis,
    text_style: ui::text_style(foreground: ui::hex("#FCE7F3")),
    selection_style: selection_patch,
  )
  unicode_clip.add(link_line)
  unicode_panel.add(unicode_clip)

  right.add(wrap_lab)
  right.add(unicode_panel)
  body.add(specimens)
  body.add(right)

  let footer = ui::box(
    ctx,
    styles: ui::style(
      background: ui::hex("#0F172A"),
      border: ui::Border::single,
      border_color: ui::hex("#334155"),
      width: ui::percent(100.0),
      height: ui::cells(4),
      flex_shrink: 0.0,
      align_items: ui::Align::center,
      justify_content: ui::Justify::center,
    ),
  )
  let status = ui::text(
    ctx,
    content: "Selection: drag or double-click any specimen",
    wrap: ui::TextWrap::none,
    styles: ui::style(height: ui::cells(1), max_width: ui::percent(100.0)),
    selectable: false,
    overflow: ui::TextOverflow::ellipsis,
    text_style: ui::text_style(foreground: ui::hex("#93C5FD")),
  )
  footer.add(status)
  footer.add(
    ui::text(
      ctx,
      content: ui::styled_text(
        [
          ui::span("1–3", style: ui::span_style(foreground: ui::hex("#FBBF24"), bold: true)),
          ui::span(" sample  ·  "),
          ui::span("Space", style: ui::span_style(foreground: ui::hex("#FBBF24"), bold: true)),
          ui::span(" next  ·  "),
          ui::span("E", style: ui::span_style(foreground: ui::hex("#FBBF24"), bold: true)),
          ui::span(" overflow  ·  "),
          ui::span("C", style: ui::span_style(foreground: ui::hex("#FBBF24"), bold: true)),
          ui::span(" clear  ·  "),
          ui::span("Q", style: ui::span_style(foreground: ui::hex("#FBBF24"), bold: true)),
          ui::span(" quit"),
        ],
      ),
      wrap: ui::TextWrap::none,
      styles: ui::style(height: ui::cells(1), max_width: ui::percent(100.0)),
      selectable: false,
      overflow: ui::TextOverflow::ellipsis,
      text_style: ui::text_style(foreground: ui::hex("#CBD5E1")),
    ),
  )

  root.add(header)
  root.add(body)
  root.add(footer)
  application.root.add(root)

  mut current = 0
  mut ellipsis = true
  apply_sample(current, ellipsis, wrap_lab, word_text, character_text, single_line_text)

  let _ = application.on_selection_change(fn(value: ui::Selection?) {
    match value {
      selected => {
        let flattened = strings::ReplaceAll(selected.selected_text, "\n", " / ")
        status.set_content("Selection: {flattened}")
      },
      _ => status.set_content("Selection: none — drag or double-click any specimen"),
    }
  })
  let _ = link_line.on_link(fn(received: mut ui::LinkEvent) {
    received.prevent_default()
    status.set_content("Link intercepted: {received.url}")
  })
  let _ = application.on_key(fn(received: mut cooper::KeyEvent) {
    if received.event_type == cooper::KeyEventType::press {
      if received.matches("q") {
        received.prevent_default()
        application.destroy()
      } else if received.matches("e") {
        ellipsis = not ellipsis
        apply_sample(current, ellipsis, wrap_lab, word_text, character_text, single_line_text)
        received.prevent_default()
      } else if received.matches("c") {
        application.clear_selection()
        received.prevent_default()
      } else {
        match sample_for_key(received, current) {
          selected => {
            current = selected
            application.clear_selection()
            apply_sample(current, ellipsis, wrap_lab, word_text, character_text, single_line_text)
            received.prevent_default()
          },
          _ => (),
        }
      }
    }
  })

  application.run().expect("run Cooper text gallery")
}
