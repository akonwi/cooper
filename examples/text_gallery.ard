use cooper/app
use cooper/box
use cooper/color
use cooper/context
use cooper/event
use cooper/selection
use cooper/style
use cooper/text
use go:strings

private fn sample(number: Int) Str {
  match number {
    0 => "Text wraps cleanly across terminal.",
    1 => "supercalifragilistic/without-breaks",
    _ => "你好世界🙂 Cooper élan wraps grapheme-safe.",
  }
}

private fn sample_for_key(key: mut event::KeyEvent, current: Int) Int? {
  if key.matches("1") {
    Maybe::new(0)
  } else if key.matches("2") {
    Maybe::new(1)
  } else if key.matches("3") {
    Maybe::new(2)
  } else if key.matches("space") {
    Maybe::new((current + 1) % 3)
  } else {
    Maybe::new<Int>()
  }
}

private fn selection_patch(value: mut text::TextStyle) {
  value.background = Maybe::new(color::hex("#1D4ED8"))
  value.foreground = Maybe::new(color::hex("#FFFFFF"))
  value.bold = true
}

private fn specimen_content() text::StyledText {
  let label = color::hex("#67E8F9")
  text::styled_text(
    [
      text::span("BOLD      ", style: text::span_style(foreground: label, bold: true)),
      text::span("confident\n", style: text::span_style(bold: true)),
      text::span("DIM       ", style: text::span_style(foreground: label, bold: true)),
      text::span("secondary\n", style: text::span_style(dim: true)),
      text::span("ITALIC    ", style: text::span_style(foreground: label, bold: true)),
      text::span("emphasis\n", style: text::span_style(italic: true)),
      text::span("UNDERLINE ", style: text::span_style(foreground: label, bold: true)),
      text::span("actionable\n", style: text::span_style(underline: true)),
      text::span("BLINK     ", style: text::span_style(foreground: label, bold: true)),
      text::span("attention\n", style: text::span_style(blink: true)),
      text::span("REVERSE   ", style: text::span_style(foreground: label, bold: true)),
      text::span("inverted\n", style: text::span_style(reverse: true)),
      text::span("STRIKE    ", style: text::span_style(foreground: label, bold: true)),
      text::span("retired\n", style: text::span_style(strike: true)),
      text::span("HIDDEN    ", style: text::span_style(foreground: label, bold: true)),
      text::span("concealed\n", style: text::span_style(hidden: true)),
      text::span("FG + BG   ", style: text::span_style(foreground: label, bold: true)),
      text::span(
        " BADGE ",
        style: text::span_style(
          foreground: color::hex("#082F49"),
          background: color::hex("#FDE047"),
          bold: true,
        ),
      ),
    ],
  )
}

private fn grapheme_content() text::StyledText {
  text::styled_text(
    [
      text::span("GRAPHEMES  ", style: text::span_style(foreground: color::hex("#67E8F9"), bold: true)),
      text::span("élan · 你好世界 · 👩🏽\u200d💻 · 🏳️\u200d🌈 · 🇯🇵"),
    ],
  )
}

private fn badge_content() text::StyledText {
  text::styled_text(
    [
      text::span("SPANS      ", style: text::span_style(foreground: color::hex("#67E8F9"), bold: true)),
      text::span(
        " READY ",
        style: text::span_style(
          foreground: color::hex("#052E16"),
          background: color::hex("#4ADE80"),
          bold: true,
        ),
      ),
      text::span(" "),
      text::span(
        " WARN ",
        style: text::span_style(
          foreground: color::hex("#422006"),
          background: color::hex("#FACC15"),
          bold: true,
        ),
      ),
      text::span(" "),
      text::span(
        " ERROR ",
        style: text::span_style(
          foreground: color::hex("#450A0A"),
          background: color::hex("#F87171"),
          bold: true,
        ),
      ),
    ],
  )
}

private fn horizontal_padding() style::Edges {
  let padding = mut style::edges()
  padding.left = style::cells(1)
  padding.right = style::cells(1)
  padding.@
}

private fn content_clip(ctx: mut context::Context, inset: Bool) mut box::Box {
  let applied = mut style::new(
    width: style::percent(100.0),
    height: style::percent(100.0),
    overflow: style::Overflow::hidden,
  )
  if inset {
    applied.padding = horizontal_padding()
  }
  box::new(ctx, styles: applied.@)
}

private fn make_wrap_card(ctx: mut context::Context, title: Str, border_color: color::Color) mut box::Box {
  box::new(
    ctx,
    title: title,
    styles: style::new(
      background: color::hex("#111827"),
      border: style::Border::single,
      border_color: border_color,
      width: style::cells(8),
      height: style::percent(100.0),
      flex_grow: 1.0,
      flex_shrink: 1.0,
      overflow: style::Overflow::hidden,
    ),
  )
}

private fn overflow_label(ellipsis: Bool) Str {
  if ellipsis {
    "ELLIPSIS"
  } else {
    "CLIP"
  }
}

private fn apply_sample(
  number: Int,
  ellipsis: Bool,
  wrap_lab: mut box::Box,
  word_text: mut text::Text,
  character_text: mut text::Text,
  single_line_text: mut text::Text,
) {
  let content = sample(number)
  word_text.set_content(content)
  character_text.set_content(content)
  single_line_text.set_content(content)
  if ellipsis {
    single_line_text.set_overflow(text::TextOverflow::ellipsis)
  } else {
    single_line_text.set_overflow(text::TextOverflow::clip)
  }
  wrap_lab.set_title("WRAP LAB · SAMPLE {number + 1}/3 · {overflow_label(ellipsis)}")
}

fn main() {
  let application = app::new().expect("create Cooper text gallery")
  defer application.destroy()
  let ctx = application.context

  let root = box::new(
    ctx,
    styles: style::new(
      background: color::hex("#020617"),
      width: style::percent(100.0),
      height: style::percent(100.0),
      gap: style::cells(1),
    ),
  )

  let header = box::new(
    ctx,
    styles: style::new(
      background: color::hex("#0F172A"),
      border: style::Border::single,
      border_color: color::hex("#A78BFA"),
      width: style::percent(100.0),
      height: style::cells(4),
      flex_shrink: 0.0,
      align_items: style::Align::center,
      justify_content: style::Justify::center,
    ),
  )
  header.add(
    text::new(
      ctx,
      content: "COOPER TEXT GALLERY",
      selectable: false,
      text_style: text::style(foreground: color::hex("#C4B5FD"), bold: true),
    ),
  )
  header.add(
    text::new(
      ctx,
      content: "Styled spans · Unicode graphemes · wrapping · overflow · selection",
      styles: style::new(height: style::cells(1), max_width: style::percent(100.0)),
      selectable: false,
      wrap: text::TextWrap::none,
      overflow: text::TextOverflow::ellipsis,
      text_style: text::style(foreground: color::hex("#94A3B8")),
    ),
  )

  let body = box::new(
    ctx,
    styles: style::new(
      width: style::percent(100.0),
      height: style::cells(1),
      flex_grow: 1.0,
      flex_shrink: 1.0,
      flex_direction: style::FlexDirection::row,
      gap: style::cells(1),
      overflow: style::Overflow::hidden,
    ),
  )

  let specimens = box::new(
    ctx,
    title: "STYLE SPECIMENS",
    styles: style::new(
      background: color::hex("#0B1220"),
      border: style::Border::rounded,
      border_color: color::hex("#22D3EE"),
      width: style::percent(34.0),
      height: style::percent(100.0),
      flex_shrink: 0.0,
    ),
  )
  let specimen_clip = content_clip(ctx, true)
  specimen_clip.add(
    text::new(
      ctx,
      content: specimen_content(),
      wrap: text::TextWrap::none,
      styles: style::new(width: style::percent(100.0), height: style::percent(100.0)),
      text_style: text::style(foreground: color::hex("#E2E8F0")),
      selection_style: selection_patch,
      overflow: text::TextOverflow::ellipsis,
    ),
  )
  specimens.add(specimen_clip)

  let right = box::new(
    ctx,
    styles: style::new(
      width: style::cells(1),
      height: style::percent(100.0),
      flex_grow: 1.0,
      flex_shrink: 1.0,
      gap: style::cells(1),
      overflow: style::Overflow::hidden,
    ),
  )

  let wrap_lab = box::new(
    ctx,
    title: "WRAP LAB",
    styles: style::new(
      background: color::hex("#0B1220"),
      border: style::Border::rounded,
      border_color: color::hex("#8B5CF6"),
      width: style::percent(100.0),
      height: style::cells(8),
      flex_shrink: 0.0,
      flex_direction: style::FlexDirection::row,
      gap: style::cells(1),
      overflow: style::Overflow::hidden,
    ),
  )

  let word_card = make_wrap_card(ctx, "WORD", color::hex("#60A5FA"))
  let word_text = text::new(
    ctx,
    content: "",
    wrap: text::TextWrap::word,
    styles: style::new(width: style::percent(80.0), height: style::cells(4)),
    text_style: text::style(foreground: color::hex("#BFDBFE")),
    selection_style: selection_patch,
  )
  let word_clip = content_clip(ctx, false)
  word_clip.add(word_text)
  word_card.add(word_clip)

  let character_card = make_wrap_card(ctx, "CHAR", color::hex("#34D399"))
  let character_text = text::new(
    ctx,
    content: "",
    wrap: text::TextWrap::character,
    styles: style::new(width: style::percent(80.0), height: style::cells(4)),
    text_style: text::style(foreground: color::hex("#A7F3D0")),
    selection_style: selection_patch,
  )
  let character_clip = content_clip(ctx, false)
  character_clip.add(character_text)
  character_card.add(character_clip)

  let single_line_card = make_wrap_card(ctx, "NONE", color::hex("#FBBF24"))
  let single_line_text = text::new(
    ctx,
    content: "",
    wrap: text::TextWrap::none,
    styles: style::new(width: style::percent(80.0), height: style::cells(4)),
    text_style: text::style(foreground: color::hex("#FDE68A")),
    selection_style: selection_patch,
    overflow: text::TextOverflow::ellipsis,
  )
  let single_line_clip = content_clip(ctx, false)
  single_line_clip.add(single_line_text)
  single_line_card.add(single_line_clip)

  wrap_lab.add(word_card)
  wrap_lab.add(character_card)
  wrap_lab.add(single_line_card)

  let unicode_panel = box::new(
    ctx,
    title: "RICH TEXT & UNICODE",
    styles: style::new(
      background: color::hex("#0B1220"),
      border: style::Border::rounded,
      border_color: color::hex("#F472B6"),
      width: style::percent(100.0),
      height: style::cells(1),
      flex_grow: 1.0,
      flex_shrink: 1.0,
    ),
  )
  let unicode_clip = content_clip(ctx, false)
  unicode_clip.add(
    text::new(
      ctx,
      content: grapheme_content(),
      wrap: text::TextWrap::none,
      styles: style::new(width: style::percent(100.0), height: style::cells(1), flex_shrink: 0.0),
      overflow: text::TextOverflow::ellipsis,
      text_style: text::style(foreground: color::hex("#FCE7F3")),
      selection_style: selection_patch,
    ),
  )
  unicode_clip.add(
    text::new(
      ctx,
      content: badge_content(),
      wrap: text::TextWrap::none,
      styles: style::new(width: style::percent(100.0), height: style::cells(1), flex_shrink: 0.0),
      overflow: text::TextOverflow::ellipsis,
      text_style: text::style(foreground: color::hex("#FCE7F3")),
      selection_style: selection_patch,
    ),
  )
  let link_line = text::new(
    ctx,
    content: text::styled_text(
      [
        text::span("LINK       ", style: text::span_style(foreground: color::hex("#67E8F9"), bold: true)),
        text::span(
          "Cooper source",
          style: text::span_style(foreground: color::hex("#7DD3FC"), bold: true, underline: true),
          link: "https://github.com/akonwi/cooper",
        ),
      ],
    ),
    wrap: text::TextWrap::none,
    styles: style::new(width: style::percent(100.0), height: style::cells(1), flex_shrink: 0.0),
    overflow: text::TextOverflow::ellipsis,
    text_style: text::style(foreground: color::hex("#FCE7F3")),
    selection_style: selection_patch,
  )
  unicode_clip.add(link_line)
  unicode_panel.add(unicode_clip)

  right.add(wrap_lab)
  right.add(unicode_panel)
  body.add(specimens)
  body.add(right)

  let footer = box::new(
    ctx,
    styles: style::new(
      background: color::hex("#0F172A"),
      border: style::Border::single,
      border_color: color::hex("#334155"),
      width: style::percent(100.0),
      height: style::cells(4),
      flex_shrink: 0.0,
      align_items: style::Align::center,
      justify_content: style::Justify::center,
    ),
  )
  let status = text::new(
    ctx,
    content: "Selection: drag or double-click any specimen",
    wrap: text::TextWrap::none,
    styles: style::new(height: style::cells(1), max_width: style::percent(100.0)),
    selectable: false,
    overflow: text::TextOverflow::ellipsis,
    text_style: text::style(foreground: color::hex("#93C5FD")),
  )
  footer.add(status)
  footer.add(
    text::new(
      ctx,
      content: text::styled_text(
        [
          text::span("1–3", style: text::span_style(foreground: color::hex("#FBBF24"), bold: true)),
          text::span(" sample  ·  "),
          text::span("Space", style: text::span_style(foreground: color::hex("#FBBF24"), bold: true)),
          text::span(" next  ·  "),
          text::span("E", style: text::span_style(foreground: color::hex("#FBBF24"), bold: true)),
          text::span(" overflow  ·  "),
          text::span("C", style: text::span_style(foreground: color::hex("#FBBF24"), bold: true)),
          text::span(" clear  ·  "),
          text::span("Q", style: text::span_style(foreground: color::hex("#FBBF24"), bold: true)),
          text::span(" quit"),
        ],
      ),
      wrap: text::TextWrap::none,
      styles: style::new(height: style::cells(1), max_width: style::percent(100.0)),
      selectable: false,
      overflow: text::TextOverflow::ellipsis,
      text_style: text::style(foreground: color::hex("#CBD5E1")),
    ),
  )

  root.add(header)
  root.add(body)
  root.add(footer)
  application.root.add(root)

  mut current = 0
  mut ellipsis = true
  apply_sample(current, ellipsis, wrap_lab, word_text, character_text, single_line_text)

  let _ = application.on_selection_change(fn(value: selection::Selection?) {
    match value {
      selected => {
        let flattened = strings::ReplaceAll(selected.selected_text, "\n", " / ")
        status.set_content("Selection: {flattened}")
      },
      _ => status.set_content("Selection: none — drag or double-click any specimen"),
    }
  })
  let _ = link_line.on_link(fn(received: mut text::LinkEvent) {
    received.prevent_default()
    status.set_content("Link intercepted: {received.url}")
  })
  let _ = application.on_key(fn(received: mut event::KeyEvent) {
    if received.event_type == event::KeyEventType::press {
      if received.matches("q") {
        received.prevent_default()
        application.destroy()
      } else if received.matches("e") {
        ellipsis = not ellipsis
        apply_sample(current, ellipsis, wrap_lab, word_text, character_text, single_line_text)
        received.prevent_default()
      } else if received.matches("c") {
        application.clear_selection()
        received.prevent_default()
      } else {
        match sample_for_key(received, current) {
          selected => {
            current = selected
            application.clear_selection()
            apply_sample(current, ellipsis, wrap_lab, word_text, character_text, single_line_text)
            received.prevent_default()
          },
          _ => (),
        }
      }
    }
  })

  application.run().expect("run Cooper text gallery")
}
