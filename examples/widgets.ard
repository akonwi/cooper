private fn render_select(demo: mut SelectDemo) {
  let highlighted = try demo.control.highlighted() -> _ { () }
  mut selected = "No item activated yet"
  match demo.control.selected() {
    active => { selected = "*** ACTIVATED: {active.option.label} ({active.option.value.or("")}) ***" },
    _ => (),
  }
  mut focus_text = "Select element is BLURRED"
  mut focus_color = ui::hex("#FF0000")
  if demo.control.is_focused() {
    focus_text = "Select element is FOCUSED"
    focus_color = ui::hex("#00FF00")
  }
  mut description_text = "off"
  if demo.show_description {
    description_text = "on"
  }
  mut indicator_text = "off"
  if demo.show_indicator {
    indicator_text = "on"
  }
  mut wrap_text = "off"
  if demo.wrap {
    wrap_text = "on"
  }
  demo.status.set_content(
    ui::styled_text(
      [
        ui::span(
          "Selection: {highlighted.option.label} ({highlighted.option.value.or("")}) - Index: {highlighted.index}\n",
          style: ui::span_style(foreground: ui::hex("#00FF00")),
        ),
        ui::span("{focus_text}\n", style: ui::span_style(foreground: focus_color)),
        ui::span(
          "Indicator: {indicator_text} | Description: {description_text} | Wrap: {wrap_text}\n",
          style: ui::span_style(foreground: ui::hex("#CCCCCC")),
        ),
        ui::span("{selected}", style: ui::span_style(foreground: ui::hex("#FF00FF"), bold: true)),
      ],
    ),
  )
}

private fn apply_select_config(demo: mut SelectDemo) {
  demo.control.set_config(
    ui::select_config(
      show_descriptions: demo.show_description,
      show_indicator: demo.show_indicator,
      fast_step: 5,
      wrap_selection: demo.wrap,
    ),
  )
  render_select(demo)
}

