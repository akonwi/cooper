private fn horizontal_padding() style::Edges {
  let padding = mut style::edges()
  padding.left = style::cells(1)
  padding.right = style::cells(1)
  padding.@
}

private fn padded(value: Str, width: Int) Str {
  if value.size() >= width {
    value
  } else {
    "{value}{strings::Repeat(" ", width - value.size())}"
  }
}

private fn tab_page_style(show: Bool) style::Style {
  style::new(
    display: visible(show),
    background: color::hex("#001122"),
    width: style::percent(100.0),
    height: style::percent(100.0),
    flex_direction: style::FlexDirection::column,
    align_items: style::Align::center,
    gap: style::cells(1),
    overflow: style::Overflow::hidden,
  )
}

private fn render_tabs(demo: mut TabDemo) {
  if demo.highlighted < demo.offset {
    demo.offset = demo.highlighted
  } else if demo.highlighted >= demo.offset + 5 {
    demo.offset = demo.highlighted - 4
  }
  mut left_arrow = "  "
  if demo.show_arrows and demo.offset > 0 {
    left_arrow = "‹ "
  }
  let spans = mut [
    text::span(left_arrow, style: text::span_style(foreground: color::hex("#94A3B8"), bold: true)),
  ]
  mut slot = 0
  while slot < 5 {
    let option_index = demo.offset + slot
    match demo.options.at(option_index) {
      option => {
        mut foreground = color::hex("#E2E8F0")
        mut background = color::hex("#1E293B")
        mut bold = false
        mut underline = false
        if option_index == demo.activated {
          foreground = color::hex("#FFFFFF")
          background = color::hex("#3B82F6")
          bold = true
        }
        if option_index == demo.highlighted and demo.focused {
          foreground = color::hex("#F7FAFC")
          if option_index != demo.activated {
            background = color::hex("#2D3748")
          }
          underline = demo.show_underline
        }
        spans.push(
          text::span(
            " {padded(option.name, 10)} ",
            style: text::span_style(
              foreground: foreground,
              background: background,
              bold: bold,
              underline: underline,
            ),
          ),
        )
      },
      _ => spans.push(text::span(strings::Repeat(" ", 12))),
    }
    slot =+ 1
  }
  let more = demo.offset + 5 < demo.options.size()
  mut right_arrow = "  "
  if demo.show_arrows and more {
    right_arrow = " ›"
  }
  spans.push(
    text::span(right_arrow, style: text::span_style(foreground: color::hex("#94A3B8"), bold: true)),
  )
  demo.tabs.set_content(text::styled_text(spans.@))

  match demo.options.at(demo.highlighted) {
    option => {
      if demo.show_description {
        demo.description.set_content(option.description)
      } else {
        demo.description.set_content("Descriptions hidden — press P")
      }
      mut selected = "No item selected yet (press Enter to select)"
      match demo.options.at(demo.activated) {
        active => { selected = "Last Selected: {active.name} ({active.value})" },
        _ => (),
      }
      mut focus_text = "Tab selector is BLURRED"
      mut focus_color = color::hex("#FF0000")
      if demo.focused {
        focus_text = "Tab selector is FOCUSED"
        focus_color = color::hex("#00FF00")
      }
      mut underline_text = "off"
      if demo.show_underline {
        underline_text = "on"
      }
      mut description_text = "off"
      if demo.show_description {
        description_text = "on"
      }
      mut arrows_text = "off"
      if demo.show_arrows {
        arrows_text = "on"
      }
      mut wrap_text = "off"
      if demo.wrap {
        wrap_text = "on"
      }
      demo.status.set_content(
        text::styled_text(
          [
            text::span(
              "Highlighted: {option.name} ({option.value}) - Index: {demo.highlighted}\n",
              style: text::span_style(foreground: color::hex("#00FF00")),
            ),
            text::span("{selected}\n", style: text::span_style(foreground: color::hex("#FFFF00"))),
            text::span("{focus_text}\n", style: text::span_style(foreground: focus_color)),
            text::span(
              "Underline: {underline_text} | Description: {description_text} | Scroll arrows: {arrows_text} | Wrap: {wrap_text}",
              style: text::span_style(foreground: color::hex("#CCCCCC")),
            ),
          ],
        ),
      )
    },
    _ => (),
  }
}

private fn move_tab(demo: mut TabDemo, delta: Int) {
  mut next = demo.highlighted + delta
  if demo.wrap {
    if next < 0 {
      next = demo.options.size() - 1
    } else if next >= demo.options.size() {
      next = 0
    }
  } else {
    next = clamp(next, 0, demo.options.size() - 1)
  }
  demo.highlighted = next
  render_tabs(demo)
}

