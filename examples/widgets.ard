private fn slider_page_style(show: Bool) ui::Style {
  ui::style(
    display: visible(show),
    background: ui::hex("#1A1B26"),
    width: ui::percent(100.0),
    height: ui::percent(100.0),
    flex_direction: ui::FlexDirection::row,
    gap: ui::cells(1),
    overflow: ui::Overflow::hidden,
  )
}

private fn horizontal_bar(slider: mut LocalSlider) Str {
  let width = 48
  let filled = (slider.value - slider.minimum) * (width - 1) / (slider.maximum - slider.minimum)
  let line = "{strings::Repeat("█", filled)}●{strings::Repeat("░", width - filled - 1)}"
  mut rendered = line
  mut row = 1
  while row < slider.thickness {
    rendered = "{rendered}\n{line}"
    row =+ 1
  }
  rendered
}

private fn vertical_bar(slider: mut LocalSlider) Str {
  let rows = 12
  let filled = (slider.value - slider.minimum) * rows / (slider.maximum - slider.minimum)
  mut rendered = ""
  mut row = 0
  while row < rows {
    mut glyph = "░"
    if row >= rows - filled {
      glyph = "█"
    }
    rendered = "{rendered}{strings::Repeat(glyph, slider.track_width)}"
    if row < rows - 1 {
      rendered = "{rendered}\n"
    }
    row =+ 1
  }
  rendered
}

private fn render_slider(slider: mut LocalSlider) {
  slider.value = clamp(slider.value, slider.minimum, slider.maximum)
  slider.value_label.set_content("{slider.value}")
  if slider.orientation == SliderOrientation::horizontal {
    slider.track.set_content(horizontal_bar(slider))
  } else {
    slider.track.set_content(vertical_bar(slider))
  }
  if slider.panel.is_focused() {
    slider.panel.set_border_color(ui::hex("#FFFFFF"))
  } else {
    slider.panel.set_border_color(slider.tint)
  }
}

private fn make_horizontal_slider(
  ctx: mut cooper::Runtime,
  name: Str,
  detail: Str,
  value: Int,
  minimum: Int,
  maximum: Int,
  step: Int,
  thickness: Int,
  tint: ui::Color,
) mut LocalSlider {
  let panel = ui::box(
    ctx,
    styles: ui::style(
      background: ui::hex("#24283B"),
      border: ui::Border::single,
      border_color: tint,
      width: ui::percent(100.0),
      height: ui::cells(thickness + 4),
      flex_shrink: 0.0,
      padding: horizontal_padding(),
      overflow: ui::Overflow::hidden,
    ),
  )
  panel.set_focusable(true)
  let label = ui::text(
    ctx,
    content: ui::styled_text(
      [
        ui::span(name, style: ui::span_style(foreground: tint, bold: true)),
        ui::span(" - {detail}", style: ui::span_style(foreground: ui::hex("#565F89"))),
      ],
    ),
    styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
    selectable: false,
  )
  let value_label = ui::text(
    ctx,
    content: "",
    styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
    selectable: false,
    text_style: ui::text_style(foreground: tint, bold: true),
  )
  let track = ui::text(
    ctx,
    content: "",
    styles: ui::style(
      width: ui::cells(48),
      height: ui::cells(thickness),
      flex_shrink: 0.0,
      overflow: ui::Overflow::hidden,
    ),
    selectable: false,
    overflow: ui::TextOverflow::clip,
    text_style: ui::text_style(foreground: tint),
  )
  panel.add(label)
  panel.add(value_label)
  panel.add(track)
  let slider = mut LocalSlider{
    name: name,
    panel: panel,
    track: track,
    value_label: value_label,
    orientation: SliderOrientation::horizontal,
    minimum: minimum,
    maximum: maximum,
    value: value,
    step: step,
    thickness: thickness,
    track_width: 48,
    tint: tint,
    direction: 1,
  }
  render_slider(slider)
  slider
}

private fn make_vertical_slider(
  ctx: mut cooper::Runtime,
  name: Str,
  width: Int,
  value: Int,
  minimum: Int,
  maximum: Int,
  step: Int,
  track_width: Int,
  tint: ui::Color,
) mut LocalSlider {
  let panel = ui::box(
    ctx,
    styles: ui::style(
      background: ui::hex("#24283B"),
      border: ui::Border::single,
      border_color: tint,
      width: ui::cells(width),
      height: ui::percent(100.0),
      flex_shrink: 0.0,
      align_items: ui::Align::center,
      overflow: ui::Overflow::hidden,
    ),
  )
  panel.set_focusable(true)
  let label = ui::text(
    ctx,
    content: name,
    styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
    selectable: false,
    text_style: ui::text_style(foreground: tint, bold: true),
  )
  let track = ui::text(
    ctx,
    content: "",
    styles: ui::style(
      width: ui::cells(track_width),
      height: ui::cells(12),
      flex_shrink: 0.0,
      overflow: ui::Overflow::hidden,
    ),
    selectable: false,
    overflow: ui::TextOverflow::clip,
    text_style: ui::text_style(foreground: tint),
  )
  let value_label = ui::text(
    ctx,
    content: "",
    styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
    selectable: false,
    text_style: ui::text_style(foreground: tint, bold: true),
  )
  panel.add(label)
  panel.add(track)
  panel.add(value_label)
  let slider = mut LocalSlider{
    name: name,
    panel: panel,
    track: track,
    value_label: value_label,
    orientation: SliderOrientation::vertical,
    minimum: minimum,
    maximum: maximum,
    value: value,
    step: step,
    thickness: 1,
    track_width: track_width,
    tint: tint,
    direction: 1,
  }
  render_slider(slider)
  slider
}

private fn slider_action(action: mut ui::Text, slider: mut LocalSlider) {
  action.set_content(
    "Focused {slider.name} · Value {slider.value} · arrows adjust · R reset · 1-7 focus",
  )
  action.set_text_style(ui::text_style(foreground: slider.tint, bold: true))
}

private fn update_slider_from_mouse(slider: mut LocalSlider, received: mut cooper::MouseEvent) {
  let screen = slider.track.layout().screen
  if slider.orientation == SliderOrientation::horizontal {
    let position = clamp(received.x - screen.x, 0, screen.width - 1)
    slider.value = slider.minimum + position * (slider.maximum - slider.minimum) / clamp(screen.width - 1, 1, screen.width)
  } else {
    let position = clamp(received.y - screen.y, 0, screen.height - 1)
    slider.value = slider.maximum - position * (slider.maximum - slider.minimum) / clamp(screen.height - 1, 1, screen.height)
  }
  render_slider(slider)
}

private fn reset_sliders(sliders: [mut LocalSlider], action: mut ui::Text) {
  let defaults = [25, 100, 25, 0, 0, 50, 50]
  for slider, index in sliders {
    slider.value = defaults.at(index).expect("slider default")
    slider.direction = 1
    render_slider(slider)
  }
  action.set_content("*** All sliders reset to default values ***")
  action.set_text_style(ui::text_style(foreground: ui::hex("#FF00FF"), bold: true))
}

private fn make_slider_page(ctx: mut cooper::Runtime) SliderDemo {
  let root = ui::box(ctx, styles: slider_page_style(false))
  let horizontal = ui::box(
    ctx,
    styles: ui::style(
      width: ui::percent(64.0),
      height: ui::percent(100.0),
      gap: ui::cells(1),
      overflow: ui::Overflow::hidden,
    ),
  )
  let h1 = make_horizontal_slider(
    ctx,
    "H1",
    "1h×48w (0-50)",
    25,
    0,
    50,
    1,
    1,
    ui::hex("#E0AF68"),
  )
  let h2 = make_horizontal_slider(
    ctx,
    "H2",
    "3h×48w (0-200)",
    100,
    0,
    200,
    5,
    3,
    ui::hex("#BB9AF7"),
  )
  let h3 = make_horizontal_slider(
    ctx,
    "H3",
    "animated block cells",
    25,
    0,
    50,
    1,
    1,
    ui::hex("#FF6B6B"),
  )
  horizontal.add(h1.panel)
  horizontal.add(h2.panel)
  horizontal.add(h3.panel)

  let vertical = ui::box(
    ctx,
    styles: ui::style(
      width: ui::cells(1),
      height: ui::percent(100.0),
      flex_grow: 1.0,
      flex_shrink: 1.0,
      flex_direction: ui::FlexDirection::row,
      gap: ui::cells(1),
      overflow: ui::Overflow::hidden,
    ),
  )
  let v1 = make_vertical_slider(ctx, "V1", 7, 0, -10, 10, 1, 1, ui::hex("#F7768E"))
  let v2 = make_vertical_slider(ctx, "V2", 8, 0, -50, 50, 5, 3, ui::hex("#FF9E64"))
  let v3 = make_vertical_slider(ctx, "V3", 9, 50, 0, 100, 10, 5, ui::hex("#73DACA"))
  let va = make_vertical_slider(ctx, "VA", 7, 50, 0, 100, 2, 2, ui::hex("#FF6B6B"))
  vertical.add(v1.panel)
  vertical.add(v2.panel)
  vertical.add(v3.panel)
  vertical.add(va.panel)
  root.add(horizontal)
  root.add(vertical)
  SliderDemo{root: root, sliders: [h1, h2, h3, v1, v2, v3, va]}
}

private fn nav_style(active: Bool) ui::Style {
  mut background = ui::hex("#1E293B")
  if active {
    background = ui::hex("#3B82F6")
  }
  ui::style(
    background: background,
    width: ui::cells(18),
    height: ui::cells(1),
    flex_shrink: 0.0,
    align_items: ui::Align::center,
    justify_content: ui::Justify::center,
  )
}

private fn show_page(
  index: Int,
  state: mut ShellState,
  tab_demo: mut TabDemo,
  select_demo: mut SelectDemo,
  slider_page: mut ui::Box,
  sliders: [mut LocalSlider],
  nav: [mut ui::Box],
  action: mut ui::Text,
) {
  state.page = index
  tab_demo.root.set_style(tab_page_style(index == 0))
  select_demo.root.set_style(select_page_style(index == 1))
  slider_page.set_style(slider_page_style(index == 2))
  for button, button_index in nav {
    button.set_style(nav_style(button_index == index))
  }
  tab_demo.control.blur()
  select_demo.control.blur()
  for slider in sliders {
    slider.panel.blur()
  }
  match index {
    0 => {
      tab_demo.control.focus()
      action.set_content("TAB SELECT · Navigate, configure, and activate retained tabs")
      action.set_text_style(ui::text_style(foreground: ui::hex("#38BDF8"), bold: true))
    },
    1 => {
      select_demo.control.focus()
      action.set_content("SELECT · Compact input with anchored option menu")
      action.set_text_style(ui::text_style(foreground: ui::hex("#A78BFA"), bold: true))
    },
    _ => {
      sliders.at(0).expect("first slider").panel.focus()
      slider_action(action, sliders.at(0).expect("first slider"))
    },
  }
}

fn main() {
  let application = cooper::app().expect("create Cooper widget lab")
  defer application.destroy()
  let ctx = application.context

  let root = ui::box(
    ctx,
    styles: ui::style(
      background: ui::hex("#001122"),
      width: ui::percent(100.0),
      height: ui::percent(100.0),
      overflow: ui::Overflow::hidden,
    ),
  )
  let header = ui::box(
    ctx,
    styles: ui::style(
      background: ui::hex("#0F172A"),
      width: ui::percent(100.0),
      height: ui::cells(4),
      flex_shrink: 0.0,
      overflow: ui::Overflow::hidden,
    ),
  )
  header.add(
    ui::text(
      ctx,
      content: "WIDGET LAB — built-in Selects + app-local sliders",
      styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
      selectable: false,
      text_style: ui::text_style(foreground: ui::hex("#38BDF8"), bold: true),
    ),
  )
  let nav_row = ui::box(
    ctx,
    styles: ui::style(
      width: ui::percent(100.0),
      height: ui::cells(1),
      flex_shrink: 0.0,
      flex_direction: ui::FlexDirection::row,
      gap: ui::cells(1),
    ),
  )
  let nav: [mut ui::Box] = [
    ui::box(ctx, styles: nav_style(true)),
    ui::box(ctx, styles: nav_style(false)),
    ui::box(ctx, styles: nav_style(false)),
  ]
  let nav_labels = ["F1 TAB SELECT", "F2 SELECT", "F3 SLIDERS"]
  for button, index in nav {
    button.add(
      ui::text(
        ctx,
        content: nav_labels.at(index).expect("nav label"),
        selectable: false,
        text_style: ui::text_style(foreground: ui::hex("#FFFFFF"), bold: true),
      ),
    )
    nav_row.add(button)
  }
  header.add(nav_row)
  let action = ui::text(
    ctx,
    content: "",
    styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
    selectable: false,
    wrap: ui::TextWrap::none,
    overflow: ui::TextOverflow::ellipsis,
  )
  header.add(action)
  root.add(header)

  let body = ui::box(
    ctx,
    styles: ui::style(
      width: ui::percent(100.0),
      height: ui::cells(1),
      flex_grow: 1.0,
      flex_shrink: 1.0,
      overflow: ui::Overflow::hidden,
    ),
  )
  let tab_demo = make_tab_demo(ctx)
  let select_demo = make_select_demo(ctx)
  let slider_result = make_slider_page(ctx)
  let slider_page = slider_result.root
  let sliders = slider_result.sliders
  body.add(tab_demo.root)
  body.add(select_demo.root)
  body.add(slider_page)
  root.add(body)
  application.root.add(root)

  let state = mut ShellState{page: 0}

  let _ = tab_demo.control.on_focus(fn() {
    render_tabs(tab_demo)
  })
  let _ = tab_demo.control.on_blur(fn() {
    render_tabs(tab_demo)
  })
  let _ = tab_demo.control.on_highlight(fn(value: ui::SelectSelection) {
    render_tabs(tab_demo)
    action.set_content("TAB SELECT navigation moved to {value.option.label}")
  })
  let _ = tab_demo.control.on_change(fn(value: ui::SelectSelection) {
    render_tabs(tab_demo)
  })
  let _ = tab_demo.control.on_submit(fn(value: ui::SelectSelection) {
    render_tabs(tab_demo)
    action.set_content("TAB SELECT activated {value.option.label}")
  })

  let _ = select_demo.control.on_focus(fn() {
    render_select(select_demo)
  })
  let _ = select_demo.control.on_blur(fn() {
    render_select(select_demo)
  })
  let _ = select_demo.control.on_highlight(fn(value: ui::SelectSelection) {
    render_select(select_demo)
    action.set_content("SELECT navigation moved to {value.option.label}")
  })
  let _ = select_demo.control.on_change(fn(value: ui::SelectSelection) {
    render_select(select_demo)
  })
  let _ = select_demo.control.on_submit(fn(value: ui::SelectSelection) {
    render_select(select_demo)
    action.set_content("SELECT activated {value.option.label}")
  })

  for slider, index in sliders {
    let selected_index = index
    let target = slider
    let _ = slider.panel.on_focus(fn() {
      for candidate in sliders {
        render_slider(candidate)
      }
      slider_action(action, target)
    })
    let _ = slider.track.on_mouse(fn(received: mut cooper::MouseEvent) {
      if (received.event_type == cooper::MouseEventType::down or received.event_type == cooper::MouseEventType::drag) and received.button == cooper::MouseButton::left {
        target.panel.focus()
        update_slider_from_mouse(target, received)
        slider_action(action, target)
        received.stop_propagation()
      }
    })
  }

  for button, index in nav {
    let page_index = index
    let _ = button.on_mouse(fn(received: mut cooper::MouseEvent) {
      if received.event_type == cooper::MouseEventType::down and received.button == cooper::MouseButton::left {
        show_page(page_index, state, tab_demo, select_demo, slider_page, sliders, nav, action)
      }
    })
  }

  let _ = application.on_key(fn(received: mut cooper::KeyEvent) {
    if received.event_type == cooper::KeyEventType::press {
      mut handled = true
      if received.matches("f1") {
        show_page(0, state, tab_demo, select_demo, slider_page, sliders, nav, action)
      } else if received.matches("f2") {
        show_page(1, state, tab_demo, select_demo, slider_page, sliders, nav, action)
      } else if received.matches("f3") {
        show_page(2, state, tab_demo, select_demo, slider_page, sliders, nav, action)
      } else if state.page == 0 {
        if received.matches("f") {
          if tab_demo.control.is_focused() {
            tab_demo.control.blur()
          } else {
            tab_demo.control.focus()
          }
        } else if received.matches("u") {
          tab_demo.show_underline = not tab_demo.show_underline
          apply_tab_config(tab_demo)
          action.set_content("TAB SELECT toggled underline")
        } else if received.matches("p") {
          tab_demo.show_description = not tab_demo.show_description
          apply_tab_config(tab_demo)
          action.set_content("TAB SELECT toggled descriptions")
        } else if received.matches("s") {
          tab_demo.show_arrows = not tab_demo.show_arrows
          apply_tab_config(tab_demo)
          action.set_content("TAB SELECT toggled scroll arrows")
        } else if received.matches("w") {
          tab_demo.wrap = not tab_demo.wrap
          apply_tab_config(tab_demo)
          action.set_content("TAB SELECT toggled wrap selection")
        } else {
          handled = false
        }
      } else if state.page == 1 {
        if received.matches("f") {
          if select_demo.control.is_focused() {
            select_demo.control.blur()
          } else {
            select_demo.control.focus()
          }
        } else if received.matches("d") {
          select_demo.show_description = not select_demo.show_description
          apply_select_config(select_demo)
          action.set_content("SELECT toggled descriptions")
        } else if received.matches("s") {
          select_demo.show_indicator = not select_demo.show_indicator
          apply_select_config(select_demo)
          action.set_content("SELECT toggled scroll indicator")
        } else if received.matches("w") {
          select_demo.wrap = not select_demo.wrap
          apply_select_config(select_demo)
          action.set_content("SELECT toggled wrap selection")
        } else {
          handled = false
        }
      } else {
        mut slider_index = -1
        if received.matches("1") {
          slider_index = 0
        } else if received.matches("2") {
          slider_index = 1
        } else if received.matches("3") {
          slider_index = 2
        } else if received.matches("4") {
          slider_index = 3
        } else if received.matches("5") {
          slider_index = 4
        } else if received.matches("6") {
          slider_index = 5
        } else if received.matches("7") {
          slider_index = 6
        }
        if slider_index >= 0 {
          sliders.at(slider_index).expect("focused slider").panel.focus()
        } else if received.matches("r") {
          reset_sliders(sliders, action)
        } else {
          mut focused_index = -1
          for slider, index in sliders {
            if slider.panel.is_focused() {
              focused_index = index
            }
          }
          match sliders.at(focused_index) {
            slider => {
              if received.matches("right") or received.matches("up") {
                slider.value =+ slider.step
                render_slider(slider)
                slider_action(action, slider)
              } else if received.matches("left") or received.matches("down") {
                slider.value =- slider.step
                render_slider(slider)
                slider_action(action, slider)
              } else {
                handled = false
              }
            },
            _ => { handled = false },
          }
        }
      }
      if handled {
        received.prevent_default()
        received.stop_propagation()
      }
    }
  })

  render_tabs(tab_demo)
  render_select(select_demo)
  show_page(0, state, tab_demo, select_demo, slider_page, sliders, nav, action)

  let cancellation = ctx.cancellation
  let dispatch = ctx.dispatch
  let animate = fn() {
    if state.page == 2 {
      for index in [2, 6] {
        let slider = sliders.at(index).expect("animated slider")
        slider.value = slider.value + slider.direction * slider.step
        if slider.value >= slider.maximum {
          slider.value = slider.maximum
          slider.direction = -1
        } else if slider.value <= slider.minimum {
          slider.value = slider.minimum
          slider.direction = 1
        }
        render_slider(slider)
      }
    }
  }
  async::start(fn() {
    mut running = true
    while running {
      select {
        cancellation.recv() => { running = false },
        time::After(120 * time::Millisecond).recv() => {
          if dispatch(animate).is_err() {
            running = false
          }
        },
      }
    }
  })

  application.run().expect("run Cooper widget lab")
}
