struct Choice {
  name: Str,
  description: Str,
  value: Str,
}

struct ShellState {
  page: Int,
}

struct TabDemo {
  root: mut box::Box,
  control: mut box::Box,
  tabs: mut text::Text,
  description: mut text::Text,
  status: mut text::Text,
  options: [Choice],
  highlighted: Int,
  activated: Int,
  offset: Int,
  focused: Bool,
  show_underline: Bool,
  show_description: Bool,
  show_arrows: Bool,
  wrap: Bool,
}

struct SelectRow {
  panel: mut box::Box,
  name: mut text::Text,
  description: mut text::Text,
}

struct SelectDemo {
  root: mut box::Box,
  viewport: mut scroll_box::ScrollBox,
  indicator: mut text::Text,
  status: mut text::Text,
  rows: [mut SelectRow],
  options: [Choice],
  highlighted: Int,
  activated: Int,
  focused: Bool,
  show_description: Bool,
  show_indicator: Bool,
  wrap: Bool,
}

enum SliderOrientation {
  horizontal,
  vertical,
}

struct SliderDemo {
  root: mut box::Box,
  sliders: [mut LocalSlider],
}

struct LocalSlider {
  name: Str,
  panel: mut box::Box,
  track: mut text::Text,
  value_label: mut text::Text,
  orientation: SliderOrientation,
  minimum: Int,
  maximum: Int,
  value: Int,
  step: Int,
  thickness: Int,
  track_width: Int,
  tint: color::Color,
  direction: Int,
}

private fn clamp(value: Int, minimum: Int, maximum: Int) Int {
  if value < minimum {
    minimum
  } else if value > maximum {
    maximum
  } else {
    value
  }
}

private fn visible(show: Bool) style::Display {
  if show {
    style::Display::flex
  } else {
    style::Display::none
  }
}

