use ard/async

use cooper
use cooper/ui
use go:strings
use go:time

struct Choice {
  name: Str,
  description: Str,
  value: Str,
}

struct ShellState {
  page: Int,
}

struct TabDemo {
  root: mut ui::Box,
  control: mut ui::Select,
  status: mut ui::Text,
  show_underline: Bool,
  show_description: Bool,
  show_arrows: Bool,
  wrap: Bool,
}

struct SelectDemo {
  root: mut ui::Box,
  control: mut ui::Select,
  status: mut ui::Text,
  show_description: Bool,
  show_indicator: Bool,
  wrap: Bool,
}

enum SliderOrientation {
  horizontal,
  vertical,
}

struct SliderDemo {
  root: mut ui::Box,
  sliders: [mut LocalSlider],
}

struct LocalSlider {
  name: Str,
  panel: mut ui::Box,
  track: mut ui::Text,
  value_label: mut ui::Text,
  orientation: SliderOrientation,
  minimum: Int,
  maximum: Int,
  value: Int,
  step: Int,
  thickness: Int,
  track_width: Int,
  tint: ui::Color,
  direction: Int,
}

private fn clamp(value: Int, minimum: Int, maximum: Int) Int {
  if value < minimum {
    minimum
  } else if value > maximum {
    maximum
  } else {
    value
  }
}

private fn visible(show: Bool) ui::Display {
  if show {
    ui::Display::flex
  } else {
    ui::Display::none
  }
}

