      flex_direction: ui::FlexDirection::row,
      gap: ui::cells(1),
      overflow: ui::Overflow::hidden,
    ),
  )
  let legend_panel = ui::box(
    ctx,
    title: "KEY CONTROLS",
    styles: ui::style(
      border: ui::Border::single,
      border_color: ui::hex("#475569"),
      width: ui::percent(42.0),
      height: ui::percent(100.0),
      overflow: ui::Overflow::hidden,
    ),
  )
  legend_panel.add(
    ui::text(
      ctx,
      content: "←/→ or [/]: Navigate tabs\nEnter: Select tab\nF: Toggle focus\nU: Toggle underline\nP: Toggle description\nS: Toggle scroll arrows\nW: Toggle wrap selection",
      selectable: false,
      text_style: ui::text_style(foreground: ui::hex("#AAAAAA")),
    ),
  )
  let status_panel = ui::box(
    ctx,
    title: "STATUS",
    styles: ui::style(
      border: ui::Border::single,
      border_color: ui::hex("#475569"),
      width: ui::cells(1),
      height: ui::percent(100.0),
      flex_grow: 1.0,
      flex_shrink: 1.0,
      overflow: ui::Overflow::hidden,
    ),
  )
  let status = ui::text(
    ctx,
    content: "",
    styles: ui::style(width: ui::percent(100.0), height: ui::percent(100.0)),
    selectable: false,
  )
  status_panel.add(status)
  details.add(legend_panel)
  details.add(status_panel)
  root.add(details)

  (mut TabDemo{
    root: root,
    control: control,
    status: status,
    show_underline: true,
    show_description: true,
    show_arrows: true,
    wrap: false,
  })
}

