    ctx,
    content: "",
    styles: style::new(width: style::percent(100.0), height: style::cells(1), flex_shrink: 0.0),
    selectable: false,
    wrap: text::TextWrap::none,
    overflow: text::TextOverflow::ellipsis,
    text_style: text::style(foreground: color::hex("#CBD5E1")),
  )
  control.add(tabs)
  control.add(description)
  root.add(control)

  let details = box::new(
