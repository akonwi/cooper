private fn horizontal_padding() ui::Edges {
  let padding = mut ui::edges()
  padding.left = ui::cells(1)
  padding.right = ui::cells(1)
  padding.@
}

private fn padded(value: Str, width: Int) Str {
  if value.size() >= width {
    value
  } else {
    "{value}{strings::Repeat(" ", width - value.size())}"
  }
}

private fn tab_page_style(show: Bool) ui::Style {
  ui::style(
    display: visible(show),
    background: ui::hex("#001122"),
    width: ui::percent(100.0),
    height: ui::percent(100.0),
    flex_direction: ui::FlexDirection::column,
    align_items: ui::Align::center,
    gap: ui::cells(1),
    overflow: ui::Overflow::hidden,
  )
}

private fn control_options(values: [Choice]) [ui::SelectOption] {
  let options = mut List::new<ui::SelectOption>()
  for value in values {
    options.push(
      ui::select_option(value.name, description: value.description, value: value.value),
    )
  }
  options.@
}

private fn widget_appearance() ui::SelectAppearance {
  ui::select_appearance(
    normal: ui::span_style(foreground: ui::hex("#E2E8F0")),
    description: ui::span_style(foreground: ui::hex("#94A3B8")),
    highlighted: ui::span_style(
      foreground: ui::hex("#FFFFFF"),
      background: ui::hex("#2D3748"),
      bold: true,
    ),
    selected: ui::span_style(
      foreground: ui::hex("#FFFFFF"),
      background: ui::hex("#3B82F6"),
      reverse: false,
      bold: true,
    ),
    selected_description: ui::span_style(foreground: ui::hex("#DBEAFE")),
    indicator: ui::span_style(foreground: ui::hex("#94A3B8"), bold: true),
  )
}

private fn render_tabs(demo: mut TabDemo) {
  let highlighted = try demo.control.highlighted() -> _ { () }
  mut selected = "No item selected yet (press Enter to select)"
  match demo.control.selected() {
    active => { selected = "Last Selected: {active.option.label} ({active.option.value.or("")})" },
    _ => (),
  }
  mut focus_text = "Tab selector is BLURRED"
  mut focus_color = ui::hex("#FF0000")
  if demo.control.is_focused() {
    focus_text = "Tab selector is FOCUSED"
    focus_color = ui::hex("#00FF00")
  }
  mut underline_text = "off"
  if demo.show_underline {
    underline_text = "on"
  }
  mut description_text = "off"
  mut description_notice = "Descriptions hidden — press P\n"
  if demo.show_description {
    description_text = "on"
    description_notice = ""
  }
  mut arrows_text = "off"
  if demo.show_arrows {
    arrows_text = "on"
  }
  mut wrap_text = "off"
  if demo.wrap {
    wrap_text = "on"
  }
  demo.status.set_content(
    ui::styled_text(
      [
        ui::span(
          "Highlighted: {highlighted.option.label} ({highlighted.option.value.or("")}) - Index: {highlighted.index}\n",
          style: ui::span_style(foreground: ui::hex("#00FF00")),
        ),
        ui::span("{selected}\n", style: ui::span_style(foreground: ui::hex("#FFFF00"))),
        ui::span("{description_notice}", style: ui::span_style(foreground: ui::hex("#CBD5E1"))),
        ui::span("{focus_text}\n", style: ui::span_style(foreground: focus_color)),
        ui::span(
          "Underline: {underline_text} | Description: {description_text} | Scroll arrows: {arrows_text} | Wrap: {wrap_text}",
          style: ui::span_style(foreground: ui::hex("#CCCCCC")),
        ),
      ],
    ),
  )
}

private fn apply_tab_config(demo: mut TabDemo) {
  demo.control.set_tab_config(
    ui::select_tab_config(
      tab_width: 12,
      show_description: demo.show_description,
      show_underline: demo.show_underline,
      show_arrows: demo.show_arrows,
      wrap_selection: demo.wrap,
    ),
  )
  render_tabs(demo)
}

