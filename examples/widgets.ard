  let root = box::new(ctx, styles: tab_page_style(true))
  let control = box::new(
    ctx,
    title: "TAB SELECT",
    styles: style::new(
      background: color::hex("#1E293B"),
      border: style::Border::rounded,
      border_color: color::hex("#3B82F6"),
      width: style::percent(100.0),
      max_width: style::cells(72),
      height: style::cells(6),
