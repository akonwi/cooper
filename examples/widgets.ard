      border: style::Border::single,
      border_color: color::hex("#475569"),
      width: style::percent(42.0),
      height: style::percent(100.0),
      overflow: style::Overflow::hidden,
    ),
  )
  legend_panel.add(
    text::new(
      ctx,
      content: "←/→ or [/]: Navigate tabs\nEnter: Select tab\nF: Toggle focus\nU: Toggle underline\nP: Toggle description\nS: Toggle scroll arrows\nW: Toggle wrap selection",
