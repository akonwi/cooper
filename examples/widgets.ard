private fn select_page_style(show: Bool) style::Style {
  style::new(
    display: visible(show),
    background: color::hex("#001122"),
    width: style::percent(100.0),
    height: style::percent(100.0),
    flex_direction: style::FlexDirection::row,
    gap: style::cells(1),
    overflow: style::Overflow::hidden,
  )
}

private fn select_row_style(highlighted: Bool, activated: Bool, focused: Bool, description: Bool) style::Style {
  mut background = color::hex("#1E293B")
  mut height = 2
  if description {
    height = 3
  }
  if highlighted and focused {
    background = color::hex("#2D3748")
  }
  if activated {
    background = color::hex("#3B82F6")
  }
  style::new(
    background: background,
    width: style::percent(100.0),
    height: style::cells(height),
    flex_shrink: 0.0,
    padding: horizontal_padding(),
    overflow: style::Overflow::hidden,
  )
}

private fn select_indicator(index: Int, count: Int) Str {
  mut rendered = "▲\n"
  let thumb = index * 7 / (count - 1)
  mut row = 0
  while row < 8 {
    if row == thumb {
      rendered = "{rendered}█"
    } else {
      rendered = "{rendered}│"
    }
    if row < 7 {
      rendered = "{rendered}\n"
    }
    row =+ 1
  }
  "{rendered}\n▼"
}

private fn render_select(demo: mut SelectDemo) {
  for row, index in demo.rows {
    let highlighted = index == demo.highlighted
    let activated = index == demo.activated
    row.panel.set_style(
      select_row_style(highlighted, activated, demo.focused, demo.show_description),
    )
    mut marker = "  "
    mut foreground = color::hex("#E2E8F0")
    if highlighted {
      marker = "▶ "
    }
    if activated or highlighted {
      foreground = color::hex("#FFFFFF")
    }
    row.name.set_content("{marker}{demo.options.at(index).expect("row option").name}")
    row.name.set_text_style(text::style(foreground: foreground, bold: highlighted))
    row.description.set_style(
      style::new(
        display: visible(demo.show_description),
        width: style::percent(100.0),
        height: style::cells(1),
        flex_shrink: 0.0,
      ),
    )
  }
  demo.indicator.set_content(select_indicator(demo.highlighted, demo.options.size()))
  demo.indicator.set_style(
    style::new(
      display: visible(demo.show_indicator),
      width: style::cells(1),
      height: style::percent(100.0),
      flex_shrink: 0.0,
    ),
  )
  let option = demo.options.at(demo.highlighted).expect("highlighted option")
  mut selected = "No item activated yet"
  match demo.options.at(demo.activated) {
    active => { selected = "*** ACTIVATED: {active.name} ({active.value}) ***" },
    _ => (),
  }
  mut focus_text = "Select element is BLURRED"
  mut focus_color = color::hex("#FF0000")
  if demo.focused {
    focus_text = "Select element is FOCUSED"
    focus_color = color::hex("#00FF00")
  }
  mut description_text = "off"
  if demo.show_description {
    description_text = "on"
  }
  mut indicator_text = "off"
  if demo.show_indicator {
    indicator_text = "on"
  }
  mut wrap_text = "off"
  if demo.wrap {
    wrap_text = "on"
  }
  demo.status.set_content(
    text::styled_text(
      [
        text::span(
          "Selection: {option.name} ({option.value}) - Index: {demo.highlighted}\n",
          style: text::span_style(foreground: color::hex("#00FF00")),
        ),
        text::span("{focus_text}\n", style: text::span_style(foreground: focus_color)),
        text::span(
          "Indicator: {indicator_text} | Description: {description_text} | Wrap: {wrap_text}\n",
          style: text::span_style(foreground: color::hex("#CCCCCC")),
        ),
        text::span("{selected}", style: text::span_style(foreground: color::hex("#FF00FF"), bold: true)),
      ],
    ),
  )
  match demo.rows.at(demo.highlighted) {
    row => {
      let _ = demo.viewport.scroll_child_into_view(row.panel)
    },
    _ => (),
  }
}

private fn pin_select(demo: mut SelectDemo) {
  mut row_height = 2
  if demo.show_description {
    row_height = 3
  }
  let _ = demo.viewport.scroll_to(demo.highlighted * row_height)
}

private fn move_select(demo: mut SelectDemo, delta: Int) {
  mut next = demo.highlighted + delta
  if demo.wrap {
    while next < 0 {
      next =+ demo.options.size()
    }
    next = next % demo.options.size()
  } else {
    next = clamp(next, 0, demo.options.size() - 1)
  }
  demo.highlighted = next
  render_select(demo)
}

private fn make_select_demo(ctx: mut context::Context) mut SelectDemo {
  let root = box::new(ctx, styles: select_page_style(false))
  let list_panel = box::new(
    ctx,
    title: "SELECT",
    styles: style::new(
      border: style::Border::rounded,
      border_color: color::hex("#3B82F6"),
      position: style::Position::relative,
      width: style::percent(56.0),
      height: style::percent(100.0),
      padding: style::edges(style::cells(1)),
      flex_direction: style::FlexDirection::row,
      overflow: style::Overflow::hidden,
    ),
  )
  let viewport = scroll_box::new(
    ctx,
    styles: style::new(
      width: style::cells(1),
      height: style::percent(100.0),
      flex_grow: 1.0,
      flex_shrink: 1.0,
    ),
  )
  let indicator = text::new(
    ctx,
    content: "",
    styles: style::new(width: style::cells(1), height: style::percent(100.0), flex_shrink: 0.0),
    selectable: false,
    text_style: text::style(foreground: color::hex("#94A3B8")),
  )
  list_panel.add(viewport)
  list_panel.add(indicator)
  root.add(list_panel)

  let side = box::new(
    ctx,
    styles: style::new(
      width: style::cells(1),
      height: style::percent(100.0),
      flex_grow: 1.0,
      flex_shrink: 1.0,
      gap: style::cells(1),
      overflow: style::Overflow::hidden,
    ),
  )
  let legend = box::new(
    ctx,
    title: "KEY CONTROLS",
    styles: style::new(
      border: style::Border::single,
      border_color: color::hex("#475569"),
      width: style::percent(100.0),
      height: style::cells(10),
      flex_shrink: 0.0,
      padding: style::edges(style::cells(1)),
      overflow: style::Overflow::hidden,
    ),
  )
  legend.add(
    text::new(
      ctx,
      content: "↑/↓ or j/k: Navigate items\nShift+↑/↓ or J/K: Fast scroll\nEnter: Select item\nF: Toggle focus\nD: Toggle descriptions\nS: Toggle scroll indicator\nW: Toggle wrap selection",
      selectable: false,
      text_style: text::style(foreground: color::hex("#AAAAAA")),
    ),
  )
  let status_panel = box::new(
    ctx,
    title: "STATUS",
    styles: style::new(
      border: style::Border::single,
      border_color: color::hex("#475569"),
      width: style::percent(100.0),
      height: style::cells(1),
      flex_grow: 1.0,
      flex_shrink: 1.0,
      overflow: style::Overflow::hidden,
    ),
  )
  let status = text::new(
    ctx,
    content: "",
    styles: style::new(width: style::percent(100.0), height: style::percent(100.0)),
    selectable: false,
  )
  status_panel.add(status)
  side.add(legend)
  side.add(status_panel)
  root.add(side)

  let rows = mut List::new<mut SelectRow>()
  for option in select_options() {
    let panel = box::new(ctx, styles: select_row_style(false, false, false, true))
    let name = text::new(
      ctx,
      content: option.name,
      styles: style::new(width: style::percent(100.0), height: style::cells(1), flex_shrink: 0.0),
      selectable: false,
    )
    let description = text::new(
      ctx,
      content: option.description,
      styles: style::new(width: style::percent(100.0), height: style::cells(1), flex_shrink: 0.0),
      selectable: false,
      wrap: text::TextWrap::none,
      overflow: text::TextOverflow::ellipsis,
      text_style: text::style(foreground: color::hex("#94A3B8")),
    )
    panel.add(name)
    panel.add(description)
    viewport.add(panel)
    let row = mut SelectRow{
      panel: panel,
      name: name,
      description: description,
    }
    rows.push(row)
  }

  let demo = mut SelectDemo{
    root: root,
    viewport: viewport,
    indicator: indicator,
    status: status,
    rows: rows.@,
    options: select_options(),
    highlighted: 0,
    activated: -1,
    focused: false,
    show_description: true,
    show_indicator: true,
    wrap: false,
  }
  demo
}

private fn slider_page_style(show: Bool) style::Style {
  style::new(
    display: visible(show),
    background: color::hex("#1A1B26"),
    width: style::percent(100.0),
    height: style::percent(100.0),
    flex_direction: style::FlexDirection::row,
    gap: style::cells(1),
    overflow: style::Overflow::hidden,
  )
}

private fn horizontal_bar(slider: mut LocalSlider) Str {
  let width = 48
  let filled = (slider.value - slider.minimum) * (width - 1) / (slider.maximum - slider.minimum)
  let line = "{strings::Repeat("█", filled)}●{strings::Repeat("░", width - filled - 1)}"
  mut rendered = line
  mut row = 1
  while row < slider.thickness {
    rendered = "{rendered}\n{line}"
    row =+ 1
  }
  rendered
}

private fn vertical_bar(slider: mut LocalSlider) Str {
  let rows = 12
  let filled = (slider.value - slider.minimum) * rows / (slider.maximum - slider.minimum)
  mut rendered = ""
  mut row = 0
  while row < rows {
    mut glyph = "░"
    if row >= rows - filled {
      glyph = "█"
    }
    rendered = "{rendered}{strings::Repeat(glyph, slider.track_width)}"
    if row < rows - 1 {
      rendered = "{rendered}\n"
    }
    row =+ 1
  }
  rendered
}

private fn render_slider(slider: mut LocalSlider) {
  slider.value = clamp(slider.value, slider.minimum, slider.maximum)
  slider.value_label.set_content("{slider.value}")
  if slider.orientation == SliderOrientation::horizontal {
    slider.track.set_content(horizontal_bar(slider))
  } else {
    slider.track.set_content(vertical_bar(slider))
  }
  if slider.panel.is_focused() {
    slider.panel.set_border_color(color::hex("#FFFFFF"))
  } else {
    slider.panel.set_border_color(slider.tint)
  }
}

private fn make_horizontal_slider(
  ctx: mut context::Context,
  name: Str,
  detail: Str,
  value: Int,
  minimum: Int,
  maximum: Int,
  step: Int,
  thickness: Int,
  tint: color::Color,
) mut LocalSlider {
  let panel = box::new(
    ctx,
    styles: style::new(
      background: color::hex("#24283B"),
      border: style::Border::single,
      border_color: tint,
      width: style::percent(100.0),
      height: style::cells(thickness + 4),
      flex_shrink: 0.0,
      padding: horizontal_padding(),
      overflow: style::Overflow::hidden,
    ),
  )
  panel.set_focusable(true)
  let label = text::new(
    ctx,
    content: text::styled_text(
      [
        text::span(name, style: text::span_style(foreground: tint, bold: true)),
        text::span(" - {detail}", style: text::span_style(foreground: color::hex("#565F89"))),
      ],
    ),
    styles: style::new(width: style::percent(100.0), height: style::cells(1), flex_shrink: 0.0),
    selectable: false,
  )
  let value_label = text::new(
    ctx,
    content: "",
    styles: style::new(width: style::percent(100.0), height: style::cells(1), flex_shrink: 0.0),
    selectable: false,
    text_style: text::style(foreground: tint, bold: true),
  )
  let track = text::new(
    ctx,
    content: "",
    styles: style::new(
      width: style::cells(48),
      height: style::cells(thickness),
      flex_shrink: 0.0,
      overflow: style::Overflow::hidden,
    ),
    selectable: false,
    overflow: text::TextOverflow::clip,
    text_style: text::style(foreground: tint),
  )
  panel.add(label)
  panel.add(value_label)
  panel.add(track)
  let slider = mut LocalSlider{
    name: name,
    panel: panel,
    track: track,
    value_label: value_label,
    orientation: SliderOrientation::horizontal,
    minimum: minimum,
    maximum: maximum,
    value: value,
    step: step,
    thickness: thickness,
    track_width: 48,
    tint: tint,
    direction: 1,
  }
  render_slider(slider)
  slider
}

private fn make_vertical_slider(
  ctx: mut context::Context,
  name: Str,
  width: Int,
  value: Int,
  minimum: Int,
  maximum: Int,
  step: Int,
  track_width: Int,
  tint: color::Color,
) mut LocalSlider {
  let panel = box::new(
    ctx,
    styles: style::new(
      background: color::hex("#24283B"),
      border: style::Border::single,
      border_color: tint,
      width: style::cells(width),
      height: style::percent(100.0),
      flex_shrink: 0.0,
      align_items: style::Align::center,
      overflow: style::Overflow::hidden,
    ),
  )
  panel.set_focusable(true)
  let label = text::new(
    ctx,
    content: name,
    styles: style::new(width: style::percent(100.0), height: style::cells(1), flex_shrink: 0.0),
    selectable: false,
    text_style: text::style(foreground: tint, bold: true),
  )
  let track = text::new(
    ctx,
    content: "",
    styles: style::new(
      width: style::cells(track_width),
      height: style::cells(12),
      flex_shrink: 0.0,
      overflow: style::Overflow::hidden,
    ),
    selectable: false,
    overflow: text::TextOverflow::clip,
    text_style: text::style(foreground: tint),
  )
  let value_label = text::new(
    ctx,
    content: "",
    styles: style::new(width: style::percent(100.0), height: style::cells(1), flex_shrink: 0.0),
    selectable: false,
    text_style: text::style(foreground: tint, bold: true),
  )
  panel.add(label)
  panel.add(track)
  panel.add(value_label)
  let slider = mut LocalSlider{
    name: name,
    panel: panel,
    track: track,
    value_label: value_label,
    orientation: SliderOrientation::vertical,
    minimum: minimum,
    maximum: maximum,
    value: value,
    step: step,
    thickness: 1,
    track_width: track_width,
    tint: tint,
    direction: 1,
  }
  render_slider(slider)
  slider
}

private fn slider_action(action: mut text::Text, slider: mut LocalSlider) {
  action.set_content(
    "Focused {slider.name} · Value {slider.value} · arrows adjust · R reset · 1-7 focus",
  )
  action.set_text_style(text::style(foreground: slider.tint, bold: true))
}

private fn update_slider_from_mouse(slider: mut LocalSlider, received: mut event::MouseEvent) {
  let screen = slider.track.layout().screen
  if slider.orientation == SliderOrientation::horizontal {
    let position = clamp(received.x - screen.x, 0, screen.width - 1)
    slider.value = slider.minimum + position * (slider.maximum - slider.minimum) / clamp(screen.width - 1, 1, screen.width)
  } else {
    let position = clamp(received.y - screen.y, 0, screen.height - 1)
    slider.value = slider.maximum - position * (slider.maximum - slider.minimum) / clamp(screen.height - 1, 1, screen.height)
  }
  render_slider(slider)
}

private fn reset_sliders(sliders: [mut LocalSlider], action: mut text::Text) {
  let defaults = [25, 100, 25, 0, 0, 50, 50]
  for slider, index in sliders {
    slider.value = defaults.at(index).expect("slider default")
    slider.direction = 1
    render_slider(slider)
  }
  action.set_content("*** All sliders reset to default values ***")
  action.set_text_style(text::style(foreground: color::hex("#FF00FF"), bold: true))
}

private fn make_slider_page(ctx: mut context::Context) SliderDemo {
  let root = box::new(ctx, styles: slider_page_style(false))
  let horizontal = box::new(
    ctx,
    styles: style::new(
      width: style::percent(64.0),
      height: style::percent(100.0),
      gap: style::cells(1),
      overflow: style::Overflow::hidden,
    ),
  )
  let h1 = make_horizontal_slider(
    ctx,
    "H1",
    "1h×48w (0-50)",
    25,
    0,
    50,
    1,
    1,
    color::hex("#E0AF68"),
  )
  let h2 = make_horizontal_slider(
    ctx,
    "H2",
    "3h×48w (0-200)",
    100,
    0,
    200,
    5,
    3,
    color::hex("#BB9AF7"),
  )
  let h3 = make_horizontal_slider(
    ctx,
    "H3",
    "animated block cells",
    25,
    0,
    50,
    1,
    1,
    color::hex("#FF6B6B"),
  )
  horizontal.add(h1.panel)
  horizontal.add(h2.panel)
  horizontal.add(h3.panel)

  let vertical = box::new(
    ctx,
    styles: style::new(
      width: style::cells(1),
      height: style::percent(100.0),
      flex_grow: 1.0,
      flex_shrink: 1.0,
      flex_direction: style::FlexDirection::row,
      gap: style::cells(1),
      overflow: style::Overflow::hidden,
    ),
  )
  let v1 = make_vertical_slider(ctx, "V1", 7, 0, -10, 10, 1, 1, color::hex("#F7768E"))
  let v2 = make_vertical_slider(ctx, "V2", 8, 0, -50, 50, 5, 3, color::hex("#FF9E64"))
  let v3 = make_vertical_slider(ctx, "V3", 9, 50, 0, 100, 10, 5, color::hex("#73DACA"))
  let va = make_vertical_slider(ctx, "VA", 7, 50, 0, 100, 2, 2, color::hex("#FF6B6B"))
  vertical.add(v1.panel)
  vertical.add(v2.panel)
  vertical.add(v3.panel)
  vertical.add(va.panel)
  root.add(horizontal)
  root.add(vertical)
  SliderDemo{root: root, sliders: [h1, h2, h3, v1, v2, v3, va]}
}

private fn nav_style(active: Bool) style::Style {
  mut background = color::hex("#1E293B")
  if active {
    background = color::hex("#3B82F6")
  }
  style::new(
    background: background,
    width: style::cells(18),
    height: style::cells(1),
    flex_shrink: 0.0,
    align_items: style::Align::center,
    justify_content: style::Justify::center,
  )
}

private fn show_page(
  index: Int,
  state: mut ShellState,
  tab_demo: mut TabDemo,
  select_demo: mut SelectDemo,
  slider_page: mut box::Box,
  sliders: [mut LocalSlider],
  nav: [mut box::Box],
  action: mut text::Text,
) {
  state.page = index
  tab_demo.root.set_style(tab_page_style(index == 0))
  select_demo.root.set_style(select_page_style(index == 1))
  slider_page.set_style(slider_page_style(index == 2))
  for button, button_index in nav {
    button.set_style(nav_style(button_index == index))
  }
  tab_demo.control.blur()
  select_demo.viewport.blur()
  for slider in sliders {
    slider.panel.blur()
  }
  match index {
    0 => {
      tab_demo.control.focus()
      action.set_content("TAB SELECT · Navigate, configure, and activate retained tabs")
      action.set_text_style(text::style(foreground: color::hex("#38BDF8"), bold: true))
    },
    1 => {
      select_demo.viewport.focus()
      pin_select(select_demo)
      action.set_content(
        "SELECT LIST · Navigate 20 options; highlight and activation stay distinct",
      )
      action.set_text_style(text::style(foreground: color::hex("#A78BFA"), bold: true))
    },
    _ => {
      sliders.at(0).expect("first slider").panel.focus()
      slider_action(action, sliders.at(0).expect("first slider"))
    },
  }
}

fn main() {
  let application = app::new().expect("create Cooper widget lab")
  defer application.destroy()
  let ctx = application.context

  let root = box::new(
    ctx,
    styles: style::new(
      background: color::hex("#001122"),
      width: style::percent(100.0),
      height: style::percent(100.0),
      overflow: style::Overflow::hidden,
    ),
  )
  let header = box::new(
    ctx,
    styles: style::new(
      background: color::hex("#0F172A"),
      width: style::percent(100.0),
      height: style::cells(4),
      flex_shrink: 0.0,
      overflow: style::Overflow::hidden,
    ),
  )
  header.add(
    text::new(
      ctx,
      content: "WIDGET LAB — app-local controls composed from Box + Text",
      styles: style::new(width: style::percent(100.0), height: style::cells(1), flex_shrink: 0.0),
      selectable: false,
      text_style: text::style(foreground: color::hex("#38BDF8"), bold: true),
    ),
  )
  let nav_row = box::new(
    ctx,
    styles: style::new(
      width: style::percent(100.0),
      height: style::cells(1),
      flex_shrink: 0.0,
      flex_direction: style::FlexDirection::row,
      gap: style::cells(1),
    ),
  )
  let nav: [mut box::Box] = [
    box::new(ctx, styles: nav_style(true)),
    box::new(ctx, styles: nav_style(false)),
    box::new(ctx, styles: nav_style(false)),
  ]
  let nav_labels = ["F1 TAB SELECT", "F2 SELECT LIST", "F3 SLIDERS"]
  for button, index in nav {
    button.add(
      text::new(
        ctx,
        content: nav_labels.at(index).expect("nav label"),
        selectable: false,
        text_style: text::style(foreground: color::hex("#FFFFFF"), bold: true),
      ),
    )
    nav_row.add(button)
  }
  header.add(nav_row)
  let action = text::new(
    ctx,
    content: "",
    styles: style::new(width: style::percent(100.0), height: style::cells(1), flex_shrink: 0.0),
    selectable: false,
    wrap: text::TextWrap::none,
    overflow: text::TextOverflow::ellipsis,
  )
  header.add(action)
  root.add(header)

  let body = box::new(
    ctx,
    styles: style::new(
      width: style::percent(100.0),
      height: style::cells(1),
      flex_grow: 1.0,
      flex_shrink: 1.0,
      overflow: style::Overflow::hidden,
    ),
  )
  let tab_demo = make_tab_demo(ctx)
  let select_demo = make_select_demo(ctx)
  let slider_result = make_slider_page(ctx)
  let slider_page = slider_result.root
  let sliders = slider_result.sliders
  body.add(tab_demo.root)
  body.add(select_demo.root)
  body.add(slider_page)
  root.add(body)
  application.root.add(root)

  let state = mut ShellState{page: 0}

  let _ = tab_demo.control.on_focus(fn() {
    tab_demo.focused = true
    render_tabs(tab_demo)
  })
  let _ = tab_demo.control.on_blur(fn() {
    tab_demo.focused = false
    render_tabs(tab_demo)
  })
  let _ = tab_demo.tabs.on_mouse(fn(received: mut event::MouseEvent) {
    if received.event_type == event::MouseEventType::down and received.button == event::MouseButton::left {
      let slot = (received.local_x - 2) / 12
      if received.local_x >= 2 and slot >= 0 and slot < 5 {
        let selected = tab_demo.offset + slot
        if selected < tab_demo.options.size() {
          tab_demo.highlighted = selected
          tab_demo.activated = selected
          tab_demo.control.focus()
          render_tabs(tab_demo)
          action.set_content(
            "TAB SELECT activated {tab_demo.options.at(selected).expect("clicked tab").name}",
          )
        }
      }
    }
  })

  let _ = select_demo.viewport.on_focus(fn() {
    select_demo.focused = true
    render_select(select_demo)
  })
  let _ = select_demo.viewport.on_blur(fn() {
    select_demo.focused = false
    render_select(select_demo)
  })
  let _ = select_demo.viewport.on_mouse(fn(received: mut event::MouseEvent) {
    if received.event_type == event::MouseEventType::scroll and received.scroll_y != 0 {
      mut delta = 1
      if received.scroll_y < 0 {
        delta = -1
      }
      let _ = ctx.dispatch(fn() {
        move_select(select_demo, delta)
        action.set_content(
          "SELECT navigation moved to {select_demo.options.at(select_demo.highlighted).expect("wheel option").name}",
        )
      })
    }
  })
  for row, index in select_demo.rows {
    let selected_index = index
    let _ = row.panel.on_mouse(fn(received: mut event::MouseEvent) {
      if received.event_type == event::MouseEventType::down and received.button == event::MouseButton::left {
        select_demo.highlighted = selected_index
        select_demo.activated = selected_index
        select_demo.viewport.focus()
        render_select(select_demo)
        action.set_content(
          "SELECT activated {select_demo.options.at(selected_index).expect("clicked option").name}",
        )
      }
    })
  }

  for slider, index in sliders {
    let selected_index = index
    let target = slider
    let _ = slider.panel.on_focus(fn() {
      for candidate in sliders {
        render_slider(candidate)
      }
      slider_action(action, target)
    })
    let _ = slider.track.on_mouse(fn(received: mut event::MouseEvent) {
      if (received.event_type == event::MouseEventType::down or received.event_type == event::MouseEventType::drag) and received.button == event::MouseButton::left {
        target.panel.focus()
        update_slider_from_mouse(target, received)
        slider_action(action, target)
        received.stop_propagation()
      }
    })
  }

  for button, index in nav {
    let page_index = index
    let _ = button.on_mouse(fn(received: mut event::MouseEvent) {
      if received.event_type == event::MouseEventType::down and received.button == event::MouseButton::left {
        show_page(page_index, state, tab_demo, select_demo, slider_page, sliders, nav, action)
      }
    })
  }

  let _ = application.on_key(fn(received: mut event::KeyEvent) {
    if received.event_type == event::KeyEventType::press {
      mut handled = true
      if received.matches("f1") {
        show_page(0, state, tab_demo, select_demo, slider_page, sliders, nav, action)
      } else if received.matches("f2") {
        show_page(1, state, tab_demo, select_demo, slider_page, sliders, nav, action)
      } else if received.matches("f3") {
        show_page(2, state, tab_demo, select_demo, slider_page, sliders, nav, action)
      } else if state.page == 0 {
        if received.matches("f") {
          if tab_demo.control.is_focused() {
            tab_demo.control.blur()
          } else {
            tab_demo.control.focus()
          }
        } else if received.matches("u") {
          tab_demo.show_underline = not tab_demo.show_underline
          render_tabs(tab_demo)
          action.set_content("TAB SELECT toggled underline")
        } else if received.matches("p") {
          tab_demo.show_description = not tab_demo.show_description
          render_tabs(tab_demo)
          action.set_content("TAB SELECT toggled descriptions")
        } else if received.matches("s") {
          tab_demo.show_arrows = not tab_demo.show_arrows
          render_tabs(tab_demo)
          action.set_content("TAB SELECT toggled scroll arrows")
        } else if received.matches("w") {
          tab_demo.wrap = not tab_demo.wrap
          render_tabs(tab_demo)
          action.set_content("TAB SELECT toggled wrap selection")
        } else if tab_demo.control.is_focused() and (received.matches("right") or received.matches("]")) {
          move_tab(tab_demo, 1)
        } else if tab_demo.control.is_focused() and (received.matches("left") or received.matches("[")) {
          move_tab(tab_demo, -1)
        } else if tab_demo.control.is_focused() and received.matches("return") {
          tab_demo.activated = tab_demo.highlighted
          render_tabs(tab_demo)
          action.set_content(
            "TAB SELECT activated {tab_demo.options.at(tab_demo.activated).expect("active tab").name}",
          )
        } else {
          handled = false
        }
      } else if state.page == 1 {
        let fast = received.modifiers.shift
        mut step = 1
        if fast {
          step = 5
        }
        if received.matches("f") {
          if select_demo.viewport.is_focused() {
            select_demo.viewport.blur()
          } else {
            select_demo.viewport.focus()
          }
        } else if received.matches("d") {
          select_demo.show_description = not select_demo.show_description
          render_select(select_demo)
          pin_select(select_demo)
          action.set_content("SELECT toggled descriptions")
        } else if received.matches("s") {
          select_demo.show_indicator = not select_demo.show_indicator
          render_select(select_demo)
          action.set_content("SELECT toggled scroll indicator")
        } else if received.matches("w") {
          select_demo.wrap = not select_demo.wrap
          render_select(select_demo)
          action.set_content("SELECT toggled wrap selection")
        } else if select_demo.viewport.is_focused() and (received.matches("down") or received.matches("down", shift: true) or received.matches("j") or received.matches("j", shift: true)) {
          move_select(select_demo, step)
        } else if select_demo.viewport.is_focused() and (received.matches("up") or received.matches("up", shift: true) or received.matches("k") or received.matches("k", shift: true)) {
          move_select(select_demo, 0 - step)
        } else if select_demo.viewport.is_focused() and received.matches("return") {
          select_demo.activated = select_demo.highlighted
          render_select(select_demo)
          action.set_content(
            "SELECT activated {select_demo.options.at(select_demo.activated).expect("active option").name}",
          )
        } else {
          handled = false
        }
      } else {
        mut slider_index = -1
        if received.matches("1") {
          slider_index = 0
        } else if received.matches("2") {
          slider_index = 1
        } else if received.matches("3") {
          slider_index = 2
        } else if received.matches("4") {
          slider_index = 3
        } else if received.matches("5") {
          slider_index = 4
        } else if received.matches("6") {
          slider_index = 5
        } else if received.matches("7") {
          slider_index = 6
        }
        if slider_index >= 0 {
          sliders.at(slider_index).expect("focused slider").panel.focus()
        } else if received.matches("r") {
          reset_sliders(sliders, action)
        } else {
          mut focused_index = -1
          for slider, index in sliders {
            if slider.panel.is_focused() {
              focused_index = index
            }
          }
          match sliders.at(focused_index) {
            slider => {
              if received.matches("right") or received.matches("up") {
                slider.value =+ slider.step
                render_slider(slider)
                slider_action(action, slider)
              } else if received.matches("left") or received.matches("down") {
                slider.value =- slider.step
                render_slider(slider)
                slider_action(action, slider)
              } else {
                handled = false
              }
            },
            _ => { handled = false },
          }
        }
      }
      if handled {
        received.prevent_default()
        received.stop_propagation()
      }
    }
  })

  render_tabs(tab_demo)
  render_select(select_demo)
  show_page(0, state, tab_demo, select_demo, slider_page, sliders, nav, action)

  let cancellation = ctx.cancellation
  let dispatch = ctx.dispatch
  let animate = fn() {
    if state.page == 2 {
      for index in [2, 6] {
        let slider = sliders.at(index).expect("animated slider")
        slider.value = slider.value + slider.direction * slider.step
        if slider.value >= slider.maximum {
          slider.value = slider.maximum
          slider.direction = -1
        } else if slider.value <= slider.minimum {
          slider.value = slider.minimum
          slider.direction = 1
        }
        render_slider(slider)
      }
    }
  }
  async::start(fn() {
    mut running = true
    while running {
      select {
        cancellation.recv() => { running = false },
        time::After(120 * time::Millisecond).recv() => {
          if dispatch(animate).is_err() {
            running = false
          }
        },
      }
    }
  })

  application.run().expect("run Cooper widget lab")
}
