use cooper/surface
use go:math

struct RouteGeometry {
  // Root geometry followed by one owner for every routed edge.
  route_sizes: [surface::Size],
  route_origins: [surface::Point],
}

struct Hit {
  // Deepest retained widget occurrence under the point.
  route: [Int],
  // Deepest focusable occurrence containing the point, if any.
  focus_path: [Int]?,
  // Point and size local to the routed widget occurrence.
  local: surface::Point,
  size: surface::Size,
  // Root size followed by one owner size for every routed edge.
  route_sizes: [surface::Size],
}

private struct Rect {
  left: Int,
  top: Int,
  right: Int,
  bottom: Int,
}

impl Rect {
  private fn contains(point: surface::Point) Bool {
    point.x >= self.left and point.x < self.right and point.y >= self.top and point.y < self.bottom
  }
}

private fn intersect(a: Rect, b: Rect) Rect {
  mut left = a.left
  mut top = a.top
  mut right = a.right
  mut bottom = a.bottom
  if b.left > left {
    left = b.left
  }
  if b.top > top {
    top = b.top
  }
  if b.right < right {
    right = b.right
  }
  if b.bottom < bottom {
    bottom = b.bottom
  }
  Rect{
    left: left,
    top: top,
    right: right,
    bottom: bottom,
  }
}

private fn saturating_add(left: Int, right: Int) Int {
  if right > 0 and left > math::MaxInt - right {
    math::MaxInt
  } else if right < 0 and left < math::MinInt - right {
    math::MinInt
  } else {
    left + right
  }
}

private fn copy_path(path: [Int]) [Int] {
  let copied = mut List::new<Int>()
  for part in path {
    copied.push(part)
  }
  copied.@
}

private fn copy_optional_path(path: [Int]?) [Int]? {
  match path {
    current => Maybe::new<[Int]>(copy_path(current)),
    _ => Maybe::new<[Int]>(),
  }
}

private fn append_path(path: [Int], part: Int) [Int] {
  let appended = mut List::new<Int>()
  for current in path {
    appended.push(current)
  }
  appended.push(part)
  appended.@
}

private fn copy_sizes(sizes: [surface::Size]) [surface::Size] {
  let copied = mut List::new<surface::Size>()
  for size in sizes {
    copied.push(size)
  }
  copied.@
}

private fn append_size(sizes: [surface::Size], size: surface::Size) [surface::Size] {
  let appended = mut List::new<surface::Size>()
  for current in sizes {
    appended.push(current)
  }
  appended.push(size)
  appended.@
}

private fn copy_points(points: [surface::Point]) [surface::Point] {
  let copied = mut List::new<surface::Point>()
  for point in points {
    copied.push(point)
  }
  copied.@
}

private fn append_point(points: [surface::Point], point: surface::Point) [surface::Point] {
  let appended = mut List::new<surface::Point>()
  for current in points {
    appended.push(current)
  }
  appended.push(point)
  appended.@
}

private fn collect_route_geometry(
  tree: surface::Surface,
  origin: surface::Point,
  desired: [Int],
  depth: Int,
  route_sizes: [surface::Size],
  route_origins: [surface::Point],
) [RouteGeometry] {
  let found = mut List::new<RouteGeometry>()
  if depth == desired.size() {
    found.push(
      RouteGeometry{route_sizes: copy_sizes(route_sizes), route_origins: copy_points(route_origins)},
    )
  } else {
    let desired_index = desired.at(depth).expect("unresolved route segment")
    for positioned in tree.children {
      let child_origin = surface::Point{
        x: saturating_add(origin.x, positioned.origin.x),
        y: saturating_add(origin.y, positioned.origin.y),
      }
      match positioned.route_index {
        route_index => {
          if route_index == desired_index {
            for geometry in collect_route_geometry(
              positioned.surface,
              child_origin,
              desired,
              depth + 1,
              append_size(route_sizes, positioned.surface.size),
              append_point(route_origins, child_origin),
            ) {
              found.push(geometry)
            }
          }
        },
        _ => {
          for geometry in collect_route_geometry(positioned.surface, child_origin, desired, depth, route_sizes, route_origins) {
            found.push(geometry)
          }
        },
      }
    }
  }
  found.@
}

fn route_geometry(tree: surface::Surface, route: [Int]) RouteGeometry? {
  let origin = surface::Point{x: 0, y: 0}
  let found = collect_route_geometry(tree, origin, route, 0, [tree.size], [origin])
  if found.size() == 1 {
    found.at(0)
  } else {
    // Repeated routed indexes do not identify one authoritative occurrence.
    Maybe::new<RouteGeometry>()
  }
}

private fn hit_surface(
  tree: surface::Surface,
  origin: surface::Point,
  clip: Rect,
  point: surface::Point,
  route: [Int],
  nearest_focus: [Int]?,
  owner_origin: surface::Point,
  owner_size: surface::Size,
  route_sizes: [surface::Size],
) Hit? {
  if not clip.contains(point) {
    Maybe::new<Hit>()
  } else {
    mut current_focus = copy_optional_path(nearest_focus)
    if tree.focusable {
      current_focus = Maybe::new<[Int]>(copy_path(route))
    }

    mut found = Maybe::new<Hit>()
    mut child_index = tree.children.size()
    while child_index > 0 and found.is_none() {
      child_index =- 1
      let positioned = tree.children.at(child_index).expect("reverse hit-test child index")
      let child_origin = surface::Point{
        x: saturating_add(origin.x, positioned.origin.x),
        y: saturating_add(origin.y, positioned.origin.y),
      }
      let child_clip = intersect(
        clip,
        Rect{
          left: child_origin.x,
          top: child_origin.y,
          right: child_origin.x + positioned.surface.size.width,
          bottom: child_origin.y + positioned.surface.size.height,
        },
      )

      if child_clip.contains(point) {
        mut child_route = copy_path(route)
        mut child_owner_origin = owner_origin
        mut child_owner_size = owner_size
        mut child_route_sizes = copy_sizes(route_sizes)
        match positioned.route_index {
          route_index => {
            child_route = append_path(route, route_index)
            child_owner_origin = child_origin
            child_owner_size = positioned.surface.size
            child_route_sizes = append_size(route_sizes, positioned.surface.size)
          },
          _ => (),
        }
        match hit_surface(
          positioned.surface,
          child_origin,
          child_clip,
          point,
          child_route,
          current_focus,
          child_owner_origin,
          child_owner_size,
          child_route_sizes,
        ) {
          child_hit => { found = Maybe::new<Hit>(child_hit) },
          _ => (),
        }
      }
    }

    match found {
      child_hit => Maybe::new<Hit>(child_hit),
      _ => {
        Maybe::new<Hit>(
          Hit{
            route: copy_path(route),
            focus_path: copy_optional_path(current_focus),
            local: surface::Point{x: point.x - owner_origin.x, y: point.y - owner_origin.y},
            size: owner_size,
            route_sizes: copy_sizes(route_sizes),
          },
        )
      },
    }
  }
}

fn hit_test(tree: surface::Surface, point: surface::Point) Hit? {
  let origin = surface::Point{x: 0, y: 0}
  hit_surface(
    tree,
    origin,
    Rect{
      left: 0,
      top: 0,
      right: tree.size.width,
      bottom: tree.size.height,
    },
    point,
    [],
    Maybe::new<[Int]>(),
    origin,
    tree.size,
    [tree.size],
  )
}
