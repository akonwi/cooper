use cooper/color
use cooper/context
use cooper/core/event_delivery
use cooper/core/node
use cooper/core/paint
use cooper/editor
use cooper/event
use cooper/geometry
use cooper/selection
use cooper/style as layout_style
use cooper/text
use go:github.com/rockorager/go-uucode as unicode

private struct Glyph {
  text: Str,
  start: Int,
  end: Int,
}

private struct View {
  text: Str,
  cursor_x: Int,
  start: Int,
}

private struct ByteRange {
  start: Int,
  end: Int,
}

private struct InputKeyBinding {
  name: Str,
  action: editor::Action,
  shift: Bool,
  ctrl: Bool,
  alt: Bool,
  super: Bool,
}

private fn input_binding(
  name: Str,
  action: editor::Action,
  shift: Bool?,
  ctrl: Bool?,
  alt: Bool?,
  super: Bool?,
) InputKeyBinding {
  InputKeyBinding{
    name: name,
    action: action,
    shift: shift.or(false),
    ctrl: ctrl.or(false),
    alt: alt.or(false),
    super: super.or(false),
  }
}

private fn default_input_bindings() [InputKeyBinding] {
  [
    input_binding("left", editor::Action::select_left, shift: true),
    input_binding("right", editor::Action::select_right, shift: true),
    input_binding("b", editor::Action::select_left, shift: true, ctrl: true),
    input_binding("f", editor::Action::select_right, shift: true, ctrl: true),
    input_binding("home", editor::Action::select_start, shift: true),
    input_binding("end", editor::Action::select_end, shift: true),
    input_binding("a", editor::Action::select_start, shift: true, ctrl: true),
    input_binding("e", editor::Action::select_end, shift: true, ctrl: true),
    input_binding("left", editor::Action::select_word_backward, shift: true, alt: true),
    input_binding("left", editor::Action::select_word_backward, shift: true, ctrl: true),
    input_binding("b", editor::Action::select_word_backward, shift: true, alt: true),
    input_binding("right", editor::Action::select_word_forward, shift: true, alt: true),
    input_binding("right", editor::Action::select_word_forward, shift: true, ctrl: true),
    input_binding("f", editor::Action::select_word_forward, shift: true, alt: true),
    input_binding("left", editor::Action::move_left),
    input_binding("right", editor::Action::move_right),
    input_binding("b", editor::Action::move_left, ctrl: true),
    input_binding("f", editor::Action::move_right, ctrl: true),
    input_binding("home", editor::Action::move_start),
    input_binding("end", editor::Action::move_end),
    input_binding("a", editor::Action::move_start, ctrl: true),
    input_binding("e", editor::Action::move_end, ctrl: true),
    input_binding("left", editor::Action::move_start, super: true),
    input_binding("right", editor::Action::move_end, super: true),
    input_binding("left", editor::Action::select_start, shift: true, super: true),
    input_binding("right", editor::Action::select_end, shift: true, super: true),
    input_binding("left", editor::Action::move_word_backward, alt: true),
    input_binding("left", editor::Action::move_word_backward, ctrl: true),
    input_binding("b", editor::Action::move_word_backward, alt: true),
    input_binding("right", editor::Action::move_word_forward, alt: true),
    input_binding("right", editor::Action::move_word_forward, ctrl: true),
    input_binding("f", editor::Action::move_word_forward, alt: true),
    input_binding("backspace", editor::Action::delete_backward),
    input_binding("delete", editor::Action::delete_forward),
    input_binding("d", editor::Action::delete_forward, ctrl: true),
    input_binding("w", editor::Action::delete_word_backward, ctrl: true),
    input_binding("backspace", editor::Action::delete_word_backward, ctrl: true),
    input_binding("backspace", editor::Action::delete_word_backward, alt: true),
    input_binding("d", editor::Action::delete_word_forward, alt: true),
    input_binding("delete", editor::Action::delete_word_forward, alt: true),
    input_binding("delete", editor::Action::delete_word_forward, ctrl: true),
    input_binding("u", editor::Action::delete_to_start, ctrl: true),
    input_binding("k", editor::Action::delete_to_end, ctrl: true),
    input_binding("a", editor::Action::select_all, super: true),
    input_binding("z", editor::Action::undo, super: true),
    input_binding("z", editor::Action::redo, shift: true, super: true),
    input_binding("-", editor::Action::undo, ctrl: true),
    input_binding(".", editor::Action::redo, ctrl: true),
    input_binding("return", editor::Action::submit),
  ]
}

private fn resolve_input_action(name: Str, modifiers: event::Modifiers) editor::Action? {
  mut resolved = Maybe::new<editor::Action>()
  for configured in default_input_bindings() {
    if configured.name == name and configured.shift == modifiers.shift and configured.ctrl == modifiers.ctrl and configured.alt == modifiers.alt and configured.super == modifiers.super {
      resolved = Maybe::new<editor::Action>(configured.action)
      break
    }
  }
  resolved
}

struct Input {
  node_ref: mut node::Node,
  editor_state: mut editor::State,
  placeholder_text: Str,
  minimum_length: Int,
  maximum_length: Int?,
  value_style: text::TextStyle,
  placeholder_text_style: text::TextStyle,
  selection_patch: fn(mut text::TextStyle),
  selected_style: text::TextStyle,
  selection_generation: Int,
  selection_version: Int,
  selection_view_start: Int,
  selection_view_width: Int,
  selection_local_valid: Bool,
  selection_local_anchor_x: Int,
  selection_local_anchor_y: Int,
  selection_local_focus_x: Int,
  selection_local_focus_y: Int,
  selected_range: selection::Range?,
  selected_text_value: Str,
  commit_baseline: Str,
  width_measurer: fn(Str) Int,
}

private fn glyphs(text: Str) [Glyph] {
  let iterator = mut unicode::NewGraphemeIterator(text)
  let output: mut [Glyph] = mut []
  mut reading = true
  while reading {
    match iterator.Next() {
      grapheme => {
        output.push(
          Glyph{
            text: text.slice(start: grapheme.Start, end: grapheme.End).or(""),
            start: grapheme.Start,
            end: grapheme.End,
          },
        )
      },
      _ => { reading = false },
    }
  }
  output.@
}

private fn previous_boundary(text: Str, cursor: Int) Int {
  mut previous = 0
  for glyph in glyphs(text) {
    if glyph.end >= cursor {
      previous = glyph.start
      break
    }
    previous = glyph.end
  }
  previous
}

private fn next_boundary(text: Str, cursor: Int) Int {
  mut next = text.size()
  for glyph in glyphs(text) {
    if glyph.end > cursor {
      next = glyph.end
      break
    }
  }
  next
}

private fn normalize_boundary(text: Str, cursor: Int) Int {
  mut normalized = cursor
  if normalized < 0 {
    normalized = 0
  }
  if normalized > text.size() {
    normalized = text.size()
  }
  for glyph in glyphs(text) {
    if normalized > glyph.start and normalized < glyph.end {
      normalized = glyph.end
      break
    }
  }
  normalized
}

private fn single_line(value: Str) Str {
  value.replace("\r\n", "").replace("\r", "").replace("\n", "").replace("\t", "    ")
}

private fn grapheme_count(value: Str) Int {
  glyphs(value).size()
}

private fn truncate(value: Str, maximum: Int?) Str {
  let limit = try maximum -> _ { value }
  mut output = ""
  for glyph, index in glyphs(value) {
    if index < limit {
      output = "{output}{glyph.text}"
    }
  }
  output
}

private fn same_color(left: color::Color?, right: color::Color?) Bool {
  match left {
    left_color => {
      match right {
        right_color => {
          left_color.red == right_color.red and left_color.green == right_color.green and left_color.blue == right_color.blue
        },
        _ => false,
      }
    },
    _ => not right.is_some(),
  }
}

private fn same_text_style(left: text::TextStyle, right: text::TextStyle) Bool {
  same_color(left.foreground, right.foreground) and same_color(left.background, right.background) and left.bold == right.bold and left.dim == right.dim and left.italic == right.italic and left.underline == right.underline and left.blink == right.blink and left.reverse == right.reverse and left.strike == right.strike and left.hidden == right.hidden
}

private fn default_selection_style(value: mut text::TextStyle) {
  value.reverse = not value.reverse
}

private fn apply_style_patch(base: text::TextStyle, patch: fn(mut text::TextStyle)) text::TextStyle {
  let selected = mut base
  patch(selected)
  selected.@
}

private fn display_offset(value: Str, boundary: Int, measure: fn(Str) Int) Int {
  mut offset = 0
  for glyph in glyphs(value) {
    if glyph.end <= boundary {
      offset = offset + measure(glyph.text)
    }
  }
  offset
}

private fn cell_style(value: text::TextStyle) paint::CellStyle {
  paint::style(
    foreground: value.foreground,
    background: value.background,
    bold: value.bold,
    dim: value.dim,
    italic: value.italic,
    underline: value.underline,
    blink: value.blink,
    reverse: value.reverse,
    strike: value.strike,
    hidden: value.hidden,
  )
}

private fn placeholder_paint_style(value: text::TextStyle, placeholder: text::TextStyle) text::TextStyle {
  mut background = value.background
  match placeholder.background {
    configured => { background = Maybe::new<color::Color>(configured) },
    _ => (),
  }
  text::TextStyle{
    foreground: placeholder.foreground,
    background: background,
    bold: placeholder.bold,
    dim: placeholder.dim,
    italic: placeholder.italic,
    underline: placeholder.underline,
    blink: placeholder.blink,
    reverse: placeholder.reverse,
    strike: placeholder.strike,
    hidden: placeholder.hidden,
  }
}

private fn constrained(value: Float32, available: Float32, mode: node::MeasureMode) Float32 {
  match mode {
    node::MeasureMode::exactly => available,
    node::MeasureMode::at_most => {
      if value > available {
        available
      } else {
        value
      }
    },
    node::MeasureMode::undefined => value,
  }
}

private fn measured_width(text: Str, measure: fn(Str) Int) Int {
  mut width = 0
  for glyph in glyphs(text) {
    width = width + measure(glyph.text)
  }
  width
}

private fn input_view(value: Str, placeholder: Str, cursor: Int, width: Int, measure: fn(Str) Int) View {
  if value.is_empty() {
    mut visible = ""
    mut visible_width = 0
    for glyph in glyphs(placeholder) {
      let glyph_width = measure(glyph.text)
      if visible_width + glyph_width <= width {
        visible = "{visible}{glyph.text}"
        visible_width = visible_width + glyph_width
      } else {
        break
      }
    }
    View{
      text: visible,
      cursor_x: 0,
      start: 0,
    }
  } else {
    let value_glyphs = glyphs(value)
    mut cursor_width = 0
    for glyph in value_glyphs {
      if glyph.end <= cursor {
        cursor_width = cursor_width + measure(glyph.text)
      }
    }

    mut start_index = 0
    mut dropped_width = 0
    if width > 0 {
      for glyph, index in value_glyphs {
        if cursor_width - dropped_width >= width {
          dropped_width = dropped_width + measure(glyph.text)
          start_index = index + 1
        } else {
          break
        }
      }
    }

    mut visible = ""
    mut visible_width = 0
    for glyph, index in value_glyphs {
      if index >= start_index {
        let glyph_width = measure(glyph.text)
        if visible_width + glyph_width <= width {
          visible = "{visible}{glyph.text}"
          visible_width = visible_width + glyph_width
        } else {
          break
        }
      }
    }

    let start = match value_glyphs.at(start_index) {
      glyph => glyph.start,
      _ => value.size(),
    }
    View{
      text: visible,
      cursor_x: cursor_width - dropped_width,
      start: start,
    }
  }
}

private fn input_view_from_start(
  value: Str,
  placeholder: Str,
  cursor: Int,
  width: Int,
  requested_start: Int,
  measure: fn(Str) Int,
) View {
  if value.is_empty() {
    input_view(value, placeholder, cursor, width, measure)
  } else {
    let start = normalize_boundary(value, requested_start)
    mut visible = ""
    mut visible_width = 0
    for glyph in glyphs(value) {
      if glyph.end > start {
        let glyph_width = measure(glyph.text)
        if visible_width + glyph_width <= width {
          visible = "{visible}{glyph.text}"
          visible_width = visible_width + glyph_width
        } else {
          break
        }
      }
    }
    View{
      text: visible,
      cursor_x: display_offset(value, cursor, measure) - display_offset(value, start, measure),
      start: start,
    }
  }
}

private fn cursor_for_column(value: Str, start: Int, column: Int, width: Int, measure: fn(Str) Int) Int {
  mut cursor = start
  mut x = 0
  mut locating = true
  for glyph in glyphs(value) {
    if locating and glyph.start >= start {
      let glyph_width = measure(glyph.text)
      if glyph_width < 0 or x + glyph_width > width {
        locating = false
      } else if glyph_width == 0 {
        cursor = glyph.end
      } else if column < x + glyph_width {
        if glyph_width > 1 and (column - x) * 2 >= glyph_width {
          cursor = glyph.end
        } else {
          cursor = glyph.start
        }
        locating = false
      } else {
        x = x + glyph_width
        cursor = glyph.end
      }
    }
  }
  cursor
}

private fn default_input_style() layout_style::Style {
  layout_style::new(height: layout_style::cells(1))
}

fn new(
  ctx: mut context::Context,
  value: Str?,
  placeholder: Str?,
  min_length: Int?,
  max_length: Int?,
  styles: layout_style::Style?,
  text_style: text::TextStyle?,
  placeholder_style: text::TextStyle?,
  selectable: Bool?,
  selection_style: fn(mut text::TextStyle)?,
) mut Input {
  let minimum = min_length.or(0)
  if minimum < 0 {
    panic("Input min_length must be non-negative")
  }
  match max_length {
    maximum => {
      if maximum < minimum {
        panic("Input max_length must be at least min_length")
      }
    },
    _ => (),
  }
  let initial_value = truncate(single_line(value.or("")), max_length)
  let configured_style = styles.or(default_input_style())
  let base_style = text_style.or(text::style())
  let patch = selection_style.or(default_selection_style)
  let input = mut Input{
    node_ref: context::internal_state(ctx).create_node(configured_style),
    editor_state: mut editor::new(initial_value),
    placeholder_text: single_line(placeholder.or("")),
    minimum_length: minimum,
    maximum_length: max_length,
    value_style: base_style,
    placeholder_text_style: placeholder_style.or(text::style(dim: true)),
    selection_patch: patch,
    selected_style: apply_style_patch(base_style, patch),
    selection_generation: 0,
    selection_version: 0,
    selection_view_start: 0,
    selection_view_width: 0,
    selection_local_valid: false,
    selection_local_anchor_x: 0,
    selection_local_anchor_y: 0,
    selection_local_focus_x: 0,
    selection_local_focus_y: 0,
    selected_range: Maybe::new<selection::Range>(),
    selected_text_value: "",
    commit_baseline: initial_value,
    width_measurer: context::internal_state(ctx).width_measurer,
  }
  let retained = input.node_ref
  retained.bind(input)
  retained.set_focusable(true)
  let _ = retained.on_focus(fn() {
    input.commit_baseline = input.editor_state.value()
  })
  let _ = retained.on_blur(fn() {
    input.commit_pending_change()
  })
  retained.set_measure(fn(measurement: node::MeasureInput) node::MeasureSize {
    mut display = input.editor_state.value()
    if display.is_empty() {
      display = input.placeholder_text
    }
    let desired_width = Float32::from(measured_width(display, input.width_measurer) + 1)
    let desired_height: Float32 = 1.0
    node::MeasureSize{
      width: constrained(desired_width, measurement.width, measurement.width_mode),
      height: constrained(desired_height, measurement.height, measurement.height_mode),
    }
  })
  if selectable.or(true) {
    input.enable_selection()
  }
  input
}

impl node::Renderable for Input {
  fn node() mut node::Node {
    self.node_ref
  }

  fn mount(ctx: node::MountContext) {}

  fn paint(ctx: mut paint::Context) {
    let width = self.node_ref.layout().screen.width
    let view = match self.editor_state.anchor() {
      anchor => {
        input_view_from_start(
          self.editor_state.value(),
          self.placeholder_text,
          self.editor_state.cursor(),
          width,
          self.selection_view_start,
          self.width_measurer,
        )
      },
      _ => {
        input_view(
          self.editor_state.value(),
          self.placeholder_text,
          self.editor_state.cursor(),
          width,
          self.width_measurer,
        )
      },
    }
    ctx.fill(cell_style(self.value_style))
    let painted_style = match self.editor_state.value().is_empty() {
      true => placeholder_paint_style(self.value_style, self.placeholder_text_style),
      false => self.value_style,
    }
    ctx.write_measured(0, 0, view.text, self.width_measurer, text_style: cell_style(painted_style))
    match self.byte_selection() {
      selected => {
        mut x = 0
        for glyph in glyphs(self.editor_state.value()) {
          if glyph.end > view.start {
            let glyph_width = self.width_measurer(glyph.text)
            if x + glyph_width <= width {
              if glyph.end > selected.start and glyph.start < selected.end {
                ctx.write_measured(
                  x,
                  0,
                  glyph.text,
                  self.width_measurer,
                  text_style: cell_style(self.selected_style),
                )
              }
              x = x + glyph_width
            } else {
              break
            }
          }
        }
      },
      _ => (),
    }
    if self.node_ref.is_focused() and view.cursor_x >= 0 and view.cursor_x < width {
      ctx.show_cursor(view.cursor_x, 0)
    }
  }

  fn mut event(ctx: mut event_delivery::Context) event_delivery::Disposition {
    match ctx.mouse_event {
      mouse => self.handle_mouse(ctx, mouse),
      _ => {
        match ctx.paste_event {
          paste => {
            if ctx.focused {
              self.insert_text(ctx, paste.text)
            } else {
              event_delivery::Disposition::ignored
            }
          },
          _ => {
            match ctx.key_event {
              key => {
                if ctx.focused {
                  self.handle_key(ctx, key)
                } else {
                  event_delivery::Disposition::ignored
                }
              },
              _ => event_delivery::Disposition::ignored,
            }
          },
        }
      },
    }
  }
}

impl Input {
  private fn byte_selection() ByteRange? {
    match self.editor_state.selection() {
      selected => Maybe::new<ByteRange>(ByteRange{start: selected.start, end: selected.end}),
      _ => Maybe::new<ByteRange>(),
    }
  }

  private fn mut clear_local_selection() node::SelectionResult {
    self.editor_state.clear_selection()
    self.selection_generation = 0
    self.selection_version = 0
    self.selection_view_start = 0
    self.selection_view_width = 0
    self.selection_local_valid = false
    self.selected_range = Maybe::new<selection::Range>()
    self.selected_text_value = ""
    node::empty_selection_result()
  }

  private fn mut refresh_selected_value() {
    match self.byte_selection() {
      selected => {
        self.selected_range = Maybe::new<selection::Range>(
          selection::Range{
            start: display_offset(self.editor_state.value(), selected.start, self.width_measurer),
            end: display_offset(self.editor_state.value(), selected.end, self.width_measurer),
          },
        )
        self.selected_text_value = self.editor_state.value().slice(
          start: selected.start,
          end: selected.end,
        ).or("")
      },
      _ => {
        self.selected_range = Maybe::new<selection::Range>()
        self.selected_text_value = ""
      },
    }
  }

  private fn selection_accepts(local_x: Int, local_y: Int) Bool {
    local_y == 0 and local_x >= 0 and local_x <= self.node_ref.layout().screen.width
  }

  private fn mut apply_local_selection(value: node::LocalSelection?) node::SelectionResult {
    let local = try value -> _ { self.clear_local_selection() }
    if (not local.is_active) or local.anchor_y < 0 and local.focus_y < 0 or local.anchor_y > 0 and local.focus_y > 0 {
      self.clear_local_selection()
    } else {
      let width = self.node_ref.layout().screen.width
      mut anchor_column = local.anchor_x
      mut focus_column = local.focus_x
      if local.anchor_y < 0 {
        anchor_column = 0
      } else if local.anchor_y > 0 {
        anchor_column = width
      }
      if local.focus_y < 0 {
        focus_column = 0
      } else if local.focus_y > 0 {
        focus_column = width
      }
      let view = input_view(
        self.editor_state.value(),
        self.placeholder_text,
        self.editor_state.cursor(),
        width,
        self.width_measurer,
      )
      let width_changed = self.selection_view_width != width
      if width_changed {
        self.selection_view_start = view.start
        self.selection_view_width = width
      }
      let preserve_initial = self.selection_generation == 0 and self.editor_state.anchor().is_some()
      let generation_changed = self.selection_generation != local.generation or not self.editor_state.anchor().is_some()
      let version_changed = self.selection_version != local.version
      let owns_selection = self.node_ref.owns_global_selection()
      let local_changed = (not self.selection_local_valid) or self.selection_local_anchor_x != local.anchor_x or self.selection_local_anchor_y != local.anchor_y or self.selection_local_focus_x != local.focus_x or self.selection_local_focus_y != local.focus_y or width_changed and (not owns_selection)
      let remap_anchor = generation_changed or local_changed and (not owns_selection)
      if remap_anchor {
        if not preserve_initial {
          if local.anchor_y < 0 {
            self.editor_state.set_anchor(0)
          } else if local.anchor_y > 0 {
            self.editor_state.set_anchor(self.editor_state.value().size())
          } else {
            self.editor_state.set_anchor(
              cursor_for_column(
                self.editor_state.value(),
                view.start,
                anchor_column,
                width,
                self.width_measurer,
              ),
            )
          }
          self.selection_view_start = view.start
        }
      }
      if generation_changed {
        self.selection_generation = local.generation
      }
      if generation_changed or version_changed or local_changed {
        if not preserve_initial {
          if local.focus_y < 0 {
            self.editor_state.set_cursor(0)
            self.selection_view_start = 0
          } else if local.focus_y > 0 {
            self.editor_state.set_cursor(self.editor_state.value().size())
            self.selection_view_start = input_view(
              self.editor_state.value(),
              self.placeholder_text,
              self.editor_state.cursor(),
              width,
              self.width_measurer,
            ).start
          } else {
            if local.allow_edge_pan and version_changed {
              if focus_column < 0 {
                self.selection_view_start = previous_boundary(
                  self.editor_state.value(),
                  self.selection_view_start,
                )
              } else if focus_column >= width {
                self.selection_view_start = next_boundary(
                  self.editor_state.value(),
                  self.selection_view_start,
                )
              }
            }
            self.editor_state.set_cursor(
              cursor_for_column(
                self.editor_state.value(),
                self.selection_view_start,
                focus_column,
                width,
                self.width_measurer,
              ),
            )
          }
        }
        self.selection_version = local.version
      }
      self.selection_local_valid = true
      self.selection_local_anchor_x = local.anchor_x
      self.selection_local_anchor_y = local.anchor_y
      self.selection_local_focus_x = local.focus_x
      self.selection_local_focus_y = local.focus_y
      self.refresh_selected_value()
      match self.byte_selection() {
        selected => {
          let selected_range = self.selected_range.expect("Input selected range")
          let fragments = mut List::new<node::SelectionFragment>()
          let clip_right = local.clip.x + local.clip.width
          let clip_bottom = local.clip.y + local.clip.height
          let intersects = local.clip.x < width and clip_right > 0 and local.clip.y < 1 and clip_bottom > 0
          if intersects {
            let screen = self.node_ref.layout().screen
            fragments.push(
              node::SelectionFragment{
                screen_x: screen.x,
                screen_y: screen.y,
                cell_width: selected_range.end - selected_range.start,
                text: self.selected_text_value,
              },
            )
          }
          node::SelectionResult{
            has_selection: true,
            start: selected_range.start,
            end: selected_range.end,
            source_text: Maybe::new<Str>(),
            fragments: fragments.@,
          }
        },
        _ => node::empty_selection_result(),
      }
    }
  }

  private fn mut enable_selection() {
    self.node_ref.set_selection_callbacks(
      fn(local_x: Int, local_y: Int) Bool {
        self.selection_accepts(local_x, local_y)
      },
      fn(value: node::LocalSelection?) node::SelectionResult {
        self.apply_local_selection(value)
      },
      Maybe::new<fn(Int, Int, Int, Int) node::SelectionExpansion?>(),
      Maybe::new<fn(Int, Int) node::SelectionExpansion?>(),
      Maybe::new<fn(node::SelectionRange, node::SelectionRange, Int) node::SelectionExpansion?>(),
    )
  }

  fn value() Str {
    self.editor_state.value()
  }

  fn mut focus() Bool {
    self.node_ref.focus()
  }

  fn mut blur() {
    self.node_ref.blur()
  }

  fn is_focused() Bool {
    self.node_ref.is_focused()
  }

  fn mut on_key(handler: fn(mut event::KeyEvent)) fn() {
    self.node_ref.on_key(handler)
  }

  fn mut on_paste(handler: fn(mut event::PasteEvent)) fn() {
    self.node_ref.on_paste(handler)
  }

  fn mut on_mouse(handler: fn(mut event::MouseEvent)) fn() {
    self.node_ref.on_mouse(handler)
  }

  fn mut on_focus(handler: fn()) fn() {
    self.node_ref.on_focus(handler)
  }

  fn mut on_blur(handler: fn()) fn() {
    self.node_ref.on_blur(handler)
  }

  fn mut on_input(handler: fn(Str)) fn() {
    self.node_ref.on_value(1, handler)
  }

  fn mut on_change(handler: fn(Str)) fn() {
    self.node_ref.on_value(2, handler)
  }

  fn mut on_submit(handler: fn(Str)) fn() {
    self.node_ref.on_value(3, handler)
  }

  fn placeholder() Str {
    self.placeholder_text
  }

  fn mut set_placeholder(value: Str) {
    self.node_ref.require_live()
    let normalized = single_line(value)
    if self.placeholder_text != normalized {
      self.placeholder_text = normalized
      self.node_ref.mark_measure_dirty()
    }
  }

  fn min_length() Int {
    self.minimum_length
  }

  fn mut set_min_length(value: Int) {
    self.node_ref.require_live()
    if value < 0 {
      panic("Input min_length must be non-negative")
    }
    match self.maximum_length {
      maximum => {
        if value > maximum {
          panic("Input min_length cannot exceed max_length")
        }
      },
      _ => (),
    }
    self.minimum_length = value
  }

  fn max_length() Int? {
    self.maximum_length
  }

  fn mut set_max_length(value: Int?) {
    self.node_ref.require_live()
    match value {
      maximum => {
        if maximum < self.minimum_length {
          panic("Input max_length must be at least min_length")
        }
      },
      _ => (),
    }
    self.maximum_length = value
    self.set_value(self.editor_state.value())
  }

  fn text_style() text::TextStyle {
    self.value_style
  }

  fn selectable() Bool {
    self.node_ref.is_selectable()
  }

  fn mut set_selectable(value: Bool) {
    self.node_ref.require_live()
    if value and not self.node_ref.is_selectable() {
      self.enable_selection()
    } else if (not value) and self.node_ref.is_selectable() {
      self.node_ref.clear_selection_callbacks()
    }
  }

  fn selection() selection::Range? {
    self.selected_range
  }

  fn selected_text() Str {
    self.selected_text_value
  }

  fn mut set_selection_style(patch: fn(mut text::TextStyle)) {
    self.node_ref.require_live()
    self.selection_patch = patch
    self.selected_style = apply_style_patch(self.value_style, patch)
    self.node_ref.request_redraw()
  }

  fn mut set_text_style(value: text::TextStyle) {
    self.node_ref.require_live()
    if not same_text_style(self.value_style, value) {
      self.value_style = value
      self.selected_style = apply_style_patch(value, self.selection_patch)
      self.node_ref.request_redraw()
    }
  }

  fn placeholder_style() text::TextStyle {
    self.placeholder_text_style
  }

  fn mut set_placeholder_style(value: text::TextStyle) {
    self.node_ref.require_live()
    if not same_text_style(self.placeholder_text_style, value) {
      self.placeholder_text_style = value
      self.node_ref.request_redraw()
    }
  }

  fn mut set_value(value: Str) {
    self.node_ref.require_live()
    let normalized = truncate(single_line(value), self.maximum_length)
    let had_selection = self.editor_state.has_anchor()
    let changed = self.editor_state.reset(normalized)
    if had_selection {
      self.node_ref.clear_global_selection()
      let _ = self.clear_local_selection()
    }
    if changed.text_changed {
      self.node_ref.mark_measure_dirty()
      self.node_ref.emit_value(1, normalized)
    } else if changed.cursor_changed or changed.selection_changed {
      self.node_ref.request_redraw()
    }
  }

  private fn mut commit_pending_change() {
    if self.editor_state.value() != self.commit_baseline {
      let committed = self.editor_state.value()
      self.node_ref.emit_value(2, committed)
      self.commit_baseline = committed
    }
  }

  fn mut submit() Bool {
    self.node_ref.require_live()
    if grapheme_count(self.editor_state.value()) < self.minimum_length {
      false
    } else {
      let submitted = self.editor_state.value()
      if submitted != self.commit_baseline {
        self.node_ref.emit_value(2, submitted)
      }
      self.commit_baseline = submitted
      self.node_ref.emit_value(3, submitted)
      true
    }
  }

  fn style() layout_style::Style {
    self.node_ref.style()
  }

  fn mut set_style(value: layout_style::Style) {
    self.node_ref.apply_style(value)
  }

  fn layout() geometry::Geometry {
    self.node_ref.layout()
  }

  private fn mut changed(ctx: mut event_delivery::Context, text_changed: Bool) event_delivery::Disposition {
    if text_changed {
      self.node_ref.mark_measure_dirty()
      self.node_ref.emit_value(1, self.editor_state.value())
    } else {
      self.node_ref.request_redraw()
    }
    ctx.request_redraw()
    event_delivery::Disposition::handled
  }

  private fn mut finish_editor_outcome(
    ctx: mut event_delivery::Context,
    changed: editor::Outcome,
    had_selection: Bool,
  ) event_delivery::Disposition {
    if had_selection and not self.editor_state.has_anchor() {
      self.node_ref.clear_global_selection()
      let _ = self.clear_local_selection()
    }
    if changed.text_changed {
      self.changed(ctx, true)
    } else if changed.cursor_changed or changed.selection_changed {
      self.changed(ctx, false)
    } else {
      event_delivery::Disposition::handled
    }
  }

  private fn cursor_column() Int {
    let view = input_view(
      self.editor_state.value(),
      self.placeholder_text,
      self.editor_state.cursor(),
      self.node_ref.layout().screen.width,
      self.width_measurer,
    )
    view.cursor_x
  }

  private fn mut begin_keyboard_selection() Bool {
    if self.editor_state.has_anchor() and self.node_ref.owns_global_selection() {
      true
    } else {
      if self.editor_state.has_anchor() {
        let _ = self.clear_local_selection()
      }
      let view = input_view(
        self.editor_state.value(),
        self.placeholder_text,
        self.editor_state.cursor(),
        self.node_ref.layout().screen.width,
        self.width_measurer,
      )
      self.editor_state.set_anchor(self.editor_state.cursor())
      self.selection_generation = 0
      self.selection_version = 0
      self.selection_view_start = view.start
      self.selection_view_width = self.node_ref.layout().screen.width
      self.refresh_selected_value()
      let accepted = self.node_ref.start_selection(view.cursor_x, 0)
      if not accepted {
        let _ = self.clear_local_selection()
      }
      accepted
    }
  }

  private fn mut finish_keyboard_selection() {
    let view = input_view(
      self.editor_state.value(),
      self.placeholder_text,
      self.editor_state.cursor(),
      self.node_ref.layout().screen.width,
      self.width_measurer,
    )
    if self.node_ref.update_selection(view.cursor_x, 0, true) {
      self.selection_version =+ 1
      self.selection_view_start = view.start
      self.selection_view_width = self.node_ref.layout().screen.width
    }
    self.refresh_selected_value()
  }

  private fn mut clear_keyboard_selection() {
    if self.editor_state.has_anchor() {
      self.node_ref.clear_global_selection()
      let _ = self.clear_local_selection()
    }
  }

  private fn mut insert_text(ctx: mut event_delivery::Context, value: Str) event_delivery::Disposition {
    let inserted = single_line(value)
    if inserted.is_empty() {
      event_delivery::Disposition::handled
    } else {
      let had_selection = self.editor_state.has_anchor()
      let changed = self.editor_state.insert_text(inserted, maximum_length: self.maximum_length)
      self.finish_editor_outcome(ctx, changed, had_selection)
    }
  }

  private fn mut handle_mouse(ctx: mut event_delivery::Context, mouse: mut event::MouseEvent) event_delivery::Disposition {
    if mouse.button != event::MouseButton::left or mouse.event_type != event::MouseEventType::down {
      event_delivery::Disposition::ignored
    } else {
      let column = mouse.local_x
      let width = self.node_ref.layout().screen.width
      let view = input_view(
        self.editor_state.value(),
        self.placeholder_text,
        self.editor_state.cursor(),
        width,
        self.width_measurer,
      )
      self.editor_state.set_cursor(
        cursor_for_column(
          self.editor_state.value(),
          view.start,
          column,
          width,
          self.width_measurer,
        ),
      )
      if self.node_ref.is_selectable() and self.node_ref.owns_global_selection() {
        self.editor_state.set_anchor(self.editor_state.cursor())
        self.selection_generation = 0
        self.selection_version = 0
        self.selection_view_start = view.start
        self.selection_view_width = width
        self.refresh_selected_value()
      }
      self.changed(ctx, false)
    }
  }

  private fn mut select_all(ctx: mut event_delivery::Context) event_delivery::Disposition {
    if self.editor_state.has_anchor() {
      self.node_ref.clear_global_selection()
      let _ = self.clear_local_selection()
    }
    self.editor_state.set_cursor(0)
    let selecting = self.begin_keyboard_selection()
    if selecting {
      let _ = self.editor_state.apply(editor::Action::select_end)
      self.finish_keyboard_selection()
    } else {
      let _ = self.editor_state.apply(editor::Action::move_end)
    }
    self.changed(ctx, false)
  }

  private fn mut perform_selection_action(ctx: mut event_delivery::Context, action: editor::Action) event_delivery::Disposition {
    let selecting = self.begin_keyboard_selection()
    if selecting {
      let _ = self.editor_state.apply(action)
      self.finish_keyboard_selection()
    } else {
      let fallback = match action {
        editor::Action::select_left => editor::Action::move_left,
        editor::Action::select_right => editor::Action::move_right,
        editor::Action::select_start => editor::Action::move_start,
        editor::Action::select_end => editor::Action::move_end,
        editor::Action::select_word_backward => editor::Action::move_word_backward,
        editor::Action::select_word_forward => editor::Action::move_word_forward,
        _ => action,
      }
      let _ = self.editor_state.apply(fallback)
    }
    self.changed(ctx, false)
  }

  private fn mut handle_key(ctx: mut event_delivery::Context, key: mut event::KeyEvent) event_delivery::Disposition {
    if key.event_type == event::KeyEventType::release {
      event_delivery::Disposition::ignored
    } else {
      match resolve_input_action(key.name, key.modifiers) {
        action => {
          match action {
            editor::Action::submit => {
              let _ = self.submit()
              event_delivery::Disposition::handled
            },
            editor::Action::select_all => self.select_all(ctx),
            _ => {
              let selecting = action == editor::Action::select_left or action == editor::Action::select_right or action == editor::Action::select_start or action == editor::Action::select_end or action == editor::Action::select_word_backward or action == editor::Action::select_word_forward
              if selecting {
                self.perform_selection_action(ctx, action)
              } else {
                let had_selection = self.editor_state.has_anchor()
                let changed = self.editor_state.apply(action)
                self.finish_editor_outcome(ctx, changed, had_selection)
              }
            },
          }
        },
        _ => {
          if (not key.text.is_empty()) and (not key.modifiers.ctrl) and (not key.modifiers.alt) and (not key.modifiers.super) {
            self.insert_text(ctx, key.text)
          } else {
            event_delivery::Disposition::ignored
          }
        },
      }
    }
  }

  fn mut destroy(recursive: Bool?) {
    self.node_ref.destroy(recursive)
  }
}
