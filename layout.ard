use cooper/cooper
use cooper/event
use cooper/surface
use go:go.rockorager.dev/vaxis
use go:math

// Loose fit preserves inherent height and adds remaining space. Tight fit uses
// only the allocated share and may shrink below inherent height.
enum FlexFit {
  loose,
  tight,
}

struct FlexItem {
  widget: mut cooper::Widget,
  // Zero keeps the widget at its inherent height. Positive values share bounded remaining height.
  flex: Int,
  fit: FlexFit,
}

struct Column {
  children: [FlexItem],
}

private struct MeasuredItem {
  surface: surface::Surface,
  flex: Int,
  fit: FlexFit,
}

fn flex_item(widget: mut cooper::Widget, flex: Int?, fit: FlexFit?) FlexItem {
  FlexItem{
    widget: widget,
    flex: nonnegative(flex.or(0)),
    fit: fit.or(FlexFit::loose),
  }
}

fn column(children: [FlexItem]) Column {
  let owned = mut List::new<FlexItem>()
  for child in children {
    owned.push(child)
  }
  Column{children: owned.@}
}

private fn nonnegative(value: Int) Int {
  if value < 0 {
    0
  } else {
    value
  }
}

private fn saturating_add(total: Int, added: Int, limit: Int) Int {
  let cap = nonnegative(limit)
  let current = nonnegative(total)
  let increment = nonnegative(added)
  if current >= cap {
    cap
  } else if increment >= cap - current {
    cap
  } else {
    current + increment
  }
}

// Scales unusually large factors together so their sum remains representable as Int.
private fn flex_scale(children: [FlexItem]) Int {
  if children.size() == 0 {
    1
  } else {
    let per_item_limit = math::MaxInt / children.size()
    mut largest = 0
    for item in children {
      let weight = nonnegative(item.flex)
      if weight > largest {
        largest = weight
      }
    }

    if largest > per_item_limit {
      mut scale = largest / per_item_limit
      if largest % per_item_limit > 0 {
        scale =+ 1
      }
      scale
    } else {
      1
    }
  }
}

private fn scaled_flex(value: Int, scale: Int) Int {
  let weight = nonnegative(value)
  if weight == 0 {
    0
  } else {
    let scaled = weight / scale
    if scaled < 1 {
      1
    } else {
      scaled
    }
  }
}

// Calculates floor(value * weight / total) without overflowing Int multiplication.
private fn proportional_share(value: Int, weight: Int, total: Int) Int {
  if value <= 0 or weight <= 0 or total <= 0 {
    0
  } else {
    let whole = value / total
    let remainder = value % total
    let base = whole * weight
    mut multiplier = weight
    mut term_quotient = 0
    mut term_remainder = remainder
    mut fraction_quotient = 0
    mut fraction_remainder = 0

    while multiplier > 0 {
      if multiplier % 2 == 1 {
        fraction_quotient = fraction_quotient + term_quotient
        if fraction_remainder >= total - term_remainder {
          fraction_remainder = fraction_remainder - (total - term_remainder)
          fraction_quotient =+ 1
        } else {
          fraction_remainder = fraction_remainder + term_remainder
        }
      }

      multiplier = multiplier / 2
      if multiplier > 0 {
        term_quotient = term_quotient * 2
        if term_remainder >= total - term_remainder {
          term_remainder = term_remainder - (total - term_remainder)
          term_quotient =+ 1
        } else {
          term_remainder = term_remainder * 2
        }
      }
    }

    base + fraction_quotient
  }
}

private fn child_context(ctx: surface::RenderContext, route_index: Int) surface::RenderContext {
  ctx.for_child(
    route_index,
    surface::Constraints{
      min_width: 0,
      max_width: ctx.constraints.max_width,
      min_height: 0,
    },
  )
}

private fn tight_child_context(ctx: surface::RenderContext, route_index: Int, height: Int) surface::RenderContext {
  ctx.for_child(
    route_index,
    surface::Constraints{
      min_width: 0,
      max_width: ctx.constraints.max_width,
      min_height: height,
      max_height: height,
    },
  )
}

private fn normalize(rendered: surface::Surface) surface::Surface {
  let normalized = mut rendered
  normalized.size.width = nonnegative(normalized.size.width)
  normalized.size.height = nonnegative(normalized.size.height)
  normalized.@
}

impl cooper::Widget for Column {
  fn render(ctx: surface::RenderContext) surface::Surface {
    let measured = mut List::new<MeasuredItem>()
    let height_limit = nonnegative(ctx.constraints.max_height.or(math::MaxInt))
    let scale = flex_scale(self.children)
    mut inherent_height = 0
    mut total_flex = 0
    mut last_flexible = -1

    for item, index in self.children {
      let first = normalize(item.widget.render(child_context(ctx, index)))
      let weight = scaled_flex(item.flex, scale)
      measured.push(
        MeasuredItem{
          surface: first,
          flex: weight,
          fit: item.fit,
        },
      )
      mut base_height = first.size.height
      if weight > 0 and item.fit == FlexFit::tight {
        base_height = 0
      }
      inherent_height = saturating_add(inherent_height, base_height, height_limit)
      total_flex = saturating_add(total_flex, weight, math::MaxInt)
      if weight > 0 {
        last_flexible = index
      }
    }

    mut bounded = false
    mut remaining = 0
    match ctx.constraints.max_height {
      maximum => {
        bounded = true
        let limit = nonnegative(maximum)
        if inherent_height < limit {
          remaining = limit - inherent_height
        }
      },
      _ => (),
    }

    let rendered_children = mut List::new<surface::Surface>()
    mut distributed = 0
    for item, index in self.children {
      let first = measured.at(index).expect("measured column child")
      mut selected = first.surface

      if bounded and first.flex > 0 {
        mut extra = 0
        if index == last_flexible {
          extra = remaining - distributed
        } else {
          extra = proportional_share(remaining, first.flex, total_flex)
        }
        distributed = saturating_add(distributed, extra, remaining)
        mut allocated_height = saturating_add(first.surface.size.height, extra, math::MaxInt)
        if first.fit == FlexFit::tight {
          allocated_height = extra
        }
        let rerendered = mut normalize(
          item.widget.render(tight_child_context(ctx, index, allocated_height)),
        )
        // Enforce the allocation when a malformed child ignores tight constraints.
        rerendered.size.height = allocated_height
        selected = rerendered.@
      }

      rendered_children.push(normalize(selected))
    }

    mut content_width = 0
    mut content_height = 0
    for rendered in rendered_children {
      if rendered.size.width > content_width {
        content_width = rendered.size.width
      }
      content_height = saturating_add(content_height, rendered.size.height, height_limit)
    }

    let width = ctx.constraints.constrain_width(content_width)
    let height = ctx.constraints.constrain_height(content_height)
    let output = mut surface::Surface{
      size: surface::Size{width: width, height: height},
      cells: [],
      children: [],
      focusable: false,
    }
    mut y = 0
    for rendered, index in rendered_children {
      output.add_widget_child(index, 0, y, rendered)
      y = saturating_add(y, rendered.size.height, math::MaxInt)
    }
    output.@
  }

  fn mut event(ctx: mut event::EventContext, received: vaxis::Event) event::EventResult {
    let route_index = try ctx.next_route_index() -> _ { event::EventResult::ignored }
    let item = try self.children.at(route_index) -> _ { event::EventResult::ignored }
    ctx.enter_child()
    let result = item.widget.event(ctx, received)
    ctx.leave_child()
    result
  }
}
