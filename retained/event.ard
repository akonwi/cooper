enum EventResult {
  ignored,
  handled,
}

struct EventContext {
  redraw: Bool,
  quit: Bool,
}

fn new_context() EventContext {
  EventContext{redraw: false, quit: false}
}

impl EventContext {
  fn mut request_redraw() {
    self.redraw = true
  }

  fn mut request_quit() {
    self.quit = true
  }

  fn redraw_requested() Bool {
    self.redraw
  }

  fn quit_requested() Bool {
    self.quit
  }
}
