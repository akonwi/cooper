use cooper/event as framework_event
use go:go.rockorager.dev/vaxis

private fn stopped_dispatch(action: fn()) Void!framework_event::DispatchError {
  Result::err(framework_event::DispatchError::stopped)
}

private fn reject_focus() Bool {
  false
}

struct State {
  propagation_stopped: Bool,
  handled: Bool,
  redraw: Bool,
  quit: Bool,
}

fn new_state() mut State {
  (mut State{
    propagation_stopped: false,
    handled: false,
    redraw: false,
    quit: false,
  })
}

struct Context {
  phase: framework_event::EventPhase,
  terminal_event: vaxis::Event,
  local_x: Int?,
  local_y: Int?,
  focused: Bool,
  state: mut State,
  focus_request: fn() Bool,
  dispatch: fn(fn()) Void!framework_event::DispatchError,
}

fn context(
  phase: framework_event::EventPhase,
  terminal_event: vaxis::Event,
  local_x: Int?,
  local_y: Int?,
  focused: Bool,
  state: mut State,
  focus_request: (fn() Bool)?,
  dispatch: (fn(fn()) Void!framework_event::DispatchError)?,
) mut Context {
  (mut Context{
    phase: phase,
    terminal_event: terminal_event,
    local_x: local_x,
    local_y: local_y,
    focused: focused,
    state: state,
    focus_request: focus_request.or(reject_focus),
    dispatch: dispatch.or(stopped_dispatch),
  })
}

impl Context {
  fn stop_propagation() {
    self.state.propagation_stopped = true
  }

  fn request_redraw() {
    self.state.redraw = true
  }

  fn request_quit() {
    self.state.quit = true
  }

  fn request_focus() Bool {
    self.focus_request()
  }

  fn mark_handled() {
    self.state.handled = true
  }
}
