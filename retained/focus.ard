use cooper/retained/node
use cooper/retained/style
use go:math

private fn collect_node(current: mut node::Node, targets: mut [mut node::Node]) {
  if (not current.is_destroyed()) and current.style().display != style::Display::none {
    let layout = current.layout().screen
    if current.is_focusable() and layout.width > 0 and layout.height > 0 {
      targets.push(current)
    }
    for child in current.children {
      collect_node(child, targets)
    }
  }
}

fn targets(root: mut node::Renderable) [mut node::Node] {
  let retained = root.node()
  if retained.parent.is_some() {
    panic("retained focus traversal requires a detached root")
  }
  let found = mut List::new<mut node::Node>()
  collect_node(retained, found)
  found.@
}

private fn saturating_add(left: Int, right: Int) Int {
  if right > 0 and left > math::MaxInt - right {
    math::MaxInt
  } else if right < 0 and left < math::MinInt - right {
    math::MinInt
  } else {
    left + right
  }
}

private fn saturating_subtract(left: Int, right: Int) Int {
  if right > 0 and left < math::MinInt + right {
    math::MinInt
  } else if right < 0 and left > math::MaxInt + right {
    math::MaxInt
  } else {
    left - right
  }
}

fn reveal(root: mut node::Renderable, target: mut node::Node) Bool {
  let root_node = root.node()
  mut ancestor = target.parent
  mut moved = false
  mut scanning = true
  while scanning {
    match ancestor {
      current => {
        if current.style().overflow == style::Overflow::scroll {
          let viewport = current.layout().screen
          let target_bounds = target.layout().screen
          if viewport.height > 0 {
            mut requested = current.scroll_y()
            if target_bounds.y < viewport.y {
              let distance = saturating_subtract(viewport.y, target_bounds.y)
              requested = saturating_subtract(requested, distance)
            } else if target_bounds.height >= viewport.height {
              if target_bounds.y > viewport.y {
                let distance = saturating_subtract(target_bounds.y, viewport.y)
                requested = saturating_add(requested, distance)
              }
            } else {
              let target_bottom = saturating_add(target_bounds.y, target_bounds.height)
              let viewport_bottom = saturating_add(viewport.y, viewport.height)
              if target_bottom > viewport_bottom {
                let distance = saturating_subtract(target_bottom, viewport_bottom)
                requested = saturating_add(requested, distance)
              }
            }
            if current.set_scroll_y(requested) {
              moved = true
            }
          }
        }

        if current == root_node {
          scanning = false
        } else {
          ancestor = current.parent
        }
      },
      _ => { scanning = false },
    }
  }
  moved
}

struct State {
  focused_node: (mut node::Node)?,
  focused_ordinal: Int,
  reveal_requested: Bool,
}

fn new() mut State {
  (mut State{
    focused_node: Maybe::new<mut node::Node>(),
    focused_ordinal: 0,
    reveal_requested: false,
  })
}

impl State {
  fn focused() (mut node::Node)? {
    self.focused_node
  }

  fn is_focused(target: mut node::Node) Bool {
    match self.focused_node {
      current => current == target,
      _ => false,
    }
  }

  private fn mut change(next: (mut node::Node)?, ordinal: Int) {
    mut changed = true
    match self.focused_node {
      current => {
        match next {
          candidate => { changed = current != candidate },
          _ => (),
        }
      },
      _ => {
        if not next.is_some() {
          changed = false
        }
      },
    }

    self.focused_ordinal = ordinal
    if changed {
      self.reveal_requested = true
      match self.focused_node {
        previous => previous.set_focused(false),
        _ => (),
      }
      self.focused_node = next
      match self.focused_node {
        current => current.set_focused(true),
        _ => (),
      }
    }
  }

  fn mut clear() {
    self.change(Maybe::new<mut node::Node>(), 0)
  }

  fn mut focus(root: mut node::Renderable, target: mut node::Node) Bool {
    mut accepted_index = -1
    for candidate, index in targets(root) {
      if candidate == target {
        accepted_index = index
      }
    }
    if accepted_index >= 0 {
      self.change(Maybe::new<mut node::Node>(target), accepted_index)
      self.reveal_requested = true
      true
    } else {
      false
    }
  }

  fn mut reconcile(root: mut node::Renderable) {
    let candidates = targets(root)
    mut current_index = -1
    match self.focused_node {
      current => {
        for candidate, index in candidates {
          if candidate == current {
            current_index = index
          }
        }
      },
      _ => (),
    }

    if current_index >= 0 {
      self.focused_ordinal = current_index
    } else if candidates.size() == 0 {
      self.clear()
    } else {
      mut fallback = self.focused_ordinal
      if fallback < 0 {
        fallback = 0
      }
      if fallback >= candidates.size() {
        fallback = candidates.size() - 1
      }
      self.change(
        Maybe::new<mut node::Node>(candidates.at(fallback).expect("retained focus fallback")),
        fallback,
      )
    }
  }

  fn mut take_reveal_request() Bool {
    let requested = self.reveal_requested
    self.reveal_requested = false
    requested
  }

  fn mut next(root: mut node::Renderable, reverse: Bool?) {
    let candidates = targets(root)
    if candidates.size() == 0 {
      self.clear()
    } else {
      mut current_index = -1
      match self.focused_node {
        current => {
          for candidate, index in candidates {
            if candidate == current {
              current_index = index
            }
          }
        },
        _ => (),
      }

      mut next_index = 0
      if reverse.or(false) {
        if current_index <= 0 {
          next_index = candidates.size() - 1
        } else {
          next_index = current_index - 1
        }
      } else if current_index >= 0 {
        next_index = (current_index + 1) % candidates.size()
      }
      self.change(
        Maybe::new<mut node::Node>(candidates.at(next_index).expect("retained focus target index")),
        next_index,
      )
    }
  }
}
