use cooper/retained/geometry
use cooper/retained/node
use cooper/retained/style

struct Hit {
  target: mut node::Node,
  local_x: Int,
  local_y: Int,
}

private fn test_node(current: mut node::Node, x: Int, y: Int, inherited_clip: geometry::Rect) Hit? {
  if current.is_destroyed() or current.style().display == style::Display::none {
    Maybe::new<Hit>()
  } else {
    let bounds = current.layout().screen
    let node_clip = match current.style().overflow {
      style::Overflow::hidden => geometry::intersect(inherited_clip, bounds),
      style::Overflow::scroll => geometry::intersect(inherited_clip, bounds),
      _ => inherited_clip,
    }

    if not geometry::contains(node_clip, x, y) {
      Maybe::new<Hit>()
    } else {
      mut index = current.children.size()
      mut found = Maybe::new<Hit>()
      while index > 0 and not found.is_some() {
        index =- 1
        let child = current.children.at(index).expect("retained hit child index")
        found = test_node(child, x, y, node_clip)
      }

      match found {
        hit => Maybe::new<Hit>(hit),
        _ => {
          if current.accepts_pointer() and geometry::contains(bounds, x, y) {
            Maybe::new<Hit>(
              Hit{
                target: current,
                local_x: x - bounds.x,
                local_y: y - bounds.y,
              },
            )
          } else {
            Maybe::new<Hit>()
          }
        },
      }
    }
  }
}

fn test(root: mut node::Renderable, x: Int, y: Int) Hit? {
  let retained = root.node()
  if retained.parent.is_some() {
    panic("retained hit testing requires a detached root")
  }
  test_node(retained, x, y, retained.layout_viewport())
}
