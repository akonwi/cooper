use cooper/event as framework_event
use cooper/retained/context
use cooper/retained/event as retained_event
use cooper/retained/geometry
use cooper/retained/node
use cooper/retained/paint
use cooper/retained/style
use go:github.com/rockorager/go-uucode as unicode
use go:go.rockorager.dev/vaxis

private struct Glyph {
  text: Str,
  start: Int,
  end: Int,
}

private struct View {
  text: Str,
  cursor_x: Int,
  start: Int,
}

struct Input {
  node_ref: mut node::Node,
  value_text: Str,
  placeholder: Str,
  cursor: Int,
  width_measurer: fn(Str) Int,
}

private fn glyphs(text: Str) [Glyph] {
  let iterator = mut unicode::NewGraphemeIterator(text)
  let output: mut [Glyph] = mut []
  mut reading = true
  while reading {
    match iterator.Next() {
      grapheme => {
        output.push(
          Glyph{
            text: text.slice(start: grapheme.Start, end: grapheme.End).or(""),
            start: grapheme.Start,
            end: grapheme.End,
          },
        )
      },
      _ => { reading = false },
    }
  }
  output.@
}

private fn previous_boundary(text: Str, cursor: Int) Int {
  mut previous = 0
  for glyph in glyphs(text) {
    if glyph.end >= cursor {
      previous = glyph.start
      break
    }
    previous = glyph.end
  }
  previous
}

private fn next_boundary(text: Str, cursor: Int) Int {
  mut next = text.size()
  for glyph in glyphs(text) {
    if glyph.end > cursor {
      next = glyph.end
      break
    }
  }
  next
}

private fn normalize_boundary(text: Str, cursor: Int) Int {
  mut normalized = cursor
  if normalized < 0 {
    normalized = 0
  }
  if normalized > text.size() {
    normalized = text.size()
  }
  for glyph in glyphs(text) {
    if normalized > glyph.start and normalized < glyph.end {
      normalized = glyph.end
      break
    }
  }
  normalized
}

private fn remove_range(text: Str, start: Int, end: Int) Str {
  let before = text.slice(end: start).or("")
  let after = text.slice(start: end).or("")
  "{before}{after}"
}

private fn insert_at(text: Str, index: Int, inserted_text: Str) Str {
  let before = text.slice(end: index).or("")
  let after = text.slice(start: index).or("")
  "{before}{inserted_text}{after}"
}

private fn single_line(text: Str) Str {
  text.replace("\r\n", " ").replace("\r", " ").replace("\n", " ").replace("\t", "    ")
}

private fn constrained(value: Float32, available: Float32, mode: node::MeasureMode) Float32 {
  match mode {
    node::MeasureMode::exactly => available,
    node::MeasureMode::at_most => {
      if value > available {
        available
      } else {
        value
      }
    },
    node::MeasureMode::undefined => value,
  }
}

private fn measured_width(text: Str, measure: fn(Str) Int) Int {
  mut width = 0
  for glyph in glyphs(text) {
    width = width + measure(glyph.text)
  }
  width
}

private fn input_view(value: Str, placeholder: Str, cursor: Int, width: Int, measure: fn(Str) Int) View {
  if value.is_empty() {
    mut visible = ""
    mut visible_width = 0
    for glyph in glyphs(placeholder) {
      let glyph_width = measure(glyph.text)
      if visible_width + glyph_width <= width {
        visible = "{visible}{glyph.text}"
        visible_width = visible_width + glyph_width
      } else {
        break
      }
    }
    View{
      text: visible,
      cursor_x: 0,
      start: 0,
    }
  } else {
    let value_glyphs = glyphs(value)
    mut cursor_width = 0
    for glyph in value_glyphs {
      if glyph.end <= cursor {
        cursor_width = cursor_width + measure(glyph.text)
      }
    }

    mut start_index = 0
    mut dropped_width = 0
    if width > 0 {
      for glyph, index in value_glyphs {
        if cursor_width - dropped_width >= width {
          dropped_width = dropped_width + measure(glyph.text)
          start_index = index + 1
        } else {
          break
        }
      }
    }

    mut visible = ""
    mut visible_width = 0
    for glyph, index in value_glyphs {
      if index >= start_index {
        let glyph_width = measure(glyph.text)
        if visible_width + glyph_width <= width {
          visible = "{visible}{glyph.text}"
          visible_width = visible_width + glyph_width
        } else {
          break
        }
      }
    }

    let start = match value_glyphs.at(start_index) {
      glyph => glyph.start,
      _ => value.size(),
    }
    View{
      text: visible,
      cursor_x: cursor_width - dropped_width,
      start: start,
    }
  }
}

private fn cursor_for_column(value: Str, start: Int, column: Int, width: Int, measure: fn(Str) Int) Int {
  mut cursor = start
  mut x = 0
  mut locating = true
  for glyph in glyphs(value) {
    if locating and glyph.start >= start {
      let glyph_width = measure(glyph.text)
      if glyph_width < 0 or x + glyph_width > width {
        locating = false
      } else if glyph_width == 0 {
        cursor = glyph.end
      } else if column < x + glyph_width {
        if glyph_width > 1 and (column - x) * 2 >= glyph_width {
          cursor = glyph.end
        } else {
          cursor = glyph.start
        }
        locating = false
      } else {
        x = x + glyph_width
        cursor = glyph.end
      }
    }
  }
  cursor
}

fn new(ctx: mut context::Context, value: Str?, placeholder: Str?, initial_style: style::Style?) mut Input {
  let initial_value = single_line(value.or(""))
  let retained = ctx.create_node(initial_style.or(style::new(height: style::cells(1))))
  let input = mut Input{
    node_ref: retained,
    value_text: initial_value,
    placeholder: single_line(placeholder.or("")),
    cursor: initial_value.size(),
    width_measurer: ctx.width_measurer,
  }
  retained.bind(input)
  retained.set_focusable(true)
  retained.set_pointer_enabled(true)
  retained.set_measure(fn(measurement: node::MeasureInput) node::MeasureSize {
    mut display = input.value_text
    if display.is_empty() {
      display = input.placeholder
    }
    let desired_width = Float32::from(measured_width(display, input.width_measurer) + 1)
    let desired_height: Float32 = 1.0
    node::MeasureSize{
      width: constrained(desired_width, measurement.width, measurement.width_mode),
      height: constrained(desired_height, measurement.height, measurement.height_mode),
    }
  })
  input
}

impl node::Renderable for Input {
  fn node() mut node::Node {
    self.node_ref
  }

  fn paint(ctx: mut paint::Context) {
    let width = self.node_ref.layout().screen.width
    let view = input_view(
      self.value_text,
      self.placeholder,
      self.cursor,
      width,
      self.width_measurer,
    )
    ctx.write_measured(0, 0, view.text, self.width_measurer)
    if self.node_ref.is_focused() and width > 0 {
      ctx.show_cursor(view.cursor_x, 0)
    }
  }

  fn mut event(ctx: mut retained_event::Context) framework_event::EventResult {
    if ctx.phase != framework_event::EventPhase::target {
      framework_event::EventResult::ignored
    } else {
      match ctx.terminal_event {
        vaxis::Mouse(mouse) => self.handle_mouse(ctx, mouse),
        vaxis::Key(key) => {
          if ctx.focused {
            self.handle_key(ctx, key)
          } else {
            framework_event::EventResult::ignored
          }
        },
        _ => framework_event::EventResult::ignored,
      }
    }
  }
}

impl Input {
  fn value() Str {
    self.value_text
  }

  fn mut set_value(value: Str) {
    self.value_text = single_line(value)
    self.cursor = self.value_text.size()
    self.node_ref.mark_measure_dirty()
  }

  fn layout() geometry::Geometry {
    self.node_ref.layout()
  }

  private fn mut changed(ctx: mut retained_event::Context, text_changed: Bool) framework_event::EventResult {
    if text_changed {
      self.node_ref.mark_measure_dirty()
    } else {
      self.node_ref.request_redraw()
    }
    ctx.request_redraw()
    framework_event::EventResult::handled
  }

  private fn mut insert_text(ctx: mut retained_event::Context, text: Str) framework_event::EventResult {
    let inserted = single_line(text)
    if inserted.is_empty() {
      framework_event::EventResult::ignored
    } else {
      let desired_cursor = self.cursor + inserted.size()
      self.value_text = insert_at(self.value_text, self.cursor, inserted)
      self.cursor = normalize_boundary(self.value_text, desired_cursor)
      self.changed(ctx, true)
    }
  }

  private fn mut handle_mouse(ctx: mut retained_event::Context, mouse: vaxis::Mouse) framework_event::EventResult {
    if mouse.Button != vaxis::MouseLeftButton or mouse.EventType != vaxis::EventPress {
      framework_event::EventResult::ignored
    } else {
      let column = try ctx.local_x -> _ { framework_event::EventResult::ignored }
      let width = self.node_ref.layout().screen.width
      let view = input_view(
        self.value_text,
        self.placeholder,
        self.cursor,
        width,
        self.width_measurer,
      )
      self.cursor = normalize_boundary(
        self.value_text,
        cursor_for_column(self.value_text, view.start, column, width, self.width_measurer),
      )
      let _ = ctx.request_focus()
      self.changed(ctx, false)
    }
  }

  private fn mut handle_key(ctx: mut retained_event::Context, key: vaxis::Key) framework_event::EventResult {
    if key.EventType == vaxis::EventRelease {
      framework_event::EventResult::ignored
    } else if key.EventType == vaxis::EventPaste {
      self.insert_text(ctx, key.Text)
    } else if key.MatchString("Left") {
      self.cursor = previous_boundary(self.value_text, self.cursor)
      self.changed(ctx, false)
    } else if key.MatchString("Right") {
      self.cursor = next_boundary(self.value_text, self.cursor)
      self.changed(ctx, false)
    } else if key.MatchString("Home") {
      self.cursor = 0
      self.changed(ctx, false)
    } else if key.MatchString("End") {
      self.cursor = self.value_text.size()
      self.changed(ctx, false)
    } else if key.MatchString("Backspace") {
      if self.cursor > 0 {
        let previous = previous_boundary(self.value_text, self.cursor)
        self.value_text = remove_range(self.value_text, previous, self.cursor)
        self.cursor = normalize_boundary(self.value_text, previous)
      }
      self.changed(ctx, true)
    } else if key.MatchString("Delete") {
      if self.cursor < self.value_text.size() {
        let next = next_boundary(self.value_text, self.cursor)
        self.value_text = remove_range(self.value_text, self.cursor, next)
        self.cursor = normalize_boundary(self.value_text, self.cursor)
      }
      self.changed(ctx, true)
    } else {
      self.insert_text(ctx, key.Text)
    }
  }

  fn mut destroy() {
    self.node_ref.destroy()
  }
}
