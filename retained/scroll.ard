use cooper/event as framework_event
use cooper/retained/context
use cooper/retained/event as retained_event
use cooper/retained/node
use cooper/retained/paint
use cooper/retained/style
use go:go.rockorager.dev/vaxis

struct ScrollView {
  node_ref: mut node::Node,
  child_ref: mut node::Node,
  wheel_step: Int,
}

private fn positive(value: Int) Int {
  if value < 1 {
    1
  } else {
    value
  }
}

fn new(
  ctx: mut context::Context,
  child: mut node::Renderable,
  initial_style: style::Style?,
  wheel_step: Int?,
) mut ScrollView {
  let configured = mut initial_style.or(style::new())
  configured.overflow = style::Overflow::scroll
  let content = child.node()
  let retained = ctx.create_node(configured.@)
  let view = mut ScrollView{
    node_ref: retained,
    child_ref: content,
    wheel_step: positive(wheel_step.or(3)),
  }
  retained.bind(view)
  retained.set_pointer_enabled(true)
  retained.add(content)
  view
}

impl node::Renderable for ScrollView {
  fn node() mut node::Node {
    self.node_ref
  }

  fn paint(ctx: mut paint::Context) {}

  fn mut event(ctx: mut retained_event::Context) framework_event::EventResult {
    if ctx.phase == framework_event::EventPhase::capture or ctx.phase == framework_event::EventPhase::bubble and ctx.was_handled() {
      framework_event::EventResult::ignored
    } else {
      match ctx.terminal_event {
        vaxis::Mouse(mouse) => self.handle_mouse(ctx, mouse),
        _ => framework_event::EventResult::ignored,
      }
    }
  }
}

impl ScrollView {
  fn offset() Int {
    self.node_ref.scroll_y()
  }

  fn maximum_offset() Int {
    self.node_ref.max_scroll_y()
  }

  fn requested_offset() Int {
    self.node_ref.requested_scroll_y()
  }

  fn mut set_offset(offset: Int) Bool {
    self.node_ref.set_scroll_y(offset)
  }

  fn child() mut node::Node {
    self.child_ref
  }

  private fn mut handle_mouse(ctx: mut retained_event::Context, mouse: vaxis::Mouse) framework_event::EventResult {
    if mouse.EventType != vaxis::EventPress or mouse.Button != vaxis::MouseWheelUp and mouse.Button != vaxis::MouseWheelDown {
      framework_event::EventResult::ignored
    } else {
      mut delta = self.wheel_step
      if mouse.Button == vaxis::MouseWheelUp {
        delta = 0 - self.wheel_step
      }
      if self.node_ref.scroll_by(delta) {
        ctx.preserve_focus_scroll()
        ctx.request_redraw()
        framework_event::EventResult::handled
      } else {
        framework_event::EventResult::ignored
      }
    }
  }

  fn mut destroy() {
    self.node_ref.destroy()
  }
}
