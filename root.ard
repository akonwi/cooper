use cooper/core/event_delivery
use cooper/core/node
use cooper/core/paint
use cooper/runtime
use cooper/ui/style

struct Root {
  node_ref: mut node::Node,
}

impl node::Renderable for Root {
  fn node() mut node::Node {
    self.node_ref
  }

  fn mount(ctx: node::MountContext) {}

  fn paint(ctx: mut paint::Context) {}

  fn event(ctx: mut event_delivery::Context) event_delivery::Disposition {
    event_delivery::Disposition::ignored
  }
}

fn new(app_runtime: mut runtime::Runtime) mut Root {
  let retained_node = app_runtime.create_node(style::new())
  let created = mut Root{node_ref: retained_node}
  retained_node.bind(created)
  retained_node.mark_application_root()
  app_runtime.bind_root(retained_node)
  created
}

impl Root {
  fn mut add(child: mut node::Renderable, index: Int?) {
    match index {
      requested => {
        self.node_ref.add(child.node(), self.node_ref.public_child_index(requested, child.node()))
      },
      _ => self.node_ref.add(child.node()),
    }
  }

  fn mut remove(child: mut node::Renderable) Bool {
    self.node_ref.remove(child.node())
  }

  fn child_count() Int {
    self.node_ref.public_child_count()
  }
}
