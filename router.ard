use cooper/event as framework_event
use cooper/event as retained_event
use cooper/focus
use cooper/node
use go:go.rockorager.dev/vaxis

struct Pointer {
  x: Int,
  y: Int,
}

struct Outcome {
  handled: Bool,
  redraw: Bool,
  quit: Bool,
  preserve_focus_scroll: Bool,
}

private struct RouteEntry {
  owner: mut node::Node,
  generation: Int,
}

private fn path(root: mut node::Node, target: mut node::Node) [RouteEntry]? {
  let ascending = mut List::new<mut node::Node>()
  mut current = Maybe::new<mut node::Node>(target)
  mut found = false
  mut scanning = true
  while scanning {
    match current {
      retained => {
        ascending.push(retained)
        if retained == root {
          found = true
          scanning = false
        } else {
          current = retained.parent
        }
      },
      _ => { scanning = false },
    }
  }

  if not found {
    Maybe::new<[RouteEntry]>()
  } else {
    let routed = mut List::new<RouteEntry>()
    mut index = ascending.size()
    while index > 0 {
      index =- 1
      let owner = ascending.at(index).expect("retained routed ancestor")
      routed.push(RouteEntry{owner: owner, generation: owner.attachment_generation()})
    }
    Maybe::new<[RouteEntry]>(routed.@)
  }
}

private fn route_is_current(routed: [RouteEntry], tree_version: Int) Bool {
  mut current = true
  match routed.at(0) {
    root => {
      if root.owner.event_route_invalidated() or root.owner.attachment_tree_version() != tree_version {
        current = false
      }
    },
    _ => { current = false },
  }
  for entry, index in routed {
    let owner = entry.owner
    if (not owner.is_mounted()) or owner.attachment_generation() != entry.generation {
      current = false
      break
    }
    if index == 0 {
      if owner.parent.is_some() {
        current = false
        break
      }
    } else {
      let expected_parent = routed.at(index - 1).expect("route parent").owner
      match owner.parent {
        parent => {
          if parent.id != expected_parent.id {
            current = false
            break
          }
        },
        _ => {
          current = false
          break
        },
      }
    }
  }
  current
}

private fn attached_to(root: mut node::Node, current: mut node::Node) Bool {
  mut candidate = Maybe::new<mut node::Node>(current)
  mut attached = false
  mut scanning = true
  while scanning {
    match candidate {
      retained => {
        if retained == root {
          attached = true
          scanning = false
        } else {
          candidate = retained.parent
        }
      },
      _ => { scanning = false },
    }
  }
  attached
}

private fn deliver(
  root: mut node::Renderable,
  current: mut node::Node,
  phase: framework_event::EventPhase,
  received: vaxis::Event,
  pointer: Pointer?,
  focused: mut focus::State,
  state: mut retained_event::State,
) {
  if current.can_receive_events() and attached_to(root.node(), current) {
    mut local_x = Maybe::new<Int>()
    mut local_y = Maybe::new<Int>()
    match pointer {
      position => {
        let bounds = current.layout().screen
        local_x = Maybe::new<Int>(position.x - bounds.x)
        local_y = Maybe::new<Int>(position.y - bounds.y)
      },
      _ => (),
    }
    let ctx = retained_event::context(
      phase,
      received,
      local_x,
      local_y,
      focused.is_focused(current),
      state,
      focus_request: fn() Bool {
        focused.focus(root, current)
      },
      dispatch: current.attachment_dispatch(),
    )
    let tree_version_before: Int = root.node().attachment_tree_version()
    let result = current.owner_as_renderable().event(ctx)
    if result == framework_event::EventResult::handled {
      state.handled = true
    }
    if root.node().attachment_tree_version() != tree_version_before {
      state.propagation_stopped = true
    }
  }
}

private fn dispatch_path(
  root: mut node::Renderable,
  target: mut node::Node,
  received: vaxis::Event,
  pointer: Pointer?,
  focused: mut focus::State,
  routed: [RouteEntry],
  tree_version: Int,
) Outcome {
  let routed_root = root.node()
  let state = retained_event::new_state()
  routed_root.begin_event_route(fn() {
    state.propagation_stopped = true
  })

  mut index = 0
  while index + 1 < routed.size() and (not state.propagation_stopped) and route_is_current(routed, tree_version) {
    deliver(
      root,
      routed.at(index).expect("retained capture owner").owner,
      framework_event::EventPhase::capture,
      received,
      pointer,
      focused,
      state,
    )
    index =+ 1
  }

  if (not state.propagation_stopped) and route_is_current(routed, tree_version) {
    deliver(root, target, framework_event::EventPhase::target, received, pointer, focused, state)
  }

  if routed.size() > 1 {
    index = routed.size() - 1
    while index > 0 and (not state.propagation_stopped) and route_is_current(routed, tree_version) {
      index =- 1
      deliver(
        root,
        routed.at(index).expect("retained bubble owner").owner,
        framework_event::EventPhase::bubble,
        received,
        pointer,
        focused,
        state,
      )
    }
  }

  let outcome = Outcome{
    handled: state.handled,
    redraw: state.redraw,
    quit: state.quit,
    preserve_focus_scroll: state.preserve_focus_scroll,
  }
  routed_root.end_event_route()
  outcome
}

fn dispatch(
  root: mut node::Renderable,
  target: mut node::Node,
  received: vaxis::Event,
  pointer: Pointer?,
  focused: mut focus::State,
) Outcome {
  match path(root.node(), target) {
    routed => {
      let tree_version: Int = root.node().attachment_tree_version()
      dispatch_path(root, target, received, pointer, focused, routed, tree_version)
    },
    _ => {
      Outcome{
        handled: false,
        redraw: false,
        quit: false,
        preserve_focus_scroll: false,
      }
    },
  }
}
