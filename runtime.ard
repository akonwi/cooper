private fn vaxis_color(value: color::Color?) vaxis::Color {
  match value {
    color => {
      if color.terminal_default {
        vaxis::ColorDefault
      } else {
        match color.index {
          index => vaxis::IndexColor(Byte::from(index)),
          _ => {
            let packed = Uint32::from(color.red) * 65536 + Uint32::from(color.green) * 256 + Uint32::from(color.blue)
            vaxis::HexColor(packed)
          },
        }
      }
    },
    _ => vaxis::ColorDefault,
  }
}

private fn sanitize_terminal_title(value: Str) Str {
  mut sanitized = ""
  for character in value {
    if unicode::IsControl(Int32::from(character)) {
      sanitized = "{sanitized} "
    } else {
      sanitized = "{sanitized}{character}"
    }
  }
  sanitized
}

private fn vaxis_mouse_shape(cursor: event::MouseCursor) vaxis::MouseShape {
  match cursor {
    event::MouseCursor::pointer => vaxis::MouseShapeClickable,
    _ => vaxis::MouseShapeDefault,
  }
}

private fn terminal_progress_code(state: terminal_progress::State) Int {
  match state {
    terminal_progress::State::remove => 0,
    terminal_progress::State::normal => 1,
    terminal_progress::State::error => 2,
    terminal_progress::State::indeterminate => 3,
    terminal_progress::State::paused => 4,
  }
}

private fn vaxis_attributes(style: paint::CellStyle) vaxis::AttributeMask {
  mut attributes = vaxis::AttributeMask::from(0)
  if style.bold {
    attributes = attributes + vaxis::AttrBold
  }
  if style.dim {
    attributes = attributes + vaxis::AttrDim
  }
  if style.italic {
    attributes = attributes + vaxis::AttrItalic
  }
  if style.blink {
    attributes = attributes + vaxis::AttrBlink
  }
  if style.reverse {
    attributes = attributes + vaxis::AttrReverse
  }
  if style.strike {
    attributes = attributes + vaxis::AttrStrikethrough
  }
  if style.hidden {
    attributes = attributes + vaxis::AttrInvisible
  }
  attributes
}

private fn vaxis_style(style: paint::CellStyle) vaxis::Style {
  mut underline: vaxis::UnderlineStyle = vaxis::UnderlineOff
  if style.underline {
    underline = vaxis::UnderlineSingle
  }
  vaxis::Style{
    Hyperlink: style.hyperlink.or(""),
    Foreground: vaxis_color(style.foreground),
    Background: vaxis_color(style.background),
    UnderlineStyle: underline,
    Attribute: vaxis_attributes(style),
  }
}

private fn key_event_type(code: Int) event::KeyEventType {
  match code {
    1 => event::KeyEventType::repeat,
    2 => event::KeyEventType::release,
    _ => event::KeyEventType::press,
  }
}

private fn key_event(key: vaxis::Key) mut event::KeyEvent {
  let converted = bridge::Key(key)
  event::key(
    converted.Name,
    converted.Text,
    key_event_type(converted.EventType),
    event::Modifiers{
      shift: converted.Shift,
      ctrl: converted.Ctrl,
      alt: converted.Alt,
      super: converted.Super,
    },
  )
}

private fn mouse_event_type(code: Int) event::MouseEventType {
  match code {
    1 => event::MouseEventType::up,
    2 => event::MouseEventType::move,
    3 => event::MouseEventType::drag,
    4 => event::MouseEventType::drag_end,
    5 => event::MouseEventType::drop,
    6 => event::MouseEventType::over,
    7 => event::MouseEventType::out,
    8 => event::MouseEventType::scroll,
    _ => event::MouseEventType::down,
  }
}

private fn mouse_button(code: Int) event::MouseButton {
  match code {
    1 => event::MouseButton::left,
    2 => event::MouseButton::middle,
    3 => event::MouseButton::right,
    _ => event::MouseButton::none,
  }
}

private fn mouse_event(mouse: vaxis::Mouse) mut event::MouseEvent {
  let converted = bridge::Mouse(mouse)
  event::mouse(
    mouse_event_type(converted.EventType),
    mouse_button(converted.Button),
    converted.X,
    converted.Y,
    event::Modifiers{
      shift: converted.Shift,
      ctrl: converted.Ctrl,
      alt: converted.Alt,
      super: converted.Super,
    },
    scroll_x: converted.ScrollX,
    scroll_y: converted.ScrollY,
  )
}

private fn default_width(text: Str) Int {
  mut width = 0
  for character in vaxis::Characters(text) {
    width = width + character.Width
  }
  width
}

private fn reject_url(url: Str) Void!Error {
  Result::err(Error::new("URL opening is unavailable"))
}

private fn reject_notification(message: Str, title: Str?) Bool {
  false
}

private fn reject_terminal_progress(state: terminal_progress::State, percent: Int?) Bool {
  false
}

private fn ignore_terminal_title(value: Str) {}

struct KeyListener {
  id: Int,
  handler: fn(mut event::KeyEvent),
}

struct PasteListener {
  id: Int,
  handler: fn(mut event::PasteEvent),
}

struct TerminalFocusListener {
  id: Int,
  handler: fn(event::TerminalFocus),
}

struct SelectionListener {
  id: Int,
  handler: fn(public_selection::Selection?),
}

struct PendingSelection {
  revision: Int,
  value: public_selection::Selection?,
}

struct Runtime {
  clipboard: mut clipboard::Clipboard,
  dispatch: fn(fn()) Void!event::DispatchError,
  cancellation: Receiver<Void>,
  internal: Any,
}

private fn internal_state(runtime: mut Runtime) mut State {
  unsafe::cast<mut State>(runtime.internal).expect("Runtime must be created by Cooper")
}

private fn public_runtime(state: mut State) mut Runtime {
  (mut Runtime{
    clipboard: state.clipboard,
    dispatch: state.dispatch,
    cancellation: state.cancellation,
    internal: state,
  })
}

private struct State {
  clipboard: mut clipboard::Clipboard,
  dispatch: fn(fn()) Void!event::DispatchError,
  cancellation: Receiver<Void>,
  terminal: (mut vaxis::Vaxis)?,
  notification_action: fn(Str, Str?) Bool,
  terminal_progress_action: fn(terminal_progress::State, Int?) Bool,
  terminal_title_action: fn(Str),
  terminal_title_supported: Bool,
  render_request: fn(),
  width_measurer: fn(Str) Int,
  open_url_action: fn(Str) Void!Error,
  terminal_title: Str,
  terminal_title_initialized: Bool,
  terminal_progress_state: terminal_progress::State,
  terminal_progress_percent: Int?,
  terminal_io: mut sync::Mutex,
  terminal_suspended: Bool,
  terminal_closed: Bool,
  signal_watcher: (mut signalwatch::Watcher)?,
  system_wake: Chan<Bool>,
  animation_control_wake: Chan<Bool>,
  animation_frame_wake: Chan<Bool>,
  animation_frame_pending: Bool,
  animation_clock_initialized: Bool,
  animation_last_ms: Int64,
  animation_clock_generation: Int,
  animation_applied_clock_generation: Int,
  animation_execution_generation: Int,
  timelines: [mut animation::Timeline],
  pending_resize_cols: Int,
  pending_resize_rows: Int,
  lifecycle: mut sync::Mutex,
  // 0 ready, 1 running, 2 test, 3 destroyed, 4 destroying,
  // 5/6 suspended ready/running, 7/8 starting active/suspended,
  // 9/10 resuming ready/running, 11/12/13 suspending ready/running/starting,
  // 14/15 test suspended/resuming.
  phase: Int,
  resources_stopped: Bool,
  construction_committed: Bool,
  pump_started: Bool,
  test_flushing: Bool,
  shutdown: Chan<Bool>,
  wake: Chan<Bool>,
  updates: mut dispatch_runtime::DispatchQueue,
  cancellation_signal: Chan<Void>,
  cancellation_closed: Bool,
  startup_done: Chan<Void>,
  startup_published: Bool,
  startup_error: Error?,
  completion_done: Chan<Void>,
  completion_published: Bool,
  completion_error: Error?,
  next_node_id: Int,
  context_token: mut node::ContextToken,
  nodes: [mut node::Node],
  retained_destroyed: Bool,
  retained_running: Bool,
  root_node: (mut node::Node)?,
  pointer: mut pointer::State,
  pointer_cursor: event::MouseCursor,
  pointer_cursor_initialized: Bool,
  selection: mut selection_state::State,
  focused: mut focus::State,
  has_frame: Bool,
  post_frame_quit: Bool,
  suppress_focus_reveal: Bool,
  exit_on_ctrl_c: Bool,
  auto_focus: Bool,
  headless: Bool,
  detached: Bool,
  test_now_ms: Int64,
  headless_width: Int,
  headless_height: Int,
  last_frame: mut paint::Buffer,
  next_listener_id: Int,
  key_listeners: [KeyListener],
  paste_listeners: [PasteListener],
  live_paste_buffer: mut bridge::PasteBuffer,
  terminal_focus_state: event::TerminalFocus?,
  terminal_focus_listeners: [TerminalFocusListener],
  selection_listeners: [SelectionListener],
  painted_selection: public_selection::Selection?,
  pending_selection: PendingSelection?,
  selection_notifying: Bool,
  selection_clear_queued: Bool,
}

private fn state(
  terminal: (mut vaxis::Vaxis)?,
  clipboard: mut clipboard::Clipboard,
  notification_action: fn(Str, Str?) Bool,
  terminal_progress_action: fn(terminal_progress::State, Int?) Bool,
  terminal_title_action: fn(Str),
  terminal_title_supported: Bool,
  render_request: fn()?,
  width_measurer: (fn(Str) Int)?,
  open_url_action: fn(Str) Void!Error,
  signal_watcher: (mut signalwatch::Watcher)?,
  exit_on_ctrl_c: Bool,
  auto_focus: Bool,
  width: Int,
  height: Int,
  construction_committed: Bool,
  headless: Bool,
  detached: Bool,
) mut State {
  let terminal_io = mut sync::Mutex{}
  let lifecycle = mut sync::Mutex{}
  let updates = mut dispatch_runtime::new_dispatch_queue()
  let dispatch = fn(action: fn()) Void!event::DispatchError {
    if updates.post(action) {
      Result::ok(())
    } else {
      Result::err(event::DispatchError::stopped)
    }
  }
  let cancellation_signal = Chan::new<Void>()
  let wake = Chan::new<Bool>(1)
  let retained_render_request = render_request.or(fn() {
    select {
      wake.send(true) => (),
      _ => (),
    }
  })
  let retained_width_measurer = match width_measurer {
    measure => measure,
    _ => {
      match terminal {
        active_terminal => {
          fn(text: Str) Int {
            terminal_io.Lock()
            let width = active_terminal.RenderedWidth(text)
            terminal_io.Unlock()
            width
          }
        },
        _ => default_width,
      }
    },
  }
  (mut State{
    clipboard: clipboard,
    dispatch: dispatch,
    cancellation: cancellation_signal.receiver(),
    terminal: terminal,
    notification_action: notification_action,
    terminal_progress_action: terminal_progress_action,
    terminal_title_action: terminal_title_action,
    terminal_title_supported: terminal_title_supported,
    render_request: retained_render_request,
    width_measurer: retained_width_measurer,
    open_url_action: open_url_action,
    terminal_title: "",
    terminal_title_initialized: false,
    terminal_progress_state: terminal_progress::State::remove,
    terminal_progress_percent: Maybe::new<Int>(),
    terminal_io: terminal_io,
    terminal_suspended: false,
    terminal_closed: not terminal.is_some(),
    signal_watcher: signal_watcher,
    system_wake: Chan::new<Bool>(1),
    animation_control_wake: Chan::new<Bool>(1),
    animation_frame_wake: Chan::new<Bool>(1),
    animation_frame_pending: false,
    animation_clock_initialized: false,
    animation_last_ms: 0,
    animation_clock_generation: 0,
    animation_applied_clock_generation: 0,
    animation_execution_generation: 0,
    timelines: [],
    pending_resize_cols: 0,
    pending_resize_rows: 0,
    lifecycle: lifecycle,
    phase: 0,
    resources_stopped: false,
    construction_committed: construction_committed,
    pump_started: false,
    test_flushing: false,
    shutdown: Chan::new<Bool>(1),
    wake: wake,
    updates: updates,
    cancellation_signal: cancellation_signal,
    cancellation_closed: false,
    startup_done: Chan::new<Void>(),
    startup_published: false,
    startup_error: Maybe::new<Error>(),
    completion_done: Chan::new<Void>(),
    completion_published: false,
    completion_error: Maybe::new<Error>(),
    next_node_id: 1,
    context_token: node::new_context_token(),
    nodes: [],
    retained_destroyed: false,
    retained_running: false,
    root_node: Maybe::new<mut node::Node>(),
    pointer: pointer::new(),
    pointer_cursor: event::MouseCursor::default_cursor,
    pointer_cursor_initialized: false,
    selection: selection_state::new(),
    focused: focus::new(),
    has_frame: false,
    post_frame_quit: false,
    suppress_focus_reveal: false,
    exit_on_ctrl_c: exit_on_ctrl_c,
    auto_focus: auto_focus,
    headless: headless,
    detached: detached,
    test_now_ms: 0,
    headless_width: width,
    headless_height: height,
    last_frame: paint::new_buffer(width, height),
    next_listener_id: 1,
    key_listeners: [],
    paste_listeners: [],
    live_paste_buffer: bridge::NewPasteBuffer(),
    terminal_focus_state: Maybe::new<event::TerminalFocus>(),
    terminal_focus_listeners: [],
    selection_listeners: [],
    painted_selection: Maybe::new<public_selection::Selection>(),
    pending_selection: Maybe::new<PendingSelection>(),
    selection_notifying: false,
    selection_clear_queued: false,
  })
}

private fn new_live_state(exit_on_ctrl_c: Bool, auto_focus: Bool, use_mouse: Bool) (mut State)!Error {
  let watcher = signalwatch::New()
  match vaxis::New(vaxis::Options{DisableMouse: not use_mouse, NoSignals: true}) {
    ok(terminal) => {
      let backend = clipboardbridge::New(terminal)
      let clipboard = clipboard::internal_new(
        fn() Str!Error {
          backend.Read()
        },
        fn(value: Str) {
          backend.Write(value)
        },
        fn() {
          backend.Suspend()
        },
        fn() {
          backend.Resume()
        },
        fn() {
          backend.Cancel()
        },
      )
      let notification_backend = notificationbridge::New(terminal)
      let created = state(
        Maybe::new<mut vaxis::Vaxis>(terminal),
        clipboard,
        fn(message: Str, title: Str?) Bool {
          notification_backend.Notify(message, title.or(""))
        },
        fn(progress_state: terminal_progress::State, percent: Int?) Bool {
          notification_backend.SetProgress(
            terminal_progress_code(progress_state),
            percent.or(0),
            percent.is_some(),
          )
        },
        fn(value: Str) {
          terminal.SetTitle(value)
        },
        true,
        Maybe::new<fn()>(),
        Maybe::new<fn(Str) Int>(),
        fn(target: Str) Void!Error {
          urlopen::Open(target)
        },
        Maybe::new<mut signalwatch::Watcher>(watcher),
        exit_on_ctrl_c,
        auto_focus,
        0,
        0,
        false,
        false,
        false,
      )
      Result::ok(created)
    },
    err(error) => {
      watcher.Close()
      Result::err(error)
    },
  }
}

private fn new_headless_state(
  width: Int,
  height: Int,
  open_url: fn(Str) Void!Error,
  notification_action: fn(Str, Str?) Bool,
  terminal_progress_action: fn(terminal_progress::State, Int?) Bool,
  terminal_title_action: fn(Str),
) mut State {
  if width < 0 or height < 0 {
    panic("headless application dimensions must be non-negative")
  }
  let created = state(
    Maybe::new<mut vaxis::Vaxis>(),
    clipboard::internal_memory(),
    notification_action,
    terminal_progress_action,
    terminal_title_action,
    true,
    Maybe::new<fn()>(),
    Maybe::new<fn(Str) Int>(),
    open_url,
    Maybe::new<mut signalwatch::Watcher>(),
    true,
    true,
    width,
    height,
    true,
    true,
    false,
  )
  created
}

private fn new_detached_state(request_render: fn()?, width_measurer: (fn(Str) Int)?) mut State {
  let created = state(
    Maybe::new<mut vaxis::Vaxis>(),
    clipboard::internal_memory(),
    reject_notification,
    reject_terminal_progress,
    ignore_terminal_title,
    false,
    request_render,
    width_measurer,
    reject_url,
    Maybe::new<mut signalwatch::Watcher>(),
    true,
    true,
    0,
    0,
    true,
    true,
    true,
  )
  created.updates.stop()
  created
}

impl State {
  fn mut create_node(initial_style: style::Style) mut node::Node {
    self.lifecycle.Lock()
    let destroyed = self.retained_destroyed
    self.lifecycle.Unlock()
    if destroyed {
      panic("cannot create a retained Node from a destroyed Runtime")
    }
    let created = node::create(
      self.next_node_id,
      self.context_token,
      initial_style,
      self.render_request,
      self.focus_request(),
      self.blur_request(),
      self.selection_start_request(),
      self.selection_update_request(),
      self.selection_owns_request(),
      self.selection_clear_request(),
      fn(destroyed_id: Int) {
        self.release_node(destroyed_id)
      },
    )
    self.next_node_id =+ 1
    self.nodes.push(created)
    created
  }

  private fn mut release_node(destroyed_id: Int) {
    let retained = mut List::new<mut node::Node>()
    for current in self.nodes {
      if current.id != destroyed_id {
        retained.push(current)
      }
    }
    self.nodes = retained.@
  }

  fn mut node_count() Int {
    self.nodes.size()
  }

  fn mut is_retained_destroyed() Bool {
    self.lifecycle.Lock()
    let destroyed = self.retained_destroyed
    self.lifecycle.Unlock()
    destroyed
  }

  fn mut is_destroyed() Bool {
    self.is_retained_destroyed()
  }

  private fn mut begin_run() {
    self.lifecycle.Lock()
    let available = (not self.retained_destroyed) and not self.retained_running
    if available {
      self.retained_running = true
    }
    self.lifecycle.Unlock()
    if not available {
      panic("retained Runtime is not available to run")
    }
  }

  private fn mut end_run() {
    self.lifecycle.Lock()
    self.retained_running = false
    self.lifecycle.Unlock()
  }

  fn mut measure_text(text: Str) Int {
    self.width_measurer(text)
  }

  fn mut compute_layout(root: mut node::Renderable, width: Int, height: Int) {
    self.lifecycle.Lock()
    let destroyed = self.retained_destroyed
    self.lifecycle.Unlock()
    if destroyed {
      panic("cannot lay out with a destroyed Runtime")
    }
    if root.node().context_token != self.context_token {
      panic("cannot lay out a retained tree from another Runtime")
    }
    if root.node().parent.is_some() {
      panic("only a detached retained root can be laid out")
    }
    root.node().compute(width, height)
  }

  fn mut destroy_retained() {
    self.lifecycle.Lock()
    let running = self.retained_running
    let should_destroy = not self.retained_destroyed
    if should_destroy and not running {
      self.retained_destroyed = true
    }
    self.lifecycle.Unlock()
    if running {
      panic("cannot destroy a running retained Runtime")
    }
    if should_destroy {
      let owned = self.nodes
      self.nodes = []
      for retained in owned {
        retained.destroy_from_context()
      }
    }
  }

  fn mut destroy_detached() {
    self.lifecycle.Lock()
    let detached = self.detached
    let stopped = self.resources_stopped
    self.lifecycle.Unlock()
    if not detached {
      panic("only a detached Runtime can be destroyed without an App")
    }
    if not stopped {
      self.stop_resources()
    }
  }

  private fn mut now_ms() Int64 {
    if self.headless {
      self.test_now_ms
    } else {
      clock::Milliseconds()
    }
  }

  private fn mut animation_wake() fn() {
    let wake = self.animation_control_wake
    fn() {
      select {
        wake.send(true) => (),
        _ => (),
      }
    }
  }

  fn mut timeline(duration: Int, loop: Bool?, alternate: Bool?, on_complete: fn()?) mut animation::Timeline {
    if duration <= 0 {
      panic("Timeline duration must be positive")
    }
    self.lifecycle.Lock()
    defer self.lifecycle.Unlock()
    let available = (not self.retained_destroyed) and (not self.resources_stopped) and (not self.detached) and self.phase != 3 and self.phase != 4
    if not available {
      panic("cannot create a Timeline without an active App Runtime")
    }
    self.prune_animations()
    let created = animation::internal_new(
      duration,
      self.animation_wake(),
      loop: loop,
      alternate: alternate,
      on_complete: on_complete,
    )
    self.timelines.push(created)
    created
  }

  private fn mut prune_animations() {
    let retained = mut List::new<mut animation::Timeline>()
    for timeline in self.timelines {
      if not timeline.internal_destroyed() {
        retained.push(timeline)
      }
    }
    self.timelines = retained.@
  }

  private fn mut animations_active() Bool {
    mut active = false
    for timeline in self.timelines {
      if timeline.internal_active() {
        active = true
      }
    }
    active
  }

  private fn mut reset_animation_clock() {
    self.animation_clock_initialized = false
    self.animation_last_ms = 0
  }

  private fn mut wake_animations_after_failed_suspend(previous_phase: Int) {
    if previous_phase == 1 {
      (self.animation_wake())()
      (self.request_render())()
    }
  }

  private fn mut request_animation_clock_reset() {
    self.lifecycle.Lock()
    self.animation_clock_generation =+ 1
    self.lifecycle.Unlock()
    (self.animation_wake())()
  }

  private fn mut apply_animation_clock_reset() {
    self.lifecycle.Lock()
    let generation = self.animation_clock_generation
    self.lifecycle.Unlock()
    if generation != self.animation_applied_clock_generation {
      self.animation_applied_clock_generation = generation
      self.reset_animation_clock()
    }
  }

  private fn mut schedule_animation_frame() {
    if (not self.animation_frame_pending) and self.animations_active() {
      self.animation_frame_pending = true
      let now = self.now_ms()
      mut delay = Int64::from(0)
      if self.animation_clock_initialized {
        let elapsed = now - self.animation_last_ms
        if elapsed < 16 {
          delay = 16 - elapsed
        }
      }
      let wake = self.animation_frame_wake
      async::start(fn() {
        clock::SleepMilliseconds(delay)
        select {
          wake.send(true) => (),
          _ => (),
        }
      })
    }
  }

  private fn mut claim_animation_frame() Int? {
    self.lifecycle.Lock()
    let generation = match self.phase == 1 {
      true => Maybe::new<Int>(self.animation_execution_generation),
      false => Maybe::new<Int>(),
    }
    self.lifecycle.Unlock()
    generation
  }

  private fn mut animation_frame_valid(generation: Int) Bool {
    self.lifecycle.Lock()
    let valid = self.phase == 1 and self.animation_execution_generation == generation
    self.lifecycle.Unlock()
    valid
  }

  private fn mut advance_animations(now: Int64, allow: fn() Bool) Bool {
    mut changed = false
    if allow() {
      self.apply_animation_clock_reset()
      mut delta = 0
      if self.animation_clock_initialized {
        let elapsed = now - self.animation_last_ms
        if elapsed > 0 {
          delta = clock::IntFromInt64(elapsed).expect("animation frame delta exceeds Int range")
        }
      }
      self.animation_clock_initialized = true
      self.animation_last_ms = now

      let initial_size = self.timelines.size()
      let candidates = self.timelines
      let retained = mut List::new<mut animation::Timeline>()
      for timeline in candidates {
        if allow() and not timeline.internal_destroyed() {
          if timeline.internal_tick(delta, allow) {
            changed = true
          }
        }
        if not timeline.internal_destroyed() {
          retained.push(timeline)
        }
      }
      mut index = initial_size
      while index < self.timelines.size() {
        match self.timelines.at(index) {
          timeline => {
            if not timeline.internal_destroyed() {
              retained.push(timeline)
            }
          },
          _ => (),
        }
        index =+ 1
      }
      self.timelines = retained.@
      if not self.animations_active() {
        self.reset_animation_clock()
      }
    }
    changed
  }

  private fn mut destroy_animations() {
    let retained = self.timelines
    self.timelines = []
    for timeline in retained {
      timeline.destroy()
    }
    self.animation_frame_pending = false
    self.reset_animation_clock()
  }

  fn mut mouse_cursor() event::MouseCursor {
    self.terminal_io.Lock()
    let cursor = self.pointer_cursor
    self.terminal_io.Unlock()
    cursor
  }

  private fn mut update_pointer_cursor(root: mut node::Renderable) Bool {
    self.terminal_io.Lock()
    let next = self.pointer.mouse_cursor(root)
    mut changed = false
    if (not self.pointer_cursor_initialized) or next != self.pointer_cursor {
      self.pointer_cursor = next
      self.pointer_cursor_initialized = true
      if self.live_rendering() {
        match self.terminal {
          terminal => terminal.SetMouseShape(vaxis_mouse_shape(next)),
          _ => (),
        }
      }
      changed = true
    }
    self.terminal_io.Unlock()
    changed
  }

  fn mut failed_suspend_animation_wake_test() Bool {
    self.require_phase(2)
    let controls = self.animation_control_wake.receiver()
    mut draining = true
    while draining {
      select {
        controls.recv() => (),
        _ => { draining = false },
      }
    }
    self.drain_redraw_requests()
    self.wake_animations_after_failed_suspend(1)
    let animation_woken = select {
      controls.recv() => true,
      _ => false,
    }
    let redraws = self.wake.receiver()
    let redraw_woken = select {
      redraws.recv() => true,
      _ => false,
    }
    animation_woken and redraw_woken
  }

  fn mut advance_time_test(delta_ms: Int) {
    self.lifecycle.Lock()
    let phase = self.phase
    self.lifecycle.Unlock()
    let active = phase == 2
    if phase != 2 and phase != 14 {
      panic("headless time advance requires an active or suspended TestApp (phase {phase})")
    }
    if delta_ms < 0 {
      panic("headless time advance must be non-negative")
    }
    self.test_now_ms = self.test_now_ms + Int64::from(delta_ms)
    if active {
      let _ = self.advance_animations(self.test_now_ms, fn() Bool {
        true
      })
    }
  }

  fn mut bind_root(root: mut node::Node) {
    if self.root_node.is_some() {
      panic("application runtime Root is already bound")
    }
    if root.context_token != self.context_token {
      panic("cannot bind a Root from another Runtime")
    }
    self.root_node = Maybe::new<mut node::Node>(root)
  }

  private fn mut owns_root(root: mut node::Renderable) Bool {
    match self.root_node {
      bound => bound == root.node() and root.node().context_token == self.context_token,
      _ => false,
    }
  }

  private fn mut require_root(root: mut node::Renderable) Void!Error {
    if self.owns_root(root) and not self.is_retained_destroyed() {
      Result::ok(())
    } else {
      Result::err(Error::new("application Root does not belong to this Runtime"))
    }
  }

  private fn mut focus_node(target_id: Int) Bool {
    match self.root_node {
      root => {
        match root.find(target_id) {
          target => self.focused.focus(root.owner_as_renderable(), target),
          _ => false,
        }
      },
      _ => false,
    }
  }

  private fn mut blur_node(target_id: Int) {
    match self.focused.focused() {
      target => {
        if target.id == target_id {
          self.focused.blur(target)
        }
      },
      _ => (),
    }
  }

  fn mut focus_request() fn(Int) Bool {
    fn(target_id: Int) Bool {
      self.focus_node(target_id)
    }
  }

  fn mut blur_request() fn(Int) {
    fn(target_id: Int) {
      self.blur_node(target_id)
    }
  }

  private fn mut start_selection_node(target_id: Int, local_x: Int, local_y: Int) Bool {
    match self.root_node {
      root => {
        match root.find(target_id) {
          target => {
            let bounds = target.layout().screen
            let changed = self.selection.start(
              root.owner_as_renderable(),
              target,
              bounds.x + local_x,
              bounds.y + local_y,
            )
            if changed {
              (self.request_render())()
            }
            changed
          },
          _ => false,
        }
      },
      _ => false,
    }
  }

  private fn mut update_selection_node(target_id: Int, local_x: Int, local_y: Int, finish: Bool) Bool {
    match self.root_node {
      root => {
        match root.find(target_id) {
          target => {
            let bounds = target.layout().screen
            let generation = self.selection.generation()
            let changed = self.selection.update(
              Maybe::new<mut node::Node>(target),
              bounds.x + local_x,
              bounds.y + local_y,
            )
            if finish {
              match generation {
                expected => {
                  let _ = self.selection.finish(expected)
                },
                _ => (),
              }
            }
            if changed {
              (self.request_render())()
            }
            changed
          },
          _ => false,
        }
      },
      _ => false,
    }
  }

  private fn mut selection_owned_by(target_id: Int) Bool {
    match self.root_node {
      root => {
        match root.find(target_id) {
          target => self.selection.owns(target),
          _ => false,
        }
      },
      _ => false,
    }
  }

  fn mut selection_start_request() fn(Int, Int, Int) Bool {
    fn(target_id: Int, local_x: Int, local_y: Int) Bool {
      self.start_selection_node(target_id, local_x, local_y)
    }
  }

  fn mut selection_update_request() fn(Int, Int, Int, Bool) Bool {
    fn(target_id: Int, local_x: Int, local_y: Int, finish: Bool) Bool {
      self.update_selection_node(target_id, local_x, local_y, finish)
    }
  }

  fn mut selection_owns_request() fn(Int) Bool {
    fn(target_id: Int) Bool {
      self.selection_owned_by(target_id)
    }
  }

  fn mut selection_clear_request() fn() {
    fn() {
      self.clear_selection()
    }
  }

  fn mut commit_construction() {
    self.lifecycle.Lock()
    if self.phase != 0 or self.construction_committed {
      self.lifecycle.Unlock()
      panic("application runtime construction cannot be committed")
    }
    self.construction_committed = true
    self.lifecycle.Unlock()
  }

  private fn mut close_cancellation() {
    self.lifecycle.Lock()
    let close = not self.cancellation_closed
    if close {
      self.cancellation_closed = true
    }
    self.lifecycle.Unlock()
    if close {
      self.cancellation_signal.close()
    }
  }

  private fn mut publish_startup(error: Error?) {
    self.lifecycle.Lock()
    let publish = not self.startup_published
    if publish {
      self.startup_published = true
      self.startup_error = error
    }
    self.lifecycle.Unlock()
    if publish {
      self.startup_done.close()
    }
  }

  private fn mut startup_result() Void!Error {
    self.startup_done.recv()
    self.lifecycle.Lock()
    let error = self.startup_error
    self.lifecycle.Unlock()
    match error {
      failure => Result::err(failure),
      _ => Result::ok(()),
    }
  }

  private fn mut publish_completion(error: Error?) {
    self.lifecycle.Lock()
    let publish = not self.completion_published
    if publish {
      self.completion_published = true
      self.completion_error = error
    }
    self.lifecycle.Unlock()
    if publish {
      self.completion_done.close()
    }
  }

  private fn mut completion_result() Void!Error {
    self.completion_done.recv()
    self.lifecycle.Lock()
    let error = self.completion_error
    self.lifecycle.Unlock()
    match error {
      failure => Result::err(failure),
      _ => Result::ok(()),
    }
  }

  fn mut rollback_construction() {
    self.lifecycle.Lock()
    let should_stop = self.phase == 0 and (not self.construction_committed) and (not self.resources_stopped)
    if should_stop {
      self.phase = 3
      self.resources_stopped = true
    }
    self.lifecycle.Unlock()

    if should_stop {
      self.updates.stop()
      self.key_listeners = []
      self.paste_listeners = []
      self.terminal_focus_listeners = []
      self.selection_listeners = []
      self.pointer.clear()
      self.selection.destroy()
      self.clipboard.internal_stop()
      self.close_cancellation()
      self.terminal_io.Lock()
      self.pointer_cursor = event::MouseCursor::default_cursor
      self.pointer_cursor_initialized = false
      match self.terminal {
        terminal => terminal.Close(),
        _ => (),
      }
      self.terminal_closed = true
      self.terminal_io.Unlock()
      match self.signal_watcher {
        watcher => watcher.Close(),
        _ => (),
      }
      self.publish_completion(Maybe::new<Error>())
    }
  }

  private fn mut begin_phase(expected_terminal: Bool, next_phase: Int) {
    self.lifecycle.Lock()
    let valid = self.phase == 0 and self.construction_committed and self.terminal.is_some() == expected_terminal
    if valid {
      self.phase = next_phase
    }
    self.lifecycle.Unlock()
    if not valid {
      panic("application runtime is not available to start")
    }
  }

  private fn mut require_phase(expected: Int) {
    self.lifecycle.Lock()
    let valid = self.phase == expected
    self.lifecycle.Unlock()
    if not valid {
      panic("application runtime is not active")
    }
  }

  private fn mut request_live_destroy() Bool {
    self.lifecycle.Lock()
    mut finish_now = false
    mut request_shutdown = false
    mut stop_dispatch = false
    if self.phase == 4 and (not self.pump_started) and (not self.resources_stopped) {
      finish_now = true
      stop_dispatch = true
    } else if (self.phase == 0 or self.phase == 5 or self.phase == 9 or self.phase == 11) and not self.pump_started {
      self.phase = 4
      finish_now = true
      stop_dispatch = true
    } else if self.phase == 1 or self.phase == 6 or self.phase == 7 or self.phase == 8 or self.phase == 9 or self.phase == 10 or self.phase == 11 or self.phase == 12 or self.phase == 13 {
      self.phase = 4
      request_shutdown = true
      stop_dispatch = true
    }
    self.lifecycle.Unlock()

    if stop_dispatch {
      self.clipboard.internal_cancel()
      self.updates.stop()
    }
    if request_shutdown {
      select {
        self.shutdown.send(true) => (),
        _ => (),
      }
    }
    finish_now
  }

  private fn mut claim_test_destroy() Bool {
    self.lifecycle.Lock()
    mut finish_now = false
    mut stop_dispatch = false
    if self.phase == 2 or self.phase == 14 or self.phase == 15 {
      stop_dispatch = true
      if self.test_flushing {
        self.phase = 4
      } else {
        self.phase = 3
        finish_now = true
      }
    }
    self.lifecycle.Unlock()
    if stop_dispatch {
      self.clipboard.internal_cancel()
      self.updates.stop()
    }
    finish_now
  }

  private fn mut test_stopping() Bool {
    self.lifecycle.Lock()
    let stopping = self.phase == 4
    self.lifecycle.Unlock()
    stopping
  }

  private fn mut test_active() Bool {
    self.lifecycle.Lock()
    let active = self.phase == 2
    self.lifecycle.Unlock()
    active
  }

  private fn mut callbacks_active() Bool {
    self.lifecycle.Lock()
    let active = self.phase == 1 or self.phase == 2
    self.lifecycle.Unlock()
    active
  }

  private fn mut begin_test_flush() {
    self.lifecycle.Lock()
    let valid = self.phase == 2 and not self.test_flushing
    if valid {
      self.test_flushing = true
    }
    self.lifecycle.Unlock()
    if not valid {
      panic("headless application runtime cannot flush")
    }
  }

  private fn mut end_test_flush() Bool {
    self.lifecycle.Lock()
    self.test_flushing = false
    let finish_destroy = self.phase == 4
    self.lifecycle.Unlock()
    finish_destroy
  }

  private fn mut live_rendering() Bool {
    self.lifecycle.Lock()
    let active = self.phase == 1
    self.lifecycle.Unlock()
    active
  }

  private fn mut live_stopping() Bool {
    self.lifecycle.Lock()
    let stopping = self.phase == 4
    self.lifecycle.Unlock()
    stopping
  }

  private fn mut finish_test(root: mut node::Renderable) {
    root.node().unmount_root()
    self.end_run()
    self.stop_resources()
  }

  private fn mut stop_resources(error: Error?) {
    self.lifecycle.Lock()
    let should_stop = not self.resources_stopped
    if should_stop {
      self.resources_stopped = true
      self.phase = 3
    }
    self.lifecycle.Unlock()

    if should_stop {
      self.updates.stop()
      self.key_listeners = []
      self.paste_listeners = []
      self.live_paste_buffer.Reset()
      self.terminal_focus_listeners = []
      self.selection_listeners = []
      self.pointer.clear()
      self.selection.destroy()
      self.clipboard.internal_stop()
      self.close_cancellation()
      self.destroy_animations()
    }

    let final_error = self.release_terminal(error)
    if should_stop {
      self.destroy_retained()
      self.publish_completion(final_error)
    }
  }

  private fn mut release_terminal(error: Error?) Error? {
    mut final_error = error
    self.terminal_io.Lock()
    self.pointer_cursor = event::MouseCursor::default_cursor
    self.pointer_cursor_initialized = false
    if self.headless {
      self.clear_terminal_progress_locked()
    }
    if not self.terminal_closed {
      mut close_terminal = true
      match self.terminal {
        terminal => {
          if self.terminal_suspended {
            match terminal.Resume() {
              ok(_) => { self.terminal_suspended = false },
              err(resume_error) => {
                close_terminal = false
                if not final_error.is_some() {
                  final_error = Maybe::new<Error>(resume_error)
                }
              },
            }
          }
          if close_terminal {
            self.clear_terminal_progress_locked()
            terminal.Close()
            self.terminal_closed = true
          }
        },
        _ => { self.terminal_closed = true },
      }
    }
    let terminal_finished = self.terminal_closed
    self.terminal_io.Unlock()

    if terminal_finished {
      match self.signal_watcher {
        watcher => watcher.Close(),
        _ => (),
      }
    }
    final_error
  }

  private fn mut terminal_cleanup_pending() Bool {
    self.lifecycle.Lock()
    let cleanup_started = self.resources_stopped or self.phase == 4 and (not self.pump_started)
    self.lifecycle.Unlock()
    self.terminal_io.Lock()
    let pending = cleanup_started and not self.terminal_closed
    self.terminal_io.Unlock()
    pending
  }

  private fn mut take_redraw_request() Bool {
    let pending = self.wake.receiver()
    select {
      pending.recv() => true,
      _ => false,
    }
  }

  private fn mut drain_redraw_requests() {
    let pending = self.wake.receiver()
    mut draining = true
    while draining {
      select {
        pending.recv() => (),
        _ => { draining = false },
      }
    }
  }

  private fn mut apply_pending_resize_locked(terminal: mut vaxis::Vaxis) Bool {
    self.lifecycle.Lock()
    let cols = self.pending_resize_cols
    let rows = self.pending_resize_rows
    self.pending_resize_cols = 0
    self.pending_resize_rows = 0
    self.lifecycle.Unlock()
    if cols > 0 and rows > 0 {
      let current = terminal.Size()
      terminal.Resize(
        vaxis::Resize{
          Cols: cols,
          Rows: rows,
          XPixel: current.XPixel,
          YPixel: current.YPixel,
        },
      )
      true
    } else {
      false
    }
  }

  private fn mut draw(root: mut node::Renderable, width: Int, height: Int) mut paint::Buffer {
    self.compute_layout(root, width, height)
    self.focused.reconcile(root)
    let focus_changed = self.focused.take_reveal_request()
    if focus_changed or not self.suppress_focus_reveal {
      match self.focused.focused() {
        target => {
          let _ = focus::reveal(root, target)
        },
        _ => (),
      }
    }
    self.suppress_focus_reveal = false
    self.selection.reconcile(root)
    let selected = self.selection.current()
    if not public_selection::internal_same(self.painted_selection, selected) {
      self.painted_selection = selected
      self.pending_selection = Maybe::new<PendingSelection>(
        PendingSelection{revision: self.selection.revision(), value: selected},
      )
    }
    let buffer = paint::new_buffer(width, height)
    root.node().paint(buffer)
    self.last_frame = buffer
    self.has_frame = true
    self.drain_redraw_requests()
    buffer
  }

  private fn mut present(terminal: mut vaxis::Vaxis, buffer: mut paint::Buffer) {
    let window = terminal.Window()
    window.Clear()
    terminal.HideCursor()
    if buffer.width > 0 {
      for cell, index in buffer.cells {
        if cell.width > 0 {
          let x = index % buffer.width
          let y = index / buffer.width
          window.SetCell(
            x,
            y,
            vaxis::Cell{
              Character: vaxis::Character{Grapheme: cell.grapheme, Width: cell.width},
              Style: vaxis_style(cell.style),
            },
          )
        }
      }
    }
    match buffer.cursor {
      cursor => {
        match buffer.cell_at(cursor.x, cursor.y) {
          cell => {
            if cell.width > 0 {
              window.ShowCursor(cursor.x, cursor.y, vaxis::CursorStyle::from(vaxis::CursorBeam))
            }
          },
          _ => (),
        }
      },
      _ => (),
    }
    terminal.Render()
  }

  private fn mut post_frame_pointer(root: mut node::Renderable) {
    let outcome = self.pointer.reconcile(root, self.focused)
    self.apply_outcome(outcome)
    let cursor_changed = self.update_pointer_cursor(root)
    if outcome.redraw or cursor_changed {
      (self.request_render())()
    }
    if outcome.quit {
      self.post_frame_quit = true
    }
  }

  private fn mut post_frame_selection() {
    mut deferred = false
    if self.pending_selection.is_some() and self.take_redraw_request() {
      deferred = true
      if self.callbacks_active() {
        (self.request_render())()
      }
    }
    if not deferred {
      match self.pending_selection {
        pending => {
          self.pending_selection = Maybe::new<PendingSelection>()
          if pending.revision == self.selection.revision() {
            let listeners = self.selection_listeners
            self.selection_notifying = true
            for listener in listeners {
              if self.callbacks_active() {
                listener.handler(pending.value)
              }
            }
            self.selection_notifying = false
            if self.selection_clear_queued {
              self.selection_clear_queued = false
              if self.callbacks_active() and self.selection.clear() {
                (self.request_render())()
              }
            }
          } else {
            (self.request_render())()
          }
        },
        _ => (),
      }
    }
  }

  private fn mut paint_live(root: mut node::Renderable) {
    let terminal = self.terminal.expect("live application terminal")
    self.terminal_io.Lock()
    mut width = 0
    mut height = 0
    let active = self.live_rendering()
    if active {
      let window = terminal.Window()
      width = window.Width
      height = window.Height
    }
    self.terminal_io.Unlock()
    if active {
      let buffer = self.draw(root, width, height)
      self.terminal_io.Lock()
      let present = self.live_rendering()
      if present {
        self.present(terminal, buffer)
      }
      self.terminal_io.Unlock()
      if present {
        self.post_frame_pointer(root)
        self.post_frame_selection()
      }
    }
  }

  private fn mut paint_test(root: mut node::Renderable) {
    let _ = self.draw(root, self.headless_width, self.headless_height)
    self.post_frame_pointer(root)
    self.post_frame_selection()
  }

  private fn mut apply_outcome(outcome: router::Outcome) {
    if outcome.preserve_focus_scroll {
      self.suppress_focus_reveal = true
    }
  }

  private fn mut drain_updates() Int {
    mut drained = 0
    mut draining = true
    while draining and drained < 64 {
      match self.updates.pop() {
        action => {
          action()
          drained =+ 1
        },
        _ => { draining = false },
      }
    }
    self.updates.wake_if_pending()
    drained
  }
}

impl State {
  private fn mut handle_system_shutdown() {
    self.lifecycle.Lock()
    let defer_app_cleanup = (not self.pump_started) and (not self.resources_stopped) and (self.phase == 0 or self.phase == 4 or self.phase == 5 or self.phase == 9 or self.phase == 11)
    if defer_app_cleanup {
      self.phase = 4
    }
    self.lifecycle.Unlock()

    if defer_app_cleanup {
      self.updates.stop()
      self.clipboard.internal_stop()
      self.close_cancellation()
      let _ = self.release_terminal(Maybe::new<Error>())
    } else {
      self.destroy_live()
    }
  }

  fn mut start_signal_monitor() {
    match self.signal_watcher {
      watcher => {
        async::start(fn() {
          let events = watcher.Events()
          mut watching = true
          while watching {
            match events.recv() {
              signaled => {
                mut draining = true
                while draining {
                  let received = watcher.Next()
                  if received.Kind == signalwatch::Shutdown {
                    self.handle_system_shutdown()
                    draining = false
                  } else if received.Kind == signalwatch::Resize {
                    self.lifecycle.Lock()
                    let available = self.phase != 3 and self.phase != 4
                    if available {
                      self.pending_resize_cols = received.Cols
                      self.pending_resize_rows = received.Rows
                    }
                    self.lifecycle.Unlock()
                    if available {
                      select {
                        self.system_wake.send(true) => (),
                        _ => (),
                      }
                    }
                  } else {
                    draining = false
                  }
                }
              },
              _ => { watching = false },
            }
          }
        })
      },
      _ => (),
    }
  }

  fn mut request_render() fn() {
    self.render_request
  }

  fn mut open_url(target: Str) Void!Error {
    self.lifecycle.Lock()
    defer self.lifecycle.Unlock()
    let available = (not self.retained_destroyed) and (not self.resources_stopped) and self.phase != 3 and self.phase != 4
    if available {
      self.open_url_action(target)
    } else {
      Result::err(Error::new("cannot open a URL from a destroyed Runtime"))
    }
  }

  fn mut set_title(value: Str) Bool {
    let normalized = sanitize_terminal_title(value)
    self.terminal_io.Lock()
    defer self.terminal_io.Unlock()
    self.lifecycle.Lock()
    defer self.lifecycle.Unlock()
    let active = self.phase == 0 or self.phase == 1 or self.phase == 2 or self.phase == 5 or self.phase == 6 or self.phase == 7 or self.phase == 8 or self.phase == 14
    let accepted = active and self.terminal_title_supported and (not self.resources_stopped) and (not self.retained_destroyed)
    if accepted and ((not self.terminal_title_initialized) or self.terminal_title != normalized) {
      self.terminal_title = normalized
      self.terminal_title_initialized = true
      self.terminal_title_action(normalized)
    }
    accepted
  }

  fn mut notify(message: Str, title: Str?) Bool {
    mut normalized = title
    match title {
      value => {
        if value == "" {
          normalized = Maybe::new<Str>()
        }
      },
      _ => (),
    }
    self.lifecycle.Lock()
    defer self.lifecycle.Unlock()
    let active = self.phase == 0 or self.phase == 1 or self.phase == 2 or self.phase == 7
    mut accepted = false
    if active and not self.resources_stopped {
      accepted = (self.notification_action)(message, normalized)
    }
    accepted
  }

  fn mut progress(progress_state: terminal_progress::State, percent: Int?) Bool {
    match percent {
      value => {
        if value < 0 or value > 100 {
          panic("terminal progress percent must be between 0 and 100")
        }
      },
      _ => (),
    }
    match progress_state {
      terminal_progress::State::remove => {
        if percent.is_some() {
          panic("removed terminal progress cannot include a percent")
        }
      },
      terminal_progress::State::normal => {
        if not percent.is_some() {
          panic("normal terminal progress requires a percent")
        }
      },
      terminal_progress::State::indeterminate => {
        if percent.is_some() {
          panic("indeterminate terminal progress cannot include a percent")
        }
      },
      terminal_progress::State::error => (),
      terminal_progress::State::paused => (),
    }
    self.lifecycle.Lock()
    defer self.lifecycle.Unlock()
    let active = self.phase == 0 or self.phase == 1 or self.phase == 2 or self.phase == 7
    mut accepted = false
    if active and not self.resources_stopped {
      accepted = (self.terminal_progress_action)(progress_state, percent)
      if accepted {
        self.terminal_progress_state = progress_state
        self.terminal_progress_percent = percent
      }
    }
    accepted
  }

  private fn mut clear_terminal_progress_locked() {
    if self.terminal_progress_state != terminal_progress::State::remove {
      self.terminal_progress_action(terminal_progress::State::remove)
    }
  }

  private fn mut restore_terminal_progress_locked() {
    if self.terminal_progress_state != terminal_progress::State::remove {
      self.terminal_progress_action(self.terminal_progress_state, self.terminal_progress_percent)
    }
  }

  private fn mut restore_terminal_progress_and_commit_phase(
    transition: Int,
    target: Int,
    reset_pointer: Bool,
  ) Bool {
    self.lifecycle.Lock()
    defer self.lifecycle.Unlock()
    let committed = self.phase == transition
    if committed {
      self.restore_terminal_progress_locked()
      self.phase = target
      if reset_pointer {
        self.pointer_cursor_initialized = false
      }
    }
    committed
  }

  private fn mut next_listener() Int {
    self.lifecycle.Lock()
    let prestart_shutdown = self.phase == 4 and (not self.pump_started) and (not self.resources_stopped)
    let available = self.phase != 3 and (self.phase != 4 or prestart_shutdown) and self.next_listener_id < math::MaxInt
    mut id = 0
    if available {
      id = self.next_listener_id
      self.next_listener_id =+ 1
    }
    self.lifecycle.Unlock()
    if not available {
      panic("application listener registration is unavailable")
    }
    id
  }

  fn mut on_key(handler: fn(mut event::KeyEvent)) fn() {
    let id = self.next_listener()
    self.key_listeners.push(KeyListener{id: id, handler: handler})
    fn() {
      self.remove_key_listener(id)
    }
  }

  private fn mut remove_key_listener(id: Int) {
    let retained = mut List::new<KeyListener>()
    for listener in self.key_listeners {
      if listener.id != id {
        retained.push(listener)
      }
    }
    self.key_listeners = retained.@
  }

  fn mut on_paste(handler: fn(mut event::PasteEvent)) fn() {
    let id = self.next_listener()
    self.paste_listeners.push(PasteListener{id: id, handler: handler})
    fn() {
      self.remove_paste_listener(id)
    }
  }

  private fn mut remove_paste_listener(id: Int) {
    let retained = mut List::new<PasteListener>()
    for listener in self.paste_listeners {
      if listener.id != id {
        retained.push(listener)
      }
    }
    self.paste_listeners = retained.@
  }

  fn mut terminal_focus() event::TerminalFocus? {
    self.terminal_focus_state
  }

  fn mut on_terminal_focus(handler: fn(event::TerminalFocus)) fn() {
    let id = self.next_listener()
    self.terminal_focus_listeners.push(TerminalFocusListener{id: id, handler: handler})
    fn() {
      self.remove_terminal_focus_listener(id)
    }
  }

  private fn mut remove_terminal_focus_listener(id: Int) {
    let retained = mut List::new<TerminalFocusListener>()
    for listener in self.terminal_focus_listeners {
      if listener.id != id {
        retained.push(listener)
      }
    }
    self.terminal_focus_listeners = retained.@
  }

  private fn mut set_terminal_focus(value: event::TerminalFocus) {
    mut changed = true
    match self.terminal_focus_state {
      current => { changed = current != value },
      _ => (),
    }
    if changed {
      self.terminal_focus_state = Maybe::new<event::TerminalFocus>(value)
      let listeners = self.terminal_focus_listeners
      for listener in listeners {
        listener.handler(value)
      }
    }
  }

  fn mut current_selection() public_selection::Selection? {
    self.selection.current()
  }

  fn mut clear_selection() {
    if self.selection_notifying {
      self.selection_clear_queued = true
    } else if self.selection.clear() {
      (self.request_render())()
    }
  }

  fn mut on_selection_change(handler: fn(public_selection::Selection?)) fn() {
    let id = self.next_listener()
    self.selection_listeners.push(SelectionListener{id: id, handler: handler})
    fn() {
      self.remove_selection_listener(id)
    }
  }

  private fn mut remove_selection_listener(id: Int) {
    let retained = mut List::new<SelectionListener>()
    for listener in self.selection_listeners {
      if listener.id != id {
        retained.push(listener)
      }
    }
    self.selection_listeners = retained.@
  }

  private fn mut emit_key(received: mut event::KeyEvent) {
    let listeners = self.key_listeners
    for listener in listeners {
      if not received.is_propagation_stopped() {
        listener.handler(received)
      }
    }
  }

  private fn mut emit_paste(received: mut event::PasteEvent) {
    let listeners = self.paste_listeners
    for listener in listeners {
      if not received.is_propagation_stopped() {
        listener.handler(received)
      }
    }
  }

  private fn mut route_live_paste(root: mut node::Renderable, received: mut event::PasteEvent) router::Outcome {
    self.emit_paste(received)
    self.focused.reconcile(root)
    if received.is_propagation_stopped() {
      router::empty_outcome()
    } else {
      match self.focused.focused() {
        target => router::dispatch_paste(target, received, self.focused),
        _ => router::empty_outcome(),
      }
    }
  }

  fn mut suspend_live() Void!Error {
    self.terminal_io.Lock()
    self.lifecycle.Lock()
    mut previous = -1
    mut transition = -1
    mut suspended = -1
    mut available = true
    mut already_suspended = false
    if self.phase == 0 {
      previous = 0
      transition = 11
      suspended = 5
      self.phase = transition
    } else if self.phase == 1 {
      previous = 1
      transition = 12
      suspended = 6
      self.animation_execution_generation =+ 1
      self.phase = transition
    } else if self.phase == 7 {
      previous = 7
      transition = 13
      suspended = 8
      self.phase = transition
    } else if self.phase == 5 or self.phase == 6 or self.phase == 8 {
      already_suspended = true
    } else {
      available = false
    }
    self.lifecycle.Unlock()

    mut outcome: Void!Error = Result::ok(())
    if available and not already_suspended {
      if not self.clipboard.internal_suspend() {
        self.lifecycle.Lock()
        let restored = self.phase == transition
        if restored {
          self.phase = previous
        }
        self.lifecycle.Unlock()
        if restored {
          self.wake_animations_after_failed_suspend(previous)
        }
        outcome = Result::err(
          Error::new("application cannot suspend while a clipboard read is active"),
        )
      } else {
        let terminal = self.terminal.expect("live application terminal")
        self.clear_terminal_progress_locked()
        terminal.SetMouseShape(vaxis::MouseShapeDefault)
        terminal.Render()
        outcome = terminal.Suspend()
        match outcome {
          ok(_) => {
            self.terminal_suspended = true
            let events = terminal.Events()
            mut draining = true
            while draining {
              select {
                events.recv() => (),
                _ => { draining = false },
              }
            }
            self.lifecycle.Lock()
            let committed = self.phase == transition
            if committed {
              self.phase = suspended
            }
            self.lifecycle.Unlock()
            if committed {
              self.live_paste_buffer.Reset()
            }
            if not committed {
              outcome = Result::err(Error::new("application was destroyed while suspending"))
            }
          },
          err(error) => {
            self.clipboard.internal_resume()
            let restored = self.restore_terminal_progress_and_commit_phase(
              transition,
              previous,
              false,
            )
            if restored {
              self.wake_animations_after_failed_suspend(previous)
            }
            outcome = Result::err(error)
          },
        }
      }
    }
    self.terminal_io.Unlock()

    if not available {
      Result::err(Error::new("application runtime is not available to suspend"))
    } else {
      outcome
    }
  }

  fn mut resume_live() Void!Error {
    self.terminal_io.Lock()
    self.lifecycle.Lock()
    mut suspended = -1
    mut transition = -1
    mut resumed = -1
    mut available = true
    mut already_active = false
    if self.phase == 5 {
      suspended = 5
      transition = 9
      resumed = 0
      self.phase = transition
    } else if self.phase == 6 {
      suspended = 6
      transition = 10
      resumed = 1
      self.phase = transition
    } else if self.phase == 0 or self.phase == 1 or self.phase == 7 {
      already_active = true
    } else {
      available = false
    }
    self.lifecycle.Unlock()

    mut outcome: Void!Error = Result::ok(())
    if available and not already_active {
      let terminal = self.terminal.expect("live application terminal")
      outcome = terminal.Resume()
      match outcome {
        ok(_) => {
          self.terminal_suspended = false
          let _ = self.apply_pending_resize_locked(terminal)
          self.request_animation_clock_reset()
          let committed = self.restore_terminal_progress_and_commit_phase(transition, resumed, true)
          if committed {
            self.clipboard.internal_resume()
            (self.request_render())()
          } else {
            outcome = Result::err(Error::new("application was destroyed while resuming"))
          }
        },
        err(error) => {
          self.lifecycle.Lock()
          if self.phase == transition {
            self.phase = suspended
          }
          self.lifecycle.Unlock()
          outcome = Result::err(error)
        },
      }
    }
    self.terminal_io.Unlock()

    if not available {
      Result::err(Error::new("application runtime is not available to resume"))
    } else {
      outcome
    }
  }

  fn mut start_live(root: mut node::Renderable) Void!Error {
    try self.require_root(root)
    self.terminal_io.Lock()
    self.lifecycle.Lock()
    mut launch = false
    mut finish_shutdown = false
    mut available = true
    if self.phase == 0 {
      self.phase = 7
      self.pump_started = true
      launch = true
    } else if self.phase == 5 {
      self.phase = 8
      self.pump_started = true
      launch = true
    } else if self.phase == 1 or self.phase == 6 or self.phase == 7 or self.phase == 8 or self.phase == 9 or self.phase == 10 {
      available = self.pump_started
    } else {
      finish_shutdown = self.phase == 4 and (not self.pump_started) and (not self.resources_stopped)
      available = false
    }
    self.lifecycle.Unlock()
    self.terminal_io.Unlock()

    if not available {
      if finish_shutdown {
        self.stop_resources()
      }
      Result::err(Error::new("application runtime is not available to start"))
    } else {
      if launch {
        async::start(fn() {
          self.live_pump(root)
        })
      }
      self.startup_result()
    }
  }

  fn mut wait_live() Void!Error {
    self.lifecycle.Lock()
    let available = self.pump_started
    self.lifecycle.Unlock()
    if not available {
      Result::err(Error::new("application runtime has not started"))
    } else {
      self.completion_result()
    }
  }

  fn mut run(root: mut node::Renderable) Void!Error {
    try self.start_live(root)
    self.wait_live()
  }

  private fn mut live_pump(root: mut node::Renderable) {
    self.begin_run()
    defer self.stop_resources()
    defer self.end_run()
    defer self.publish_startup(Maybe::new<Error>(Error::new("application startup did not complete")))
    root.node().mount_root(self.dispatch)
    defer root.node().unmount_root()

    self.terminal_io.Lock()
    self.lifecycle.Lock()
    mut started = false
    mut active = false
    if self.phase == 7 {
      self.phase = 1
      started = true
      active = true
    } else if self.phase == 8 {
      self.phase = 6
      started = true
    }
    self.lifecycle.Unlock()

    if active {
      let terminal = self.terminal.expect("live application terminal")
      if self.live_rendering() {
        if not self.apply_pending_resize_locked(terminal) {
          terminal.Resize(terminal.Size())
        }
      }
    }
    self.terminal_io.Unlock()
    if active {
      self.paint_live(root)
    }

    self.lifecycle.Lock()
    let startup_valid = started and self.phase != 4 and self.phase != 3
    self.lifecycle.Unlock()
    if startup_valid {
      self.publish_startup(Maybe::new<Error>())
      self.live_event_loop(root)
    } else {
      self.publish_startup(
        Maybe::new<Error>(Error::new("application was destroyed during startup")),
      )
    }

    if not self.live_stopping() {
      let _ = self.request_live_destroy()
    }
  }

  private fn mut live_event_loop(root: mut node::Renderable) {
    let terminal = self.terminal.expect("live application terminal")
    let events = terminal.Events()
    let redraws = self.wake.receiver()
    let update_events = self.updates.events()
    let shutdowns = self.shutdown.receiver()
    let system_events = self.system_wake.receiver()
    let animation_controls = self.animation_control_wake.receiver()
    let animation_frames = self.animation_frame_wake.receiver()
    mut running = true
    while running and (not self.live_stopping()) and (not self.post_frame_quit) {
      if self.live_rendering() {
        select {
          shutdowns.recv() => { running = false },
          system_events.recv() => {
            self.terminal_io.Lock()
            mut resized = false
            if self.live_rendering() {
              resized = self.apply_pending_resize_locked(terminal)
            }
            self.terminal_io.Unlock()
            if resized {
              self.paint_live(root)
            }
          },
          animation_controls.recv() => {
            self.prune_animations()
            self.schedule_animation_frame()
          },
          animation_frames.recv() => {
            let now = self.now_ms()
            self.animation_frame_pending = false
            match self.claim_animation_frame() {
              generation => {
                let allow = fn() Bool {
                  self.animation_frame_valid(generation)
                }
                let _ = self.advance_animations(now, allow)
                if self.take_redraw_request() and self.live_rendering() {
                  self.paint_live(root)
                }
                self.schedule_animation_frame()
              },
              _ => (),
            }
          },
          redraws.recv() => {
            if self.live_rendering() {
              self.paint_live(root)
            }
          },
          update_events.recv() => {
            let _ = self.drain_updates()
            if self.take_redraw_request() and self.live_rendering() {
              self.paint_live(root)
            }
          },
          let posted = events.recv() => {
            match posted {
              received => {
                if self.live_stopping() {
                  running = false
                } else {
                  match received {
                    vaxis::QuitEvent(_) => { running = false },
                    _ => {
                      if self.live_rendering() {
                        if self.take_redraw_request() {
                          self.paint_live(root)
                        } else {
                          self.focused.reconcile(root)
                        }
                        match received {
                          vaxis::Resize(size) => {
                            self.terminal_io.Lock()
                            if self.live_rendering() {
                              terminal.Resize(size)
                            }
                            self.terminal_io.Unlock()
                            self.paint_live(root)
                          },
                          vaxis::Redraw(_) => self.paint_live(root),
                          vaxis::SyncFunc(action) => {
                            action()
                            if self.take_redraw_request() {
                              self.paint_live(root)
                            }
                          },
                          vaxis::FocusIn(_) => {
                            self.set_terminal_focus(event::TerminalFocus::gained)
                            if self.take_redraw_request() {
                              self.paint_live(root)
                            }
                          },
                          vaxis::FocusOut(_) => {
                            self.set_terminal_focus(event::TerminalFocus::lost)
                            if self.take_redraw_request() {
                              self.paint_live(root)
                            }
                          },
                          vaxis::PasteStartEvent(_) => self.live_paste_buffer.Start(),
                          vaxis::PasteEndEvent(_) => {
                            let pasted = self.live_paste_buffer.Finish()
                            if pasted.Active {
                              let converted = event::paste(pasted.Value)
                              let outcome = self.route_live_paste(root, converted)
                              self.apply_outcome(outcome)
                              if outcome.redraw or self.take_redraw_request() {
                                self.paint_live(root)
                              }
                              if outcome.quit or self.post_frame_quit {
                                running = false
                              }
                            }
                          },
                          vaxis::Mouse(mouse) => {
                            let converted = mouse_event(mouse)
                            let outcome = self.pointer.process(
                              root,
                              converted,
                              self.focused,
                              self.selection,
                              self.auto_focus,
                              self.now_ms(),
                            )
                            self.apply_outcome(outcome)
                            let cursor_changed = self.update_pointer_cursor(root)
                            if outcome.redraw or cursor_changed or self.take_redraw_request() {
                              self.paint_live(root)
                            }
                            if outcome.quit or self.post_frame_quit {
                              running = false
                            }
                          },
                          vaxis::Key(key) => {
                            if key.EventType == vaxis::EventPaste {
                              if not self.live_paste_buffer.AppendKey(key) {
                                let converted = event::paste(bridge::PasteText(key))
                                let outcome = self.route_live_paste(root, converted)
                                self.apply_outcome(outcome)
                                if outcome.redraw or self.take_redraw_request() {
                                  self.paint_live(root)
                                }
                                if outcome.quit or self.post_frame_quit {
                                  running = false
                                }
                              }
                            } else {
                              let converted = key_event(key)
                              self.emit_key(converted)
                              self.focused.reconcile(root)
                              if self.exit_on_ctrl_c and converted.event_type != event::KeyEventType::release and converted.matches("c", ctrl: true) and (not converted.is_default_prevented()) and (not converted.is_propagation_stopped()) {
                                running = false
                              } else {
                                match self.focused.focused() {
                                  target => {
                                    if not converted.is_propagation_stopped() {
                                      let outcome = router::dispatch_key(
                                        target,
                                        converted,
                                        self.focused,
                                      )
                                      self.apply_outcome(outcome)
                                      if outcome.redraw {
                                        self.paint_live(root)
                                      }
                                      if outcome.quit {
                                        running = false
                                      }
                                    }
                                  },
                                  _ => (),
                                }
                              }
                            }
                          },
                          _ => (),
                        }
                      }
                    },
                  }
                }
              },
              _ => { running = false },
            }
          },
        }
      } else {
        select {
          shutdowns.recv() => { running = false },
          system_events.recv() => {
            self.terminal_io.Lock()
            mut resized = false
            if self.live_rendering() {
              resized = self.apply_pending_resize_locked(terminal)
            }
            self.terminal_io.Unlock()
            if resized {
              self.paint_live(root)
            }
          },
          redraws.recv() => {
            if self.live_rendering() {
              self.paint_live(root)
            }
          },
          update_events.recv() => {
            let _ = self.drain_updates()
            if self.take_redraw_request() and self.live_rendering() {
              self.paint_live(root)
            }
          },
        }
      }
    }
  }

  fn mut destroy_live() {
    let finish_now = self.request_live_destroy()
    if finish_now or self.terminal_cleanup_pending() {
      self.stop_resources()
    }
  }

  fn mut start_test(root: mut node::Renderable) {
    if not self.owns_root(root) or self.is_retained_destroyed() {
      panic("application Root does not belong to this Runtime")
    }
    self.begin_phase(false, 2)
    self.begin_run()
    root.node().mount_root(self.dispatch)
  }

  fn mut render_test(root: mut node::Renderable) {
    self.require_phase(2)
    self.paint_test(root)
  }

  fn mut key_test(root: mut node::Renderable, received: mut event::KeyEvent) {
    self.require_phase(2)
    self.emit_key(received)
    self.focused.reconcile(root)
    mut redraw = false
    match self.focused.focused() {
      target => {
        if not received.is_propagation_stopped() {
          let outcome = router::dispatch_key(target, received, self.focused)
          self.apply_outcome(outcome)
          redraw = outcome.redraw
        }
      },
      _ => (),
    }
    if self.test_active() and (redraw or self.take_redraw_request()) {
      self.paint_test(root)
    }
  }

  fn mut paste_test(root: mut node::Renderable, received: mut event::PasteEvent) {
    self.require_phase(2)
    self.emit_paste(received)
    self.focused.reconcile(root)
    mut redraw = false
    match self.focused.focused() {
      target => {
        if not received.is_propagation_stopped() {
          let outcome = router::dispatch_paste(target, received, self.focused)
          self.apply_outcome(outcome)
          redraw = outcome.redraw
        }
      },
      _ => (),
    }
    if self.test_active() and (redraw or self.take_redraw_request()) {
      self.paint_test(root)
    }
  }

  fn mut mouse_test(root: mut node::Renderable, received: mut event::MouseEvent) {
    self.require_phase(2)
    mut precommit = not self.has_frame
    if self.take_redraw_request() {
      precommit = true
    }
    if precommit {
      self.paint_test(root)
    } else {
      self.focused.reconcile(root)
    }
    let outcome = self.pointer.process(
      root,
      received,
      self.focused,
      self.selection,
      self.auto_focus,
      self.now_ms(),
    )
    self.apply_outcome(outcome)
    let cursor_changed = self.update_pointer_cursor(root)
    if self.test_active() and (outcome.redraw or cursor_changed or self.take_redraw_request()) {
      self.paint_test(root)
    }
  }

  fn mut terminal_focus_test(root: mut node::Renderable, value: event::TerminalFocus) {
    self.require_phase(2)
    self.set_terminal_focus(value)
    if self.test_active() and self.take_redraw_request() {
      self.paint_test(root)
    }
  }

  fn mut flush_test(root: mut node::Renderable, limit: Int) Int {
    self.require_phase(2)
    if limit < 0 {
      panic("headless flush limit must be non-negative")
    }
    self.begin_test_flush()
    mut drained = 0
    mut reading = true
    while reading and drained < limit {
      match self.updates.pop() {
        action => {
          action()
          drained =+ 1
          if self.test_stopping() {
            reading = false
          }
        },
        _ => { reading = false },
      }
    }
    if self.test_stopping() {
      if self.take_redraw_request() {
        self.paint_test(root)
      }
    } else {
      self.updates.wake_if_pending()
      if self.take_redraw_request() {
        self.paint_test(root)
      }
    }
    if self.end_test_flush() {
      self.finish_test(root)
    }
    drained
  }

  fn mut suspend_test() Bool {
    self.terminal_io.Lock()
    defer self.terminal_io.Unlock()
    self.lifecycle.Lock()
    let available = self.phase == 2
    if available {
      self.phase = 14
    }
    self.lifecycle.Unlock()
    if available {
      self.clear_terminal_progress_locked()
      self.terminal_suspended = true
    }
    available
  }

  fn mut resume_test() Bool {
    self.terminal_io.Lock()
    defer self.terminal_io.Unlock()
    self.lifecycle.Lock()
    let available = self.phase == 14
    if available {
      self.phase = 15
    }
    self.lifecycle.Unlock()
    if not available {
      false
    } else {
      self.terminal_suspended = false
      self.request_animation_clock_reset()
      self.restore_terminal_progress_and_commit_phase(15, 2, false)
    }
  }

  fn mut resize_test(width: Int, height: Int) {
    self.require_phase(2)
    if width < 0 or height < 0 {
      panic("headless application dimensions must be non-negative")
    }
    if self.headless_width != width or self.headless_height != height {
      self.headless_width = width
      self.headless_height = height
      (self.request_render())()
    }
  }

  fn mut frame() paint::Buffer {
    self.last_frame.@
  }

  fn mut destroy_test(root: mut node::Renderable) {
    if self.claim_test_destroy() {
      self.finish_test(root)
    }
  }
}

fn new_live(exit_on_ctrl_c: Bool, auto_focus: Bool, use_mouse: Bool) (mut Runtime)!Error {
  let state = try new_live_state(exit_on_ctrl_c, auto_focus, use_mouse)
  Result::ok(public_runtime(state))
}

fn new_headless(
  width: Int,
  height: Int,
  open_url: fn(Str) Void!Error,
  notification_action: fn(Str, Str?) Bool,
  terminal_progress_action: fn(terminal_progress::State, Int?) Bool,
  terminal_title_action: fn(Str),
) mut Runtime {
  public_runtime(
    new_headless_state(
      width,
      height,
      open_url,
      notification_action,
      terminal_progress_action,
      terminal_title_action,
    ),
  )
}

fn new_detached(request_render: fn()?, width_measurer: (fn(Str) Int)?) mut Runtime {
  public_runtime(new_detached_state(request_render, width_measurer))
}

