use cooper/event
use go:sync

private fn no_op() {}

struct MountScope {
  stopped: Bool,
  cancellation: Chan<Void>,
}

fn new_mount_scope() mut MountScope {
  (mut MountScope{stopped: false, cancellation: Chan::new<Void>()})
}

impl MountScope {
  fn cancellation() Receiver<Void> {
    self.cancellation.receiver()
  }

  fn is_cancelled() Bool {
    select {
      self.cancellation.recv() => true,
      _ => false,
    }
  }

  fn mut stop() {
    if not self.stopped {
      self.stopped = true
      self.cancellation.close()
    }
  }
}

fn scoped_dispatch(base: fn(fn()) Void!event::DispatchError, scope: mut MountScope) fn(fn()) Void!event::DispatchError {
  fn(action: fn()) Void!event::DispatchError {
    if scope.is_cancelled() {
      Result::err(event::DispatchError::stopped)
    } else {
      base(fn() {
        if not scope.is_cancelled() {
          action()
        }
      })
    }
  }
}

struct DispatchQueue {
  mutex: mut sync::Mutex,
  pending: [fn()],
  head: Int,
  wake: Chan<Bool>,
  stopped: Bool,
}

fn new_dispatch_queue() DispatchQueue {
  let mutex = mut sync::Mutex{}
  DispatchQueue{
    mutex: mutex,
    pending: [],
    head: 0,
    wake: Chan::new<Bool>(1),
    stopped: false,
  }
}

impl DispatchQueue {
  fn mut post(action: fn()) Bool {
    self.mutex.Lock()
    mut accepted = false
    if not self.stopped {
      self.pending.push(action)
      accepted = true
    }
    self.mutex.Unlock()

    if accepted {
      select {
        self.wake.send(true) => (),
        _ => (),
      }
    }
    accepted
  }

  fn events() Receiver<Bool> {
    self.wake.receiver()
  }

  fn mut pop() fn()? {
    self.mutex.Lock()
    mut pending = Maybe::new<fn()>()
    match self.pending.at(self.head) {
      action => {
        pending = Maybe::new<fn()>(action)
        self.pending.set(self.head, no_op)
        self.head =+ 1
        if self.head == self.pending.size() {
          self.pending = []
          self.head = 0
        } else if self.head >= 64 and self.head >= self.pending.size() - self.head {
          let remaining = mut List::new<fn()>()
          mut index = self.head
          while index < self.pending.size() {
            remaining.push(self.pending.at(index).expect("remaining dispatch action"))
            index =+ 1
          }
          self.pending = remaining.@
          self.head = 0
        }
      },
      _ => (),
    }
    self.mutex.Unlock()
    pending
  }

  fn mut wake_if_pending() {
    self.mutex.Lock()
    let has_pending = self.head < self.pending.size()
    self.mutex.Unlock()

    if has_pending {
      select {
        self.wake.send(true) => (),
        _ => (),
      }
    }
  }

  fn mut stop() {
    self.mutex.Lock()
    self.stopped = true
    self.pending = []
    self.head = 0
    self.mutex.Unlock()

    select {
      self.wake.send(true) => (),
      _ => (),
    }
  }
}
