use cooper/cooper
use cooper/event
use cooper/surface
use go:go.rockorager.dev/vaxis

struct ScrollView {
  child: mut cooper::Widget,
  // Desired vertical cell offset. Rendering clamps it without discarding the
  // request, so the position is restored if temporarily smaller content grows.
  requested_offset: Int,
  // Rows moved per wheel event.
  wheel_step: Int,
}

fn new(child: mut cooper::Widget, offset: Int?, wheel_step: Int?) ScrollView {
  ScrollView{
    child: child,
    requested_offset: nonnegative(offset.or(0)),
    wheel_step: positive(wheel_step.or(3)),
  }
}

private fn nonnegative(value: Int) Int {
  if value < 0 {
    0
  } else {
    value
  }
}

private fn positive(value: Int) Int {
  if value < 1 {
    1
  } else {
    value
  }
}

private fn maximum(left: Int, right: Int) Int {
  if left > right {
    left
  } else {
    right
  }
}

private fn overflow(content: Int, viewport: Int) Int {
  if content > viewport {
    content - viewport
  } else {
    0
  }
}

private fn clamped(value: Int, maximum: Int) Int {
  if value < 0 {
    0
  } else if value > maximum {
    maximum
  } else {
    value
  }
}

private fn child_context(ctx: surface::RenderContext) surface::RenderContext {
  ctx.for_child(
    0,
    surface::Constraints{
      min_width: 0,
      max_width: ctx.constraints.max_width,
      min_height: 0,
    },
  )
}

private fn normalize(rendered: surface::Surface) surface::Surface {
  let normalized = mut rendered
  normalized.size.width = nonnegative(normalized.size.width)
  normalized.size.height = nonnegative(normalized.size.height)
  normalized.@
}

private fn content_wrapper(child: surface::Surface, width: Int) surface::Surface {
  let wrapped = mut surface::Surface{
    size: surface::Size{width: maximum(child.size.width, width), height: child.size.height},
    cells: [],
    children: [],
    focusable: false,
  }
  wrapped.add_child(0, 0, child)
  wrapped.@
}

impl ScrollView {
  private fn mut route_child(ctx: mut event::EventContext, received: vaxis::Event) event::EventResult {
    let route_index = try ctx.next_route_index() -> _ { event::EventResult::ignored }
    if route_index != 0 {
      event::EventResult::ignored
    } else {
      ctx.enter_child()
      let result = self.child.event(ctx, received)
      ctx.leave_child()
      result
    }
  }

  private fn mut scroll_wheel(ctx: mut event::EventContext, mouse: vaxis::Mouse) event::EventResult {
    if mouse.EventType != vaxis::EventPress or mouse.Button != vaxis::MouseWheelUp and mouse.Button != vaxis::MouseWheelDown {
      event::EventResult::ignored
    } else {
      let viewport = try ctx.current_route_size() -> _ { event::EventResult::ignored }
      let content = try ctx.next_route_size() -> _ { event::EventResult::ignored }
      let max_offset = overflow(nonnegative(content.height), nonnegative(viewport.height))
      let current = clamped(self.requested_offset, max_offset)
      let wheel_step = positive(self.wheel_step)
      mut next = current

      if mouse.Button == vaxis::MouseWheelUp {
        if wheel_step >= current {
          next = 0
        } else {
          next = current - wheel_step
        }
      } else {
        let remaining = max_offset - current
        if wheel_step >= remaining {
          next = max_offset
        } else {
          next = current + wheel_step
        }
      }

      self.requested_offset = next
      if next == current {
        event::EventResult::ignored
      } else {
        ctx.request_redraw()
        event::EventResult::handled
      }
    }
  }
}

impl cooper::Widget for ScrollView {
  fn render(ctx: surface::RenderContext) surface::Surface {
    let child = normalize(self.child.render(child_context(ctx)))
    let width = ctx.constraints.constrain_width(child.size.width)
    let height = ctx.constraints.constrain_height(child.size.height)
    let content = content_wrapper(child, width)
    let max_offset = overflow(content.size.height, height)
    let offset = clamped(self.requested_offset, max_offset)
    let viewport = mut surface::Surface{
      size: surface::Size{width: width, height: height},
      cells: [],
      children: [],
      focusable: false,
    }
    viewport.add_widget_child(0, 0, -offset, content)
    viewport.@
  }

  fn mut event(ctx: mut event::EventContext, received: vaxis::Event) event::EventResult {
    match received {
      vaxis::Mouse(mouse) => {
        let child_result = self.route_child(ctx, received)
        if child_result == event::EventResult::handled {
          child_result
        } else {
          self.scroll_wheel(ctx, mouse)
        }
      },
      _ => self.route_child(ctx, received),
    }
  }
}
