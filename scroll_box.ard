use ard/unsafe

use cooper/context
use cooper/core/event_delivery
use cooper/core/node
use cooper/core/paint
use cooper/event
use cooper/geometry
use cooper/scrollbar
use cooper/style as layout_style

private struct Part {
  node_ref: mut node::Node,
}

impl node::Renderable for Part {
  fn node() mut node::Node {
    self.node_ref
  }

  fn mount(ctx: node::MountContext) {}

  fn paint(ctx: mut paint::Context) {}

  fn event(ctx: mut event_delivery::Context) event_delivery::Disposition {
    event_delivery::Disposition::ignored
  }
}

private struct Parts {
  destroying: Bool,
  wrapper: mut Part,
  viewport_column: mut Part,
  viewport: mut Part,
  vertical_bar: mut scrollbar::Scrollbar,
}

struct ScrollBox {
  node_ref: mut node::Node,
  internal: Any,
}

private fn parts(value: Any) mut Parts {
  unsafe::cast<mut Parts>(value).expect("ScrollBox must be created by Cooper")
}

private fn positive(value: Int) Int {
  if value < 1 {
    1
  } else {
    value
  }
}

private fn configured(value: layout_style::Style) layout_style::Style {
  let applied = mut value
  applied.overflow = layout_style::Overflow::hidden
  applied.flex_direction = layout_style::FlexDirection::column
  applied.flex_wrap = layout_style::FlexWrap::no_wrap
  applied.@
}

private fn configured_viewport(value: layout_style::Style) layout_style::Style {
  layout_style::new(
    overflow: layout_style::Overflow::scroll,
    flex_direction: layout_style::FlexDirection::column,
    flex_wrap: layout_style::FlexWrap::no_wrap,
    flex_grow: 1.0,
    flex_shrink: 1.0,
    align_items: value.align_items,
    justify_content: value.justify_content,
    min_width: layout_style::cells(0),
    min_height: layout_style::cells(0),
    gap: value.gap,
  )
}

private fn part(ctx: mut context::Context, styles: layout_style::Style) mut Part {
  let retained = context::internal_state(ctx).create_node(styles)
  let created = mut Part{node_ref: retained}
  retained.bind(created)
  created
}

fn new(
  ctx: mut context::Context,
  styles: layout_style::Style?,
  scrollbar_options: scrollbar::Options?,
) mut ScrollBox {
  let public_style = styles.or(layout_style::new())
  let retained = context::internal_state(ctx).create_node(configured(public_style))
  let wrapper = part(
    ctx,
    layout_style::new(
      flex_direction: layout_style::FlexDirection::row,
      flex_grow: 1.0,
      align_self: layout_style::Align::stretch,
      min_width: layout_style::cells(0),
      min_height: layout_style::cells(0),
    ),
  )
  let viewport_column = part(
    ctx,
    layout_style::new(
      flex_direction: layout_style::FlexDirection::column,
      flex_grow: 1.0,
      flex_shrink: 1.0,
      min_width: layout_style::cells(0),
      min_height: layout_style::cells(0),
    ),
  )
  let viewport = part(ctx, configured_viewport(public_style))
  let vertical_bar = scrollbar::internal_new(
    ctx,
    scrollbar::Orientation::vertical,
    scrollbar::state(),
    scrollbar_options.or(scrollbar::options()),
    layout_style::new(),
    false,
  )
  let internal_parts = mut Parts{
    destroying: false,
    wrapper: wrapper,
    viewport_column: viewport_column,
    viewport: viewport,
    vertical_bar: vertical_bar,
  }
  let scroll_box = mut ScrollBox{node_ref: retained, internal: internal_parts}
  retained.bind(scroll_box)
  retained.set_focusable(true)

  retained.add(wrapper.node_ref)
  wrapper.node_ref.add(viewport_column.node_ref)
  viewport_column.node_ref.add(viewport.node_ref)
  wrapper.node_ref.add(vertical_bar.node_ref)
  let _ = vertical_bar.on_change(fn(position: Int) {
    let _ = viewport.node_ref.set_scroll_y(position)
  })
  scroll_box
}

impl node::Renderable for ScrollBox {
  fn node() mut node::Node {
    self.node_ref
  }

  fn mount(ctx: node::MountContext) {}

  fn paint(ctx: mut paint::Context) {
    let internal_parts = parts(self.internal)
    let viewport = internal_parts.viewport.node_ref
    internal_parts.vertical_bar.internal_sync_state(
      scrollbar::state(
        position: viewport.scroll_y(),
        viewport_size: viewport.layout().screen.height,
        content_size: viewport.scroll_height(),
      ),
    )
  }

  fn mut event(ctx: mut event_delivery::Context) event_delivery::Disposition {
    match ctx.mouse_event {
      mouse => self.handle_mouse(ctx, mouse),
      _ => {
        match ctx.key_event {
          key => {
            if ctx.focused {
              self.handle_key(ctx, key)
            } else {
              event_delivery::Disposition::ignored
            }
          },
          _ => event_delivery::Disposition::ignored,
        }
      },
    }
  }
}

impl ScrollBox {
  private fn require_live() {
    if parts(self.internal).destroying {
      panic("cannot mutate a destroying ScrollBox")
    }
    self.node_ref.require_live()
  }

  private fn viewport() mut node::Node {
    parts(self.internal).viewport.node_ref
  }

  fn mut add(child: mut node::Renderable, index: Int?) {
    self.require_live()
    self.viewport().add(child.node(), index)
  }

  fn mut remove(child: mut node::Renderable) Bool {
    self.require_live()
    self.viewport().remove(child.node())
  }

  fn child_count() Int {
    self.viewport().child_count()
  }

  fn scroll_top() Int {
    self.viewport().scroll_y()
  }

  fn requested_scroll_top() Int {
    self.viewport().requested_scroll_y()
  }

  fn maximum_scroll_top() Int {
    self.viewport().max_scroll_y()
  }

  fn scroll_height() Int {
    self.viewport().scroll_height()
  }

  fn mut scroll_to(y: Int) Bool {
    self.require_live()
    self.viewport().set_scroll_y(y)
  }

  fn mut scroll_by(delta: Int) Bool {
    self.require_live()
    self.viewport().scroll_by(delta)
  }

  fn mut scroll_child_into_view(child: mut node::Renderable) Bool {
    self.require_live()
    self.viewport().scroll_node_into_view(child.node())
  }

  fn scrollbar_options() scrollbar::Options {
    parts(self.internal).vertical_bar.options()
  }

  fn mut set_scrollbar_options(value: scrollbar::Options) {
    self.require_live()
    parts(self.internal).vertical_bar.set_options(value)
  }

  fn style() layout_style::Style {
    self.node_ref.style()
  }

  fn mut set_style(value: layout_style::Style) {
    self.require_live()
    self.node_ref.apply_style(configured(value))
    self.viewport().apply_style(configured_viewport(value))
  }

  fn mut focus() Bool {
    self.require_live()
    self.node_ref.focus()
  }

  fn mut blur() {
    self.require_live()
    self.node_ref.blur()
  }

  fn is_focused() Bool {
    self.node_ref.is_focused()
  }

  fn mut on_key(handler: fn(mut event::KeyEvent)) fn() {
    self.require_live()
    self.node_ref.on_key(handler)
  }

  fn mut on_paste(handler: fn(mut event::PasteEvent)) fn() {
    self.require_live()
    self.node_ref.on_paste(handler)
  }

  fn mut on_mouse(handler: fn(mut event::MouseEvent)) fn() {
    self.require_live()
    self.node_ref.on_mouse(handler)
  }

  fn mut on_focus(handler: fn()) fn() {
    self.require_live()
    self.node_ref.on_focus(handler)
  }

  fn mut on_blur(handler: fn()) fn() {
    self.require_live()
    self.node_ref.on_blur(handler)
  }

  fn layout() geometry::Geometry {
    self.node_ref.layout()
  }

  private fn mut moved(ctx: mut event_delivery::Context, changed: Bool) event_delivery::Disposition {
    if changed {
      ctx.preserve_focus_scroll()
      ctx.request_redraw()
      event_delivery::Disposition::handled
    } else {
      event_delivery::Disposition::ignored
    }
  }

  private fn mut handle_mouse(ctx: mut event_delivery::Context, mouse: mut event::MouseEvent) event_delivery::Disposition {
    if mouse.event_type != event::MouseEventType::scroll or mouse.scroll_y == 0 {
      event_delivery::Disposition::ignored
    } else {
      mut delta = 3
      if mouse.scroll_y < 0 {
        delta = -3
      }
      let result = self.moved(ctx, self.scroll_by(delta))
      if result == event_delivery::Disposition::handled {
        ctx.stop_propagation()
      }
      result
    }
  }

  private fn mut handle_key(ctx: mut event_delivery::Context, key: mut event::KeyEvent) event_delivery::Disposition {
    if key.event_type == event::KeyEventType::release {
      event_delivery::Disposition::ignored
    } else if key.matches("up") {
      self.moved(ctx, self.scroll_by(-1))
    } else if key.matches("down") {
      self.moved(ctx, self.scroll_by(1))
    } else if key.matches("page_up") {
      self.moved(ctx, self.scroll_by(0 - positive(self.viewport().layout().screen.height)))
    } else if key.matches("page_down") {
      self.moved(ctx, self.scroll_by(positive(self.viewport().layout().screen.height)))
    } else if key.matches("home") {
      self.moved(ctx, self.scroll_to(0))
    } else if key.matches("end") {
      self.moved(ctx, self.scroll_to(self.maximum_scroll_top()))
    } else {
      event_delivery::Disposition::ignored
    }
  }

  fn mut destroy(recursive: Bool?) {
    let internal_parts = parts(self.internal)
    if self.node_ref.is_destroyed() or internal_parts.destroying {
      ()
    } else {
      internal_parts.destroying = true
      if recursive.or(false) {
        self.node_ref.destroy(true)
      } else {
        let viewport = internal_parts.viewport.node_ref
        let public_children = viewport.children
        for child in public_children {
          let _ = viewport.remove(child)
        }
        self.node_ref.destroy(true)
      }
    }
  }
}
