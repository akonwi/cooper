use go:go.rockorager.dev/vaxis

struct Size {
  width: Int,
  height: Int,
}

struct Point {
  x: Int,
  y: Int,
}

struct Constraints {
  min_width: Int,
  max_width: Int?,
  min_height: Int,
  max_height: Int?,
}

fn bounded(max_width: Int, max_height: Int) Constraints {
  mut safe_width = max_width
  mut safe_height = max_height
  if safe_width < 0 {
    safe_width = 0
  }
  if safe_height < 0 {
    safe_height = 0
  }
  Constraints{
    min_width: 0,
    max_width: safe_width,
    min_height: 0,
    max_height: safe_height,
  }
}

impl Constraints {
  fn constrain_width(width: Int) Int {
    mut constrained = width
    if constrained < self.min_width {
      constrained = self.min_width
    }
    match self.max_width {
      maximum => {
        if constrained > maximum {
          constrained = maximum
        }
      },
      _ => (),
    }
    if constrained < 0 {
      constrained = 0
    }
    constrained
  }

  fn constrain_height(height: Int) Int {
    mut constrained = height
    if constrained < self.min_height {
      constrained = self.min_height
    }
    match self.max_height {
      maximum => {
        if constrained > maximum {
          constrained = maximum
        }
      },
      _ => (),
    }
    if constrained < 0 {
      constrained = 0
    }
    constrained
  }
}

struct RenderContext {
  constraints: Constraints,
  width_measurer: (fn(Str) Int)?,
  // None means focus is outside this subtree. An empty path focuses this widget.
  focus_path: [Int]?,
}

struct Cell {
  grapheme: Str,
  // Zero marks a continuation cell reserved by a preceding wide grapheme.
  width: Int,
}

enum CursorShape {
  default,
  block,
  underline,
  beam,
}

struct Cursor {
  point: Point,
  shape: CursorShape,
}

struct PositionedSurface {
  origin: Point,
  surface: Surface,
  // A routed edge enters the corresponding retained child. None is decorative.
  route_index: Int?,
}

struct Surface {
  size: Size,
  cells: [Cell],
  children: [PositionedSurface],
  cursor: Cursor?,
  focusable: Bool,
  // Opaque retained Widget reference. Surface cannot import cooper without a
  // module cycle; the runtime recovers mut Widget through ard/unsafe.
  owner: Any?,
}

fn blank(width: Int, height: Int) Surface {
  mut safe_width = width
  mut safe_height = height
  if safe_width < 0 {
    safe_width = 0
  }
  if safe_height < 0 {
    safe_height = 0
  }

  let cells = mut List::new<Cell>()
  mut row = 0
  while row < safe_height {
    mut column = 0
    while column < safe_width {
      cells.push(blank_cell())
      column =+ 1
    }
    row =+ 1
  }

  Surface{
    size: Size{width: safe_width, height: safe_height},
    cells: cells.@,
    children: [],
    focusable: false,
  }
}

fn text_width(text: Str) Int {
  mut width = 0
  for character in vaxis::Characters(text) {
    width = width + character.Width
  }
  width
}

impl RenderContext {
  fn measure_text(text: Str) Int {
    match self.width_measurer {
      measurer => measurer(text),
      _ => text_width(text),
    }
  }

  fn is_focused() Bool {
    match self.focus_path {
      path => path.size() == 0,
      _ => false,
    }
  }

  fn for_child(route_index: Int, constraints: Constraints) RenderContext {
    mut child_path = Maybe::new<[Int]>()
    match self.focus_path {
      path => {
        if path.size() > 0 and path.at(0).expect("non-empty focus path") == route_index {
          child_path = Maybe::new<[Int]>(path.slice(start: 1).expect("focus path tail").to_list())
        }
      },
      _ => (),
    }
    RenderContext{
      constraints: constraints,
      width_measurer: self.width_measurer,
      focus_path: child_path,
    }
  }
}

fn blank_cell() Cell {
  Cell{grapheme: " ", width: 1}
}

private fn snapshot(surface: Surface) Surface {
  let cells = mut List::map(surface.cells, fn(c) {
    c
  })
  let children = mut List::map(surface.children, fn(c) {
    PositionedSurface{
      origin: c.origin,
      surface: snapshot(c.surface),
      route_index: c.route_index,
    }
  })
  Surface{
    size: surface.size,
    cells: cells.@,
    children: children.@,
    cursor: surface.cursor,
    focusable: surface.focusable,
    owner: surface.owner,
  }
}

private struct Clip {
  left: Int,
  top: Int,
  right: Int,
  bottom: Int,
}

impl Clip {
  private fn is_empty() Bool {
    self.left >= self.right or self.top >= self.bottom
  }

  private fn contains(x: Int, y: Int) Bool {
    x >= self.left and x < self.right and y >= self.top and y < self.bottom
  }
}

private fn intersect(a: Clip, b: Clip) Clip {
  mut left = a.left
  mut top = a.top
  mut right = a.right
  mut bottom = a.bottom
  if b.left > left {
    left = b.left
  }
  if b.top > top {
    top = b.top
  }
  if b.right < right {
    right = b.right
  }
  if b.bottom < bottom {
    bottom = b.bottom
  }
  Clip{
    left: left,
    top: top,
    right: right,
    bottom: bottom,
  }
}

impl Surface {
  fn cell(x: Int, y: Int) Cell? {
    if x >= 0 and x < self.size.width and y >= 0 and y < self.size.height {
      self.cells.at(y * self.size.width + x)
    } else {
      Maybe::new<Cell>()
    }
  }

  private fn mut set_raw(x: Int, y: Int, cell: Cell) {
    if x >= 0 and x < self.size.width and y >= 0 and y < self.size.height {
      self.cells.set(y * self.size.width + x, cell)
    }
  }

  private fn span_origin(x: Int, y: Int) Int {
    mut origin = x
    mut searching = true
    while origin > 0 and searching {
      let cell = try self.cell(origin, y) -> _ { origin }
      match cell.width == 0 {
        true => { origin =- 1 },
        false => { searching = false },
      }
    }
    origin
  }

  private fn mut clear_span_at(x: Int, y: Int) {
    let origin = self.span_origin(x, y)
    match self.cell(origin, y) {
      cell => {
        mut width = cell.width
        let remaining = self.size.width - origin
        if width < 1 {
          width = 1
        }
        if width > remaining {
          width = remaining
        }
        mut offset = 0
        while offset < width {
          self.set_raw(origin + offset, y, blank_cell())
          offset = offset + 1
        }
      },
      _ => (),
    }
  }

  fn mut set_cell(x: Int, y: Int, cell: Cell) {
    if cell.width > 0 and x >= 0 and x < self.size.width and cell.width <= self.size.width - x and y >= 0 and y < self.size.height {
      let end = x + cell.width
      mut column = x
      while column < end {
        self.clear_span_at(column, y)
        column = column + 1
      }

      self.set_raw(x, y, cell)
      column = x + 1
      while column < end {
        self.set_raw(column, y, Cell{grapheme: "", width: 0})
        column = column + 1
      }
    }
  }

  fn mut write(ctx: RenderContext, x: Int, y: Int, text: Str) {
    mut column = x
    for character in vaxis::Characters(text) {
      let width = ctx.measure_text(character.Grapheme)
      self.set_cell(column, y, Cell{grapheme: character.Grapheme, width: width})
      column = column + width
    }
  }

  fn mut add_child(x: Int, y: Int, child: Surface) {
    self.children.push(PositionedSurface{origin: Point{x: x, y: y}, surface: snapshot(child)})
  }

  fn mut add_widget_child(owner: Any, route_index: Int, x: Int, y: Int, child: Surface) {
    let owned = mut snapshot(child)
    owned.set_owner(owner)
    self.children.push(
      PositionedSurface{
        origin: Point{x: x, y: y},
        surface: owned.@,
        route_index: route_index,
      },
    )
  }

  fn mut set_owner(owner: Any) {
    self.owner = Maybe::new<Any>(owner)
  }

  fn mut accept_focus() {
    self.focusable = true
  }

  fn mut show_cursor(point: Point, shape: CursorShape) {
    self.cursor = Cursor{point: point, shape: shape}
  }

  private fn mut hide_cursor() {
    self.cursor = Maybe::new<Cursor>()
  }
}

private fn clear_clipped_span(target: mut Surface, x: Int, y: Int, width: Int, clip: Clip) {
  mut start = x
  mut end = x + width
  if start < clip.left {
    start = clip.left
  }
  if end > clip.right {
    end = clip.right
  }
  if start < 0 {
    start = 0
  }
  if end > target.size.width {
    end = target.size.width
  }
  if y >= clip.top and y < clip.bottom and y >= 0 and y < target.size.height {
    mut column = start
    while column < end {
      target.set_cell(column, y, blank_cell())
      column = column + 1
    }
  }
}

private fn append_route(path: [Int], route_index: Int) [Int] {
  let appended = mut List::new<Int>()
  for part in path {
    appended.push(part)
  }
  appended.push(route_index)
  appended.@
}

private fn routes_equal(left: [Int], right: [Int]) Bool {
  if left.size() != right.size() {
    false
  } else {
    mut equal = true
    for part, index in left {
      if part != right.at(index).expect("matching route length") {
        equal = false
        break
      }
    }
    equal
  }
}

private fn cursor_allowed(route: [Int], filter_cursors: Bool, focused_path: [Int]?) Bool {
  if not filter_cursors {
    true
  } else {
    match focused_path {
      focused => routes_equal(route, focused),
      _ => false,
    }
  }
}

private fn composite(
  target: mut Surface,
  source: Surface,
  origin: Point,
  clip: Clip,
  route: [Int],
  filter_cursors: Bool,
  focused_path: [Int]?,
) {
  if source.size.width > 0 and not clip.is_empty() {
    for cell, index in source.cells {
      if cell.width > 0 {
        let local_x = index % source.size.width
        let local_y = index / source.size.width
        if local_y < source.size.height {
          let x = origin.x + local_x
          let y = origin.y + local_y
          let source_remaining = source.size.width - local_x
          let valid_span = cell.width <= source_remaining
          let fully_visible = valid_span and clip.contains(x, y) and cell.width <= clip.right - x
          if fully_visible {
            target.set_cell(x, y, cell)
          } else {
            mut visible_width = cell.width
            if visible_width > source_remaining {
              visible_width = source_remaining
            }
            clear_clipped_span(target, x, y, visible_width, clip)
          }
        }
      }
    }
  }

  if cursor_allowed(route, filter_cursors, focused_path) {
    match source.cursor {
      cursor => {
        let translated = Point{x: origin.x + cursor.point.x, y: origin.y + cursor.point.y}
        if cursor.point.x >= 0 and cursor.point.x < source.size.width and cursor.point.y >= 0 and cursor.point.y < source.size.height and clip.contains(translated.x, translated.y) {
          target.show_cursor(translated, cursor.shape)
        }
      },
      _ => (),
    }
  }

  for positioned in source.children {
    let child_origin = Point{x: origin.x + positioned.origin.x, y: origin.y + positioned.origin.y}
    let child_clip = intersect(
      clip,
      Clip{
        left: child_origin.x,
        top: child_origin.y,
        right: child_origin.x + positioned.surface.size.width,
        bottom: child_origin.y + positioned.surface.size.height,
      },
    )
    if not child_clip.is_empty() {
      let child_route = match positioned.route_index {
        route_index => append_route(route, route_index),
        _ => route,
      }
      composite(
        target,
        positioned.surface,
        child_origin,
        child_clip,
        child_route,
        filter_cursors,
        focused_path,
      )
    }
  }
}

private fn finish_flattened(flattened: mut Surface) Surface {
  let cursor = try flattened.cursor -> _ { flattened.@ }
  let cell = try flattened.cell(cursor.point.x, cursor.point.y) -> _ {
    flattened.hide_cursor()
    flattened.@
  }
  if cell.width == 0 {
    flattened.hide_cursor()
  }
  flattened.@
}

private fn flatten_with_focus(surface: Surface, filter_cursors: Bool, focused_path: [Int]?) Surface {
  let flattened = mut blank(surface.size.width, surface.size.height)
  let root_clip = Clip{
    left: 0,
    top: 0,
    right: surface.size.width,
    bottom: surface.size.height,
  }
  composite(flattened, surface, Point{x: 0, y: 0}, root_clip, [], filter_cursors, focused_path)
  finish_flattened(flattened)
}

fn flatten(surface: Surface) Surface {
  flatten_with_focus(surface, false, Maybe::new<[Int]>())
}

fn flatten_focused(surface: Surface, focused_path: [Int]?) Surface {
  flatten_with_focus(surface, true, focused_path)
}
