use go:go.rockorager.dev/vaxis

struct Size {
  width: Int,
  height: Int,
}

struct Point {
  x: Int,
  y: Int,
}

struct Constraints {
  min_width: Int,
  max_width: Int?,
  min_height: Int,
  max_height: Int?,
}

fn bounded(max_width: Int, max_height: Int) Constraints {
  mut safe_width = max_width
  mut safe_height = max_height
  if safe_width < 0 {
    safe_width = 0
  }
  if safe_height < 0 {
    safe_height = 0
  }
  Constraints{
    min_width: 0,
    max_width: safe_width,
    min_height: 0,
    max_height: safe_height,
  }
}

impl Constraints {
  fn constrain_width(width: Int) Int {
    mut constrained = width
    if constrained < self.min_width {
      constrained = self.min_width
    }
    match self.max_width {
      maximum => {
        if constrained > maximum {
          constrained = maximum
        }
      },
      _ => (),
    }
    if constrained < 0 {
      constrained = 0
    }
    constrained
  }

  fn constrain_height(height: Int) Int {
    mut constrained = height
    if constrained < self.min_height {
      constrained = self.min_height
    }
    match self.max_height {
      maximum => {
        if constrained > maximum {
          constrained = maximum
        }
      },
      _ => (),
    }
    if constrained < 0 {
      constrained = 0
    }
    constrained
  }
}

struct RenderContext {
  constraints: Constraints,
  width_measurer: (fn(Str) Int)?,
}

struct Cell {
  grapheme: Str,
  // Zero marks a continuation cell reserved by a preceding wide grapheme.
  width: Int,
}

enum CursorShape {
  default,
  block,
  underline,
  beam,
}

struct Cursor {
  point: Point,
  shape: CursorShape,
}

struct PositionedSurface {
  origin: Point,
  surface: Surface,
}

struct Surface {
  size: Size,
  cells: [Cell],
  children: [PositionedSurface],
  cursor: Cursor?,
}

fn blank(width: Int, height: Int) Surface {
  mut safe_width = width
  mut safe_height = height
  if safe_width < 0 {
    safe_width = 0
  }
  if safe_height < 0 {
    safe_height = 0
  }

  let cells = mut List::new<Cell>()
  mut row = 0
  while row < safe_height {
    mut column = 0
    while column < safe_width {
      cells.push(blank_cell())
      column =+ 1
    }
    row =+ 1
  }

  Surface{
    size: Size{width: safe_width, height: safe_height},
    cells: cells.@,
    children: [],
  }
}

fn text_width(text: Str) Int {
  mut width = 0
  for character in vaxis::Characters(text) {
    width = width + character.Width
  }
  width
}

impl RenderContext {
  fn measure_text(text: Str) Int {
    match self.width_measurer {
      measurer => measurer(text),
      _ => text_width(text),
    }
  }
}

fn blank_cell() Cell {
  Cell{grapheme: " ", width: 1}
}

private fn snapshot(surface: Surface) Surface {
  let cells = mut List::map(surface.cells, fn(c) { c })
  let children = mut List::map(surface.children, fn(c) {
    PositionedSurface{origin: c.origin, surface: snapshot(c.surface)}
  })
  Surface{
    size: surface.size,
    cells: cells.@,
    children: children.@,
    cursor: surface.cursor,
  }
}

private struct Clip {
  left: Int,
  top: Int,
  right: Int,
  bottom: Int,
}

impl Clip {
  private fn is_empty() Bool {
    self.left >= self.right or self.top >= self.bottom
  }

  private fn contains(x: Int, y: Int) Bool {
    x >= self.left and x < self.right and y >= self.top and y < self.bottom
  }
}

private fn intersect(a: Clip, b: Clip) Clip {
  mut left = a.left
  mut top = a.top
  mut right = a.right
  mut bottom = a.bottom
  if b.left > left {
    left = b.left
  }
  if b.top > top {
    top = b.top
  }
  if b.right < right {
    right = b.right
  }
  if b.bottom < bottom {
    bottom = b.bottom
  }
  Clip{
    left: left,
    top: top,
    right: right,
    bottom: bottom,
  }
}

impl Surface {
  fn cell(x: Int, y: Int) Cell? {
    if x >= 0 and x < self.size.width and y >= 0 and y < self.size.height {
      self.cells.at(y * self.size.width + x)
    } else {
      Maybe::new<Cell>()
    }
  }

  private fn mut set_raw(x: Int, y: Int, cell: Cell) {
    if x >= 0 and x < self.size.width and y >= 0 and y < self.size.height {
      self.cells.set(y * self.size.width + x, cell)
    }
  }

  private fn span_origin(x: Int, y: Int) Int {
    mut origin = x
    mut searching = true
    while origin > 0 and searching {
      let cell = try self.cell(origin, y) -> _ { origin }
      match cell.width == 0 {
        true => { origin =- 1 },
        false => { searching = false }
      }
    }
    origin
  }

  private fn mut clear_span_at(x: Int, y: Int) {
    let origin = self.span_origin(x, y)
    match self.cell(origin, y) {
      cell => {
        mut width = cell.width
        let remaining = self.size.width - origin
        if width < 1 {
          width = 1
        }
        if width > remaining {
          width = remaining
        }
        mut offset = 0
        while offset < width {
          self.set_raw(origin + offset, y, blank_cell())
          offset = offset + 1
        }
      },
      _ => (),
    }
  }

  fn mut set_cell(x: Int, y: Int, cell: Cell) {
    if cell.width > 0 and x >= 0 and x < self.size.width and cell.width <= self.size.width - x and y >= 0 and y < self.size.height {
      let end = x + cell.width
      mut column = x
      while column < end {
        self.clear_span_at(column, y)
        column = column + 1
      }

      self.set_raw(x, y, cell)
      column = x + 1
      while column < end {
        self.set_raw(column, y, Cell{grapheme: "", width: 0})
        column = column + 1
      }
    }
  }

  fn mut write(ctx: RenderContext, x: Int, y: Int, text: Str) {
    mut column = x
    for character in vaxis::Characters(text) {
      let width = ctx.measure_text(character.Grapheme)
      self.set_cell(column, y, Cell{grapheme: character.Grapheme, width: width})
      column = column + width
    }
  }

  fn mut add_child(x: Int, y: Int, child: Surface) {
    self.children.push(PositionedSurface{origin: Point{x: x, y: y}, surface: snapshot(child)})
  }

  fn mut show_cursor(point: Point, shape: CursorShape) {
    self.cursor = Cursor{point: point, shape: shape}
  }

  private fn mut hide_cursor() {
    self.cursor = Maybe::new<Cursor>()
  }
}

private fn clear_clipped_span(target: mut Surface, x: Int, y: Int, width: Int, clip: Clip) {
  mut start = x
  mut end = x + width
  if start < clip.left {
    start = clip.left
  }
  if end > clip.right {
    end = clip.right
  }
  if start < 0 {
    start = 0
  }
  if end > target.size.width {
    end = target.size.width
  }
  if y >= clip.top and y < clip.bottom and y >= 0 and y < target.size.height {
    mut column = start
    while column < end {
      target.set_cell(column, y, blank_cell())
      column = column + 1
    }
  }
}

private fn composite(target: mut Surface, source: Surface, origin: Point, clip: Clip) {
  if source.size.width > 0 and not clip.is_empty() {
    for cell, index in source.cells {
      if cell.width > 0 {
        let local_x = index % source.size.width
        let local_y = index / source.size.width
        if local_y < source.size.height {
          let x = origin.x + local_x
          let y = origin.y + local_y
          let source_remaining = source.size.width - local_x
          let valid_span = cell.width <= source_remaining
          let fully_visible = valid_span and clip.contains(x, y) and cell.width <= clip.right - x
          if fully_visible {
            target.set_cell(x, y, cell)
          } else {
            mut visible_width = cell.width
            if visible_width > source_remaining {
              visible_width = source_remaining
            }
            clear_clipped_span(target, x, y, visible_width, clip)
          }
        }
      }
    }
  }

  match source.cursor {
    cursor => {
      let translated = Point{x: origin.x + cursor.point.x, y: origin.y + cursor.point.y}
      if cursor.point.x >= 0 and cursor.point.x < source.size.width and cursor.point.y >= 0 and cursor.point.y < source.size.height and clip.contains(translated.x, translated.y) {
        target.show_cursor(translated, cursor.shape)
      }
    },
    _ => (),
  }

  for positioned in source.children {
    let child_origin = Point{x: origin.x + positioned.origin.x, y: origin.y + positioned.origin.y}
    let child_clip = intersect(
      clip,
      Clip{
        left: child_origin.x,
        top: child_origin.y,
        right: child_origin.x + positioned.surface.size.width,
        bottom: child_origin.y + positioned.surface.size.height,
      },
    )
    if not child_clip.is_empty() {
      composite(target, positioned.surface, child_origin, child_clip)
    }
  }
}

fn flatten(surface: Surface) Surface {
  let flattened = mut blank(surface.size.width, surface.size.height)
  let root_clip = Clip{
    left: 0,
    top: 0,
    right: surface.size.width,
    bottom: surface.size.height,
  }
  composite(flattened, surface, Point{x: 0, y: 0}, root_clip)

  let cursor = try flattened.cursor -> _ { flattened.@ }
  let cell = try flattened.cell(cursor.point.x, cursor.point.y) -> _ {
    flattened.hide_cursor()
    flattened.@
  }
  if cell.width == 0 {
    flattened.hide_cursor()
  }
  flattened.@
}
