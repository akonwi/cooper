use ard/testing

use cooper/cell_style
use cooper/geometry
use cooper/paint

private fn styled() cell_style::Style {
  cell_style::new(
    foreground: cell_style::rgb(12, 34, 56),
    background: cell_style::rgb(78, 90, 123),
    bold: true,
    italic: true,
    underline: true,
    reverse: true,
  )
}

test fn cell_style_validates_rgb_and_defaults_attributes() Void!Str {
  let color = cell_style::rgb(12, 34, 56)
  let plain = cell_style::new(foreground: color)

  try testing::assert(color.red == Uint8::from(12), "Expected red channel")
  try testing::assert(color.green == Uint8::from(34), "Expected green channel")
  try testing::assert(color.blue == Uint8::from(56), "Expected blue channel")
  testing::assert(
    (not plain.bold) and (not plain.dim) and (not plain.italic) and (not plain.underline) and (not plain.blink) and (not plain.reverse) and (not plain.strike),
    "Expected default cell attributes",
  )
}

test fn painted_cells_preserve_and_clear_style_across_wide_spans() Void!Str {
  let buffer = paint::new_buffer(3, 1)
  let bounds = geometry::Rect{
    x: 0,
    y: 0,
    width: 3,
    height: 1,
  }
  let ctx = mut paint::Context{
    buffer: buffer,
    bounds: bounds,
    clip: bounds,
  }
  ctx.write(0, 0, "界", text_style: styled())

  let lead = buffer.cell_at(0, 0).expect("styled lead")
  let continuation = buffer.cell_at(1, 0).expect("styled continuation")
  try testing::assert(
    lead.style.background.expect("background").blue == Uint8::from(123),
    "Expected painted background",
  )
  try testing::assert(
    continuation.width == 0 and continuation.style.reverse,
    "Expected styled continuation",
  )

  ctx.write(1, 0, "x")
  try testing::assert(
    not buffer.cell_at(0, 0).expect("cleared lead").style.bold,
    "Expected cleared style",
  )
  testing::assert(
    not buffer.cell_at(1, 0).expect("plain overwrite").style.foreground.is_some(),
    "Expected default overwrite style",
  )
}
