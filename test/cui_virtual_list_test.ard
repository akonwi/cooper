use ard/testing

use cooper/cui
use cooper/cui/renderer
use cooper/event
use cooper/testing as headless
use cooper/ui

private fn navigation_key(name: Str) mut event::KeyEvent {
  event::key(
    name,
    "",
    event::KeyEventType::press,
    event::Modifiers{
      shift: false,
      ctrl: false,
      alt: false,
      super: false,
    },
  )
}

private fn items(count: Int) [Int] {
  let values = mut List::new<Int>()
  mut index = 0
  while index < count {
    values.push(index)
    index =+ 1
  }
  values.@
}
private fn row(id: Int) cui::View {
  let children = mut List::new<cui::View>()
  children.push(cui::text("row{id}", styles: ui::style(height: ui::cells(1))))
  mut line = 0
  while line < id % 3 {
    children.push(cui::text("body{id}:{line}", styles: ui::style(height: ui::cells(1))))
    line =+ 1
  }
  cui::box(children.@, styles: ui::style(flex_shrink: 0.0))
}
struct Model {
  items: [Int],
  builds: Int,
  ref: mut cui::VirtualListRef,
}
struct Props {
  data: mut Model,
}
struct Screen {
  data: mut Model,
}
private fn screen(props: mut Props) mut Screen {
  (mut Screen{data: props.data})
}
impl cui::Component for Screen {
  fn mut render() cui::View {
    cui::virtual_list(
      self.data.items,
      item_key: fn(id: Int) Str {
        id.to_str()
      },
      render_item: fn(id: Int) cui::View {
        self.data.builds =+ 1
        row(id)
      },
      ref: self.data.ref,
      styles: ui::style(width: ui::percent(100.0), height: ui::percent(100.0)),
    )
  }
}

test fn variable_rows_are_lazy_and_reveal_settles_before_paint() Void!Str {
  let app = headless::new(30, 8)
  defer app.destroy()
  let data = mut Model{
    items: items(1000),
    builds: 0,
    ref: cui::virtual_list_ref(),
  }
  let renderer = renderer::mount(app.context, app.root, cui::child(screen, Props{data: data}))
  defer renderer.destroy()
  app.flush()
  let list = data.ref.current.expect("mounted list")
  try testing::assert(app.frame().text().contains("row0"), "Default options measure the initial viewport")
  try testing::assert(
    data.builds < 100 and list.mounted_count() < 40,
    "Mount is bounded by viewport, not item count",
  )
  try testing::assert(list.scroll_to_key("97"), "Offscreen key accepted")
  app.flush()
  try testing::assert(
    app.frame().cell(0, 0).expect("first cell").grapheme == "r" and app.frame().text().contains("row97"),
    "Unmeasured jump renders target in the same frame",
  )
  try testing::assert(list.visible_range().start == 97, "Start alignment resolves to the keyed row")
  try testing::assert(
    list.mounted_count() < 40 and data.builds < 250,
    "Jump does not build intervening rows",
  )
  let _ = list.scroll_to_key("500")
  app.flush()
  let _ = list.scroll_to_key("97")
  app.flush()
  try testing::assert(list.visible_range().start == 97, "Measured revisit retains key offsets")
  renderer.destroy()
  testing::assert(
    data.ref.current.is_none() and not list.reveal("97"),
    "Teardown clears public ref and retires requests",
  )
}

test fn insert_reorder_remove_and_empty_preserve_a_keyed_anchor() Void!Str {
  let app = headless::new(30, 8)
  defer app.destroy()
  let data = mut Model{
    items: items(200),
    builds: 0,
    ref: cui::virtual_list_ref(),
  }
  let renderer = renderer::mount(app.context, app.root, cui::child(screen, Props{data: data}))
  defer renderer.destroy()
  app.flush()
  let list = data.ref.current.expect("list")
  renderer.update(fn() {
    let _ = list.scroll_by(7)
  })
  app.flush()
  try testing::assert(list.scroll_top() == 7, "Owner rerender preserves scrolling from the same event")
  let _ = list.scroll_to_key("97")
  app.flush()
  renderer.update(fn() {
    let next = mut List::new<Int>()
    next.push(1001)
    next.push(1002)
    for id in data.items {
      next.push(id)
    }
    data.items = next.@
  })
  app.flush()
  try testing::assert(
    list.visible_range().start == 99 and app.frame().text().contains("row97"),
    "Prepend preserves visible key rather than index",
  )
  renderer.update(fn() {
    let next = mut List::new<Int>()
    for id in data.items {
      if id != 97 {
        next.push(id)
      }
    }
    data.items = next.@
  })
  app.flush()
  try testing::assert(
    app.frame().text().contains("row98") and not app.frame().text().contains("row97"),
    "Deleting anchor falls forward to surviving successor",
  )
  renderer.update(fn() {
    data.items = []
  })
  app.flush()
  testing::assert(
    list.mounted_count() == 0 and list.total_height() == 0 and list.scroll_top() == 0 and (not list.reveal("97")),
    "Empty transition clamps extent and retires all rows",
  )
}

test fn bad_estimates_and_oversized_rows_converge_without_blank_frames() Void!Str {
  let app = headless::new(30, 80)
  defer app.destroy()
  let ref = cui::virtual_list_ref()
  let renderer = renderer::mount(
    app.context,
    app.root,
    cui::virtual_list(
      items(1000),
      item_key: fn(id: Int) Str {
        id.to_str()
      },
      render_item: fn(id: Int) cui::View {
        cui::text("single{id}", styles: ui::style(height: ui::cells(1)))
      },
      estimated_height: 10000,
      overscan: 0,
      ref: ref,
      styles: ui::style(width: ui::percent(100.0), height: ui::percent(100.0)),
    ),
  )
  app.flush()
  try testing::assert(
    app.frame().text().contains("single79") and ref.current.expect("list").mounted_count() == 80,
    "Severe overestimate fills the entire viewport in bounded passes",
  )
  renderer.destroy()
  let tall = renderer::mount(
    app.context,
    app.root,
    cui::virtual_list(
      [0, 1, 2],
      item_key: fn(id: Int) Str {
        id.to_str()
      },
      render_item: fn(id: Int) cui::View {
        cui::box([cui::text("tall{id}")], styles: ui::style(height: ui::cells(200)))
      },
      ref: ref,
      overscan: 0,
      styles: ui::style(width: ui::percent(100.0), height: ui::percent(100.0)),
    ),
  )
  defer tall.destroy()
  app.flush()
  let list = ref.current.expect("tall list")
  let _ = list.reveal("1")
  app.flush()
  try testing::assert(
    list.visible_range().start == 1 and app.frame().text().contains("tall1"),
    "Nearest reveal of taller-than-viewport row does not oscillate",
  )
  let _ = list.scroll_by(37)
  app.flush()
  testing::assert(
    list.visible_range().start == 1 and list.scroll_top() == 237,
    "Can scroll inside a single tall row",
  )
}

test fn width_changes_remeasure_and_preserve_the_visible_key() Void!Str {
  let app = headless::new(40, 8)
  defer app.destroy()
  let ref = cui::virtual_list_ref()
  let renderer = renderer::mount(
    app.context,
    app.root,
    cui::virtual_list(
      items(200),
      item_key: fn(id: Int) Str {
        id.to_str()
      },
      render_item: fn(id: Int) cui::View {
        cui::text(
          "row{id}: variable width text wraps over additional terminal lines when resized narrower.",
        )
      },
      ref: ref,
      styles: ui::style(width: ui::percent(100.0), height: ui::percent(100.0)),
    ),
  )
  defer renderer.destroy()
  app.flush()
  let list = ref.current.expect("list")
  let _ = list.scroll_to_key("80")
  app.flush()
  app.resize(19, 8)
  app.flush()
  try testing::assert(
    list.visible_range().start == 80 and app.frame().text().contains("row80:"),
    "Narrow rewrap preserves anchor identity",
  )
  app.resize(63, 8)
  app.flush()
  testing::assert(
    list.visible_range().start == 80 and app.frame().text().contains("row80:"),
    "Wider rewrap also preserves anchor identity",
  )
}

test fn focused_row_is_pinned_until_focus_moves() Void!Str {
  let app = headless::new(30, 8)
  defer app.destroy()
  let field = cui::input_ref()
  let ref = cui::virtual_list_ref()
  let renderer = renderer::mount(
    app.context,
    app.root,
    cui::virtual_list(
      items(200),
      item_key: fn(id: Int) Str {
        id.to_str()
      },
      render_item: fn(id: Int) cui::View {
        if id == 0 {
          cui::input("editable", ref: field)
        } else {
          row(id)
        }
      },
      ref: ref,
      overscan: 0,
      styles: ui::style(width: ui::percent(100.0), height: ui::percent(100.0)),
    ),
  )
  defer renderer.destroy()
  app.flush()
  let input = field.current.expect("initial input")
  try testing::assert(input.focus(), "Input can take focus")
  app.flush()
  let list = ref.current.expect("list")
  let _ = list.scroll_to_key("100")
  app.flush()
  try testing::assert(list.visible_range().start == 100, "Pinned focus does not undo scrolling")
  try testing::assert(
    field.current.is_some() and input.is_focused(),
    "Offscreen focused row remains mounted",
  )
  try testing::assert(list.mounted_count() < 15, "Pinning does not build intervening rows")
  try testing::assert(list.focus(), "Move focus to list")
  app.flush()
  try testing::assert(field.current.is_none(), "Unfocused offscreen input is unmounted")
  renderer.destroy()
  testing::assert(not list.invalidate_item("100"), "Retired list rejects invalidation")
}

test fn thumb_drag_overrides_described_focus_until_explicit_focus_request() Void!Str {
  let app = headless::new(30, 8)
  defer app.destroy()
  let field = cui::input_ref()
  let ref = cui::virtual_list_ref()
  let renderer = renderer::mount(
    app.context,
    app.root,
    cui::virtual_list(
      items(200),
      item_key: fn(id: Int) Str {
        id.to_str()
      },
      render_item: fn(id: Int) cui::View {
        if id == 0 {
          cui::input("editable", ref: field, focused: true)
        } else {
          row(id)
        }
      },
      ref: ref,
      styles: ui::style(width: ui::percent(100.0), height: ui::percent(100.0)),
    ),
  )
  defer renderer.destroy()
  app.flush()
  let list = ref.current.expect("list")
  let input = field.current.expect("input")
  app.drag(29, 0, 29, 7)
  app.flush()
  try testing::assert(list.visible_range().start > 100, "Thumb drag can move the focused row offscreen")
  app.render()
  app.render()
  try testing::assert(list.visible_range().start > 100, "Later paints do not reveal the old focused row")
  try testing::assert(input.is_focused(), "Dragging preserves keyboard focus")
  try testing::assert(
    list.mounted_count() < 40,
    "Focused row remains pinned without mounting intervening rows",
  )
  try testing::assert(input.focus(), "Explicit focus can request reveal even on the same control")
  app.render()
  testing::assert(list.visible_range().start == 0, "Explicit focus restores visibility")
}

test fn virtual_visible_cells_match_eager_layout_after_key_jumps() Void!Str {
  let lazy = headless::new(30, 8)
  defer lazy.destroy()
  let eager = headless::new(30, 8)
  defer eager.destroy()
  let ref = cui::virtual_list_ref()
  let scroll = cui::scroll_box_ref()
  let rows = mut List::new<cui::View>()
  for id in items(200) {
    rows.push(row(id))
  }
  let size = ui::style(width: ui::percent(100.0), height: ui::percent(100.0))
  let eager_renderer = renderer::mount(
    eager.context,
    eager.root,
    cui::scroll_box(rows.@, ref: scroll, styles: size),
  )
  defer eager_renderer.destroy()
  let lazy_renderer = renderer::mount(
    lazy.context,
    lazy.root,
    cui::virtual_list(
      items(200),
      item_key: fn(id: Int) Str {
        id.to_str()
      },
      render_item: row,
      ref: ref,
      styles: size,
    ),
  )
  defer lazy_renderer.destroy()
  eager.flush()
  lazy.flush()
  for target in [0, 1, 2, 37, 125, 190, 1] {
    mut offset = 0
    mut id = 0
    while id < target {
      let extra = id % 3
      offset =+ extra + 1
      id =+ 1
    }
    let _ = ref.current.expect("list").scroll_to_key(target.to_str())
    let _ = scroll.current.expect("eager scroll").scroll_to(offset)
    eager.flush()
    lazy.flush()
    mut y = 0
    while y < 8 {
      mut x = 0
      // The scrollbar intentionally reflects estimated rather than eager extent.
      while x < 29 {
        try testing::assert(
          lazy.frame().cell(x, y).expect("lazy cell").grapheme == eager.frame().cell(x, y).expect("eager cell").grapheme,
          "Visible cell {x},{y} at key {target} matches eager layout (offset {offset}): lazy={lazy.frame().text()} eager={eager.frame().text()}",
        )
        x =+ 1
      }
      y =+ 1
    }
  }
  testing::assert(
    ref.current.expect("list").mounted_count() < 40,
    "Cell parity uses a bounded working set",
  )
}

test fn fixed_rows_center_end_and_nearest_align_exactly() Void!Str {
  let app = headless::new(30, 8)
  defer app.destroy()
  let ref = cui::virtual_list_ref()
  let renderer = renderer::mount(
    app.context,
    app.root,
    cui::virtual_list(
      items(200),
      item_key: fn(id: Int) Str {
        id.to_str()
      },
      render_item: row,
      row_height: 1,
      ref: ref,
      styles: ui::style(width: ui::percent(100.0), height: ui::percent(100.0)),
    ),
  )
  defer renderer.destroy()
  app.flush()
  let list = ref.current.expect("list")
  let _ = list.scroll_to_key("100", cui::ScrollAlignment::center)
  app.flush()
  try testing::assert(list.scroll_top() == 97, "One-cell row centered in eight-cell viewport")
  let _ = list.scroll_to_key("100", cui::ScrollAlignment::end)
  app.flush()
  try testing::assert(list.scroll_top() == 93, "End alignment places row on final viewport line")
  let _ = list.reveal("95")
  app.flush()
  try testing::assert(list.scroll_top() == 93, "Nearest leaves an already visible row in place")
  let _ = list.reveal("90")
  app.flush()
  try testing::assert(list.scroll_top() == 90, "Nearest above viewport aligns to start")
  try testing::assert(
    list.scroll_to_edge(cui::ScrollEdge::end),
    "Programmatic end follow accepted without constructor opt-in",
  )
  app.flush()
  testing::assert(
    list.is_following_edge() and list.scroll_top() == 192,
    "Programmatic end follow enables the presentation",
  )
}

struct StyledListState {
  options: ui::ScrollbarOptions,
  ref: mut cui::VirtualListRef,
}
struct StyledListProps {
  state: mut StyledListState,
}
struct StyledList {
  props: mut StyledListProps,
}
private fn styled_list(props: mut StyledListProps) mut StyledList {
  (mut StyledList{props: props})
}
impl cui::Component for StyledList {
  fn mut render() cui::View {
    cui::virtual_list(
      items(100),
      item_key: fn(id: Int) Str {
        id.to_str()
      },
      render_item: fn(id: Int) cui::View {
        cui::text("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", styles: ui::style(height: ui::cells(1)))
      },
      row_height: 1,
      scrollbar_options: self.props.state.options,
      ref: self.props.state.ref,
      styles: ui::style(width: ui::percent(100.0), height: ui::percent(100.0)),
    )
  }
}

test fn scrollbar_options_apply_update_hide_and_restore() Void!Str {
  let app = headless::new(12, 6)
  defer app.destroy()
  let ref = cui::virtual_list_ref()
  let data = mut StyledListState{
    ref: ref,
    options: ui::scrollbar_options(
      appearance: ui::scrollbar_appearance(
        track_glyph: ".",
        thumb_glyph: "#",
        thumb_style: ui::span_style(foreground: ui::indexed(2), bold: false),
        track_style: ui::span_style(dim: false),
      ),
    ),
  }
  let renderer = renderer::mount(
    app.context,
    app.root,
    cui::child(styled_list, StyledListProps{state: data}),
  )
  defer renderer.destroy()
  app.flush()
  let original = ref.current.expect("list")
  let thumb = app.frame().cell(11, 0).expect("thumb")
  try testing::assert(
    thumb.grapheme == "#" and not thumb.style.bold,
    "Custom thumb overrides default glyph and bold",
  )
  try testing::assert(
    thumb.style.foreground.expect("color").index.expect("palette") == Uint8::from(2),
    "Custom thumb color",
  )
  let track = app.frame().cell(11, 5).expect("track")
  try testing::assert(
    track.grapheme == "." and not track.style.dim,
    "Custom track overrides glyph and dim",
  )
  renderer.update(fn() {
    data.options = ui::scrollbar_options(visibility: ui::ScrollbarVisibility::hidden)
  })
  app.flush()
  try testing::assert(
    app.frame().cell(11, 0).expect("content").grapheme == "x",
    "Hidden scrollbar returns gutter to content",
  )
  renderer.update(fn() {
    data.options = ui::scrollbar_options()
  })
  app.flush()
  try testing::assert(
    ref.current.expect("same list") == original,
    "Options updates preserve list identity",
  )
  testing::assert(
    app.frame().cell(11, 0).expect("default thumb").grapheme == "┃",
    "Default options restore standard thumb",
  )
}

struct FollowingModel {
  items: [Int],
  last_height: Int,
  ref: mut cui::VirtualListRef,
}
struct FollowingProps {
  data: mut FollowingModel,
}
struct FollowingScreen {
  data: mut FollowingModel,
}
private fn following_screen(props: mut FollowingProps) mut FollowingScreen {
  (mut FollowingScreen{data: props.data})
}
impl cui::Component for FollowingScreen {
  fn mut render() cui::View {
    let last = self.data.items.size() - 1
    cui::virtual_list(
      self.data.items,
      item_key: fn(id: Int) Str {
        id.to_str()
      },
      render_item: fn(id: Int) cui::View {
        let height = match id == last {
          true => self.data.last_height,
          false => 1,
        }
        cui::text("row{id}", styles: ui::style(height: ui::cells(height)))
      },
      estimated_height: 1,
      overscan: 0,
      ref: self.data.ref,
      styles: ui::style(width: ui::percent(100.0), height: ui::percent(100.0)),
      sticky_scroll: cui::ScrollEdge::end,
    )
  }
}

test fn following_edge_tracks_growth_until_scrolling_away_and_can_be_controlled() Void!Str {
  let app = headless::new(20, 5)
  defer app.destroy()
  let data = mut FollowingModel{
    items: items(11),
    last_height: 1,
    ref: cui::virtual_list_ref(),
  }
  let renderer = renderer::mount(
    app.context,
    app.root,
    cui::child(following_screen, FollowingProps{data: data}),
  )
  defer renderer.destroy()
  app.flush()
  let list = data.ref.current.expect("following list")
  try testing::assert(
    list.is_following_edge() and list.scroll_top() == 6 and list.last_item_visible(),
    "Following list initially settles at its logical end",
  )

  app.drag(19, 4, 19, 0)
  app.flush()
  try testing::assert(
    not list.is_following_edge() and list.scroll_top() == 0,
    "Dragging the scrollbar away from a followed edge unpins it",
  )
  app.drag(19, 0, 19, 4)
  app.flush()
  try testing::assert(
    list.is_following_edge() and list.scroll_top() == 6,
    "Dragging the scrollbar back to the enabled edge resumes following",
  )

  let _ = list.scroll_by(-3)
  app.flush()
  try testing::assert(
    not list.is_following_edge() and list.scroll_top() == 3 and (not list.last_item_visible()),
    "Scrolling away stops following and reports the latest item out of view",
  )
  renderer.update(fn() {
    let next = mut List::new<Int>()
    for item in data.items {
      next.push(item)
    }
    next.push(11)
    data.items = next.@
  })
  app.flush()
  try testing::assert(list.scroll_top() == 3, "Appending while unpinned preserves the viewport")

  let _ = list.scroll_by(100)
  app.flush()
  try testing::assert(
    list.is_following_edge() and list.last_item_visible(),
    "Scrolling to the end resumes following",
  )
  renderer.update(fn() {
    let next = mut List::new<Int>()
    for item in data.items {
      next.push(item)
    }
    next.push(12)
    data.items = next.@
  })
  app.flush()
  try testing::assert(list.scroll_top() == 8, "A pinned list follows appended items")

  list.stop_following()
  renderer.update(fn() {
    let next = mut List::new<Int>()
    for item in data.items {
      next.push(item)
    }
    next.push(13)
    data.items = next.@
  })
  app.flush()
  try testing::assert(
    not list.is_following_edge() and list.scroll_top() == 8,
    "Programmatic unpin freezes the viewport",
  )
  try testing::assert(list.scroll_to_edge(cui::ScrollEdge::end), "End jump accepted")
  app.flush()
  try testing::assert(
    list.is_following_edge() and list.scroll_top() == 9 and list.last_item_visible(),
    "End jump resumes following",
  )

  renderer.update(fn() {
    data.last_height = 4
    let _ = list.invalidate_item("13")
  })
  app.flush()
  try testing::assert(list.scroll_top() == 12, "Following tracks growth of the final item")
  renderer.update(fn() {
    data.last_height = 8
    list.stop_following()
    let _ = list.invalidate_item("13")
    let _ = list.scroll_to_key("13", cui::ScrollAlignment::start)
  })
  app.flush()
  testing::assert(
    not list.is_following_edge() and list.scroll_top() == 13 and list.last_item_visible(),
    "A tall final item can be positioned at its start without resuming follow",
  )
}

test fn one_shot_end_jump_converges_from_a_severe_tail_estimate() Void!Str {
  let app = headless::new(20, 5)
  defer app.destroy()
  let ref = cui::virtual_list_ref()
  let renderer = renderer::mount(
    app.context,
    app.root,
    cui::virtual_list(
      items(100),
      item_key: fn(id: Int) Str {
        id.to_str()
      },
      render_item: fn(id: Int) cui::View {
        cui::text("row{id}", styles: ui::style(height: ui::cells(1)))
      },
      estimated_height: 10000,
      overscan: 0,
      ref: ref,
      styles: ui::style(width: ui::percent(100.0), height: ui::percent(100.0)),
    ),
  )
  defer renderer.destroy()
  app.flush()
  let list = ref.current.expect("estimated following list")
  try testing::assert(list.focus(), "Estimated list can receive navigation input")
  try testing::assert(list.scroll_to_edge(cui::ScrollEdge::end, false), "One-shot end jump accepted")
  app.key(navigation_key("up"))
  app.flush()
  try testing::assert(list.scroll_top() == 0, "Newer keyboard input cancels a pending one-shot jump")
  let _ = list.scroll_to_edge(cui::ScrollEdge::end, false)
  app.flush()
  let visible = list.visible_range()
  testing::assert(
    visible.start == 95 and visible.end == 100 and app.frame().text().contains("row99"),
    "Tail following materializes a bounded backward batch despite a severe estimate",
  )
}

test fn following_edge_bottom_anchors_short_content_and_reanchors_on_resize() Void!Str {
  let app = headless::new(20, 5)
  defer app.destroy()
  let ref = cui::virtual_list_ref()
  let renderer = renderer::mount(
    app.context,
    app.root,
    cui::virtual_list(
      [0, 1],
      item_key: fn(id: Int) Str {
        id.to_str()
      },
      render_item: fn(id: Int) cui::View {
        cui::text("row{id}", styles: ui::style(height: ui::cells(1)))
      },
      row_height: 1,
      overscan: 0,
      ref: ref,
      styles: ui::style(width: ui::percent(100.0), height: ui::percent(100.0)),
      sticky_scroll: cui::ScrollEdge::end,
    ),
  )
  defer renderer.destroy()
  app.flush()
  let list = ref.current.expect("short following list")
  try testing::assert(
    app.frame().cell(0, 3).expect("first bottom row").grapheme == "r" and app.frame().cell(0, 4).expect("last bottom row").grapheme == "r",
    "Short content grows upward from the viewport bottom",
  )
  try testing::assert(
    list.scroll_top() == 0 and list.last_item_visible(),
    "Short content is visible without a synthetic offset",
  )
  let _ = list.scroll_by(-1)
  try testing::assert(
    not list.is_following_edge(),
    "Upward intent unpins even when short content cannot move",
  )
  let _ = list.scroll_to_edge(cui::ScrollEdge::end)
  app.flush()
  app.resize(20, 7)
  app.flush()
  testing::assert(
    app.frame().cell(0, 5).expect("resized first row").grapheme == "r" and app.frame().cell(0, 6).expect("resized last row").grapheme == "r",
    "Bottom anchor follows viewport height changes",
  )
}

struct StartFollowingModel {
  items: [Int],
  edge: cui::ScrollEdge,
  ref: mut cui::VirtualListRef,
}
struct StartFollowingProps {
  data: mut StartFollowingModel,
}
struct StartFollowingScreen {
  data: mut StartFollowingModel,
}
private fn start_following_screen(props: mut StartFollowingProps) mut StartFollowingScreen {
  (mut StartFollowingScreen{data: props.data})
}
impl cui::Component for StartFollowingScreen {
  fn mut render() cui::View {
    cui::virtual_list(
      self.data.items,
      item_key: fn(id: Int) Str {
        id.to_str()
      },
      render_item: fn(id: Int) cui::View {
        cui::text("row{id}", styles: ui::style(height: ui::cells(1)))
      },
      row_height: 1,
      overscan: 0,
      ref: self.data.ref,
      styles: ui::style(width: ui::percent(100.0), height: ui::percent(100.0)),
      sticky_scroll: self.data.edge,
    )
  }
}

test fn following_start_tracks_prepends_until_scrolling_away() Void!Str {
  let app = headless::new(20, 5)
  defer app.destroy()
  let data = mut StartFollowingModel{
    items: items(11),
    edge: cui::ScrollEdge::start,
    ref: cui::virtual_list_ref(),
  }
  let renderer = renderer::mount(
    app.context,
    app.root,
    cui::child(start_following_screen, StartFollowingProps{data: data}),
  )
  defer renderer.destroy()
  app.flush()
  let list = data.ref.current.expect("start-following list")
  try testing::assert(
    list.is_following_edge() and list.scroll_top() == 0 and list.first_item_visible(),
    "Start-following list initially settles at the top",
  )

  let _ = list.scroll_by(3)
  app.flush()
  try testing::assert(
    not list.is_following_edge() and list.scroll_top() == 3 and (not list.first_item_visible()),
    "Scrolling down stops start following",
  )
  renderer.update(fn() {
    let next = mut List::new<Int>()
    next.push(-2)
    next.push(-1)
    for item in data.items {
      next.push(item)
    }
    data.items = next.@
  })
  app.flush()
  try testing::assert(
    list.scroll_top() == 5 and list.visible_range().start == 5,
    "Prepending while unpinned preserves the visible keyed row",
  )

  let _ = list.scroll_by(-100)
  app.flush()
  try testing::assert(
    list.is_following_edge() and list.scroll_top() == 0,
    "Returning to the top resumes start following",
  )
  renderer.update(fn() {
    let next = mut List::new<Int>()
    next.push(-4)
    next.push(-3)
    for item in data.items {
      next.push(item)
    }
    data.items = next.@
  })
  app.flush()
  testing::assert(
    list.scroll_top() == 0 and list.first_item_visible() and app.frame().text().contains("row-4"),
    "A pinned start follows prepended items",
  )
}

test fn declarative_edge_change_replaces_a_pending_opposite_jump() Void!Str {
  let app = headless::new(20, 5)
  defer app.destroy()
  let data = mut StartFollowingModel{
    items: items(20),
    edge: cui::ScrollEdge::end,
    ref: cui::virtual_list_ref(),
  }
  let renderer = renderer::mount(
    app.context,
    app.root,
    cui::child(start_following_screen, StartFollowingProps{data: data}),
  )
  defer renderer.destroy()
  app.flush()
  let list = data.ref.current.expect("switching-edge list")
  try testing::assert(
    list.scroll_to_edge(cui::ScrollEdge::end, false),
    "Pending one-shot edge jump accepted",
  )
  renderer.update(fn() {
    data.edge = cui::ScrollEdge::start
  })
  app.flush()
  testing::assert(
    list.is_following_edge() and list.scroll_top() == 0 and list.first_item_visible(),
    "New declarative edge supersedes an older imperative settlement",
  )
}

struct UpdateLog {
  count: Int,
  latest: cui::VirtualListUpdate?,
}
struct UpdateModel {
  log: mut UpdateLog,
  ref: mut cui::VirtualListRef,
}
struct UpdateProps {
  data: mut UpdateModel,
}
struct UpdateScreen {
  data: mut UpdateModel,
}
private fn update_screen(props: mut UpdateProps) mut UpdateScreen {
  (mut UpdateScreen{data: props.data})
}
impl cui::Component for UpdateScreen {
  fn mut render() cui::View {
    cui::virtual_list(
      items(200),
      item_key: fn(id: Int) Str {
        id.to_str()
      },
      render_item: row,
      estimated_height: 20,
      overscan: 0,
      ref: self.data.ref,
      styles: ui::style(width: ui::percent(100.0), height: ui::percent(100.0)),
      sticky_scroll: cui::ScrollEdge::end,
      on_update: fn(update: cui::VirtualListUpdate, ctx: cui::Context) {
        self.data.log.count =+ 1
        self.data.log.latest = Maybe::new(update)
      },
    )
  }
}

private fn update_direction(update: cui::VirtualListUpdate, direction: cui::VirtualScrollDirection) Bool {
  match update.user_scroll {
    actual => actual == direction,
    _ => false,
  }
}

test fn virtual_list_updates_publish_final_committed_state_and_user_intent() Void!Str {
  let app = headless::new(30, 8)
  defer app.destroy()
  let data = mut UpdateModel{
    log: mut UpdateLog{count: 0, latest: Maybe::new<cui::VirtualListUpdate>()},
    ref: cui::virtual_list_ref(),
  }
  let renderer = renderer::mount(
    app.context,
    app.root,
    cui::child(update_screen, UpdateProps{data: data}),
  )
  defer renderer.destroy()
  app.flush()
  let list = data.ref.current.expect("observed list")
  let initial = data.log.latest.expect("initial update")
  try testing::assert(
    data.log.count == 1 and initial.initial and initial.state.scroll_top == initial.state.maximum_scroll_top and initial.state.last_item_visible,
    "Initial notification coalesces measurement passes and describes the committed edge",
  )

  renderer.update(fn() {
    list.stop_following()
    let _ = list.scroll_by(-3)
  })
  app.flush()
  let programmatic = data.log.latest.expect("programmatic update")
  try testing::assert(
    data.log.count == 2 and programmatic.user_scroll.is_none() and (not programmatic.moved) and (not programmatic.initial),
    "Programmatic scrolling changes finalized state without reporting user origin",
  )

  try testing::assert(list.focus(), "Observed list accepts keyboard input")
  app.key(navigation_key("up"))
  app.flush()
  let keyboard = data.log.latest.expect("keyboard update")
  try testing::assert(
    data.log.count == 3 and update_direction(keyboard, cui::VirtualScrollDirection::toward_start) and keyboard.moved,
    "Keyboard movement reports its committed direction and movement",
  )

  renderer.update(fn() {
    let _ = list.scroll_to_edge(cui::ScrollEdge::start, false)
  })
  app.flush()
  let before_boundary = data.log.count
  app.key(navigation_key("up"))
  app.flush()
  let boundary = data.log.latest.expect("boundary update")
  try testing::assert(
    data.log.count == before_boundary + 1 and update_direction(boundary, cui::VirtualScrollDirection::toward_start) and (not boundary.moved) and boundary.state.scroll_top == 0,
    "Blocked keyboard intent still publishes against finalized state",
  )

  let before_wheel = data.log.count
  app.scroll(0, 0, -1)
  app.flush()
  let wheel = data.log.latest.expect("wheel update")
  try testing::assert(
    data.log.count == before_wheel + 1 and update_direction(wheel, cui::VirtualScrollDirection::toward_start) and (not wheel.moved),
    "Blocked wheel intent also publishes without requiring offset movement",
  )

  app.scroll(0, 0, 1)
  app.flush()
  let moving_wheel = data.log.latest.expect("moving wheel update")
  try testing::assert(
    update_direction(moving_wheel, cui::VirtualScrollDirection::toward_end) and moving_wheel.moved,
    "Moving wheel input retains user origin through the committed frame",
  )

  app.drag(29, 0, 29, 7)
  app.flush()
  let scrollbar = data.log.latest.expect("scrollbar update")
  try testing::assert(
    update_direction(scrollbar, cui::VirtualScrollDirection::toward_end) and scrollbar.moved and scrollbar.state.scroll_top > 0,
    "Scrollbar movement derives user direction from finalized offsets",
  )

  let delivered = data.log.count
  renderer.destroy()
  app.render()
  testing::assert(data.log.count == delivered, "Unmount suppresses later post-commit delivery")
}
