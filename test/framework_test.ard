test fn retained_input_clips_placeholder_to_its_layout_width() Void!Str {
  let ctx = context::internal_new()
  let field = input::new(ctx, placeholder: "abcdef", styles: fixed(3, 1))
  context::internal_state(ctx).compute_layout(field, 5, 1)
  let buffer = paint::new_buffer(5, 1)
  field.node().paint(buffer)

  try testing::assert(
    buffer.cell_at(2, 0).expect("last placeholder cell").grapheme == "c",
    "Expected clipped placeholder content",
  )
  try testing::assert(
    buffer.cell_at(3, 0).expect("outside placeholder").grapheme == " ",
    "Expected placeholder width clipping",
  )
  context::internal_state(ctx).destroy()
  testing::assert(field.node().is_destroyed(), "Expected placeholder input cleanup")
}

test fn retained_input_mutates_through_direct_routing_and_paints_cursor() Void!Str {
  let ctx = context::internal_new()
  let root = box::new(
    ctx,
    styles: style::new(
      width: style::cells(5),
      height: style::cells(1),
      align_items: style::Align::start,
    ),
  )
  let field = input::new(ctx, value: "abc", placeholder: "type", styles: fixed(5, 1))
  root.add(field)
  context::internal_state(ctx).compute_layout(root, 5, 1)
  root.node().mount_root(immediate_dispatch)
  let focused = focus::new()

  let clicked_event = framework_event::mouse(
    framework_event::MouseEventType::down,
    framework_event::MouseButton::left,
    0,
    0,
    framework_event::Modifiers{shift: false, ctrl: false, alt: false, super: false},
  )
  let clicked = router::dispatch_mouse(root, field.node(), clicked_event, focused)
  try testing::assert(clicked.handled, "Expected retained input click handling")
  try testing::assert(focused.focus(root, field.node()), "Expected runtime mouse autofocus")
  try testing::assert(focused.is_focused(field.node()), "Expected retained input click focus")

  let typed_event = framework_event::key(
    "x",
    "X",
    framework_event::KeyEventType::press,
    framework_event::Modifiers{shift: true, ctrl: false, alt: false, super: false},
  )
  let typed = router::dispatch_key(field.node(), typed_event, focused)
  try testing::assert(typed.handled, "Expected retained input key handling")
  try testing::assert(field.value() == "Xabc", "Expected retained input mutation")

  let buffer = paint::new_buffer(5, 1)
  root.node().paint(buffer)
  try testing::assert(
    buffer.cell_at(0, 0).expect("input lead cell").grapheme == "X",
    "Expected retained input paint",
  )
  try testing::assert(
    buffer.cursor.expect("retained input cursor").x == 1,
    "Expected focused retained cursor",
  )

  root.node().unmount_root()
  context::internal_state(ctx).destroy()
  testing::assert(field.node().is_destroyed(), "Expected retained input cleanup")
}

test fn retained_later_wide_paint_invalidates_cursor_on_continuation() Void!Str {
  let buffer = paint::new_buffer(2, 1)
  let bounds = geometry::Rect{
    x: 0,
    y: 0,
    width: 2,
    height: 1,
  }
  let ctx = mut paint::Context{
    buffer: buffer,
    bounds: bounds,
    clip: bounds,
    foreground: Maybe::new<color::Color>(),
    background: Maybe::new<color::Color>(),
  }
  ctx.show_cursor(1, 0)
  ctx.write(0, 0, "界")

  testing::assert(not buffer.cursor.is_some(), "Expected continuation cursor invalidation")
}

test fn retained_scroll_translates_clips_paint_and_hit_geometry() Void!Str {
  let ctx = context::internal_new()
  let content = box::new(
    ctx,
    styles: style::new(
      width: style::cells(3),
      height: style::cells(5),
      flex_shrink: 0.0,
      align_items: style::Align::start,
    ),
  )
  let labels = mut List::new<mut text::Text>()
  for value in ["0", "1", "2", "3", "4"] {
    let label = text::new(ctx, content: value)
    labels.push(label)
    content.add(label)
  }
  let view = scroll_box::new(ctx, styles: fixed(3, 2))
  view.add(content)
  context::internal_state(ctx).compute_layout(view, 3, 2)

  let before = paint::new_buffer(3, 2)
  view.node().paint(before)
  try testing::assert(
    before.cell_at(0, 0).expect("first scroll row").grapheme == "0",
    "Expected initial scroll row",
  )
  try testing::assert(
    before.cell_at(0, 1).expect("second scroll row").grapheme == "1",
    "Expected second initial row",
  )

  try testing::assert(view.scroll_to(2), "Expected retained scroll movement")
  let after = paint::new_buffer(3, 2)
  view.node().paint(after)
  try testing::assert(
    after.cell_at(0, 0).expect("translated scroll row").grapheme == "2",
    "Expected translated paint",
  )
  try testing::assert(
    after.cell_at(0, 1).expect("translated second row").grapheme == "3",
    "Expected clipped translated paint",
  )
  try testing::assert(
    labels.at(2).expect("third label").layout().screen.y == 0,
    "Expected translated cached geometry",
  )

  let target = hit::test(view, 0, 0).expect("scroll pointer target")
  try testing::assert(
    target.target == labels.at(2).expect("translated hit label").node_ref,
    "Expected deepest visible descendant hit after scrolling",
  )

  context::internal_state(ctx).destroy()
  testing::assert(content.node().is_destroyed(), "Expected retained scroll cleanup")
}

test fn retained_horizontal_scroll_translates_clips_paint_and_hit_geometry() Void!Str {
  let ctx = context::internal_new()
  let content = box::new(
    ctx,
    styles: style::new(width: style::cells(4), height: style::cells(1), flex_shrink: 0.0),
  )
  let label = text::new(
    ctx,
    content: "ABCD",
    wrap: text::TextWrap::none,
    styles: style::new(width: style::cells(4), height: style::cells(1)),
  )
  content.add(label)
  let view = scroll_box::new(ctx, styles: fixed(3, 2))
  view.add(content)
  context::internal_state(ctx).compute_layout(view, 3, 2)

  try testing::assert(view.maximum_scroll_left() == 2, "Expected horizontal maximum beside vertical gutter")
  try testing::assert(view.scroll_to_x(2), "Expected retained horizontal movement")
  let after = paint::new_buffer(3, 2)
  view.node().paint(after)
  try testing::assert(
    after.cell_at(0, 0).expect("horizontal first cell").grapheme == "C" and after.cell_at(1, 0).expect("horizontal second cell").grapheme == "D",
    "Expected clipped horizontal translation",
  )
  try testing::assert(label.layout().screen.x == -2, "Expected horizontally translated cached geometry")
  let target = hit::test(view, 0, 0).expect("horizontal pointer target")
  try testing::assert(target.target == label.node_ref, "Expected translated horizontal hit target")

  context::internal_state(ctx).destroy()
  testing::assert(content.node().is_destroyed(), "Expected horizontal retained scroll cleanup")
}

test fn retained_scroll_preserves_requested_offset_across_layout_changes() Void!Str {
  let ctx = context::internal_new()
  let content = box::new(
    ctx,
    styles: style::new(width: style::cells(2), height: style::cells(5)),
  )
  let view = scroll_box::new(ctx, styles: fixed(2, 2))
  view.add(content)

  try testing::assert(not view.scroll_to(3), "Expected pre-layout scroll request without movement")
  context::internal_state(ctx).compute_layout(view, 2, 2)
  try testing::assert(view.scroll_top() == 3, "Expected deferred retained scroll request")

  content.set_style(style::new(width: style::cells(2), height: style::cells(1)))
  context::internal_state(ctx).compute_layout(view, 2, 2)
  try testing::assert(view.scroll_top() == 0, "Expected temporary effective scroll clamp")
  try testing::assert(view.requested_scroll_top() == 3, "Expected retained desired scroll position")

  content.set_style(style::new(width: style::cells(2), height: style::cells(5)))
  context::internal_state(ctx).compute_layout(view, 2, 2)
  try testing::assert(view.scroll_top() == 3, "Expected restored retained scroll position")

  context::internal_state(ctx).destroy()
  testing::assert(content.node().is_destroyed(), "Expected requested scroll cleanup")
}

test fn retained_scroll_wheel_bubbles_and_stops_at_boundaries() Void!Str {
  let ctx = context::internal_new()
  let content = box::new(ctx, styles: fixed(2, 8))
  let view = scroll_box::new(ctx, styles: fixed(2, 2))
  view.add(content)
  context::internal_state(ctx).compute_layout(view, 2, 2)
  view.node().mount_root(immediate_dispatch)
  let focused = focus::new()
  let first = router::dispatch_mouse(view, view.node(), wheel_down(), focused)
  try testing::assert(first.handled and view.scroll_top() == 3, "Expected wheel scroll handling")

  let second = router::dispatch_mouse(view, view.node(), wheel_down(), focused)
  try testing::assert(second.handled and view.scroll_top() == 6, "Expected second wheel movement")

  let boundary = router::dispatch_mouse(view, view.node(), wheel_down(), focused)
  try testing::assert(not boundary.handled, "Expected ignored wheel at boundary")

  view.node().unmount_root()
  context::internal_state(ctx).destroy()
  testing::assert(content.node().is_destroyed(), "Expected wheel scroll cleanup")
}

test fn retained_shift_wheel_falls_back_horizontally_through_nested_scroll_boxes() Void!Str {
  let ctx = context::internal_new()
  let inner = scroll_box::new(ctx, styles: fixed(6, 2))
  inner.add(box::new(ctx, styles: fixed(5, 1)))
  let outer = scroll_box::new(ctx, styles: fixed(4, 2))
  outer.add(inner)
  context::internal_state(ctx).compute_layout(outer, 4, 2)
  outer.node().mount_root(immediate_dispatch)

  let focused = focus::new()
  let outcome = router::dispatch_mouse(outer, inner.node(), shifted_wheel_down(), focused)
  try testing::assert(outcome.handled, "Expected nested shifted wheel handling")
  try testing::assert(inner.scroll_left() == 0, "Expected inner horizontal boundary")
  try testing::assert(outer.scroll_left() == 3, "Expected outer horizontal fallback movement")

  outer.node().unmount_root()
  context::internal_state(ctx).destroy()
  testing::assert(inner.node().is_destroyed(), "Expected nested horizontal fallback cleanup")
}

test fn retained_focus_reveal_scrolls_horizontal_descendant_into_view() Void!Str {
  let ctx = context::internal_new()
