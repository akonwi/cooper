}

test fn retained_focus_reveal_scrolls_direct_descendant_identity() Void!Str {
  let ctx = context::internal_new()
  let content = box::new(ctx, styles: fixed(2, 5))
  let rows = mut List::new<mut box::Box>()
  for _index in 0..5 {
    let row = box::new(ctx, styles: fixed(2, 1))
    row.set_focusable(true)
    rows.push(row)
    content.add(row)
  }
  let view = scroll_box::new(ctx, styles: fixed(2, 2))
  view.add(content)
  context::internal_state(ctx).compute_layout(view, 2, 2)
  let focused = focus::new()
  focused.reconcile(view)
  let _ = focused.take_reveal_request()
  let last = rows.at(4).expect("fifth row").node()
  try testing::assert(focused.focus(view, last), "Expected direct retained focus request")
  let target = focused.focused().expect("last retained focus row")

  try testing::assert(focus::reveal(view, target), "Expected retained focus reveal movement")
  try testing::assert(view.scroll_top() == 3, "Expected focused row reveal offset")
  try testing::assert(target == last, "Expected persistent focus identity")
  try testing::assert(target.layout().screen.y == 1, "Expected revealed focused geometry")

  context::internal_state(ctx).destroy()
  testing::assert(content.node().is_destroyed(), "Expected focus reveal cleanup")
}

test fn retained_nested_scroll_reveal_settles_inside_out() Void!Str {
  let ctx = context::internal_new()
  let inner_content = box::new(ctx, styles: fixed(2, 5))
  let rows = mut List::new<mut box::Box>()
  for _index in 0..5 {
    let row = box::new(ctx, styles: fixed(2, 1))
    rows.push(row)
    inner_content.add(row)
  }
  let target = rows.at(4).expect("nested reveal target")
  target.set_focusable(true)
  let inner = scroll_box::new(ctx, styles: fixed(2, 2))
  inner.add(inner_content)

  let outer_content = box::new(ctx, styles: fixed(2, 8))
  outer_content.add(box::new(ctx, styles: fixed(2, 3)))
  outer_content.add(inner)
  outer_content.add(box::new(ctx, styles: fixed(2, 3)))
  let outer = scroll_box::new(ctx, styles: fixed(2, 2))
  outer.add(outer_content)
  context::internal_state(ctx).compute_layout(outer, 2, 2)

  try testing::assert(focus::reveal(outer, target.node()), "Expected nested reveal movement")
  try testing::assert(inner.scroll_top() == 3, "Expected inner focused reveal")
  try testing::assert(outer.scroll_top() == 3, "Expected outer focused reveal")
  try testing::assert(target.layout().screen.y == 1, "Expected settled target geometry")

  context::internal_state(ctx).destroy()
  testing::assert(target.node().is_destroyed(), "Expected nested reveal cleanup")
}

test fn retained_destroy_preserves_detached_children() Void!Str {
  let ctx = context::internal_new()
  let parent = box::new(ctx)
  let child = box::new(ctx)
  parent.add(child)

  parent.destroy()

  try testing::assert(parent.node().is_destroyed(), "Expected parent destruction")
  try testing::assert(not child.node().is_destroyed(), "Expected child preservation")
  try testing::assert(not child.node().parent.is_some(), "Expected preserved child detachment")
  try testing::assert(context::internal_state(ctx).node_count() == 1, "Expected preserved child Context ownership")

  let replacement = box::new(ctx)
  replacement.add(child)
  try testing::assert(child.node().parent.is_some(), "Expected preserved child reuse")

  context::internal_state(ctx).destroy()
  try testing::assert(context::internal_state(ctx).is_destroyed(), "Expected Context to become terminal")
  testing::assert(child.node().is_destroyed(), "Expected Context-owned child cleanup")
}

test fn retained_destroy_with_recursive_option_releases_the_owned_tree() Void!Str {
  let ctx = context::internal_new()
  let parent = box::new(ctx)
  let child = box::new(ctx)
  let grandchild = box::new(ctx)
  child.add(grandchild)
  parent.add(child)

  parent.destroy(recursive: true)

  try testing::assert(parent.node().is_destroyed(), "Expected recursive parent destruction")
  try testing::assert(child.node().is_destroyed(), "Expected recursive child destruction")
  try testing::assert(grandchild.node().is_destroyed(), "Expected recursive grandchild destruction")
  try testing::assert(context::internal_state(ctx).node_count() == 0, "Expected recursive deregistration")
  context::internal_state(ctx).destroy()
  testing::assert(parent.node().is_destroyed(), "Expected idempotent Context cleanup")
}
