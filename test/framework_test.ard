private fn immediate_dispatch(action: fn()) Void!framework_event::DispatchError {
  action()
  Result::ok(())
}

private fn fixed(width: Int, height: Int) style::Style {
  style::new(width: style::cells(width), height: style::cells(height), flex_shrink: 0.0)
}

private fn shifted_wheel_down() mut framework_event::MouseEvent {
  framework_event::mouse(
    framework_event::MouseEventType::scroll,
    framework_event::MouseButton::none,
    0,
    0,
    framework_event::Modifiers{shift: true, ctrl: false, alt: false, super: false},
    scroll_y: 1,
  )
}

private fn wheel_down() mut framework_event::MouseEvent {
  framework_event::mouse(
    framework_event::MouseEventType::scroll,
    framework_event::MouseButton::none,
    0,
    0,
    framework_event::Modifiers{shift: false, ctrl: false, alt: false, super: false},
    scroll_y: 1,
  )
}

private struct EventProbe {
  node_ref: mut node::Node,
  deliveries: Int,
  focus_on_event: Bool,
  stop_event: Bool,
  destroy_on_event: (mut node::Node)?,
  reparent_on_event: (mut node::Node)?,
  reparent_destination: (mut node::Node)?,
  last_local_x: Int?,
  mounts: Int,
  mounted_dispatch: (fn(fn()) Void!framework_event::DispatchError)?,
  cancellation: Receiver<Void>?,
  add_on_first_mount: (mut node::Node)?,
}

private fn event_probe(
  ctx: mut context::Context,
  initial_style: style::Style,
  focus_on_target: Bool?,
  stop_event: Bool?,
) mut EventProbe {
  let retained = context::internal_state(ctx).create_node(initial_style)
  let probe = mut EventProbe{
    node_ref: retained,
    deliveries: 0,
    focus_on_event: focus_on_target.or(false),
    stop_event: stop_event.or(false),
    destroy_on_event: Maybe::new<mut node::Node>(),
    reparent_on_event: Maybe::new<mut node::Node>(),
    reparent_destination: Maybe::new<mut node::Node>(),
    last_local_x: Maybe::new<Int>(),
    mounts: 0,
    mounted_dispatch: Maybe::new<fn(fn()) Void!framework_event::DispatchError>(),
    cancellation: Maybe::new<Receiver<Void>>(),
    add_on_first_mount: Maybe::new<mut node::Node>(),
  }
  retained.bind(probe)
  probe
}

impl node::Renderable for EventProbe {
  fn node() mut node::Node {
    self.node_ref
  }

  fn mut mount(ctx: node::MountContext) {
    self.mounts =+ 1
    self.mounted_dispatch = Maybe::new<fn(fn()) Void!framework_event::DispatchError>(ctx.dispatch)
    self.cancellation = Maybe::new<Receiver<Void>>(ctx.cancellation)
    if self.mounts == 1 {
      match self.add_on_first_mount {
        child => self.node_ref.add(child),
        _ => (),
      }
    }
  }

  fn paint(ctx: mut paint::Context) {}

  fn mut event(ctx: mut event_delivery::Context) event_delivery::Disposition {
    self.deliveries =+ 1
    self.last_local_x = ctx.local_x
    match self.destroy_on_event {
      target => target.destroy(),
      _ => (),
    }
    match self.reparent_on_event {
      target => {
        match self.reparent_destination {
          destination => destination.add(target),
          _ => (),
        }
      },
      _ => (),
    }
    if self.stop_event {
      ctx.stop_propagation()
    }
    if self.focus_on_event {
      let _ = ctx.request_focus()
      ctx.request_redraw()
    }
    event_delivery::Disposition::handled
  }
}

impl EventProbe {
  fn mut add(child: mut node::Renderable, index: Int?) {
    self.node_ref.add(child.node(), index)
  }
}

test fn retained_tree_mirrors_explicit_children_into_yoga() Void!Str {
  mut render_requests = 0
  let ctx = context::internal_new(fn() {
    render_requests =+ 1
  })
  let root = box::new(
    ctx,
    styles: style::new(
      flex_direction: style::FlexDirection::row,
      width: style::cells(30),
      height: style::cells(10),
    ),
  )
  let fixed_child = box::new(ctx, styles: fixed(10, 10))
  let flexible_child = box::new(ctx, styles: style::new(height: style::cells(10), flex_grow: 1.0))

  root.add(fixed_child)
  root.add(flexible_child)
  context::internal_state(ctx).compute_layout(root, 30, 10)

  let fixed_layout = fixed_child.layout().local
  let flexible_layout = flexible_child.layout().local
  try testing::assert(root.child_count() == 2, "Expected two retained children")
  try testing::assert(fixed_layout.x == 0 and fixed_layout.width == 10, "Expected fixed child width")
  try testing::assert(flexible_layout.x == 10, "Expected retained sibling position")
  try testing::assert(flexible_layout.width == 20, "Expected Yoga flex growth")
  try testing::assert(render_requests > 0, "Expected retained mutations to request rendering")
  context::internal_state(ctx).destroy()
  testing::assert(root.node().is_destroyed(), "Expected Context-owned native cleanup")
}

test fn retained_remove_detaches_and_readd_preserves_identity() Void!Str {
  let ctx = context::internal_new()
  let root = box::new(ctx)
  let child = box::new(ctx, styles: fixed(4, 2))
  let child_node = child.node()

  root.add(child)
  let removed = root.remove(child)

  try testing::assert(removed, "Expected explicit child removal")
  try testing::assert(root.child_count() == 0, "Expected retained child list removal")
  try testing::assert(not child_node.parent.is_some(), "Expected parent reference to clear")

  root.add(child)

  try testing::assert(root.child_count() == 1, "Expected detached renderable to be reusable")
  try testing::assert(child.node() == child_node, "Expected concrete renderable identity to persist")
  try testing::assert(child_node.parent.is_some(), "Expected parent reference after reattachment")
  context::internal_state(ctx).destroy()
  testing::assert(child_node.is_destroyed(), "Expected Context cleanup after reattachment")
}

test fn retained_indexed_add_inserts_and_reorders_in_final_order() Void!Str {
  let ctx = context::internal_new()
  let parent = box::new(
    ctx,
    styles: style::new(
      flex_direction: style::FlexDirection::row,
      width: style::cells(3),
      height: style::cells(1),
    ),
  )
  let first = box::new(ctx, styles: fixed(1, 1))
  let second = box::new(ctx, styles: fixed(1, 1))
  let third = box::new(ctx, styles: fixed(1, 1))

  parent.add(first)
  parent.add(second)
  parent.add(third, 1)
  context::internal_state(ctx).compute_layout(parent, 3, 1)

  try testing::assert(first.layout().local.x == 0, "Expected first child to remain first")
  try testing::assert(third.layout().local.x == 1, "Expected indexed child insertion")
  try testing::assert(second.layout().local.x == 2, "Expected second child to move after insertion")

  parent.add(first, 2)
  context::internal_state(ctx).compute_layout(parent, 3, 1)

  try testing::assert(third.layout().local.x == 0, "Expected final-order reorder index")
  try testing::assert(second.layout().local.x == 1, "Expected retained sibling order")
  try testing::assert(first.layout().local.x == 2, "Expected same-parent move to the end")
  context::internal_state(ctx).destroy()
  testing::assert(first.node().is_destroyed(), "Expected indexed tree cleanup")
}

test fn retained_text_measurement_updates_without_rebuilding_identity() Void!Str {
  mut render_requests = 0
  let ctx = context::internal_new(fn() {
    render_requests =+ 1
  })
  let root = box::new(
    ctx,
    styles: style::new(
      width: style::cells(80),
      height: style::cells(10),
      align_items: style::Align::start,
    ),
  )
  let label = text::new(ctx, content: "abc")
  let original_node = label.node()
  root.add(label)

  context::internal_state(ctx).compute_layout(root, 80, 10)
  let initial = label.layout().local
  try testing::assert(initial.width == 3 and initial.height == 1, "Expected intrinsic text measurement")

  label.set_content("abcdef")
  context::internal_state(ctx).compute_layout(root, 80, 10)
  let updated = label.layout().local

  try testing::assert(updated.width == 6, "Expected dirty text remeasurement")
  try testing::assert(label.node() == original_node, "Expected text updates to retain node identity")
  try testing::assert(render_requests > 0, "Expected text mutation to request rendering")

  root.destroy()
  context::internal_state(ctx).destroy()
  testing::assert(label.node().is_destroyed(), "Expected measured node cleanup")
}

test fn retained_tree_paints_directly_into_one_clipped_buffer() Void!Str {
  let ctx = context::internal_new()
  let root_style = mut style::new(
    width: style::cells(3),
    height: style::cells(1),
    align_items: style::Align::start,
  )
  root_style.overflow = style::Overflow::hidden
  let root = box::new(ctx, styles: root_style.@)
  let label = text::new(ctx, content: "hello", styles: style::new(flex_shrink: 0.0))
  root.add(label)
  context::internal_state(ctx).compute_layout(root, 3, 1)

  let buffer = paint::new_buffer(5, 1)
  root.node().paint(buffer)

  try testing::assert(
    buffer.cell_at(0, 0).expect("first cell").grapheme == "h",
    "Expected direct text paint",
  )
  try testing::assert(
    buffer.cell_at(2, 0).expect("third cell").grapheme == "l",
    "Expected visible clipped text",
  )
  try testing::assert(
    buffer.cell_at(3, 0).expect("outside clip").grapheme == " ",
    "Expected ancestor clipping",
  )

  root.destroy()
  context::internal_state(ctx).destroy()
  testing::assert(label.node().is_destroyed(), "Expected painted child cleanup")
}

test fn retained_node_overflow_clips_its_own_paint() Void!Str {
  let ctx = context::internal_new()
  let root = box::new(
    ctx,
    styles: style::new(
      width: style::cells(5),
      height: style::cells(1),
      align_items: style::Align::start,
    ),
  )
  let label_style = mut style::new(width: style::cells(3), flex_shrink: 0.0)
  label_style.overflow = style::Overflow::hidden
  let label = text::new(ctx, content: "hello", styles: label_style.@)
  root.add(label)
  context::internal_state(ctx).compute_layout(root, 5, 1)
  let buffer = paint::new_buffer(5, 1)
  root.node().paint(buffer)

  try testing::assert(
    buffer.cell_at(2, 0).expect("inside own clip").grapheme == "l",
    "Expected own clipped content",
  )
  try testing::assert(
    buffer.cell_at(3, 0).expect("outside own clip").grapheme == " ",
    "Expected own overflow clipping",
  )
  context::internal_state(ctx).destroy()
  testing::assert(label.node().is_destroyed(), "Expected clipped text cleanup")
}

test fn retained_display_none_skips_paint() Void!Str {
  let ctx = context::internal_new()
  let hidden_style = mut style::new(width: style::cells(1), height: style::cells(1))
  hidden_style.display = style::Display::none
  let label = text::new(ctx, content: "x", styles: hidden_style.@)
  context::internal_state(ctx).compute_layout(label, 1, 1)
  let buffer = paint::new_buffer(1, 1)
  label.node().paint(buffer)

  try testing::assert(
    buffer.cell_at(0, 0).expect("hidden cell").grapheme == " ",
    "Expected display none to skip paint",
  )
  context::internal_state(ctx).destroy()
  testing::assert(label.node().is_destroyed(), "Expected hidden text cleanup")
}

test fn retained_zero_bounds_remain_bounded() Void!Str {
  let ctx = context::internal_new()
  let root = box::new(ctx)

  context::internal_state(ctx).compute_layout(root, 0, 0)
  let layout = root.layout().local

  try testing::assert(layout.width == 0 and layout.height == 0, "Expected bounded zero layout")
  context::internal_state(ctx).destroy()
  testing::assert(root.node().is_destroyed(), "Expected zero-sized tree cleanup")
}

test fn retained_text_uses_one_measurer_for_layout_and_paint() Void!Str {
  let ctx = context::internal_new(width_measurer: fn(_text: Str) Int {
    2
  })
  let root = box::new(
    ctx,
    styles: style::new(
      width: style::cells(4),
      height: style::cells(1),
      align_items: style::Align::start,
    ),
  )
  let label = text::new(ctx, content: "ab")
  root.add(label)
  context::internal_state(ctx).compute_layout(root, 4, 1)
  let buffer = paint::new_buffer(4, 1)
  root.node().paint(buffer)

  try testing::assert(label.layout().local.width == 4, "Expected per-grapheme measured layout width")
  try testing::assert(
    buffer.cell_at(0, 0).expect("first lead").width == 2,
    "Expected matching first painted width",
  )
  try testing::assert(
    buffer.cell_at(1, 0).expect("first continuation").width == 0,
    "Expected first continuation",
  )
  try testing::assert(
    buffer.cell_at(2, 0).expect("second lead").width == 2,
    "Expected matching second painted width",
  )
  try testing::assert(
    buffer.cell_at(3, 0).expect("second continuation").width == 0,
    "Expected second continuation",
  )
  try testing::assert(
    not label.node().can_have_children(),
    "Expected measured text to be a retained leaf",
  )
  context::internal_state(ctx).destroy()
  testing::assert(label.node().is_destroyed(), "Expected custom measured text cleanup")
}

test fn retained_style_replacement_clears_spacing() Void!Str {
  let ctx = context::internal_new()
  let padded = mut style::new(
    width: style::cells(10),
    height: style::cells(3),
    align_items: style::Align::start,
  )
  padded.padding = style::edges(style::cells(2))
  let root = box::new(ctx, styles: padded.@)
  let child = box::new(ctx, styles: fixed(1, 1))
  root.add(child)
  context::internal_state(ctx).compute_layout(root, 10, 3)
  try testing::assert(child.layout().local.x == 2, "Expected initial retained padding")

  root.set_style(
    style::new(width: style::cells(10), height: style::cells(3), align_items: style::Align::start),
  )
  context::internal_state(ctx).compute_layout(root, 10, 3)

  try testing::assert(child.layout().local.x == 0, "Expected undefined padding to reset to zero")
  context::internal_state(ctx).destroy()
  testing::assert(root.node().is_destroyed(), "Expected spacing test cleanup")
}

test fn retained_paint_clears_partially_clipped_wide_spans() Void!Str {
  let buffer = paint::new_buffer(3, 1)
  let bounds = geometry::Rect{
    x: 0,
    y: 0,
    width: 3,
    height: 1,
  }
  let full = mut paint::Context{
    buffer: buffer,
    bounds: bounds,
    clip: bounds,
    foreground: Maybe::new<color::Color>(),
    background: Maybe::new<color::Color>(),
  }
  full.write(0, 0, "abc")

  let narrow = geometry::Rect{
    x: 0,
    y: 0,
    width: 1,
    height: 1,
  }
  let clipped = mut paint::Context{
    buffer: buffer,
    bounds: bounds,
    clip: narrow,
    foreground: Maybe::new<color::Color>(),
    background: Maybe::new<color::Color>(),
  }
  clipped.write(0, 0, "界")

  try testing::assert(
    buffer.cell_at(0, 0).expect("visible clipped part").grapheme == " ",
    "Expected visible partial span clearing",
  )
  testing::assert(
    buffer.cell_at(1, 0).expect("outside clip").grapheme == "b",
    "Expected outside clip preservation",
  )
}

test fn retained_paint_clears_overwritten_wide_spans() Void!Str {
  let buffer = paint::new_buffer(3, 1)
  let bounds = geometry::Rect{
    x: 0,
    y: 0,
    width: 3,
    height: 1,
  }
  let ctx = mut paint::Context{
    buffer: buffer,
    bounds: bounds,
    clip: bounds,
    foreground: Maybe::new<color::Color>(),
    background: Maybe::new<color::Color>(),
  }

  ctx.write(0, 0, "界")
  ctx.write(1, 0, "x")

  try testing::assert(
    buffer.cell_at(0, 0).expect("cleared lead").grapheme == " ",
    "Expected wide lead clearing",
  )
  try testing::assert(
    buffer.cell_at(1, 0).expect("replacement").grapheme == "x",
    "Expected replacement cell",
  )
  testing::assert(
    buffer.cell_at(1, 0).expect("replacement width").width == 1,
    "Expected no orphan continuation",
  )
}

test fn retained_hit_testing_returns_direct_node_and_local_coordinates() Void!Str {
  let ctx = context::internal_new()
  let root = box::new(
    ctx,
    styles: style::new(
      flex_direction: style::FlexDirection::row,
      width: style::cells(10),
      height: style::cells(2),
      align_items: style::Align::start,
    ),
  )
  let left = box::new(ctx, styles: fixed(4, 2))
  let right = box::new(ctx, styles: fixed(4, 2))
  root.add(left)
  root.add(right)
  context::internal_state(ctx).compute_layout(root, 10, 2)

  let found = hit::test(root, 5, 1).expect("retained pointer target")

  try testing::assert(found.target == right.node(), "Expected direct retained hit identity")
  try testing::assert(found.local_x == 1 and found.local_y == 1, "Expected target-local hit coordinates")
  context::internal_state(ctx).destroy()
  testing::assert(right.node().is_destroyed(), "Expected hit tree cleanup")
}

test fn retained_hit_testing_uses_layout_viewport_for_visible_overflow() Void!Str {
  let ctx = context::internal_new()
  let root = box::new(
    ctx,
    styles: style::new(
      width: style::cells(2),
      height: style::cells(1),
      align_items: style::Align::start,
    ),
  )
  let child = box::new(ctx, styles: fixed(4, 1))
  root.add(child)
  context::internal_state(ctx).compute_layout(root, 5, 1)

  let found = hit::test(root, 3, 0).expect("visible overflow hit")

  try testing::assert(found.target == child.node(), "Expected painted overflow child hit")
  context::internal_state(ctx).destroy()
  testing::assert(child.node().is_destroyed(), "Expected overflow hit tree cleanup")
}

test fn retained_hit_testing_obeys_ancestor_clipping() Void!Str {
  let ctx = context::internal_new()
  let root = box::new(
    ctx,
    styles: style::new(
      width: style::cells(5),
      height: style::cells(1),
      align_items: style::Align::start,
    ),
  )
  let clipped_style = mut fixed(2, 1)
  clipped_style.overflow = style::Overflow::hidden
  let clipped = box::new(ctx, styles: clipped_style.@)
  let child = box::new(ctx, styles: fixed(4, 1))
  clipped.add(child)
  root.add(clipped)
  context::internal_state(ctx).compute_layout(root, 5, 1)

  try testing::assert(hit::test(root, 1, 0).is_some(), "Expected hit inside ancestor clip")
  let outside_child = hit::test(root, 3, 0).expect("clipped ancestor fallback")
  try testing::assert(outside_child.target == root.node(), "Expected clipped child to fall back to visible parent")
  context::internal_state(ctx).destroy()
  testing::assert(child.node().is_destroyed(), "Expected clipped hit tree cleanup")
}

test fn retained_hit_testing_visits_later_overlapping_children_first() Void!Str {
  let ctx = context::internal_new()
  let root = box::new(ctx, styles: fixed(2, 1))
  let overlay_style = mut fixed(2, 1)
  overlay_style.position = style::Position::absolute
  let first = box::new(ctx, styles: overlay_style.@)
  let second = box::new(ctx, styles: overlay_style.@)
  root.add(first)
  root.add(second)
  context::internal_state(ctx).compute_layout(root, 2, 1)

  let found = hit::test(root, 0, 0).expect("overlapping retained hit")

  try testing::assert(found.target == second.node(), "Expected later painted child target")
  context::internal_state(ctx).destroy()
  testing::assert(second.node().is_destroyed(), "Expected overlapping hit cleanup")
}

test fn retained_z_index_controls_stable_paint_and_hit_order() Void!Str {
  let ctx = context::internal_new()
  let root = box::new(ctx, styles: fixed(2, 1))
  let front_style = mut style::new(
    position: style::Position::absolute,
    width: style::cells(2),
    height: style::cells(1),
    background: color::rgb(200, 0, 0),
    z_index: 2,
  )
  let back_style = mut style::new(
    position: style::Position::absolute,
    width: style::cells(2),
    height: style::cells(1),
    background: color::rgb(0, 0, 200),
    z_index: 1,
  )
  let front = box::new(ctx, styles: front_style.@)
  let back = box::new(ctx, styles: back_style.@)
  root.add(front)
  root.add(back)
  context::internal_state(ctx).compute_layout(root, 2, 1)

  let initial_hit = hit::test(root, 0, 0).expect("z-index hit")
  try testing::assert(initial_hit.target == front.node(), "Expected higher z-index hit before later child")
  let initial_buffer = paint::new_buffer(2, 1)
  root.node().paint(initial_buffer)
  let initial_background = initial_buffer.cell_at(0, 0).expect("z-index paint cell").style.background.expect("front background")
  try testing::assert(initial_background.red == Uint8::from(200), "Expected higher z-index paint")

  back_style.z_index = 3
  back.set_style(back_style.@)
  let raised_hit = hit::test(root, 0, 0).expect("raised z-index hit")
  try testing::assert(raised_hit.target == back.node(), "Expected changed z-index to invalidate hit order")
  let raised_buffer = paint::new_buffer(2, 1)
  root.node().paint(raised_buffer)
  let raised_background = raised_buffer.cell_at(0, 0).expect("raised paint cell").style.background.expect("back background")
  try testing::assert(raised_background.blue == Uint8::from(200), "Expected changed z-index to invalidate paint order")

  context::internal_state(ctx).destroy()
  testing::assert(back.node().is_destroyed(), "Expected z-index tree cleanup")
}

test fn retained_focus_traverses_zero_sized_visible_overflow_ancestors() Void!Str {
  let ctx = context::internal_new()
  let root = box::new(
    ctx,
    styles: style::new(
      width: style::cells(5),
      height: style::cells(1),
      align_items: style::Align::start,
    ),
  )
  let zero_parent = box::new(ctx, styles: fixed(0, 1))
  let child = box::new(ctx, styles: fixed(2, 1))
  child.set_focusable(true)
  zero_parent.add(child)
  root.add(zero_parent)
  context::internal_state(ctx).compute_layout(root, 5, 1)

  let found = focus::targets(root)

  try testing::assert(found.size() == 1, "Expected visible overflow descendant focus")
  try testing::assert(
    found.at(0).expect("overflow focus target") == child.node(),
    "Expected descendant identity",
  )
  context::internal_state(ctx).destroy()
  testing::assert(child.node().is_destroyed(), "Expected overflow focus tree cleanup")
}

test fn retained_focus_is_explicit_and_has_no_fallback() Void!Str {
  let ctx = context::internal_new()
  let root = box::new(
    ctx,
    styles: style::new(
      flex_direction: style::FlexDirection::row,
      width: style::cells(6),
      height: style::cells(1),
    ),
  )
  let first = box::new(ctx, styles: fixed(2, 1))
  let second = box::new(ctx, styles: fixed(2, 1))
  let third = box::new(ctx, styles: fixed(2, 1))
  first.set_focusable(true)
  second.set_focusable(true)
  third.set_focusable(true)
  root.add(first)
  root.add(second)
  root.add(third)
  context::internal_state(ctx).compute_layout(root, 6, 1)

  let state = focus::new()
  state.reconcile(root)
  try testing::assert(not state.focused().is_some(), "Expected no initial focus")

  try testing::assert(state.focus(root, second.node()), "Expected explicit focus")
  try testing::assert(state.is_focused(second.node()), "Expected persistent focused identity")

  root.remove(second)
  context::internal_state(ctx).compute_layout(root, 6, 1)
  state.reconcile(root)
  try testing::assert(not state.focused().is_some(), "Expected detach to clear without fallback")
  try testing::assert(not state.focus(root, second.node()), "Expected detached focus rejection")

  context::internal_state(ctx).destroy()
  testing::assert(first.node().is_destroyed(), "Expected focus tree cleanup")
}

test fn mount_callback_can_attach_child_without_double_mounting() Void!Str {
  let ctx = context::internal_new()
  let root = event_probe(ctx, fixed(2, 1))
  let child = event_probe(ctx, fixed(2, 1))
  root.add_on_first_mount = Maybe::new<mut node::Node>(child.node())

  root.node().mount_root(immediate_dispatch)

  try testing::assert(root.mounts == 1, "Expected one root mount")
  try testing::assert(child.mounts == 1, "Expected one dynamically attached child mount")
  try testing::assert(root.node().child_count() == 1, "Expected mount-time child attachment")

  root.node().unmount_root()
  context::internal_state(ctx).destroy()
  testing::assert(child.node().is_destroyed(), "Expected mount-time child cleanup")
}

test fn retained_same_parent_reorder_preserves_attachment_scope() Void!Str {
  let ctx = context::internal_new()
  let root = event_probe(ctx, fixed(2, 1))
  let first = event_probe(ctx, fixed(1, 1))
  let second = event_probe(ctx, fixed(1, 1))
  root.add(first)
  root.add(second)
  root.node().mount_root(immediate_dispatch)

  let generation = first.node().attachment_generation()
  let cancellation = first.cancellation.expect("first attachment cancellation")
  root.add(first, 1)

  let cancelled = select {
    cancellation.recv() => true,
    _ => false,
  }
  try testing::assert(first.mounts == 1, "Expected reorder without remount")
  try testing::assert(first.node().attachment_generation() == generation, "Expected stable attachment generation")
  try testing::assert(not cancelled, "Expected reorder to preserve attachment cancellation")

  root.node().unmount_root()
  context::internal_state(ctx).destroy()
  testing::assert(first.node().is_destroyed(), "Expected reordered tree cleanup")
}

test fn retained_attachment_scopes_cancel_and_refresh_on_reattach() Void!Str {
  let ctx = context::internal_new()
  let root = event_probe(ctx, fixed(2, 1))
  let child = event_probe(ctx, fixed(2, 1))
  root.add(child)
  let queue = mut runtime::new_dispatch_queue()
  let base = fn(action: fn()) Void!framework_event::DispatchError {
    if queue.post(action) {
      Result::ok(())
    } else {
      Result::err(framework_event::DispatchError::stopped)
    }
  }

  try testing::assert(root.mounts == 0 and child.mounts == 0, "Expected detached construction")
  root.node().mount_root(base)
  try testing::assert(root.mounts == 1 and child.mounts == 1, "Expected root-first subtree mount")
  let old_dispatch = child.mounted_dispatch.expect("first attachment dispatch")
  let old_cancellation = child.cancellation.expect("first attachment cancellation")
  mut stale_called = false
  let accepted = old_dispatch(fn() {
    stale_called = true
  })

  try testing::assert(root.node().remove(child.node()), "Expected mounted child detach")
  let cancelled = select {
    old_cancellation.recv() => true,
    _ => false,
  }
  (queue.pop().expect("queued stale attachment action"))()
  try testing::assert(accepted.is_ok() and cancelled, "Expected accepted then cancelled old scope")
  try testing::assert(not stale_called, "Expected stale queued action suppression")
  try testing::assert(old_dispatch(fn() {}).is_err(), "Expected old dispatch rejection")

  root.add(child)
  try testing::assert(child.mounts == 2, "Expected fresh mount after reattach")
  let fresh_dispatch = child.mounted_dispatch.expect("fresh attachment dispatch")
  mut fresh_called = false
  try testing::assert(
    fresh_dispatch(fn() {
      fresh_called = true
    }).is_ok(),
    "Expected fresh dispatch acceptance",
  )
  (queue.pop().expect("fresh attachment action"))()
  try testing::assert(fresh_called, "Expected fresh attachment action")

  root.node().unmount_root()
  try testing::assert(fresh_dispatch(fn() {}).is_err(), "Expected root unmount cancellation")
  queue.stop()
  context::internal_state(ctx).destroy()
  testing::assert(child.node().is_destroyed(), "Expected attachment tree cleanup")
}

test fn retained_router_delivers_mouse_target_then_bubbles_by_node_reference() Void!Str {
  let ctx = context::internal_new()
  let root = event_probe(ctx, fixed(4, 1))
  let child = event_probe(ctx, fixed(4, 1), focus_on_target: true)
  child.node().set_focusable(true)
  root.add(child)
  context::internal_state(ctx).compute_layout(root, 4, 1)
  root.node().mount_root(immediate_dispatch)
  let focused = focus::new()
  let received = mut framework_event::mouse(
    framework_event::MouseEventType::down,
    framework_event::MouseButton::left,
    1,
    0,
    framework_event::Modifiers{shift: false, ctrl: false, alt: false, super: false},
  )

  let outcome = router::dispatch_mouse(root, child.node(), received, focused)

  try testing::assert(outcome.handled and outcome.redraw, "Expected retained routed handling")
  try testing::assert(focused.is_focused(child.node()), "Expected direct focus request")
  try testing::assert(child.deliveries == 1, "Expected one target delivery")
  try testing::assert(root.deliveries == 1, "Expected one ancestor bubble delivery")
  try testing::assert(child.last_local_x.or(-1) == 1, "Expected target-local routed pointer")
  root.node().unmount_root()
  context::internal_state(ctx).destroy()
  testing::assert(child.node().is_destroyed(), "Expected routed tree cleanup")
}

test fn retained_router_stops_after_target_destruction() Void!Str {
  let ctx = context::internal_new()
  let root = event_probe(ctx, fixed(2, 1))
  let child = event_probe(ctx, fixed(2, 1))
  root.add(child)
  child.destroy_on_event = Maybe::new<mut node::Node>(child.node())
  context::internal_state(ctx).compute_layout(root, 2, 1)
  root.node().mount_root(immediate_dispatch)
  let focused = focus::new()
  let received = mut framework_event::mouse(
    framework_event::MouseEventType::down,
    framework_event::MouseButton::left,
    0,
    0,
    framework_event::Modifiers{shift: false, ctrl: false, alt: false, super: false},
  )

  let outcome = router::dispatch_mouse(root, child.node(), received, focused)

  try testing::assert(outcome.handled, "Expected target handling before destruction")
  try testing::assert(child.node().is_destroyed(), "Expected event-time target destruction")
  try testing::assert(child.deliveries == 1, "Expected target delivery")
  try testing::assert(root.deliveries == 0, "Expected ancestor suppression after mutation")
  root.node().unmount_root()
  context::internal_state(ctx).destroy()
  testing::assert(root.node().is_destroyed(), "Expected mutation route cleanup")
}

test fn retained_router_stops_when_bubble_reparents_target_attachment() Void!Str {
  let ctx = context::internal_new()
  let root = event_probe(ctx, fixed(4, 1))
  let former_parent = event_probe(ctx, fixed(2, 1))
  let new_parent = event_probe(ctx, fixed(2, 1))
  let child = event_probe(ctx, fixed(2, 1))
  former_parent.add(child)
  root.add(former_parent)
  root.add(new_parent)
  former_parent.reparent_on_event = Maybe::new<mut node::Node>(child.node())
  former_parent.reparent_destination = Maybe::new<mut node::Node>(new_parent.node())
  context::internal_state(ctx).compute_layout(root, 4, 1)
  root.node().mount_root(immediate_dispatch)
  let focused = focus::new()
  let received = mut framework_event::mouse(
    framework_event::MouseEventType::down,
    framework_event::MouseButton::left,
    0,
    0,
    framework_event::Modifiers{shift: false, ctrl: false, alt: false, super: false},
  )

  let outcome = router::dispatch_mouse(root, child.node(), received, focused)

  try testing::assert(outcome.handled, "Expected handling before reparent")
  try testing::assert(child.deliveries == 1, "Expected target delivery before reparent")
  try testing::assert(former_parent.deliveries == 1, "Expected former-parent bubble")
  try testing::assert(root.deliveries == 0, "Expected route invalidation before Root")
  try testing::assert(new_parent.deliveries == 0, "Expected no delivery on new route")
  try testing::assert(child.mounts == 2, "Expected a fresh target attachment")

  root.node().unmount_root()
  context::internal_state(ctx).destroy()
  testing::assert(child.node().is_destroyed(), "Expected reparented route cleanup")
}

