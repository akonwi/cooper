use ard/testing

use cooper/focus
use cooper/hit
use cooper/surface

private fn assert_path(actual: [Int], expected: [Int], message: Str) Void!Str {
  testing::assert(focus::paths_equal(actual, expected), message)
}

test fn hit_test_returns_nested_route_focus_and_local_geometry() Void!Str {
  let field = mut surface::blank(4, 1)
  field.accept_focus()
  let section = mut surface::blank(6, 2)
  section.add_widget_child(3, 1, 1, field.@)
  let root = mut surface::blank(10, 4)
  root.add_widget_child(2, 2, 1, section.@)

  let found = hit::hit_test(root.@, surface::Point{x: 4, y: 2}).expect("nested field hit")

  try assert_path(found.route, [2, 3], "Expected the deepest routed occurrence")
  try assert_path(found.focus_path.expect("focus path"), [2, 3], "Expected the field focus route")
  try testing::assert(found.local.x == 1 and found.local.y == 0, "Expected field-local coordinates")
  try testing::assert(found.size.width == 4 and found.size.height == 1, "Expected routed field size")
  try testing::assert(found.route_sizes.size() == 3, "Expected root and routed owner sizes")
  try testing::assert(found.route_sizes.at(0).expect("root size").width == 10, "Expected root geometry")
  try testing::assert(
    found.route_sizes.at(1).expect("section size").width == 6,
    "Expected section geometry",
  )
  testing::assert(
    found.route_sizes.at(2).expect("field size").width == 4,
    "Expected field geometry",
  )
}

test fn hit_test_visits_later_painted_children_first() Void!Str {
  let lower = mut surface::blank(3, 1)
  lower.accept_focus()
  let upper = mut surface::blank(3, 1)
  upper.accept_focus()
  let root = mut surface::blank(3, 1)
  root.add_widget_child(0, 0, 0, lower.@)
  root.add_widget_child(1, 0, 0, upper.@)

  let found = hit::hit_test(root.@, surface::Point{x: 1, y: 0}).expect("overlapping hit")

  try assert_path(found.route, [1], "Expected the topmost routed child")
  assert_path(found.focus_path.expect("top focus"), [1], "Expected the topmost focus target")
}

test fn hit_test_clips_descendants_to_every_ancestor() Void!Str {
  let overflowing = mut surface::blank(4, 1)
  overflowing.accept_focus()
  let clipped_parent = mut surface::blank(2, 1)
  clipped_parent.add_widget_child(0, 0, 0, overflowing.@)
  let root = mut surface::blank(5, 1)
  root.add_widget_child(1, 1, 0, clipped_parent.@)

  let visible = hit::hit_test(root.@, surface::Point{x: 2, y: 0}).expect("visible descendant")
  try assert_path(visible.route, [1, 0], "Expected the visible routed descendant")

  let clipped = hit::hit_test(root.@, surface::Point{x: 4, y: 0}).expect("root fallback hit")
  try assert_path(clipped.route, [], "Expected overflow outside the parent to miss its descendant")
  testing::assert(not clipped.focus_path.is_some(), "Expected clipped overflow not to focus")
}

test fn decorative_surfaces_preserve_widget_route_and_focus_owner() Void!Str {
  let decoration = mut surface::blank(2, 1)
  let field = mut surface::blank(4, 1)
  field.accept_focus()
  field.add_child(1, 0, decoration.@)
  let root = mut surface::blank(4, 1)
  root.add_widget_child(5, 0, 0, field.@)

  let found = hit::hit_test(root.@, surface::Point{x: 2, y: 0}).expect("decorative hit")

  try assert_path(found.route, [5], "Expected decoration to retain its widget route")
  try assert_path(found.focus_path.expect("decorative focus"), [5], "Expected nearest focusable owner")
  testing::assert(found.local.x == 2, "Expected coordinates relative to the routed owner")
}

test fn hit_test_rejects_points_outside_the_root() Void!Str {
  let root = surface::blank(2, 1)
  let negative = surface::Point{x: -1, y: 0}
  let beyond = surface::Point{x: 2, y: 0}

  try testing::assert(not hit::hit_test(root, negative).is_some(), "Expected a negative point to miss")
  testing::assert(
    not hit::hit_test(root, beyond).is_some(),
    "Expected a point beyond the root to miss",
  )
}
