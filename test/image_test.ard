use ard/testing

use cooper/core/graphics
use cooper/core/paint
use cooper/testing as headless
use cooper/ui
use go:encoding/base64

private fn grid() ui::ImageData {
  let pixels = mut List::new<ui::Color>()
  mut y = 0
  while y < 8 {
    mut x = 0
    while x < 6 {
      pixels.push(ui::rgb(x * 30, y * 20, 11))
      x =+ 1
    }
    y =+ 1
  }
  ui::image_data(6, 8, pixels.@)
}

private fn assert_rgb(value: ui::Color?, red: Int, green: Int, blue: Int) Void!Str {
  let actual = value.expect("painted RGB color")
  testing::assert(
    actual.red == Uint8::from(red) and actual.green == Uint8::from(green) and actual.blue == Uint8::from(blue),
    "Expected exact sampled RGB channels",
  )
}

test fn image_pairs_rows_and_clips_without_rescaling_the_visible_fragment() Void!Str {
  let app = headless::new(4, 2)
  defer app.destroy()
  let viewport = ui::scroll_box(
    app.context,
    styles: ui::style(width: ui::cells(4), height: ui::cells(2)),
    scrollbar_options: ui::scrollbar_options(visibility: ui::ScrollbarVisibility::hidden),
  )
  let image = ui::image(
    app.context,
    grid(),
    styles: ui::style(width: ui::cells(6), height: ui::cells(4), flex_shrink: 0.0),
  )
  viewport.add(image)
  app.root.add(viewport)
  app.render()
  try testing::assert(
    app.frame().cell(0, 0).expect("image").grapheme == "▀",
    "Expected half-block glyph",
  )
  try assert_rgb(app.frame().cell(0, 0).expect("top").style.foreground, 0, 0, 11)
  try assert_rgb(app.frame().cell(0, 0).expect("bottom").style.background, 0, 20, 11)
  try testing::assert(viewport.scroll_to_position(ui::Point{x: 1, y: 1}), "Expected two-axis movement")
  app.render()
  try assert_rgb(app.frame().cell(0, 0).expect("clipped top").style.foreground, 30, 40, 11)
  try assert_rgb(app.frame().cell(3, 1).expect("clipped bottom").style.background, 120, 100, 11)
  testing::assert(
    image.layout().screen.x == -1 and image.layout().screen.y == -1,
    "Expected translated image geometry",
  )
}

test fn image_contains_centers_and_respects_border_padding_and_resize() Void!Str {
  let app = headless::new(12, 10)
  defer app.destroy()
  let image = ui::image(
    app.context,
    grid(),
    styles: ui::style(
      width: ui::cells(12),
      height: ui::cells(8),
      border: ui::Border::single,
      padding: ui::edges(ui::cells(1)),
    ),
  )
  app.root.add(image)
  app.render()
  // Content is 8x4 cells. The 6x8 pixel source occupies centered 6x4 cells.
  try testing::assert(app.frame().cell(0, 0).expect("border").grapheme == "┌", "Expected image border")
  try testing::assert(
    app.frame().cell(2, 2).expect("letterbox").grapheme == " ",
    "Expected horizontal letterbox",
  )
  try assert_rgb(app.frame().cell(3, 2).expect("first pixel").style.foreground, 0, 0, 11)
  try assert_rgb(app.frame().cell(8, 5).expect("last pixel").style.background, 150, 140, 11)
  // Width now constrains the image. Sampling must use the entire source.
  image.set_style(ui::style(width: ui::cells(3), height: ui::cells(6)))
  app.render()
  try testing::assert(
    app.frame().cell(0, 1).expect("top letterbox").grapheme == " ",
    "Expected vertical centering",
  )
  try assert_rgb(app.frame().cell(2, 2).expect("scaled top").style.foreground, 120, 0, 11)
  try assert_rgb(app.frame().cell(2, 3).expect("scaled bottom").style.background, 120, 120, 11)
  image.set_style(ui::style(width: ui::cells(0), height: ui::cells(0)))
  app.render()
  testing::assert(
    not app.frame().text().contains("▀"),
    "Expected zero-size image to paint nothing",
  )
}

test fn image_popup_occludes_then_restores_without_replacing_the_image_node() Void!Str {
  let app = headless::new(6, 4)
  defer app.destroy()
  let image = ui::image(
    app.context,
    grid(),
    styles: ui::style(width: ui::cells(6), height: ui::cells(4)),
  )
  app.root.add(image)
  let popup = ui::text(
    app.context,
    content: "OK",
    styles: ui::style(
      position: ui::Position::absolute,
      left: ui::cells(1),
      top: ui::cells(1),
      width: ui::cells(2),
      height: ui::cells(1),
      z_index: 2,
      background: ui::rgb(7, 8, 9),
    ),
  )
  app.root.add(popup)
  app.render()
  try testing::assert(
    app.frame().cell(1, 1).expect("popup").grapheme == "O",
    "Expected later popup above image",
  )
  try assert_rgb(app.frame().cell(2, 1).expect("popup background").style.background, 7, 8, 9)
  try assert_rgb(app.frame().cell(3, 1).expect("exposed image").style.foreground, 90, 40, 11)
  popup.destroy()
  app.render()
  try testing::assert(
    app.frame().cell(1, 1).expect("restored").grapheme == "▀",
    "Expected image revealed on popup destruction",
  )
  assert_rgb(app.frame().cell(1, 1).expect("restored pixel").style.foreground, 30, 40, 11)
}

test fn image_replacement_survives_suspend_resize_detach_and_idempotent_destroy() Void!Str {
  let app = headless::new(6, 4)
  defer app.destroy()
  let image = ui::image(
    app.context,
    grid(),
    styles: ui::style(width: ui::percent(100.0), height: ui::percent(100.0)),
  )
  app.root.add(image)
  app.render()
  try testing::assert(app.suspend(), "Expected suspension")
  image.set_source(ui::image_data(1, 1, [ui::rgb(17, 29, 211)]))
  try testing::assert(app.resume(), "Expected resume")
  app.resize(4, 2)
  try assert_rgb(app.frame().cell(0, 0).expect("resumed image").style.foreground, 17, 29, 211)
  try testing::assert(app.root.remove(image), "Expected detach")
  app.render()
  try testing::assert(not app.frame().text().contains("▀"), "Expected detached image to disappear")
  app.root.add(image)
  app.render()
  try assert_rgb(app.frame().cell(3, 1).expect("reattached").style.background, 17, 29, 211)
  image.destroy()
  image.destroy()
  app.render()
  testing::assert(
    not image.source.is_some() and not app.frame().text().contains("▀"),
    "Expected cleanup to release node's source and clear cells",
  )
}

private fn encoded(value: Str) [Byte] {
  base64::StdEncoding.DecodeString(value).expect("valid fixture base64")
}

test fn native_image_regions_preserve_paint_order_and_exclude_popup_cells() Void!Str {
  let app = headless::new(6, 4)
  defer app.destroy()
  let behind = ui::text(
    app.context,
    content: "BEHIND",
    styles: ui::style(position: ui::Position::absolute, width: ui::cells(6), height: ui::cells(1)),
  )
  app.root.add(behind)
  let image = ui::image(
    app.context,
    grid(),
    styles: ui::style(width: ui::cells(6), height: ui::cells(4)),
  )
  app.root.add(image)
  let popup = ui::box(
    app.context,
    styles: ui::style(
      position: ui::Position::absolute,
      left: ui::cells(1),
      top: ui::cells(1),
      width: ui::cells(2),
      height: ui::cells(2),
      background: ui::rgb(1, 2, 3),
    ),
  )
  app.root.add(popup)
  app.render()
  let buffer = paint::new_buffer(6, 4)
  buffer.enable_images(10, 20)
  app.root.node_ref.paint(buffer)
  try testing::assert(buffer.images.size() == 1, "Expected native request instead of block glyphs")
  let request = buffer.images.at(0).expect("native image")
  let regions = graphics::regions(buffer, request)
  try testing::assert(regions.size() == 4, "Expected four merged rectangles around popup")
  mut area = 0
  for region in regions {
    area = area + region.width * region.height
  }
  try testing::assert(area == 20, "Expected exactly 24 - 4 image cells")
  mut y = 0
  while y < 4 {
    mut x = 0
    while x < 6 {
      mut count = 0
      for region in regions {
        if ui::contains(region, x, y) {
          count =+ 1
        }
      }
      let covered = x >= 1 and x < 3 and y >= 1 and y < 3
      try testing::assert(
        covered and count == 0 or not covered and count == 1,
        "Expected exact nonoverlapping popup exclusion, including earlier text",
      )
      x =+ 1
    }
    y =+ 1
  }
  popup.destroy()
  buffer.clear()
  app.root.node_ref.paint(buffer)
  testing::assert(
    graphics::regions(buffer, buffer.images.at(0).expect("revealed image")).size() == 1,
    "Expected popup removal to restore one complete placement",
  )
}

test fn native_image_uses_physical_cell_geometry_and_preserves_alpha() Void!Str {
  let source = try ui::decode_image(
    encoded(
      "iVBORw0KGgoAAAANSUhEUgAAAAMAAAABCAYAAAAb4BS0AAAAFUlEQVR4nGM4kWLUwC578n+y4gkGACJgBRdCOIO1AAAAAElFTkSuQmCC",
    ),
  )
  let app = headless::new(9, 6)
  defer app.destroy()
  let image = ui::image(
    app.context,
    source,
    styles: ui::style(width: ui::cells(9), height: ui::cells(6)),
  )
  app.root.add(image)
  app.render()
  let buffer = paint::new_buffer(9, 6)
  buffer.enable_images(10, 10)
  app.root.node_ref.paint(buffer)
  let request = buffer.images.at(0).expect("native alpha image")
  try testing::assert(
    request.destination.width == 9 and request.destination.height == 3 and request.destination.y == 1,
    "Expected square terminal cells, not hard-coded 1:2",
  )
  try testing::assert(
    request.rgba.at(0).expect("red") == Byte::from(200) and request.rgba.at(3).expect("alpha") == Byte::from(128) and request.rgba.at(11).expect("transparent") == Byte::from(0),
    "Expected original straight alpha, not matte flattening",
  )
  image.set_source(ui::image_data(1, 1, [ui::rgb(12, 13, 14)]))
  buffer.clear()
  app.root.node_ref.paint(buffer)
  testing::assert(
    buffer.images.at(0).expect("replacement").revision != request.revision,
    "Expected replacement to invalidate the upload cache key",
  )
}

test fn native_image_crop_uses_original_destination_after_two_axis_scroll() Void!Str {
  let image = paint::ImagePlacement{
    id: 1,
    revision: 1,
    order: 1,
    width: 300,
    height: 120,
    rgba: [],
    destination: ui::Rect{
      x: -2,
      y: -1,
      width: 10,
      height: 4,
    },
    clip: ui::Rect{
      x: 0,
      y: 0,
      width: 8,
      height: 3,
    },
  }
  let source = graphics::source_rect(image, image.clip)
  try testing::assert(
    source.x == 60 and source.y == 30 and source.width == 240 and source.height == 90,
    "Expected scroll offsets mapped to original pixels",
  )
  let tiny = mut image
  tiny.width = 1
  tiny.height = 1
  let pixel = graphics::source_rect(
    tiny.@,
    ui::Rect{
      x: 2,
      y: 1,
      width: 1,
      height: 1,
    },
  )
  testing::assert(
    pixel.x == 0 and pixel.y == 0 and pixel.width == 1 and pixel.height == 1,
    "Expected nonzero source crop for upscaled single pixel",
  )
}

test fn image_data_snapshots_pixels_and_thin_images_remain_visible() Void!Str {
  let pixels = mut List::new<ui::Color>()
  pixels.push(ui::rgb(10, 20, 30))
  pixels.push(ui::rgb(40, 50, 60))
  pixels.push(ui::rgb(70, 80, 90))
  let source = ui::image_data(1, 3, pixels.@)
  pixels.set(0, ui::rgb(255, 0, 0))
  let app = headless::new(1, 1)
  defer app.destroy()
  let image = ui::image(
    app.context,
    source,
    styles: ui::style(width: ui::cells(1), height: ui::cells(1)),
  )
  app.root.add(image)
  app.render()
  try assert_rgb(app.frame().cell(0, 0).expect("thin top").style.foreground, 10, 20, 30)
  try assert_rgb(app.frame().cell(0, 0).expect("thin bottom").style.background, 40, 50, 60)
  // A wide, one-pixel-high source exercises the other sub-cell fit boundary.
  image.set_source(ui::image_data(3, 1, pixels.@))
  pixels.set(0, ui::rgb(0, 0, 255))
  app.render()
  assert_rgb(app.frame().cell(0, 0).expect("wide image").style.background, 255, 0, 0)
}

test fn image_decodes_webp_lossless_alpha_lossy_and_rejects_invalid_sizes() Void!Str {
  // ImageMagick lossless 2x1 fixture: (200,40,80,128), (17,99,231,255).
  let source = try ui::decode_image(
    encoded("UklGRiIAAABXRUJQVlA4TBYAAAAvAQAAEA/wseJH3D7t/IH/wYOM6H8A"),
    matte: ui::rgb(20, 60, 100),
  )
  try testing::assert(source.width == 2 and source.height == 1, "Expected WebP dimensions")
  try testing::assert(source.rgba.size() == 8, "Expected two RGBA pixels")
  for channel, index in [200, 40, 80, 128, 17, 99, 231, 255] {
    try testing::assert(
      source.rgba.at(index).expect("WebP channel").to_int() == channel,
      "Expected original WebP colors and alpha for native rendering",
    )
  }
  try assert_rgb(source.pixels.at(0), 110, 50, 90)
  try assert_rgb(source.pixels.at(1), 17, 99, 231)
  // Independently encoded lossy 3x2 solid (60,110,170), quality 90.
  let lossy = try ui::decode_image(
    encoded(
      "UklGRjwAAABXRUJQVlA4IDAAAAAwAgCdASoDAAIAAMASJaACdLoB+AH4AAYeAAD+8U2v/bQzqhL/bj/+pwYOfPx/gAA=",
    ),
  )
  try testing::assert(lossy.width == 3 and lossy.height == 2, "Expected lossy WebP dimensions")
  let pixel = lossy.pixels.at(5).expect("last WebP pixel")
  // Allow lossy encoding and YCbCr-to-RGB conversion differences between decoders.
  try testing::assert(
    pixel.red >= Uint8::from(50) and pixel.red <= Uint8::from(70) and pixel.green >= Uint8::from(100) and pixel.green <= Uint8::from(120) and pixel.blue >= Uint8::from(160) and pixel.blue <= Uint8::from(180),
    "Expected lossy WebP colors, got {pixel.red}, {pixel.green}, {pixel.blue}",
  )
  try testing::assert(
    ui::decode_image(encoded("UklGRiIAAABXRUJQVlA4TBYAAAAvAQAAEA==")).is_err(),
    "Expected truncated WebP failure",
  )
  match ui::decode_image(encoded("UklGRiIAAABXRUJQVlA4TBUAAAAvABAAAAcQ/Y/+B4CE8P+9FtH/9A8A")) {
    err(message) => {
      testing::assert(
        message == "image dimensions must be between 1 and 4096 pixels",
        "Expected oversized WebP rejected before pixel decode",
      )
    },
    ok(_) => testing::assert(false, "Expected oversized WebP failure"),
  }
}

test fn image_decodes_png_alpha_jpeg_and_rejects_bad_or_oversized_input() Void!Str {
  // Independent 3x1 PNG: (200,100,50,128), (7,29,201,255), (99,33,200,0).
  let png = encoded(
    "iVBORw0KGgoAAAANSUhEUgAAAAMAAAABCAYAAAAb4BS0AAAAFUlEQVR4nGM4kWLUwC578n+y4gkGACJgBRdCOIO1AAAAAElFTkSuQmCC",
  )
  let decoded = try ui::decode_image(png, matte: ui::rgb(20, 40, 60))
  try testing::assert(decoded.width == 3 and decoded.height == 1, "Expected PNG dimensions")
  try assert_rgb(decoded.pixels.at(0), 110, 70, 55)
  try assert_rgb(decoded.pixels.at(1), 7, 29, 201)
  try assert_rgb(decoded.pixels.at(2), 20, 40, 60)
  let black = try ui::decode_image(png)
  try assert_rgb(black.pixels.at(2), 0, 0, 0)
  let jpeg = encoded(
    "",
  )
  let photo = try ui::decode_image(jpeg)
  try testing::assert(photo.width == 3 and photo.height == 2, "Expected JPEG dimensions")
  // JPEG is lossy, even at quality 100; independently specified channel ranges.
  let pixel = photo.pixels.at(5).expect("last JPEG pixel")
  try testing::assert(
    pixel.red >= Uint8::from(58) and pixel.red <= Uint8::from(62) and pixel.green >= Uint8::from(108) and pixel.green <= Uint8::from(112) and pixel.blue >= Uint8::from(168) and pixel.blue <= Uint8::from(172),
    "Expected decoded JPEG colors",
  )
  try testing::assert(
    ui::decode_image("not an image".bytes()).is_err(),
    "Expected unsupported data failure",
  )
  try testing::assert(
    ui::decode_image(
      encoded("iVBORw0KGgoAAAANSUhEUgAAAAMAAAABCAYAAAAb4BS0AAAABklEQVRicm9rZW5jnxQX"),
    ).is_err(),
    "Expected truncated PNG failure",
  )
  match ui::decode_image(encoded("iVBORw0KGgoAAAANSUhEUgAAEAEAAAABCAIAAAA+gZcV")) {
    err(message) => {
      testing::assert(
        message == "image dimensions must be between 1 and 4096 pixels",
        "Expected dimensions rejected before full decode",
      )
    },
    ok(_) => testing::assert(false, "Expected oversized image failure"),
  }
}
