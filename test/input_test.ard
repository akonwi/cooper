test fn input_cli_word_navigation_and_deletion_are_grapheme_safe() Void!Str {
  let application = cooper_testing::new(24, 1)
  let field = input::new(application.context, value: "hello brave world", styles: fixed(24))
  application.root.add(field)
  application.render()
  field.focus()
  mut inputs = 0
  let _ = field.on_input(fn(value: Str) {
    inputs =+ 1
  })

  application.key(modified_key("w", ctrl: true))
  try testing::assert(field.value() == "hello brave ", "Expected Ctrl-W previous-word deletion")
  try testing::assert(inputs == 1, "Expected one callback for word deletion")

  application.key(modified_key("b", alt: true))
  application.key(key("x", text: "界"))
  try testing::assert(field.value() == "hello 界brave ", "Expected Alt-B word navigation")

  application.key(modified_key("u", ctrl: true))
  try testing::assert(field.value() == "brave ", "Expected Ctrl-U delete to start")
  application.key(modified_key("k", ctrl: true))
  try testing::assert(field.value() == "", "Expected Ctrl-K delete to end")

  application.destroy()
  testing::assert(field.node_ref.is_destroyed(), "Expected CLI word editing cleanup")
}

test fn input_cli_word_selection_and_select_all_replace_atomically() Void!Str {
  let application = cooper_testing::new(16, 1)
  let field = input::new(application.context, value: "one two", styles: fixed(16))
  application.root.add(field)
  application.render()
  field.focus()

  application.key(modified_key("left", shift: true, alt: true))
  try testing::assert(field.selected_text() == "two", "Expected Shift-Alt-Left word selection")
  application.key(key("x", text: "X"))
  try testing::assert(field.value() == "one X", "Expected selected word replacement")

  application.key(modified_key("a", super: true))
  try testing::assert(field.selected_text() == "one X", "Expected Super-A select all")
  application.key(key("y", text: "Y"))
  try testing::assert(field.value() == "Y", "Expected select-all replacement")
  try testing::assert(application.selection().is_none(), "Expected replacement to clear global selection")

  application.destroy()
  testing::assert(field.node_ref.is_destroyed(), "Expected CLI selection cleanup")
}

test fn input_cli_home_end_and_character_aliases_follow_readline() Void!Str {
  let application = cooper_testing::new(12, 1)
  let field = input::new(application.context, value: "abc", styles: fixed(12))
  application.root.add(field)
  application.render()
  field.focus()

  application.key(modified_key("a", ctrl: true))
  application.key(key("x", text: "X"))
  try testing::assert(field.value() == "Xabc", "Expected Ctrl-A line start")
  application.key(modified_key("e", ctrl: true))
  application.key(modified_key("b", ctrl: true))
  application.key(key("y", text: "Y"))

  try testing::assert(field.value() == "XabYc", "Expected Ctrl-E and Ctrl-B cursor aliases")

  application.key(modified_key("left", super: true))
  application.key(key("start", text: ">"))
  application.key(modified_key("right", super: true))
  application.key(key("less_than", text: "<"))
  try testing::assert(field.value() == ">XabYc<", "Expected Super arrow start and end aliases")
  application.key(modified_key("left", shift: true, super: true))
  try testing::assert(field.selected_text() == ">XabYc<", "Expected Shift-Super-Left selection")
  application.destroy()
  testing::assert(field.node_ref.is_destroyed(), "Expected readline alias cleanup")
}

test fn input_cli_bindings_handle_repeat_release_and_modified_text() Void!Str {
  let ctx = context::internal_new()
  let field = input::new(ctx, value: "one two three", styles: fixed(16))

  let repeated = send_key(
    field,
    modified_key("w", ctrl: true, event_type: event::KeyEventType::repeat),
  )
  try testing::assert(
    repeated == event_delivery::Disposition::handled,
    "Expected repeated binding handled",
  )
  try testing::assert(field.value() == "one two ", "Expected repeat to execute word deletion")

  let released = send_key(
    field,
    modified_key("w", ctrl: true, event_type: event::KeyEventType::release),
  )
  try testing::assert(released == event_delivery::Disposition::ignored, "Expected release ignored")
  try testing::assert(field.value() == "one two ", "Expected release not to edit")

  let unsupported = send_key(field, modified_key("q", text: "q", ctrl: true, alt: true))
  try testing::assert(
    unsupported == event_delivery::Disposition::ignored,
    "Expected unsupported modified text ignored",
  )
  testing::assert(field.value() == "one two ", "Expected control chord not inserted as text")
}

test fn deferred_input_history_chords_are_consumed_without_editing() Void!Str {
  let ctx = context::internal_new()
  let field = input::new(ctx, value: "value", styles: fixed(8))

  let undone = send_key(field, modified_key("z", super: true))
  let redone = send_key(field, modified_key("z", shift: true, super: true))
  let cli_undo = send_key(field, modified_key("-", ctrl: true))
  let cli_redo = send_key(field, modified_key(".", ctrl: true))

  try testing::assert(
    undone == event_delivery::Disposition::handled,
    "Expected deferred undo chord handled",
  )
  try testing::assert(
    redone == event_delivery::Disposition::handled,
    "Expected deferred redo chord handled",
  )
  try testing::assert(
    cli_undo == event_delivery::Disposition::handled,
    "Expected Ctrl-minus undo chord handled",
  )
  try testing::assert(
    cli_redo == event_delivery::Disposition::handled,
    "Expected Ctrl-period redo chord handled",
  )
  testing::assert(field.value() == "value", "Expected deferred history no-op")
}
