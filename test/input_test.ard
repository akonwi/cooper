use ard/testing

use cooper/context
use cooper/event
use cooper/input
use cooper/paint
use cooper/style
use go:go.rockorager.dev/vaxis as raw

private fn fixed(width: Int) style::Style {
  style::new(width: style::cells(width), height: style::cells(1), shrink: 0.0)
}

private fn send(field: mut input::Input, received: raw::Event, local_x: Int?) event::EventResult {
  let state = event::new_state()
  let ctx = event::context(
    event::EventPhase::target,
    received,
    local_x,
    Maybe::new<Int>(0),
    true,
    state,
  )
  field.event(ctx)
}

test fn input_inserts_moves_and_deletes_graphemes() Void!Str {
  let ctx = context::new()
  let field = input::new(ctx, value: "ac", initial_style: fixed(10))

  let _ = send(field, raw::Key{Keycode: raw::KeyLeft})
  let _ = send(field, raw::Key{Text: "b"})
  try testing::assert(field.value() == "abc", "Expected insertion at retained cursor")
  try testing::assert(field.cursor_index() == 2, "Expected cursor after insertion")

  field.set_value("a🙂")
  let _ = send(field, raw::Key{Keycode: Int32::from(raw::KeyBackspace)})
  try testing::assert(field.value() == "a", "Expected one grapheme backspace")
  testing::assert(field.cursor_index() == 1, "Expected grapheme cursor movement")
}

test fn input_normalizes_combining_and_merged_grapheme_boundaries() Void!Str {
  let ctx = context::new()
  let field = input::new(ctx, initial_style: fixed(10))

  let _ = send(field, raw::Key{Text: "e"})
  let _ = send(field, raw::Key{Text: "́"})
  try testing::assert(field.value() == "é", "Expected combining input")
  let _ = send(field, raw::Key{Keycode: Int32::from(raw::KeyBackspace)})
  try testing::assert(field.value().is_empty(), "Expected combined grapheme removal")

  field.set_value("🇦x🇧")
  let _ = send(field, raw::Key{Keycode: raw::KeyLeft})
  let _ = send(field, raw::Key{Keycode: Int32::from(raw::KeyBackspace)})
  try testing::assert(field.value() == "🇦🇧", "Expected regional-indicator merge")
  try testing::assert(field.cursor_index() == field.value().size(), "Expected normalized cursor")
  let _ = send(field, raw::Key{Keycode: Int32::from(raw::KeyBackspace)})
  testing::assert(field.value().is_empty(), "Expected merged flag removal")
}

test fn input_paints_and_scrolls_cursor_into_narrow_viewport() Void!Str {
  let ctx = context::new()
  let field = input::new(ctx, value: "hello", initial_style: fixed(5))
  ctx.compute_layout(field, 5, 1)
  field.node().set_focused(true)
  let buffer = paint::new_buffer(5, 1)
  field.node().paint(buffer)

  try testing::assert(
    buffer.cell_at(0, 0).expect("first visible cell").grapheme == "e",
    "Expected horizontal input scroll",
  )
  try testing::assert(
    buffer.cell_at(3, 0).expect("last visible text").grapheme == "o",
    "Expected visible value suffix",
  )
  testing::assert(buffer.cursor.expect("input cursor").x == 4, "Expected visible trailing cursor")
}

test fn input_does_not_paint_partial_wide_grapheme() Void!Str {
  let ctx = context::new()
  let field = input::new(ctx, value: "🙂a", initial_style: fixed(1))
  let _ = send(field, raw::Key{Keycode: raw::KeyHome})
  ctx.compute_layout(field, 1, 1)
  let buffer = paint::new_buffer(1, 1)
  field.node().paint(buffer)

  testing::assert(
    buffer.cell_at(0, 0).expect("only cell").grapheme == " ",
    "Expected wide grapheme clipping",
  )
}

test fn input_uses_context_terminal_width_measurement() Void!Str {
  let ctx = context::new(width_measurer: fn(text: Str) Int {
    if text == "🙂" {
      4
    } else {
      1
    }
  })
  let field = input::new(ctx, value: "🙂", initial_style: fixed(3))
  let _ = send(field, raw::Key{Keycode: raw::KeyHome})
  ctx.compute_layout(field, 3, 1)
  let buffer = paint::new_buffer(3, 1)
  field.node().paint(buffer)

  testing::assert(
    buffer.cell_at(0, 0).expect("first cell").grapheme == " ",
    "Expected terminal-aware clipping",
  )
}

test fn input_inserts_pasted_ctrl_c_as_text() Void!Str {
  let ctx = context::new()
  let field = input::new(ctx, initial_style: fixed(5))

  let result = send(
    field,
    raw::Key{
      Text: "c",
      Keycode: Int32::from('c'),
      Modifiers: raw::ModCtrl,
      EventType: raw::EventPaste,
    },
  )

  try testing::assert(result == event::EventResult::handled, "Expected paste handling")
  testing::assert(field.value() == "c", "Expected pasted Ctrl+C text")
}

test fn input_mouse_uses_target_local_coordinates_and_visible_start() Void!Str {
  let ctx = context::new()
  let field = input::new(ctx, value: "hello", initial_style: fixed(5))
  ctx.compute_layout(field, 5, 1)
  let mouse = raw::Mouse{Button: raw::MouseLeftButton, EventType: raw::EventPress}

  let _ = send(field, mouse, local_x: 0)
  try testing::assert(field.cursor_index() == 1, "Expected click at scrolled viewport start")
  let _ = send(field, raw::Key{Text: "X"})
  testing::assert(field.value() == "hXello", "Expected typing at clicked cursor")
}

test fn input_mouse_preserves_wide_grapheme_boundaries() Void!Str {
  let ctx = context::new()
  let field = input::new(ctx, value: "🙂a", initial_style: fixed(4))
  ctx.compute_layout(field, 4, 1)
  let mouse = raw::Mouse{Button: raw::MouseLeftButton, EventType: raw::EventPress}

  let _ = send(field, mouse, local_x: 1)

  testing::assert(field.cursor_index() == "🙂".size(), "Expected trailing wide boundary")
}

test fn unfocused_input_is_focusable_without_hardware_cursor() Void!Str {
  let ctx = context::new()
  let field = input::new(ctx, value: "hello", initial_style: fixed(10))
  ctx.compute_layout(field, 10, 1)
  let buffer = paint::new_buffer(10, 1)
  field.node().paint(buffer)

  try testing::assert(field.node().is_focusable(), "Expected Input focus participation")
  testing::assert(not buffer.cursor.is_some(), "Expected hidden unfocused cursor")
}
