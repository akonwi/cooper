use cooper/core/layout
use cooper/core/layout/cache
use cooper/core/layout/length
use cooper/core/layout/measure
use cooper/core/layout/numeric
use cooper/ui/style
use go:fmt
use go:math

fn emit(value: Float32) {
  if value != value {
    fmt::Print(" nan")
  } else {
    fmt::Printf(" %08x", math::Float32bits(value))
  }
}

fn main() {
  let values = [
    numeric::undefined(),
    Float32::from(math::Inf(1)),
    Float32::from(math::Inf(-1)),
    Float32::from(0.0),
    Float32::from(math::Copysign(0.0, -1.0)),
    Float32::from(-7.0),
    Float32::from(2.0),
    Float32::from(0.000099),
    Float32::from(0.0001),
    Float32::from(0.000101),
    Float32::from(-0.000099),
    Float32::from(-0.0001),
    Float32::from(-0.000101),
  ]
  for a in values {
    for b in values {
      // Include input bits so mismatched fixtures cannot appear to agree.
      emit(a)
      emit(b)
      fmt::Printf(
        " %t %t %t",
        numeric::is_undefined(a),
        numeric::is_defined(a),
        numeric::inexact_equals(a, b),
      )
      emit(numeric::max_or_defined(a, b))
      emit(numeric::min_or_defined(a, b))
      fmt::Println()
    }
  }
  cache_reference()
  leaf_reference()
  axis_reference()
  length_reference()
}

fn unit_number(kind: style::LengthKind) Int {
  match kind {
    style::LengthKind::undefined => 0,
    style::LengthKind::cells => 1,
    style::LengthKind::percent => 2,
    style::LengthKind::auto => 3,
    style::LengthKind::max_content => 4,
    style::LengthKind::fit_content => 5,
    style::LengthKind::stretch => 6,
  }
}

fn length_reference() {
  let lengths = [
    style::undefined(),
    style::auto(),
    style::cells(0),
    style::cells(7),
    style::Length{kind: style::LengthKind::cells, value: Float32::from(7.00005)},
    style::Length{kind: style::LengthKind::cells, value: Float32::from(7.0002)},
    style::percent(0.0),
    style::percent(33.3),
    style::percent(100.0),
    style::max_content(),
    style::fit_content(),
    style::stretch(),
  ]
  for value in lengths {
    for reference in [
      numeric::undefined(),
      Float32::from(0.0),
      Float32::from(38.0),
      Float32::from(113.7),
      Float32::from(1000000.0),
    ] {
      fmt::Printf("length %d", unit_number(value.kind))
      emit(reference)
      emit(length::resolve(value, reference))
      fmt::Printf(" %t\n", length::is_definite(value, reference))
    }
  }
  for preferred in lengths {
    for minimum in lengths {
      for maximum in lengths {
        let processed = length::processed_dimension(preferred, minimum, maximum)
        fmt::Printf("processed %d", unit_number(processed.kind))
        emit(length::resolve(processed, Float32::from(40.0)))
        fmt::Println()
      }
    }
  }
}

fn mode_number(mode: cache::SizingMode) Int {
  match mode {
    cache::SizingMode::stretch_fit => 0,
    cache::SizingMode::max_content => 1,
    cache::SizingMode::fit_content => 2,
  }
}

fn axis_reference() {
  let values = [
    numeric::undefined(),
    Float32::from(-2.0),
    Float32::from(0.0),
    Float32::from(2.0),
    Float32::from(11.0),
    Float32::from(math::Inf(1)),
    Float32::from(3000000000000000000000000000000.0),
  ]
  let bounds = [numeric::undefined(), Float32::from(0.0), Float32::from(5.0), Float32::from(13.0)]
  for mode in [cache::SizingMode::max_content, cache::SizingMode::fit_content, cache::SizingMode::stretch_fit] {
    for available in values {
      for padding in [Float32::from(0.0), Float32::from(4.0), Float32::from(9.0)] {
        for minimum in bounds {
          for maximum in bounds {
            for margin in [Float32::from(0.0), Float32::from(3.0)] {
              let axis = measure::Axis{
                available: available,
                mode: mode,
                padding_border: padding,
                minimum: minimum,
                maximum: maximum,
              }
              let constrained = axis.constrain_max(margin)
              fmt::Print("axis")
              emit(available)
              emit(padding)
              emit(minimum)
              emit(maximum)
              emit(margin)
              fmt::Printf(" %d %d", mode_number(mode), mode_number(constrained.mode))
              emit(constrained.available)
              emit(axis.without_margin(margin).available_inner_dimension())
              fmt::Println()
            }
          }
        }
      }
    }
  }
}

fn leaf_reference() {
  let leaf = layout::new()
  let content = mut measure::Size{width: Float32::from(7.0), height: Float32::from(2.0)}
  mut calls = 0
  leaf.set_measure(fn(input: measure::Input) measure::Size {
    calls =+ 1
    content.@
  })
  let width = measure::Axis{
    available: Float32::from(20.0),
    mode: cache::SizingMode::fit_content,
    padding_border: Float32::from(4.0),
    minimum: numeric::undefined(),
    maximum: numeric::undefined(),
  }
  let height = measure::Axis{
    available: Float32::from(10.0),
    mode: cache::SizingMode::max_content,
    padding_border: Float32::from(3.0),
    minimum: numeric::undefined(),
    maximum: numeric::undefined(),
  }
  for step in [0, 1, 2, 3, 4] {
    if step == 4 {
      content.width = Float32::from(13.0)
      leaf.mark_dirty()
    }
    let generation = match step < 3 {
      true => 1,
      false => step - 1,
    }
    let visited = leaf.calculate_leaf(
      width,
      height,
      Float32::from(2.0),
      Float32::from(0.0),
      generation,
      step >= 2,
    )
    fmt::Printf("leaf %t %t %d", visited, leaf.dirty, calls)
    emit(leaf.measured_width)
    emit(leaf.measured_height)
    fmt::Println()
  }
}

fn cache_reference() {
  let values = [
    numeric::undefined(),
    Float32::from(-0.5),
    Float32::from(-0.50005),
    Float32::from(0.0),
    Float32::from(4.49),
    Float32::from(4.49995),
    Float32::from(4.5),
    Float32::from(5.0),
    Float32::from(7.0),
    Float32::from(10.0),
    Float32::from(8388608.0),
    Float32::from(3000000000000000000000000000000.0),
  ]
  let modes = [
    cache::SizingMode::max_content,
    cache::SizingMode::fit_content,
    cache::SizingMode::stretch_fit,
  ]
  for value in values {
    fmt::Print("round")
    emit(value)
    emit(cache::rounded_constraint(value))
    fmt::Println()
  }
  for round in [false, true] {
    for mode in modes {
      for old_mode in modes {
        for available in values {
          for old_available in values {
            for computed in [Float32::from(-1.0), Float32::from(5.0)] {
              let old = cache::Measurement{
                available_width: old_available,
                available_height: Float32::from(3.0),
                width_mode: old_mode,
                height_mode: cache::SizingMode::stretch_fit,
                computed_width: computed,
                computed_height: Float32::from(3.0),
              }
              fmt::Printf(
                "cache %t\n",
                cache::can_use_cached_measurement(
                  mode,
                  available,
                  cache::SizingMode::stretch_fit,
                  Float32::from(3.0),
                  old,
                  Float32::from(2.0),
                  Float32::from(0.0),
                  round,
                ),
              )
            }
          }
        }
      }
    }
  }
}
