use cooper/core/layout
use cooper/core/layout/basis
use cooper/core/layout/cache
use cooper/core/layout/flex
use cooper/core/layout/length
use cooper/core/layout/measure
use cooper/core/layout/numeric
use cooper/ui/style
use go:fmt
use go:math

fn emit(value: Float32) {
  if value != value {
    fmt::Print(" nan")
  } else {
    fmt::Printf(" %08x", math::Float32bits(value))
  }
}

fn main() {
  let values = [
    numeric::undefined(),
    Float32::from(math::Inf(1)),
    Float32::from(math::Inf(-1)),
    Float32::from(0.0),
    Float32::from(math::Copysign(0.0, -1.0)),
    Float32::from(-7.0),
    Float32::from(2.0),
    Float32::from(0.000099),
    Float32::from(0.0001),
    Float32::from(0.000101),
    Float32::from(-0.000099),
    Float32::from(-0.0001),
    Float32::from(-0.000101),
  ]
  for a in values {
    for b in values {
      // Include input bits so mismatched fixtures cannot appear to agree.
      emit(a)
      emit(b)
      fmt::Printf(
        " %t %t %t",
        numeric::is_undefined(a),
        numeric::is_defined(a),
        numeric::inexact_equals(a, b),
      )
      emit(numeric::max_or_defined(a, b))
      emit(numeric::min_or_defined(a, b))
      fmt::Println()
    }
  }
  cache_reference()
  leaf_reference()
  axis_reference()
  length_reference()
  basis_reference()
  fallback_reference()
  flex_reference()
  fixed_reference()
}

fn fixed_reference() {
  let sizes = [
    numeric::undefined(),
    Float32::from(-1.0),
    Float32::from(0.0),
    Float32::from(0.01),
    Float32::from(8.0),
  ]
  let modes = [
    cache::SizingMode::max_content,
    cache::SizingMode::fit_content,
    cache::SizingMode::stretch_fit,
  ]
  for wm in modes {
    for hm in modes {
      for w in sizes {
        for h in sizes {
          let width = measure::Axis{
            available: w,
            mode: wm,
            padding_border: Float32::from(2.0),
            minimum: Float32::from(3.0),
            maximum: Float32::from(7.0),
          }
          let height = measure::Axis{
            available: h,
            mode: hm,
            padding_border: Float32::from(4.0),
            minimum: Float32::from(1.0),
            maximum: Float32::from(9.0),
          }
          let fixed = width.is_fixed() and height.is_fixed()
          fmt::Printf("fixed %t", fixed)
          match fixed {
            true => {
              emit(width.fixed_size())
              emit(height.fixed_size())
            },
            false => {
              emit(numeric::undefined())
              emit(numeric::undefined())
            },
          }
          fmt::Println()
        }
      }
    }
  }
}

fn flex_reference() {
  for minimum in [false, true] {
    for maximum in [false, true] {
      for fractional in [false, true] {
        for space in [Float32::from(-20.0), Float32::from(0.0), Float32::from(6.0), Float32::from(40.0)] {
          let items = mut List::new<flex::Item>()
          for base, index in [Float32::from(8.0), Float32::from(13.0), Float32::from(5.0)] {
            mut low = numeric::undefined()
            mut high = numeric::undefined()
            mut grow = Float32::from(1.0)
            mut shrink = Float32::from(1.0)
            if minimum {
              low = match index {
                0 => Float32::from(6.0),
                1 => Float32::from(4.0),
                _ => Float32::from(0.0),
              }
            }
            if maximum {
              high = match index {
                0 => Float32::from(10.0),
                1 => Float32::from(14.0),
                _ => Float32::from(7.0),
              }
            }
            if fractional {
              grow = match index {
                0 => Float32::from(0.25),
                1 => Float32::from(1.0),
                _ => Float32::from(3.0),
              }
              shrink = match index {
                0 => Float32::from(1.0),
                1 => Float32::from(2.0),
                _ => Float32::from(0.5),
              }
            }
            items.push(
              flex::Item{
                basis: base,
                minimum: low,
                maximum: high,
                padding_border: Float32::from(0.0),
                margin: Float32::from(0.0),
                flex_grow: grow,
                flex_shrink: shrink,
                flexible: true,
                auto_margin_start: false,
                auto_margin_end: false,
              },
            )
          }
          let line = flex::collect_line(items.@, 0, Float32::from(100.0), Float32::from(0.0), false)
          let first = flex::distribute_first_pass(line, space)
          let result = flex::distribute_second_pass(line, first, space)
          fmt::Print("flex")
          emit(line.size_consumed)
          emit(first.remaining_free_space)
          emit(first.total_flex_grow_factors)
          emit(first.total_flex_shrink_scaled_factors)
          for size in result.sizes {
            emit(size)
          }
          emit(result.distributed_free_space)
          emit(result.remaining_free_space)
          fmt::Println()
        }
      }
    }
  }
}

fn callback_number(mode: measure::Mode) Int {
  match mode {
    measure::Mode::undefined => 0,
    measure::Mode::exactly => 1,
    measure::Mode::at_most => 2,
  }
}

fn fallback_reference() {
  for row in [true, false] {
    for scroll in [false, true] {
      for stretch in [false, true] {
        for bounded in [false, true] {
          let child = layout::new()
          let seen = mut measure::Input{
            width: numeric::undefined(),
            height: numeric::undefined(),
            width_mode: measure::Mode::undefined,
            height_mode: measure::Mode::undefined,
          }
          mut calls = 0
          child.set_measure(fn(input: measure::Input) measure::Size {
            calls =+ 1
            seen.width = input.width
            seen.height = input.height
            seen.width_mode = input.width_mode
            seen.height_mode = input.height_mode
            measure::Size{
              width: numeric::min_or_defined(Float32::from(31.0), input.width),
              height: numeric::min_or_defined(Float32::from(17.0), input.height),
            }
          })
          let w = measure::Axis{
            available: Float32::from(20.0),
            mode: cache::SizingMode::stretch_fit,
            padding_border: Float32::from(4.0),
            minimum: numeric::undefined(),
            maximum: match bounded {
              true => Float32::from(10.0),
              false => numeric::undefined(),
            },
          }
          let h = measure::Axis{
            available: Float32::from(12.0),
            mode: cache::SizingMode::stretch_fit,
            padding_border: Float32::from(1.0),
            minimum: numeric::undefined(),
            maximum: match bounded {
              true => Float32::from(6.0),
              false => numeric::undefined(),
            },
          }
          let width = basis::measurement_axis(
            w,
            style::auto(),
            Float32::from(40.0),
            Float32::from(3.0),
            not row,
            scroll,
            stretch,
          )
          let height = basis::measurement_axis(
            h,
            style::auto(),
            Float32::from(30.0),
            Float32::from(2.0),
            row,
            scroll,
            stretch,
          )
          for visit in [0, 1] {
            child.measure_leaf_basis(width, height, Float32::from(3.0), Float32::from(2.0), row, 1)
            fmt::Printf(
              "fallback %d %d %d",
              calls,
              callback_number(seen.width_mode),
              callback_number(seen.height_mode),
            )
            emit(seen.width)
            emit(seen.height)
            emit(child.measured_width)
            emit(child.measured_height)
            emit(child.cache_state.computed_flex_basis)
            fmt::Printf(" %d\n", child.cache_state.computed_flex_basis_generation)
          }
        }
      }
    }
  }
}

fn basis_reference() {
  for row in [true, false] {
    for value in [style::cells(0), style::cells(5), style::percent(25.0), style::auto(), style::max_content()] {
      for available in [numeric::undefined(), Float32::from(0.0), Float32::from(20.0)] {
        for owner in [numeric::undefined(), Float32::from(40.0)] {
          for dimension in [style::cells(7), style::percent(50.0), style::auto()] {
            for padding in [Float32::from(0.0), Float32::from(9.0)] {
              for previous in [numeric::undefined(), Float32::from(17.0)] {
                let state = cache::new_state()
                state.computed_flex_basis = previous
                state.computed_flex_basis_generation = 4
                let selected = basis::resolve_without_measurement(
                  state,
                  value,
                  dimension,
                  available,
                  owner,
                  padding,
                  9,
                )
                fmt::Printf("basis %t", selected)
                emit(state.computed_flex_basis)
                fmt::Printf(" %d\n", state.computed_flex_basis_generation)
              }
            }
          }
        }
      }
    }
  }
}

fn unit_number(kind: style::LengthKind) Int {
  match kind {
    style::LengthKind::undefined => 0,
    style::LengthKind::cells => 1,
    style::LengthKind::percent => 2,
    style::LengthKind::auto => 3,
    style::LengthKind::max_content => 4,
    style::LengthKind::fit_content => 5,
    style::LengthKind::stretch => 6,
  }
}

fn length_reference() {
  let lengths = [
    style::undefined(),
    style::auto(),
    style::cells(0),
    style::cells(7),
    style::Length{kind: style::LengthKind::cells, value: Float32::from(7.00005)},
    style::Length{kind: style::LengthKind::cells, value: Float32::from(7.0002)},
    style::percent(0.0),
    style::percent(33.3),
    style::percent(100.0),
    style::max_content(),
    style::fit_content(),
    style::stretch(),
  ]
  for value in lengths {
    for reference in [
      numeric::undefined(),
      Float32::from(0.0),
      Float32::from(38.0),
      Float32::from(113.7),
      Float32::from(1000000.0),
    ] {
      fmt::Printf("length %d", unit_number(value.kind))
      emit(reference)
      emit(length::resolve(value, reference))
      fmt::Printf(" %t\n", length::is_definite(value, reference))
    }
  }
  for preferred in lengths {
    for minimum in lengths {
      for maximum in lengths {
        let processed = length::processed_dimension(preferred, minimum, maximum)
        fmt::Printf("processed %d", unit_number(processed.kind))
        emit(length::resolve(processed, Float32::from(40.0)))
        fmt::Println()
      }
    }
  }
}

fn mode_number(mode: cache::SizingMode) Int {
  match mode {
    cache::SizingMode::stretch_fit => 0,
    cache::SizingMode::max_content => 1,
    cache::SizingMode::fit_content => 2,
  }
}

fn axis_reference() {
  let values = [
    numeric::undefined(),
    Float32::from(-2.0),
    Float32::from(0.0),
    Float32::from(2.0),
    Float32::from(11.0),
    Float32::from(math::Inf(1)),
    Float32::from(3000000000000000000000000000000.0),
  ]
  let bounds = [numeric::undefined(), Float32::from(0.0), Float32::from(5.0), Float32::from(13.0)]
  for mode in [cache::SizingMode::max_content, cache::SizingMode::fit_content, cache::SizingMode::stretch_fit] {
    for available in values {
      for padding in [Float32::from(0.0), Float32::from(4.0), Float32::from(9.0)] {
        for minimum in bounds {
          for maximum in bounds {
            for margin in [Float32::from(0.0), Float32::from(3.0)] {
              let axis = measure::Axis{
                available: available,
                mode: mode,
                padding_border: padding,
                minimum: minimum,
                maximum: maximum,
              }
              let constrained = axis.constrain_max(margin)
              fmt::Print("axis")
              emit(available)
              emit(padding)
              emit(minimum)
              emit(maximum)
              emit(margin)
              fmt::Printf(" %d %d", mode_number(mode), mode_number(constrained.mode))
              emit(constrained.available)
              emit(axis.without_margin(margin).available_inner_dimension())
              fmt::Println()
            }
          }
        }
      }
    }
  }
}

fn leaf_reference() {
  let leaf = layout::new()
  let content = mut measure::Size{width: Float32::from(7.0), height: Float32::from(2.0)}
  mut calls = 0
  leaf.set_measure(fn(input: measure::Input) measure::Size {
    calls =+ 1
    content.@
  })
  let width = measure::Axis{
    available: Float32::from(20.0),
    mode: cache::SizingMode::fit_content,
    padding_border: Float32::from(4.0),
    minimum: numeric::undefined(),
    maximum: numeric::undefined(),
  }
  let height = measure::Axis{
    available: Float32::from(10.0),
    mode: cache::SizingMode::max_content,
    padding_border: Float32::from(3.0),
    minimum: numeric::undefined(),
    maximum: numeric::undefined(),
  }
  for step in [0, 1, 2, 3, 4] {
    if step == 4 {
      content.width = Float32::from(13.0)
      leaf.mark_dirty()
    }
    let generation = match step < 3 {
      true => 1,
      false => step - 1,
    }
    let visited = leaf.calculate_leaf(
      width,
      height,
      Float32::from(2.0),
      Float32::from(0.0),
      generation,
      step >= 2,
    )
    fmt::Printf("leaf %t %t %d", visited, leaf.dirty, calls)
    emit(leaf.measured_width)
    emit(leaf.measured_height)
    fmt::Println()
  }
}

fn cache_reference() {
  let values = [
    numeric::undefined(),
    Float32::from(-0.5),
    Float32::from(-0.50005),
    Float32::from(0.0),
    Float32::from(4.49),
    Float32::from(4.49995),
    Float32::from(4.5),
    Float32::from(5.0),
    Float32::from(7.0),
    Float32::from(10.0),
    Float32::from(8388608.0),
    Float32::from(3000000000000000000000000000000.0),
  ]
  let modes = [
    cache::SizingMode::max_content,
    cache::SizingMode::fit_content,
    cache::SizingMode::stretch_fit,
  ]
  for value in values {
    fmt::Print("round")
    emit(value)
    emit(cache::rounded_constraint(value))
    fmt::Println()
  }
  for round in [false, true] {
    for mode in modes {
      for old_mode in modes {
        for available in values {
          for old_available in values {
            for computed in [Float32::from(-1.0), Float32::from(5.0)] {
              let old = cache::Measurement{
                available_width: old_available,
                available_height: Float32::from(3.0),
                width_mode: old_mode,
                height_mode: cache::SizingMode::stretch_fit,
                computed_width: computed,
                computed_height: Float32::from(3.0),
              }
              fmt::Printf(
                "cache %t\n",
                cache::can_use_cached_measurement(
                  mode,
                  available,
                  cache::SizingMode::stretch_fit,
                  Float32::from(3.0),
                  old,
                  Float32::from(2.0),
                  Float32::from(0.0),
                  round,
                ),
              )
            }
          }
        }
      }
    }
  }
}
