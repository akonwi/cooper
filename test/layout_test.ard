use ard/testing

use cooper/cooper
use cooper/event
use cooper/input
use cooper/layout
use cooper/surface
use cooper/text
use go:go.rockorager.dev/vaxis
use go:math

private struct Probe {
  desired_width: Int,
  desired_height: Int,
  glyph: Str,
  events: Int,
  handles: Bool,
}

private struct MalformedProbe {
  width: Int,
  height: Int,
}

private fn probe(width: Int, height: Int, glyph: Str, handles: Bool) Probe {
  Probe{
    desired_width: width,
    desired_height: height,
    glyph: glyph,
    events: 0,
    handles: handles,
  }
}

impl cooper::Widget for MalformedProbe {
  fn render(ctx: surface::RenderContext) surface::Surface {
    surface::Surface{
      size: surface::Size{width: self.width, height: self.height},
      cells: [],
      children: [],
    }
  }

  fn event(ctx: mut event::EventContext, received: vaxis::Event) event::EventResult {
    event::EventResult::ignored
  }
}

impl cooper::Widget for Probe {
  fn render(ctx: surface::RenderContext) surface::Surface {
    let width = ctx.constraints.constrain_width(self.desired_width)
    let height = ctx.constraints.constrain_height(self.desired_height)
    let rendered = mut surface::blank(width, height)
    rendered.write(ctx, 0, 0, self.glyph)
    rendered.@
  }

  fn mut event(ctx: mut event::EventContext, received: vaxis::Event) event::EventResult {
    self.events =+ 1
    match self.handles {
      true => event::EventResult::handled,
      false => event::EventResult::ignored,
    }
  }
}

test fn column_positions_children_vertically() Void!Str {
  let first = mut probe(2, 1, "a", false)
  let second = mut probe(3, 2, "b", false)
  let children: [mut cooper::Widget] = [first, second]
  let column = layout::column(children)

  let rendered = column.render(
    surface::RenderContext{constraints: surface::bounded(max_width: 10, max_height: 10)},
  )

  try testing::assert(rendered.size.width == 3, "Expected the widest child width")
  try testing::assert(rendered.size.height == 3, "Expected the sum of child heights")
  try testing::assert(rendered.children.size() == 2, "Expected both positioned children")
  try testing::assert(rendered.cells.size() == 0, "Expected a transparent layout surface")
  let first_child = rendered.children.at(0).expect("first child")
  let second_child = rendered.children.at(1).expect("second child")
  try testing::assert(first_child.origin.y == 0, "Expected the first child at the top")
  try testing::assert(second_child.origin.y == 1, "Expected the second child after the first")

  let flattened = surface::flatten(rendered)
  try testing::assert(
    flattened.cell(0, 0).expect("first child cell").grapheme == "a",
    "Expected the first child to render",
  )
  testing::assert(
    flattened.cell(0, 1).expect("second child cell").grapheme == "b",
    "Expected the second child to render",
  )
}

test fn column_applies_parent_minimums_without_stretching_children() Void!Str {
  let child = mut probe(2, 1, "x", false)
  let children: [mut cooper::Widget] = [child]
  let column = layout::column(children)

  let rendered = column.render(
    surface::RenderContext{
      constraints: surface::Constraints{
        min_width: 5,
        max_width: 10,
        min_height: 4,
        max_height: 10,
      },
    },
  )

  try testing::assert(rendered.size.width == 5, "Expected the column minimum width")
  try testing::assert(rendered.size.height == 4, "Expected the column minimum height")
  let rendered_child = rendered.children.at(0).expect("child")
  try testing::assert(rendered_child.surface.size.width == 2, "Expected a loose child width")
  testing::assert(rendered_child.surface.size.height == 1, "Expected a loose child height")
}

test fn column_clips_height_without_constraining_child_measurement() Void!Str {
  let first = mut probe(1, 2, "a", false)
  let second = mut probe(1, 2, "b", false)
  let children: [mut cooper::Widget] = [first, second]
  let column = layout::column(children)

  let rendered = column.render(
    surface::RenderContext{constraints: surface::bounded(max_width: 4, max_height: 1)},
  )

  try testing::assert(rendered.size.height == 1, "Expected the parent height constraint")
  let first_child = rendered.children.at(0).expect("first child")
  let second_child = rendered.children.at(1).expect("second child")
  try testing::assert(first_child.surface.size.height == 2, "Expected unbounded child height measurement")
  try testing::assert(second_child.origin.y == 2, "Expected natural child positioning")

  let flattened = surface::flatten(rendered)
  testing::assert(
    flattened.cell(0, 0).expect("visible clipped cell").grapheme == "a",
    "Expected composition to clip overflowing children",
  )
}

test fn column_normalizes_negative_child_dimensions() Void!Str {
  let malformed = mut MalformedProbe{width: -2, height: -3}
  let valid = mut probe(1, 1, "x", false)
  let children: [mut cooper::Widget] = [malformed, valid]
  let column = layout::column(children)

  let rendered = column.render(
    surface::RenderContext{constraints: surface::bounded(max_width: 10, max_height: 10)},
  )

  try testing::assert(rendered.size.width == 1, "Expected negative width not to affect layout")
  try testing::assert(rendered.size.height == 1, "Expected negative height not to affect layout")
  let first_child = rendered.children.at(0).expect("malformed child")
  let second_child = rendered.children.at(1).expect("valid child")
  try testing::assert(first_child.surface.size.width == 0, "Expected normalized child width")
  try testing::assert(first_child.surface.size.height == 0, "Expected normalized child height")
  testing::assert(second_child.origin.y == 0, "Expected a non-negative sibling origin")
}

test fn column_saturates_large_child_origins() Void!Str {
  let first = mut MalformedProbe{width: 1, height: math::MaxInt}
  let second = mut MalformedProbe{width: 1, height: 1}
  let children: [mut cooper::Widget] = [first, second]
  let column = layout::column(children)

  let rendered = column.render(
    surface::RenderContext{constraints: surface::bounded(max_width: 1, max_height: 2)},
  )

  try testing::assert(rendered.size.height == 2, "Expected bounded saturated content height")
  testing::assert(
    rendered.children.at(1).expect("second child").origin.y == math::MaxInt,
    "Expected sibling origins to saturate instead of overflowing",
  )
}

test fn empty_column_uses_only_parent_minimums() Void!Str {
  let children: [mut cooper::Widget] = []
  let column = layout::column(children)

  let intrinsic = column.render(
    surface::RenderContext{constraints: surface::bounded(max_width: 10, max_height: 10)},
  )
  try testing::assert(intrinsic.size.width == 0, "Expected no intrinsic width")
  try testing::assert(intrinsic.size.height == 0, "Expected no intrinsic height")

  let constrained = column.render(
    surface::RenderContext{
      constraints: surface::Constraints{
        min_width: 3,
        max_width: 10,
        min_height: 2,
        max_height: 10,
      },
    },
  )
  try testing::assert(constrained.size.width == 3, "Expected the minimum width")
  testing::assert(constrained.size.height == 2, "Expected the minimum height")
}

test fn column_preserves_unbounded_width_and_frame_measurement() Void!Str {
  let label = mut text::new(content: "🙂")
  let children: [mut cooper::Widget] = [label]
  let column = layout::column(children)

  let rendered = column.render(
    surface::RenderContext{
      constraints: surface::Constraints{
        min_width: 0,
        min_height: 0,
        max_height: 2,
      },
      width_measurer: fn(value: Str) Int {
        match value == "🙂" {
          true => 3,
          false => surface::text_width(value),
        }
      },
    },
  )

  try testing::assert(rendered.size.width == 3, "Expected terminal-aware child width")
  let rendered_child = rendered.children.at(0).expect("text child")
  testing::assert(
    rendered_child.surface.size.width == 3,
    "Expected the child to receive the frame measurer",
  )
}

test fn column_rerenders_retained_child_state() Void!Str {
  let child = mut probe(1, 1, "x", false)
  let children: [mut cooper::Widget] = [child]
  let column = layout::column(children)
  let ctx = surface::RenderContext{constraints: surface::bounded(max_width: 10, max_height: 10)}

  let before = column.render(ctx)
  child.desired_width = 4
  let after = column.render(ctx)

  try testing::assert(before.size.width == 1, "Expected the original child width")
  testing::assert(after.size.width == 4, "Expected retained child mutation on the next render")
}

test fn column_owns_its_child_list_structure() Void!Str {
  let original = mut probe(1, 1, "a", false)
  let replacement = mut probe(1, 1, "b", false)
  let children = mut List::new<mut cooper::Widget>()
  children.push(original)
  let column = layout::column(children.@)
  children.set(0, replacement)

  let rendered = column.render(
    surface::RenderContext{constraints: surface::bounded(max_width: 1, max_height: 1)},
  )
  let flattened = surface::flatten(rendered)

  testing::assert(
    flattened.cell(0, 0).expect("owned child cell").grapheme == "a",
    "Expected caller list mutation not to replace retained children",
  )
}

test fn column_forwards_events_until_a_child_handles_them() Void!Str {
  let first = mut probe(1, 1, "a", false)
  let second = mut probe(1, 1, "b", true)
  let third = mut probe(1, 1, "c", false)
  let children: [mut cooper::Widget] = [first, second, third]
  let column = mut layout::column(children)
  let ctx = mut event::new_context()

  let result = column.event(ctx, vaxis::Key{Text: "x"})

  try testing::assert(result == event::EventResult::handled, "Expected a handled event")
  try testing::assert(first.events == 1, "Expected the first child to receive the event")
  try testing::assert(second.events == 1, "Expected the handling child to receive the event")
  testing::assert(third.events == 0, "Expected forwarding to stop after handling")
}

test fn column_supports_heterogeneous_retained_widgets() Void!Str {
  let label = mut text::new(content: "Name")
  let field = mut input::new(value: "", placeholder: "Type here")
  let children: [mut cooper::Widget] = [label, field]
  let column = mut layout::column(children)

  let rendered = column.render(
    surface::RenderContext{constraints: surface::bounded(max_width: 10, max_height: 2)},
  )
  try testing::assert(rendered.size.width == 10, "Expected the input to fill available width")
  try testing::assert(rendered.size.height == 2, "Expected text above the input")

  let ctx = mut event::new_context()
  let result = column.event(ctx, vaxis::Key{Text: "x"})
  try testing::assert(result == event::EventResult::handled, "Expected the input to handle typing")
  testing::assert(field.value == "x", "Expected the retained input to mutate")
}
