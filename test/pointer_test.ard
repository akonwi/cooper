use ard/testing

use cooper/box
use cooper/color
use cooper/event
use cooper/scroll_box
use cooper/style
use cooper/testing as cooper_testing

private fn modifiers() event::Modifiers {
  event::Modifiers{shift: false, ctrl: false, alt: false, super: false}
}

private fn lane() style::Style {
  style::new(
    flex_direction: style::FlexDirection::row,
    width: style::cells(6),
    height: style::cells(1),
    align_items: style::Align::start,
  )
}

private fn cell() style::Style {
  style::new(width: style::cells(3), height: style::cells(1), flex_shrink: 0.0)
}

private struct EventLog {
  value: Str,
}

private fn append_event(log: mut EventLog, owner: Str, received: mut event::MouseEvent) {
  if received.event_type == event::MouseEventType::down {
    log.value = "{log.value}down:{owner};"
  } else if received.event_type == event::MouseEventType::up {
    log.value = "{log.value}up:{owner};"
  } else if received.event_type == event::MouseEventType::move {
    log.value = "{log.value}move:{owner};"
  } else if received.event_type == event::MouseEventType::drag {
    log.value = "{log.value}drag:{owner};"
  } else if received.event_type == event::MouseEventType::drag_end {
    log.value = "{log.value}drag_end:{owner};"
  } else if received.event_type == event::MouseEventType::drop {
    log.value = "{log.value}drop:{owner};"
  } else if received.event_type == event::MouseEventType::over {
    log.value = "{log.value}over:{owner};"
  } else if received.event_type == event::MouseEventType::out {
    log.value = "{log.value}out:{owner};"
  }
}

test fn left_drag_captures_source_and_orders_release_routes() Void!Str {
  let application = cooper_testing::new(6, 1)
  let row = box::new(application.context, styles: lane())
  let source = box::new(application.context, styles: cell())
  let target = box::new(application.context, styles: cell())
  row.add(source)
  row.add(target)
  application.root.add(row)
  let log = mut EventLog{value: ""}
  let _ = source.on_mouse(fn(received: mut event::MouseEvent) { append_event(log, "source", received) })
  let _ = target.on_mouse(fn(received: mut event::MouseEvent) { append_event(log, "target", received) })

  application.drag(0, 0, 4, 0)

  try testing::assert(
    log.value == "down:source;over:target;drag:source;drag_end:source;up:source;drop:target;up:target;",
    "Expected captured release order, got {log.value}",
  )
  application.destroy()
  testing::assert(target.node_ref.is_destroyed(), "Expected captured drag cleanup")
}

test fn same_drag_source_and_target_receive_one_up() Void!Str {
  let application = cooper_testing::new(3, 1)
  let source = box::new(application.context, styles: cell())
  application.root.add(source)
  let log = mut EventLog{value: ""}
  let _ = source.on_mouse(fn(received: mut event::MouseEvent) { append_event(log, "source", received) })

  application.drag(0, 0, 1, 0)

  try testing::assert(
    log.value == "down:source;over:source;drag:source;drag_end:source;drop:source;up:source;",
    "Expected de-duplicated same-target release, got {log.value}",
  )
  application.destroy()
  testing::assert(source.node_ref.is_destroyed(), "Expected same-target drag cleanup")
}

test fn non_left_drag_follows_hit_testing_without_drop() Void!Str {
  let application = cooper_testing::new(6, 1)
  let row = box::new(application.context, styles: lane())
  let source = box::new(application.context, styles: cell())
  let target = box::new(application.context, styles: cell())
  row.add(source)
  row.add(target)
  application.root.add(row)
  let log = mut EventLog{value: ""}
  let _ = source.on_mouse(fn(received: mut event::MouseEvent) { append_event(log, "source", received) })
  let _ = target.on_mouse(fn(received: mut event::MouseEvent) { append_event(log, "target", received) })

  application.drag(0, 0, 4, 0, button: event::MouseButton::right)

  try testing::assert(
    log.value == "down:source;over:target;drag:target;up:target;",
    "Expected non-left hit-routed drag, got {log.value}",
  )
  application.destroy()
  testing::assert(target.node_ref.is_destroyed(), "Expected non-left drag cleanup")
}

test fn unrelated_buttons_do_not_release_left_capture() Void!Str {
  let application = cooper_testing::new(6, 1)
  let row = box::new(application.context, styles: lane())
  let source = box::new(application.context, styles: cell())
  let target = box::new(application.context, styles: cell())
  row.add(source)
  row.add(target)
  application.root.add(row)
  mut source_ends = 0
  mut target_drags = 0
  mut target_drops = 0
  let _ = source.on_mouse(fn(received: mut event::MouseEvent) {
    if received.event_type == event::MouseEventType::drag_end {
      source_ends =+ 1
    }
  })
  let _ = target.on_mouse(fn(received: mut event::MouseEvent) {
    if received.event_type == event::MouseEventType::drag {
      target_drags =+ 1
    } else if received.event_type == event::MouseEventType::drop {
      target_drops =+ 1
    }
  })

  application.mouse_down(0, 0)
  application.mouse(event::mouse(event::MouseEventType::drag, event::MouseButton::left, 1, 0, modifiers()))
  application.mouse_down(4, 0, button: event::MouseButton::right)
  application.mouse(event::mouse(event::MouseEventType::drag, event::MouseButton::right, 4, 0, modifiers()))
  application.mouse_up(4, 0, button: event::MouseButton::right)
  try testing::assert(source_ends == 0 and target_drags == 1 and target_drops == 0, "Expected unrelated button to leave capture active")
  application.mouse_up(4, 0)

  try testing::assert(source_ends == 1 and target_drops == 1, "Expected later left release to complete capture")
  application.destroy()
  testing::assert(target.node_ref.is_destroyed(), "Expected multi-button cleanup")
}

test fn no_button_up_clears_pending_left_press() Void!Str {
  let application = cooper_testing::new(6, 1)
  let row = box::new(application.context, styles: lane())
  let source = box::new(application.context, styles: cell())
  let target = box::new(application.context, styles: cell())
  row.add(source)
  row.add(target)
  application.root.add(row)
  mut source_drags = 0
  mut source_ends = 0
  mut target_drags = 0
  mut target_drops = 0
  let _ = source.on_mouse(fn(received: mut event::MouseEvent) {
    if received.event_type == event::MouseEventType::drag {
      source_drags =+ 1
    } else if received.event_type == event::MouseEventType::drag_end {
      source_ends =+ 1
    }
  })
  let _ = target.on_mouse(fn(received: mut event::MouseEvent) {
    if received.event_type == event::MouseEventType::drag {
      target_drags =+ 1
    } else if received.event_type == event::MouseEventType::drop {
      target_drops =+ 1
    }
  })

  application.mouse_down(0, 0)
  application.mouse_up(0, 0, button: event::MouseButton::none)
  application.mouse(event::mouse(event::MouseEventType::drag, event::MouseButton::left, 4, 0, modifiers()))
  application.mouse_up(4, 0)

  try testing::assert(source_drags == 0 and source_ends == 0, "Expected released press not to become capture")
  try testing::assert(target_drags == 1 and target_drops == 0, "Expected drag after released press to remain hit-routed")
  application.destroy()
  testing::assert(target.node_ref.is_destroyed(), "Expected no-button release cleanup")
}

test fn captured_source_does_not_receive_out() Void!Str {
  let application = cooper_testing::new(6, 1)
  let row = box::new(application.context, styles: lane())
  let source = box::new(application.context, styles: cell())
  let target = box::new(application.context, styles: cell())
  row.add(source)
  row.add(target)
  application.root.add(row)
  mut source_out = 0
  mut target_over = 0
  let _ = source.on_mouse(fn(received: mut event::MouseEvent) {
    if received.event_type == event::MouseEventType::out {
      source_out =+ 1
    }
  })
  let _ = target.on_mouse(fn(received: mut event::MouseEvent) {
    if received.event_type == event::MouseEventType::over {
      target_over =+ 1
    }
  })

  application.mouse_move(0, 0)
  application.drag(0, 0, 4, 0)

  try testing::assert(source_out == 0, "Expected no out on captured source")
  try testing::assert(target_over == 1, "Expected physical target over during capture")
  application.destroy()
  testing::assert(target.node_ref.is_destroyed(), "Expected captured hover cleanup")
}

test fn invalidated_capture_skips_later_source_and_drop_routes() Void!Str {
  let application = cooper_testing::new(6, 1)
  let source = box::new(
    application.context,
    styles: style::new(position: style::Position::absolute, width: style::cells(3), height: style::cells(1), left: style::cells(0)),
  )
  let target = box::new(
    application.context,
    styles: style::new(position: style::Position::absolute, width: style::cells(3), height: style::cells(1), left: style::cells(3)),
  )
  application.root.add(source)
  application.root.add(target)
  mut target_ups = 0
  mut target_drops = 0
  let _ = source.on_mouse(fn(received: mut event::MouseEvent) {
    if received.event_type == event::MouseEventType::drag {
      source.destroy()
    }
  })
  let _ = target.on_mouse(fn(received: mut event::MouseEvent) {
    if received.event_type == event::MouseEventType::up {
      target_ups =+ 1
    } else if received.event_type == event::MouseEventType::drop {
      target_drops =+ 1
    }
  })

  application.mouse_down(0, 0)
  application.mouse(event::mouse(event::MouseEventType::drag, event::MouseButton::left, 4, 0, modifiers()))
  application.mouse_up(4, 0)

  try testing::assert(source.node_ref.is_destroyed(), "Expected drag callback to invalidate capture")
  try testing::assert(target_ups == 1 and target_drops == 0, "Expected invalid capture to fall back to ordinary up")
  application.destroy()
  testing::assert(target.node_ref.is_destroyed(), "Expected invalid capture cleanup")
}

test fn layout_change_reconciles_hover_without_motion() Void!Str {
  let application = cooper_testing::new(6, 1)
  let left_style = mut style::new(
    position: style::Position::absolute,
    width: style::cells(3),
    height: style::cells(1),
    left: style::cells(0),
  )
  let right_style = mut style::new(
    position: style::Position::absolute,
    width: style::cells(3),
    height: style::cells(1),
    left: style::cells(3),
  )
  let left = box::new(application.context, styles: left_style.@)
  let right = box::new(application.context, styles: right_style.@)
  application.root.add(left)
  application.root.add(right)
  let log = mut EventLog{value: ""}
  let _ = left.on_mouse(fn(received: mut event::MouseEvent) { append_event(log, "left", received) })
  let _ = right.on_mouse(fn(received: mut event::MouseEvent) {
    append_event(log, "right", received)
    if received.event_type == event::MouseEventType::over {
      let highlighted = mut right.style()
      highlighted.background = Maybe::new(color::rgb(200, 0, 0))
      right.set_style(highlighted.@)
    }
  })

  application.mouse_move(0, 0)
  log.value = ""
  left_style.left = style::cells(3)
  right_style.left = style::cells(0)
  left.set_style(left_style.@)
  right.set_style(right_style.@)
  application.render()

  try testing::assert(log.value == "out:left;over:right;", "Expected layout-driven hover transition, got {log.value}")
  try testing::assert(not application.frame().cell(0, 0).expect("committed hover cell").style.background.is_some(), "Expected hover mutation after committed frame")
  let _ = application.flush()
  try testing::assert(application.frame().cell(0, 0).expect("follow-up hover cell").style.background.is_some(), "Expected hover callback redraw to remain pending")
  application.destroy()
  testing::assert(right.node_ref.is_destroyed(), "Expected hover reconciliation cleanup")
}

test fn scroll_without_hit_falls_back_to_focused_control() Void!Str {
  let application = cooper_testing::new(6, 1)
  let view = scroll_box::new(application.context, styles: style::new(width: style::cells(2), height: style::cells(1)))
  let content = box::new(application.context, styles: style::new(width: style::cells(2), height: style::cells(3), flex_shrink: 0.0))
  view.add(content)
  application.root.add(view)
  application.render()
  let focused = view.focus()

  application.scroll(5, 0, 1)

  try testing::assert(view.scroll_top() == 2, "Expected focused scroll fallback outside hit controls: focused {focused}, width {view.layout().screen.width}, max {view.maximum_scroll_top()}, top {view.scroll_top()}")
  application.destroy()
  testing::assert(content.node_ref.is_destroyed(), "Expected focused scroll cleanup")
}

test fn physical_input_normalizes_public_dragging_flag() Void!Str {
  let application = cooper_testing::new(3, 1)
  let target = box::new(application.context, styles: cell())
  application.root.add(target)
  mut observed = true
  let _ = target.on_mouse(fn(received: mut event::MouseEvent) {
    if received.event_type == event::MouseEventType::move {
      observed = received.is_dragging
    }
  })
  let received = event::mouse(
    event::MouseEventType::move,
    event::MouseButton::none,
    0,
    0,
    modifiers(),
    is_dragging: true,
  )

  application.mouse(received)

  try testing::assert(not observed, "Expected physical input to normalize is_dragging")
  application.destroy()
  testing::assert(target.node_ref.is_destroyed(), "Expected dragging normalization cleanup")
}
