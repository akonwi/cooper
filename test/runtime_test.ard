use ard/testing

use cooper/event
use cooper/core/runtime

test fn dispatch_queue_accepts_reentrant_actions_without_blocking() Void!Str {
  let queue = mut runtime::new_dispatch_queue()
  mut first_called = false
  mut second_called = false

  let accepted = queue.post(fn() {
    first_called = true
    let _ = queue.post(fn() {
      second_called = true
    })
  })
  (queue.pop().expect("first queued action"))()
  (queue.pop().expect("reentrant queued action"))()

  try testing::assert(accepted, "Expected first dispatch acceptance")
  try testing::assert(first_called and second_called, "Expected reentrant actions")
  testing::assert(not queue.pop().is_some(), "Expected drained dispatch queue")
}

test fn stopped_dispatch_queue_rejects_and_discards_work() Void!Str {
  let queue = mut runtime::new_dispatch_queue()
  let _ = queue.post(fn() {})

  queue.stop()

  try testing::assert(not queue.post(fn() {}), "Expected stopped dispatch rejection")
  testing::assert(not queue.pop().is_some(), "Expected stopped queue to discard work")
}

test fn mount_scope_rejects_and_suppresses_stale_dispatch() Void!Str {
  let queue = mut runtime::new_dispatch_queue()
  let base = fn(action: fn()) Void!event::DispatchError {
    if queue.post(action) {
      Result::ok(())
    } else {
      Result::err(event::DispatchError::stopped)
    }
  }
  let scope = runtime::new_mount_scope()
  let dispatch = runtime::scoped_dispatch(base, scope)
  mut called = false

  let accepted = dispatch(fn() {
    called = true
  })
  scope.stop()
  (queue.pop().expect("queued scoped action"))()
  let rejected = dispatch(fn() {
    called = true
  })

  try testing::assert(accepted.is_ok(), "Expected mounted dispatch acceptance")
  try testing::assert(scope.is_cancelled(), "Expected cancellation signal")
  try testing::assert(rejected.is_err(), "Expected stale dispatch rejection")
  testing::assert(not called, "Expected stale queued action suppression")
}
