use ard/testing

use cooper/cooper
use cooper/event
use cooper/hit
use cooper/input
use cooper/layout
use cooper/scroll
use cooper/surface
use cooper/text
use go:go.rockorager.dev/vaxis
use go:math

private struct HeightProbe {
  height: Int,
}

private struct FixedHeight {
  child: mut cooper::Widget,
  height: Int,
}

impl cooper::Widget for HeightProbe {
  fn render(ctx: surface::RenderContext) surface::Surface {
    surface::Surface{
      size: surface::Size{width: 1, height: self.height},
      cells: [],
      children: [],
      focusable: false,
    }
  }

  fn event(ctx: mut event::EventContext) event::EventResult {
    event::EventResult::ignored
  }
}

impl cooper::Widget for FixedHeight {
  fn render(ctx: surface::RenderContext) surface::Surface {
    let child = self.child.render(
      ctx.for_child(
        0,
        surface::Constraints{
          min_width: 0,
          max_width: ctx.constraints.max_width,
          min_height: self.height,
          max_height: self.height,
        },
      ),
    )
    let output = mut surface::Surface{
      size: surface::Size{width: child.size.width, height: self.height},
      cells: [],
      children: [],
      focusable: false,
    }
    output.add_widget_child(0, 0, 0, child)
    output.@
  }

  fn mut event(ctx: mut event::EventContext) event::EventResult {
    if ctx.kind == event::ContextKind::mount or ctx.kind == event::ContextKind::unmount {
      self.child.event(ctx)
    } else {
      let route_index = try ctx.next_route_index() -> _ { event::EventResult::ignored }
      if route_index != 0 {
        event::EventResult::ignored
      } else {
        ctx.enter_child()
        let result = self.child.event(ctx)
        ctx.leave_child()
        result
      }
    }
  }
}

private fn render(view: scroll::ScrollView, height: Int) surface::Surface {
  view.render(
    surface::RenderContext{constraints: surface::bounded(max_width: 10, max_height: height)},
  )
}

private fn wheel(view: mut scroll::ScrollView, tree: surface::Surface, button: vaxis::MouseButton) event::EventContext {
  let target = hit::hit_test(tree, surface::Point{x: 0, y: 0}).expect("scroll hit")
  let ctx = mut event::terminal_context(
    vaxis::Mouse{Button: button, EventType: vaxis::EventPress},
    route: target.route,
    route_sizes: target.route_sizes,
    target_size: target.size,
  )
  let _ = view.event(ctx)
  ctx.@
}

private fn reveal(view: mut cooper::Widget, tree: surface::Surface, route: [Int]) event::EventResult {
  let geometry = hit::route_geometry(tree, route).expect("focus route geometry")
  let ctx = mut event::focus_context(route, geometry.route_sizes, geometry.route_origins)
  view.event(ctx)
}

test fn scroll_view_clips_and_scrolls_its_unbounded_child() Void!Str {
  let content = mut text::new(content: "one\ntwo\nthree", wrap_mode: text::WrapMode::none)
  let view = mut scroll::new(content, wheel_step: 1)
  let initial = render(view.@, 2)
  let initial_flat = surface::flatten(initial)
  try testing::assert(initial.size.height == 2, "Expected a bounded viewport")
  try testing::assert(
    initial.children.at(0).expect("scroll content").surface.size.height == 3,
    "Expected the child to keep its unbounded height",
  )
  try testing::assert(initial_flat.cell(0, 0).expect("first row").grapheme == "o", "Expected row one")
  try testing::assert(initial_flat.cell(0, 1).expect("second row").grapheme == "t", "Expected row two")

  let ctx = wheel(view, initial, vaxis::MouseWheelDown)
  try testing::assert(ctx.redraw_requested(), "Expected wheel scrolling to request redraw")
  try testing::assert(view.requested_offset == 1, "Expected the retained offset to advance")
  let scrolled = surface::flatten(render(view.@, 2))
  try testing::assert(
    scrolled.cell(0, 0).expect("scrolled first row").grapheme == "t",
    "Expected row two after scrolling",
  )
  testing::assert(
    scrolled.cell(0, 1).expect("scrolled second row").grapheme == "t",
    "Expected row three after scrolling",
  )
}

test fn scroll_view_ignores_wheel_at_content_boundaries() Void!Str {
  let content = mut text::new(content: "one\ntwo\nthree", wrap_mode: text::WrapMode::none)
  let view = mut scroll::new(content, wheel_step: 3)
  let initial = render(view.@, 2)
  let first = wheel(view, initial, vaxis::MouseWheelDown)
  try testing::assert(first.redraw_requested(), "Expected the first wheel to reach the bottom")
  try testing::assert(view.requested_offset == 1, "Expected the offset clamped to the last row")

  let bottom = render(view.@, 2)
  let second = wheel(view, bottom, vaxis::MouseWheelDown)
  try testing::assert(not second.redraw_requested(), "Expected no redraw at the bottom boundary")
  try testing::assert(view.requested_offset == 1, "Expected the bottom offset to remain stable")

  let top = wheel(view, bottom, vaxis::MouseWheelUp)
  try testing::assert(top.redraw_requested(), "Expected wheel up to leave the boundary")
  testing::assert(view.requested_offset == 0, "Expected the offset to return to the top")
}

test fn scroll_view_visually_clamps_an_oversized_initial_offset() Void!Str {
  let content = mut text::new(content: "one\ntwo\nthree", wrap_mode: text::WrapMode::none)
  let view = scroll::new(content, offset: 99, wheel_step: 1)

  let flattened = surface::flatten(render(view, 2))

  try testing::assert(
    flattened.cell(0, 0).expect("clamped first row").grapheme == "t",
    "Expected row two",
  )
  testing::assert(
    flattened.cell(0, 1).expect("clamped second row").grapheme == "t",
    "Expected row three",
  )
}

test fn desired_offset_is_restored_after_temporary_content_shrink() Void!Str {
  let child = mut HeightProbe{height: 6}
  let view = scroll::new(child, offset: 4)

  let initial = view.render(
    surface::RenderContext{constraints: surface::bounded(max_width: 1, max_height: 2)},
  )
  try testing::assert(
    initial.children.at(0).expect("initial content").origin.y == -4,
    "Expected requested offset",
  )

  child.height = 2
  let shrunk = view.render(
    surface::RenderContext{constraints: surface::bounded(max_width: 1, max_height: 2)},
  )
  try testing::assert(
    shrunk.children.at(0).expect("shrunk content").origin.y == 0,
    "Expected visual clamping",
  )
  try testing::assert(view.requested_offset == 4, "Expected the desired offset to remain retained")

  child.height = 6
  let regrown = view.render(
    surface::RenderContext{constraints: surface::bounded(max_width: 1, max_height: 2)},
  )
  testing::assert(
    regrown.children.at(0).expect("regrown content").origin.y == -4,
    "Expected desired offset restoration",
  )
}

test fn scroll_view_normalizes_malformed_child_sizes_and_wheel_step() Void!Str {
  let child = mut HeightProbe{height: -5}
  let view = mut scroll::new(child)
  let malformed = render(view.@, 2)
  try testing::assert(malformed.size.height >= 0, "Expected a non-negative viewport")
  try testing::assert(
    malformed.children.at(0).expect("normalized content").surface.size.height >= 0,
    "Expected a non-negative content height",
  )

  child.height = 3
  view.wheel_step = -5
  let valid = render(view.@, 2)
  let ctx = wheel(view, valid, vaxis::MouseWheelDown)
  try testing::assert(ctx.redraw_requested(), "Expected a normalized wheel step to scroll")
  testing::assert(view.requested_offset == 1, "Expected a minimum one-row wheel step")
}

test fn unbounded_scroll_view_uses_its_full_content_height() Void!Str {
  let content = mut text::new(content: "one\ntwo\nthree", wrap_mode: text::WrapMode::none)
  let view = scroll::new(content, offset: 2)

  let rendered = view.render(
    surface::RenderContext{
      constraints: surface::Constraints{
        min_width: 0,
        max_width: 10,
        min_height: 0,
      },
    },
  )

  try testing::assert(rendered.size.height == 3, "Expected no viewport clipping without a height bound")
  testing::assert(
    rendered.children.at(0).expect("unbounded content").origin.y == 0,
    "Expected an unbounded view not to scroll",
  )
}

test fn scroll_view_reveals_focused_descendants_in_both_directions() Void!Str {
  let first = mut input::new(value: "", placeholder: "First")
  let second = mut input::new(value: "", placeholder: "Second")
  let third = mut input::new(value: "", placeholder: "Third")
  let content = mut layout::column(
    [layout::flex_item(first), layout::flex_item(second), layout::flex_item(third)],
  )
  let view = mut scroll::new(content)

  let initial = render(view.@, 2)
  let down = reveal(view, initial, [0, 2])
  try testing::assert(
    down == event::EventResult::handled,
    "Expected the offscreen target to request redraw",
  )
  try testing::assert(view.requested_offset == 1, "Expected the third Input revealed at the bottom")

  let scrolled = render(view.@, 2)
  let stable = reveal(view, scrolled, [0, 1])
  try testing::assert(stable == event::EventResult::ignored, "Expected no movement for a visible target")
  try testing::assert(view.requested_offset == 1, "Expected the visible target to preserve offset")

  let up = reveal(view, scrolled, [0, 0])
  try testing::assert(
    up == event::EventResult::handled,
    "Expected the clipped target above to request redraw",
  )
  testing::assert(view.requested_offset == 0, "Expected the first Input revealed at the top")
}

test fn reveal_saturates_extreme_target_origin_differences() Void!Str {
  let child = mut HeightProbe{height: 10}
  let view = mut scroll::new(child)
  let down_ctx = mut event::focus_context(
    [0],
    [surface::Size{width: 1, height: 2}, surface::Size{width: 1, height: 10}],
    [surface::Point{x: 0, y: math::MinInt}, surface::Point{x: 0, y: math::MaxInt}],
  )
  let down = view.event(down_ctx)
  try testing::assert(down == event::EventResult::handled, "Expected an extreme target below to scroll")
  try testing::assert(view.requested_offset == 8, "Expected the maximum bounded offset")

  let up_ctx = mut event::focus_context(
    [0],
    [surface::Size{width: 1, height: 2}, surface::Size{width: 1, height: 10}],
    [surface::Point{x: 0, y: math::MaxInt}, surface::Point{x: 0, y: math::MinInt}],
  )
  let up = view.event(up_ctx)
  try testing::assert(up == event::EventResult::handled, "Expected an extreme target above to scroll")
  testing::assert(view.requested_offset == 0, "Expected the minimum bounded offset")
}

test fn repeated_reveal_geometry_settles_nested_scroll_views() Void!Str {
  let field_0 = mut input::new(value: "", placeholder: "0")
  let field_1 = mut input::new(value: "", placeholder: "1")
  let field_2 = mut input::new(value: "", placeholder: "2")
  let field_3 = mut input::new(value: "", placeholder: "3")
  let field_4 = mut input::new(value: "", placeholder: "4")
  let field_5 = mut input::new(value: "", placeholder: "5")
  let inner_content = mut layout::column(
    [
      layout::flex_item(field_0),
      layout::flex_item(field_1),
      layout::flex_item(field_2),
      layout::flex_item(field_3),
      layout::flex_item(field_4),
      layout::flex_item(field_5),
    ],
  )
  let inner = mut scroll::new(inner_content)
  let inner_viewport = mut FixedHeight{child: inner, height: 2}
  let top = mut HeightProbe{height: 1}
  let bottom = mut HeightProbe{height: 5}
  let outer_content = mut layout::column(
    [layout::flex_item(top), layout::flex_item(inner_viewport), layout::flex_item(bottom)],
  )
  let outer = mut scroll::new(outer_content)
  let target_route = [0, 1, 0, 0, 5]

  let initial = render(outer.@, 3)
  let first = reveal(outer, initial, target_route)
  try testing::assert(first == event::EventResult::handled, "Expected nested viewports to move")
  try testing::assert(inner.requested_offset == 4, "Expected the inner viewport to reveal its target")
  try testing::assert(outer.requested_offset == 4, "Expected the outer viewport's first adjustment")

  let once = render(outer.@, 3)
  let second = reveal(outer, once, target_route)
  try testing::assert(
    second == event::EventResult::handled,
    "Expected geometry to correct the outer viewport",
  )
  try testing::assert(inner.requested_offset == 4, "Expected the settled inner offset")
  try testing::assert(outer.requested_offset == 2, "Expected the target aligned in the outer viewport")

  let twice = render(outer.@, 3)
  let settled = reveal(outer, twice, target_route)
  testing::assert(
    settled == event::EventResult::ignored,
    "Expected nested reveal geometry to settle",
  )
}

test fn scroll_view_routes_non_wheel_events_to_its_retained_child() Void!Str {
  let field = mut input::new(value: "", placeholder: "Type")
  let view = mut scroll::new(field)
  let ctx = mut event::terminal_context(vaxis::Key{Text: "x"}, route: [0])

  let result = view.event(ctx)

  try testing::assert(result == event::EventResult::handled, "Expected the child to handle typing")
  testing::assert(field.value == "x", "Expected retained child mutation through the ScrollView")
}

test fn scrolled_hit_testing_returns_focus_and_coordinates_in_content_space() Void!Str {
  let label = mut text::new(content: "Label")
  let field = mut input::new(value: "", placeholder: "Value")
  let content = mut layout::column([layout::flex_item(label), layout::flex_item(field)])
  let view = scroll::new(content, offset: 1)
  let rendered = view.render(
    surface::RenderContext{constraints: surface::bounded(max_width: 10, max_height: 1), focus_path: [0, 1]},
  )

  let target = hit::hit_test(rendered, surface::Point{x: 2, y: 0}).expect("scrolled Input hit")
  let flattened = surface::flatten_focused(rendered, [0, 1])

  try testing::assert(
    flattened.cursor.expect("scrolled focused cursor").point.y == 0,
    "Expected cursor translation through the scrolled viewport",
  )
  try testing::assert(target.route_sizes.size() == 3, "Expected viewport, content, and Input geometry")
  try testing::assert(
    target.local.x == 2 and target.local.y == 0,
    "Expected Input-local coordinates after scrolling",
  )
  try testing::assert(target.focus_path.is_some(), "Expected the visible Input focus target")
  testing::assert(
    target.route.at(0).expect("scroll child route") == 0 and target.route.at(1).expect("Input route") == 1,
    "Expected the routed Input below the ScrollView",
  )
}

test fn tight_flex_gives_scroll_view_the_remaining_bounded_height() Void!Str {
  let heading = mut text::new(content: "Heading")
  let content = mut text::new(content: "one\ntwo\nthree\nfour", wrap_mode: text::WrapMode::none)
  let viewport = mut scroll::new(content)
  let page = layout::column(
    [layout::flex_item(heading), layout::flex_item(viewport, flex: 1, fit: layout::FlexFit::tight)],
  )

  let rendered = page.render(
    surface::RenderContext{constraints: surface::bounded(max_width: 10, max_height: 3)},
  )
  let scroll_surface = rendered.children.at(1).expect("flex ScrollView").surface

  try testing::assert(scroll_surface.size.height == 2, "Expected the remaining height as viewport")
  testing::assert(
    scroll_surface.children.at(0).expect("scroll content").surface.size.height == 4,
    "Expected full content behind the viewport",
  )
}
