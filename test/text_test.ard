use ard/testing

use cooper/box
use cooper/color
use cooper/style
use cooper/testing as cooper_testing
use cooper/text

test fn text_defaults_to_word_wrap_and_preserves_explicit_lines() Void!Str {
  let application = cooper_testing::new(6, 4)
  let label = text::new(
    application.context,
    content: "one two\n🙂x",
    styles: style::new(width: style::cells(5)),
  )
  application.root.add(label)
  application.render()

  try testing::assert(label.wrap() == text::TextWrap::word, "Expected default word wrapping")
  try testing::assert(label.layout().screen.height == 3, "Expected wrapped and explicit lines")
  try testing::assert(application.frame().cell(0, 0).expect("word lead").grapheme == "o", "Expected first word")
  try testing::assert(application.frame().cell(0, 1).expect("wrapped lead").grapheme == "t", "Expected second wrapped word")
  try testing::assert(application.frame().cell(0, 2).expect("wide lead").grapheme == "🙂", "Expected explicit wide line")

  application.destroy()
  testing::assert(label.node_ref.is_destroyed(), "Expected wrapped Text cleanup")
}

test fn unicode_word_wrap_handles_cjk_emoji_latin_and_style_boundaries() Void!Str {
  let application = cooper_testing::new(6, 4)
  let label = text::new(
    application.context,
    content: text::styled_text(
      [
        text::span("Hi", style: text::span_style(bold: true)),
        text::span("你好", style: text::span_style(foreground: color::rgb(20, 180, 220)), link: "https://example.com/cjk"),
        text::span("🙂"),
        text::span("world", style: text::span_style(underline: true), link: "https://example.com/world"),
      ],
    ),
    styles: style::new(width: style::cells(6)),
  )
  application.root.add(label)
  application.render()

  try testing::assert(label.layout().screen.height == 3, "Expected mixed Unicode line opportunities")
  try testing::assert(application.frame().cell(0, 0).expect("Latin line lead").grapheme == "H", "Expected short Latin prefix retained")
  try testing::assert(application.frame().cell(2, 0).expect("first CJK glyph").grapheme == "你", "Expected CJK break opportunities")
  try testing::assert(application.frame().cell(4, 0).expect("second CJK glyph").style.foreground.expect("CJK style").green == Uint8::from(180), "Expected styles across Unicode wrapping")
  try testing::assert(application.frame().cell(2, 0).expect("linked CJK glyph").hyperlink.or("") == "https://example.com/cjk", "Expected CJK hyperlink metadata")
  try testing::assert(application.frame().cell(0, 1).expect("emoji line").grapheme == "🙂", "Expected complete emoji grapheme")
  try testing::assert(application.frame().cell(0, 2).expect("Latin word line").grapheme == "w" and application.frame().cell(4, 2).expect("Latin word end").style.underline, "Expected fitting Latin word not split")
  try testing::assert(application.frame().cell(4, 2).expect("linked Latin word end").hyperlink.or("") == "https://example.com/world", "Expected hyperlink through wrapping")

  application.destroy()
  testing::assert(label.node_ref.is_destroyed(), "Expected Unicode wrapped Text cleanup")
}

test fn horizontal_ellipsis_replaces_complete_glyph_and_clamps_selection() Void!Str {
  let application = cooper_testing::new(5, 1)
  let label = text::new(
    application.context,
    content: text::styled_text(
      [
        text::span("abc", style: text::span_style(foreground: color::rgb(180, 20, 30)), link: "https://example.com/abc"),
        text::span("你", style: text::span_style(foreground: color::rgb(20, 180, 30), italic: true), link: "https://example.com/wide"),
        text::span("z", style: text::span_style(foreground: color::rgb(20, 30, 180)), link: "https://example.com/z"),
      ],
    ),
    wrap: text::TextWrap::none,
    styles: style::new(width: style::cells(5), height: style::cells(1)),
    overflow: text::TextOverflow::ellipsis,
  )
  application.root.add(label)
  application.render()

  let marker = application.frame().cell(3, 0).expect("horizontal ellipsis")
  try testing::assert(label.overflow() == text::TextOverflow::ellipsis and label.content() == "abc你z", "Expected configured ellipsis without source mutation")
  try testing::assert(marker.grapheme == "…" and (not marker.style.italic) and marker.style.foreground.expect("ellipsis inherited style").red == Uint8::from(180), "Expected ellipsis style immediately before final omitted source")
  try testing::assert(marker.hyperlink.is_none(), "Expected synthetic ellipsis without hyperlink")
  try testing::assert(application.frame().cell(4, 0).expect("cleared wide continuation").grapheme == " ", "Expected no partial wide glyph")

  application.drag(3, 0, 0, 0)
  try testing::assert(label.selected_text() == "abc" and application.selection().expect("ellipsis-clamped selection").selected_text == "abc", "Expected ellipsis endpoint clamped to visible source")
  try testing::assert(not application.frame().cell(3, 0).expect("unselected ellipsis").style.reverse, "Expected synthetic ellipsis not selected")

  label.set_overflow(text::TextOverflow::clip)
  application.render()
  try testing::assert(label.overflow() == text::TextOverflow::clip, "Expected overflow setter")
  try testing::assert(application.frame().cell(3, 0).expect("restored clipped wide glyph").grapheme == "你" and application.frame().cell(4, 0).expect("restored wide link continuation").hyperlink.or("") == "https://example.com/wide", "Expected clip mode to restore complete linked wide glyph")

  application.destroy()
  testing::assert(label.node_ref.is_destroyed(), "Expected horizontal ellipsis cleanup")
}

test fn vertical_ellipsis_uses_last_visible_row_and_preceding_style() Void!Str {
  let application = cooper_testing::new(6, 2)
  let label = text::new(
    application.context,
    content: text::styled_text(
      [
        text::span("one "),
        text::span("two ", style: text::span_style(foreground: color::rgb(40, 150, 210), italic: true), link: "https://example.com/two"),
        text::span("three", style: text::span_style(bold: true)),
      ],
    ),
    styles: style::new(width: style::cells(6), height: style::cells(2)),
    overflow: text::TextOverflow::ellipsis,
  )
  application.root.add(label)
  application.render()

  let marker = application.frame().cell(4, 1).expect("vertical ellipsis")
  try testing::assert(application.frame().cell(0, 0).expect("first visible line").grapheme == "o" and application.frame().cell(0, 1).expect("last visible line").grapheme == "t", "Expected visible wrapped prefix")
  try testing::assert(marker.grapheme == "…" and marker.style.italic and marker.style.foreground.expect("vertical marker style").blue == Uint8::from(210), "Expected marker after last visible source")
  try testing::assert(marker.hyperlink.is_none(), "Expected vertical ellipsis to clear source hyperlink")

  application.destroy()
  testing::assert(label.node_ref.is_destroyed(), "Expected vertical ellipsis cleanup")
}

test fn ellipsis_without_visible_source_is_synthetic_and_not_selectable() Void!Str {
  let application = cooper_testing::new(2, 1)
  let label = text::new(
    application.context,
    content: "\n\n",
    styles: style::new(width: style::cells(2), height: style::cells(1)),
    text_style: text::style(bold: true),
    overflow: text::TextOverflow::ellipsis,
  )
  application.root.add(label)
  application.render()

  let marker = application.frame().cell(0, 0).expect("source-free ellipsis")
  try testing::assert(marker.grapheme == "…" and marker.style.bold, "Expected Text-level marker style without fitting source")
  application.click(0, 0)
  let copied = match application.selection() {
    selected => selected.selected_text,
    _ => "",
  }
  try testing::assert((not label.selection().is_some()) and copied.is_empty(), "Expected source-free synthetic marker not selectable")

  application.destroy()
  testing::assert(label.node_ref.is_destroyed(), "Expected source-free ellipsis cleanup")
}

test fn styled_text_paints_inherited_span_overrides_and_snapshots() Void!Str {
  let application = cooper_testing::new(9, 1)
  let spans = mut List::new<text::Span>()
  spans.push(
    text::span(
      "RED",
      style: text::span_style(foreground: color::rgb(220, 20, 30), underline: true),
    ),
  )
  spans.push(text::span(" plain", style: text::span_style(bold: false, hidden: true), link: "https://example.com"))
  let content = text::styled_text(spans.@)
  spans.set(0, text::span("changed"))
  let label = text::new(
    application.context,
    content: content,
    styles: style::new(background: color::rgb(4, 5, 6), width: style::cells(9)),
    text_style: text::style(bold: true, italic: true),
  )
  application.root.add(label)
  application.render()

  let emphasized = application.frame().cell(0, 0).expect("styled span cell").style
  let linked_cell = application.frame().cell(4, 0).expect("inherited span cell")
  let inherited = linked_cell.style
  try testing::assert(label.content() == "RED plain", "Expected flattened rich content")
  try testing::assert(emphasized.foreground.expect("span foreground").red == Uint8::from(220), "Expected span foreground override")
  try testing::assert(emphasized.bold and emphasized.italic and emphasized.underline and (not emphasized.hidden), "Expected Text-level attributes inherited by span")
  try testing::assert((not inherited.bold) and inherited.italic and inherited.hidden, "Expected explicit false and hidden span overrides")
  try testing::assert(inherited.background.expect("common background").blue == Uint8::from(6), "Expected common color inheritance through span")
  try testing::assert(linked_cell.hyperlink.or("") == "https://example.com", "Expected linked span cell metadata")

  let snapshot = label.styled_content()
  try testing::assert(snapshot.spans.size() == 2 and snapshot.spans.at(0).expect("first snapshot span").text == "RED", "Expected helper and Text ingress snapshots")
  try testing::assert(snapshot.spans.at(1).expect("linked snapshot span").link.or("") == "https://example.com", "Expected exact link snapshot")
  let returned_spans = mut snapshot.spans
  returned_spans.set(0, text::span("getter mutation"))
  try testing::assert(label.content() == "RED plain", "Expected getter snapshot isolated from Text")

  let direct_spans = mut List::new<text::Span>()
  direct_spans.push(text::span("direct"))
  label.set_content(text::StyledText{spans: direct_spans.@})
  direct_spans.set(0, text::span("caller mutation"))
  try testing::assert(label.content() == "direct", "Expected direct StyledText ingress snapshot")

  label.set_content("plain")
  application.render()
  try testing::assert(label.content() == "plain" and label.styled_content().spans.size() == 1, "Expected plain union setter to create one span")
  try testing::assert(application.frame().cell(0, 0).expect("plain replacement cell").hyperlink.is_none(), "Expected plain replacement to clear hyperlink")

  application.destroy()
  testing::assert(label.node_ref.is_destroyed(), "Expected styled Text cleanup")
}

test fn styled_text_uses_first_scalar_style_for_cross_span_grapheme() Void!Str {
  let application = cooper_testing::new(1, 1)
  let label = text::new(
    application.context,
    content: text::styled_text(
      [
        text::span("e", style: text::span_style(foreground: color::rgb(200, 10, 20), bold: true), link: "https://example.com/first"),
        text::span("́", style: text::span_style(foreground: color::rgb(10, 20, 200), italic: true), link: "https://example.com/second"),
      ],
    ),
    styles: style::new(width: style::cells(1), height: style::cells(1)),
  )
  application.root.add(label)
  application.render()

  let painted = application.frame().cell(0, 0).expect("cross-span grapheme")
  try testing::assert(painted.grapheme == "é", "Expected one cross-span grapheme")
  try testing::assert(painted.style.foreground.expect("first scalar foreground").red == Uint8::from(200), "Expected first scalar color")
  try testing::assert(painted.style.bold and (not painted.style.italic), "Expected complete first scalar style")
  try testing::assert(painted.hyperlink.or("") == "https://example.com/first", "Expected first scalar hyperlink for cross-span grapheme")

  application.destroy()
  testing::assert(label.node_ref.is_destroyed(), "Expected cross-span Text cleanup")
}

test fn text_character_wrap_never_splits_a_grapheme() Void!Str {
  let application = cooper_testing::new(3, 3)
  let label = text::new(
    application.context,
    content: "ab🙂",
    wrap: text::TextWrap::character,
    styles: style::new(width: style::cells(3)),
  )
  application.root.add(label)
  application.render()

  try testing::assert(label.layout().screen.height == 2, "Expected character wrap height")
  try testing::assert(application.frame().cell(1, 0).expect("first line end").grapheme == "b", "Expected first line")
  try testing::assert(application.frame().cell(0, 1).expect("second line lead").grapheme == "🙂", "Expected intact grapheme")

  application.destroy()
  testing::assert(label.node_ref.is_destroyed(), "Expected character Text cleanup")
}

test fn common_colors_follow_tree_inheritance_not_sibling_paint_order() Void!Str {
  let application = cooper_testing::new(1, 1)
  let parent = box::new(
    application.context,
    styles: style::new(width: style::cells(1), height: style::cells(1)),
  )
  let behind = text::new(
    application.context,
    content: "a",
    styles: style::new(
      foreground: color::rgb(1, 2, 3),
      background: color::rgb(4, 5, 6),
      position: style::Position::absolute,
      width: style::cells(1),
      height: style::cells(1),
    ),
  )
  let front = text::new(
    application.context,
    content: "b",
    styles: style::new(
      position: style::Position::absolute,
      width: style::cells(1),
      height: style::cells(1),
    ),
  )
  parent.add(behind)
  parent.add(front)
  application.root.add(parent)
  application.render()

  let painted = application.frame().cell(0, 0).expect("overlapping Text")
  try testing::assert(painted.grapheme == "b", "Expected later sibling paint")
  try testing::assert(not painted.style.foreground.is_some(), "Expected no foreground leakage between siblings")
  try testing::assert(not painted.style.background.is_some(), "Expected no background leakage between siblings")

  application.destroy()
  testing::assert(front.node_ref.is_destroyed(), "Expected overlapping Text cleanup")
}

test fn common_colors_inherit_through_visible_overflow() Void!Str {
  let application = cooper_testing::new(2, 1)
  let parent = box::new(
    application.context,
    styles: style::new(
      foreground: color::rgb(7, 8, 9),
      background: color::rgb(10, 11, 12),
      width: style::cells(1),
      height: style::cells(1),
      overflow: style::Overflow::visible,
    ),
  )
  let child = text::new(
    application.context,
    content: "x",
    styles: style::new(
      position: style::Position::absolute,
      left: style::cells(1),
      width: style::cells(1),
      height: style::cells(1),
    ),
  )
  parent.add(child)
  application.root.add(parent)
  application.render()

  let painted = application.frame().cell(1, 0).expect("overflowing Text")
  try testing::assert(painted.grapheme == "x", "Expected visible overflow paint")
  try testing::assert(painted.style.foreground.expect("inherited foreground").blue == Uint8::from(9), "Expected foreground inheritance outside parent bounds")
  try testing::assert(painted.style.background.expect("inherited background").blue == Uint8::from(12), "Expected background inheritance outside parent bounds")

  application.destroy()
  testing::assert(child.node_ref.is_destroyed(), "Expected overflowing Text cleanup")
}

test fn text_exposes_styles_content_wrapping_and_common_api() Void!Str {
  let application = cooper_testing::new(5, 2)
  let red = color::rgb(200, 10, 20)
  let common_foreground = color::rgb(20, 30, 40)
  let common_background = color::rgb(50, 60, 70)
  let label = text::new(
    application.context,
    content: "old",
    text_style: text::style(foreground: red, bold: true),
  )
  application.root.add(label)
  label.set_content("new")
  label.set_wrap(text::TextWrap::character)
  label.set_style(
    style::new(
      foreground: common_foreground,
      background: common_background,
      width: style::cells(3),
    ),
  )
  application.render()

  try testing::assert(label.content() == "new", "Expected Text content getter")
  try testing::assert(label.wrap() == text::TextWrap::character, "Expected Text wrap getter")
  try testing::assert(label.text_style().bold, "Expected TextStyle getter")
  try testing::assert(label.style().width.kind == style::LengthKind::cells, "Expected common style getter")
  try testing::assert(label.style().foreground.expect("common foreground").green == Uint8::from(30), "Expected color in common Style")
  let painted = application.frame().cell(0, 0).expect("styled Text cell")
  try testing::assert(painted.style.bold, "Expected bold Text paint")
  try testing::assert(painted.style.foreground.expect("Text foreground override").red == Uint8::from(200), "Expected TextStyle to override common foreground")
  try testing::assert(painted.style.background.expect("common background").blue == Uint8::from(70), "Expected inherited common background")

  application.destroy()
  testing::assert(label.node_ref.is_destroyed(), "Expected styled Text cleanup")
}
