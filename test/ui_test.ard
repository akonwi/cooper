use ard/testing

use cooper/context
use cooper/style
use cooper/ui

test fn ui_reexports_control_types_and_constructors() Void!Str {
  let ctx = context::internal_new()
  let emphasized: ui::TextStyle = ui::text_style(bold: true)
  let inline: ui::Span = ui::span("Name", style: ui::span_style(underline: true))
  let rich: ui::StyledText = ui::styled_text([inline])
  let content: ui::TextContent = rich
  let panel: mut ui::Box = ui::box(
    ctx,
    styles: style::new(border: ui::Border::single),
    title: "Profile",
  )
  let label: mut ui::Text = ui::text(
    ctx,
    content: content,
    wrap: ui::TextWrap::word,
    text_style: emphasized,
    overflow: ui::TextOverflow::ellipsis,
  )
  let field: mut ui::Input = ui::input(ctx, placeholder: "Ada")
  let viewport: mut ui::ScrollBox = ui::scroll_box(ctx, styles: style::new(height: style::cells(1)))

  viewport.add(field)
  panel.add(label)
  panel.add(viewport)

  try testing::assert(panel.child_count() == 2, "Expected ui::box to retain aliased controls")
  try testing::assert(panel.border() == ui::Border::single, "Expected ui::Border alias")
  try testing::assert(label.wrap() == ui::TextWrap::word, "Expected ui::TextWrap alias")
  try testing::assert(label.overflow() == ui::TextOverflow::ellipsis, "Expected ui::TextOverflow alias")
  try testing::assert(label.content() == "Name" and label.styled_content().spans.size() == 1, "Expected rich Text aliases")
  try testing::assert(label.text_style().bold, "Expected ui::text_style alias")
  try testing::assert(field.placeholder() == "Ada", "Expected ui::input alias")
  try testing::assert(viewport.child_count() == 1, "Expected ui::scroll_box alias")

  context::internal_state(ctx).destroy()
  testing::assert(context::internal_state(ctx).is_destroyed(), "Expected ui alias test cleanup")
}
