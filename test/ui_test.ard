use ard/testing

use cooper/runtime
use cooper/ui

test fn ui_reexports_control_types_and_constructors() Void!Str {
  let ctx = runtime::new_detached()
  let emphasized: ui::TextStyle = ui::text_style(bold: true)
  let inline: ui::Span = ui::span("Name", style: ui::span_style(underline: true))
  let rich: ui::StyledText = ui::styled_text([inline])
  let content: ui::TextContent = rich
  let panel: mut ui::Box = ui::box(
    ctx,
    styles: ui::style(
      foreground: ui::indexed(7),
      background: ui::terminal_default(),
      border: ui::Border::single,
      width: ui::percent(100.0),
    ),
    title: "Profile",
  )
  let label: mut ui::Text = ui::text(
    ctx,
    content: content,
    wrap: ui::TextWrap::word,
    text_style: emphasized,
    overflow: ui::TextOverflow::ellipsis,
  )
  let _ = label.on_link(fn(received: mut ui::LinkEvent) {
    received.prevent_default()
  })
  let field: mut ui::Input = ui::input(ctx, placeholder: "Ada")
  let notes: mut ui::TextArea = ui::text_area(
    ctx,
    placeholder: "Notes",
    wrap: ui::TextWrap::word,
    styles: ui::style(min_height: ui::cells(2)),
  )
  let viewport: mut ui::ScrollBox = ui::scroll_box(ctx, styles: ui::style(height: ui::cells(1)))
  let bar: mut ui::Scrollbar = ui::scrollbar(
    ctx,
    ui::ScrollbarOrientation::vertical,
    state: ui::scrollbar_state(viewport_size: 1, content_size: 2),
    options: ui::scrollbar_options(
      visibility: ui::ScrollbarVisibility::always,
      appearance: ui::scrollbar_appearance(thumb_glyph: "#"),
    ),
  )

  let menu: mut ui::Select = ui::select_input(
    ctx,
    [ui::select_option("Open", description: "Open a file", value: "open")],
    config: ui::select_config(show_indicator: true),
  )
  let tabs: mut ui::TabSelect = ui::tab_select(
    ctx,
    [ui::select_option("Home", value: "home")],
    config: ui::select_tab_config(show_description: false),
  )

  viewport.add(field)
  panel.add(label)
  panel.add(viewport)
  panel.add(notes)
  panel.add(bar)
  panel.add(menu)
  panel.add(tabs)

  try testing::assert(panel.child_count() == 6, "Expected ui::box to retain aliased controls")
  try testing::assert(panel.border() == ui::Border::single, "Expected ui::Border alias")
  try testing::assert(panel.style().width.kind == ui::LengthKind::percent, "Expected layout aliases")
  try testing::assert(
    panel.style().foreground.expect("indexed foreground").index.is_some(),
    "Expected color aliases",
  )
  try testing::assert(
    ui::contains(ui::Rect{x: 0, y: 0, width: 2, height: 2}, 1, 1),
    "Expected geometry aliases",
  )
  try testing::assert(label.wrap() == ui::TextWrap::word, "Expected ui::TextWrap alias")
  try testing::assert(label.overflow() == ui::TextOverflow::ellipsis, "Expected ui::TextOverflow alias")
  try testing::assert(
    label.content() == "Name" and label.styled_content().spans.size() == 1,
    "Expected rich Text aliases",
  )
  try testing::assert(label.text_style().bold, "Expected ui::text_style alias")
  try testing::assert(field.placeholder() == "Ada", "Expected ui::input alias")
  try testing::assert(
    notes.placeholder() == "Notes" and notes.wrap() == ui::TextWrap::word,
    "Expected ui::text_area alias",
  )
  try testing::assert(
    notes.scrollbar_options().visibility == ui::ScrollbarVisibility::automatic,
    "Expected automatic TextArea scrollbar",
  )
  notes.set_scrollbar_options(
    ui::scrollbar_options(visibility: ui::ScrollbarVisibility::hidden),
  )
  try testing::assert(
    notes.scrollbar_options().visibility == ui::ScrollbarVisibility::hidden,
    "Expected configurable TextArea scrollbar",
  )
  try testing::assert(viewport.child_count() == 1, "Expected ui::scroll_box alias")
  try testing::assert(bar.state().content_size == 2, "Expected Scrollbar aliases")
  try testing::assert(
    menu.highlighted().expect("Select alias highlight").option.value.or("") == "open",
    "Expected Select input aliases",
  )
  let presentation: ui::SelectPresentation = tabs.presentation()
  mut tabbed = false
  match presentation {
    ui::SelectTabConfig => { tabbed = true },
    _ => (),
  }
  try testing::assert(tabbed, "Expected tab Select aliases")

  ctx.destroy_detached()
  testing::assert(ctx.is_destroyed(), "Expected ui alias test cleanup")
}
