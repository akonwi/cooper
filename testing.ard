use ard/testing as assertions
use ard/unsafe

use cooper/clipboard
use cooper/context
use cooper/core/app_runtime
use cooper/core/paint
use cooper/event
use cooper/notification
use cooper/root
use cooper/selection
use cooper/terminal_progress
use cooper/text
use go:sync

struct Cell {
  grapheme: Str,
  width: Int,
  style: text::TextStyle,
  hyperlink: Str?,
}

struct Frame {
  buffer: paint::Buffer,
}

private fn text_style(value: paint::CellStyle) text::TextStyle {
  text::TextStyle{
    foreground: value.foreground,
    background: value.background,
    bold: value.bold,
    dim: value.dim,
    italic: value.italic,
    underline: value.underline,
    blink: value.blink,
    reverse: value.reverse,
    strike: value.strike,
    hidden: value.hidden,
  }
}

impl Frame {
  fn width() Int {
    self.buffer.width
  }

  fn height() Int {
    self.buffer.height
  }

  fn cell(x: Int, y: Int) Cell? {
    match self.buffer.cell_at(x, y) {
      value => {
        Maybe::new<Cell>(
          Cell{
            grapheme: value.grapheme,
            width: value.width,
            style: text_style(value.style),
            hyperlink: value.style.hyperlink,
          },
        )
      },
      _ => Maybe::new<Cell>(),
    }
  }

  fn cursor_x() Int? {
    match self.buffer.cursor {
      cursor => Maybe::new<Int>(cursor.x),
      _ => Maybe::new<Int>(),
    }
  }

  fn cursor_y() Int? {
    match self.buffer.cursor {
      cursor => Maybe::new<Int>(cursor.y),
      _ => Maybe::new<Int>(),
    }
  }

  fn text() Str {
    mut output = ""
    mut y = 0
    while y < self.buffer.height {
      if y > 0 {
        output = "{output}\n"
      }
      mut x = 0
      while x < self.buffer.width {
        match self.buffer.cell_at(x, y) {
          cell => {
            if cell.width > 0 {
              output = "{output}{cell.grapheme}"
            }
          },
          _ => (),
        }
        x =+ 1
      }
      y =+ 1
    }
    output
  }
}

private struct OpenedURLs {
  values: [Str],
}

private struct SentNotifications {
  mutex: mut sync::Mutex,
  values: [notification::Notification],
}

private struct TerminalProgressReports {
  mutex: mut sync::Mutex,
  values: [terminal_progress::Report],
}

struct TestApp {
  context: mut context::Context,
  root: mut root::Root,
  clipboard: mut clipboard::Clipboard,
  opened: Any,
  notification_log: Any,
  terminal_progress_log: Any,
}

private fn modifiers(value: event::Modifiers?) event::Modifiers {
  value.or(event::Modifiers{shift: false, ctrl: false, alt: false, super: false})
}

fn new(
  width: Int,
  height: Int,
  notifications_supported: Bool?,
  terminal_progress_supported: Bool?,
  on_terminal_progress: (fn(terminal_progress::Report))?,
) TestApp {
  let supported = notifications_supported.or(true)
  let progress_supported = terminal_progress_supported.or(true)
  let notification_log = mut SentNotifications{mutex: mut sync::Mutex{}, values: []}
  let terminal_progress_log = mut TerminalProgressReports{mutex: mut sync::Mutex{}, values: []}
  let runtime = app_runtime::new_headless(
    width,
    height,
    fn(message: Str, title: Str?) Bool {
      if not supported {
        false
      } else {
        notification_log.mutex.Lock()
        notification_log.values.push(notification::Notification{message: message, title: title})
        notification_log.mutex.Unlock()
        true
      }
    },
    fn(progress_state: terminal_progress::State, percent: Int?) Bool {
      if not progress_supported {
        false
      } else {
        let report = terminal_progress::Report{state: progress_state, percent: percent}
        match on_terminal_progress {
          observe => observe(report),
          _ => (),
        }
        terminal_progress_log.mutex.Lock()
        terminal_progress_log.values.push(report)
        terminal_progress_log.mutex.Unlock()
        true
      }
    },
  )
  let opened = mut OpenedURLs{values: []}
  let ctx = context::internal_new(
    request_render: runtime.request_render(),
    width_measurer: runtime.width_measurer(),
    dispatch: runtime.dispatch(),
    cancellation: runtime.cancellation(),
    focus_request: runtime.focus_request(),
    blur_request: runtime.blur_request(),
    selection_start: runtime.selection_start_request(),
    selection_update: runtime.selection_update_request(),
    selection_owns: runtime.selection_owns_request(),
    selection_clear: runtime.selection_clear_request(),
    open_url: fn(url: Str) Void!Error {
      opened.values.push(url)
      Result::ok(())
    },
    notify: fn(message: Str, title: Str?) Bool {
      runtime.notify(message, title)
    },
    terminal_progress: fn(progress_state: terminal_progress::State, percent: Int?) Bool {
      runtime.progress(progress_state, percent)
    },
  )
  let root = root::new(ctx, runtime)
  let clipboard_service = runtime.clipboard()
  runtime.start_test(ctx, root)
  TestApp{
    context: ctx,
    root: root,
    clipboard: clipboard_service,
    opened: opened,
    notification_log: notification_log,
    terminal_progress_log: terminal_progress_log,
  }
}

impl TestApp {
  fn opened_urls() [Str] {
    let opened = unsafe::cast<mut OpenedURLs>(self.opened).expect("TestApp opened URLs must be created by Cooper")
    let output = mut List::new<Str>()
    for url in opened.values {
      output.push(url)
    }
    output.@
  }

  fn sent_notifications() [notification::Notification] {
    let log = unsafe::cast<mut SentNotifications>(self.notification_log).expect("TestApp notifications must be created by Cooper")
    log.mutex.Lock()
    let output = mut List::new<notification::Notification>()
    for sent in log.values {
      output.push(sent)
    }
    log.mutex.Unlock()
    output.@
  }

  fn terminal_progress_reports() [terminal_progress::Report] {
    let log = unsafe::cast<mut TerminalProgressReports>(self.terminal_progress_log).expect("TestApp terminal progress must be created by Cooper")
    log.mutex.Lock()
    let output = mut List::new<terminal_progress::Report>()
    for report in log.values {
      output.push(report)
    }
    log.mutex.Unlock()
    output.@
  }

  fn mouse_cursor() event::MouseCursor {
    self.root.state_ref.mouse_cursor()
  }

  fn on_key(handler: fn(mut event::KeyEvent)) fn() {
    self.root.state_ref.on_key(handler)
  }

  fn on_paste(handler: fn(mut event::PasteEvent)) fn() {
    self.root.state_ref.on_paste(handler)
  }

  fn terminal_focus() event::TerminalFocus? {
    self.root.state_ref.terminal_focus()
  }

  fn on_terminal_focus(handler: fn(event::TerminalFocus)) fn() {
    self.root.state_ref.on_terminal_focus(handler)
  }

  fn set_terminal_focus(value: event::TerminalFocus) {
    self.root.state_ref.terminal_focus_test(self.context, self.root, value)
  }

  fn selection() selection::Selection? {
    self.root.state_ref.current_selection()
  }

  fn clear_selection() {
    self.root.state_ref.clear_selection()
  }

  fn on_selection_change(handler: fn(selection::Selection?)) fn() {
    self.root.state_ref.on_selection_change(handler)
  }

  fn render() {
    self.root.state_ref.render_test(self.context, self.root)
  }

  fn flush(limit: Int?) Int {
    self.root.state_ref.flush_test(self.context, self.root, limit.or(1024))
  }

  fn suspend() Bool {
    self.root.state_ref.suspend_test()
  }

  fn resume() Bool {
    self.root.state_ref.resume_test()
  }

  fn resize(width: Int, height: Int) {
    self.root.state_ref.resize_test(width, height)
    self.render()
  }

  fn key(received: mut event::KeyEvent) {
    self.root.state_ref.key_test(self.context, self.root, received)
  }

  fn paste(received: mut event::PasteEvent) {
    self.root.state_ref.paste_test(self.context, self.root, received)
  }

  fn mouse(received: mut event::MouseEvent) {
    self.root.state_ref.mouse_test(self.context, self.root, received)
  }

  fn advance_time(milliseconds: Int) {
    self.root.state_ref.advance_time_test(milliseconds)
  }

  fn mouse_move(x: Int, y: Int, received_modifiers: event::Modifiers?) {
    self.mouse(event::mouse(event::MouseEventType::move, event::MouseButton::none, x, y, modifiers(received_modifiers)))
  }

  fn mouse_down(x: Int, y: Int, button: event::MouseButton?, received_modifiers: event::Modifiers?) {
    self.mouse(event::mouse(event::MouseEventType::down, button.or(event::MouseButton::left), x, y, modifiers(received_modifiers)))
  }

  fn mouse_up(x: Int, y: Int, button: event::MouseButton?, received_modifiers: event::Modifiers?) {
    self.mouse(event::mouse(event::MouseEventType::up, button.or(event::MouseButton::left), x, y, modifiers(received_modifiers)))
  }

  fn click(x: Int, y: Int, button: event::MouseButton?, received_modifiers: event::Modifiers?) {
    let configured = button.or(event::MouseButton::left)
    self.mouse_down(x, y, configured, received_modifiers)
    self.mouse_up(x, y, configured, received_modifiers)
  }

  fn double_click(x: Int, y: Int) {
    self.click(x, y)
    self.click(x, y)
  }

  fn drag(
    start_x: Int,
    start_y: Int,
    end_x: Int,
    end_y: Int,
    button: event::MouseButton?,
    received_modifiers: event::Modifiers?,
  ) {
    let configured = button.or(event::MouseButton::left)
    let applied_modifiers = modifiers(received_modifiers)
    self.mouse_down(start_x, start_y, configured, applied_modifiers)
    self.mouse(event::mouse(event::MouseEventType::drag, configured, end_x, end_y, applied_modifiers))
    self.mouse_up(end_x, end_y, configured, applied_modifiers)
  }

  fn scroll(x: Int, y: Int, delta_y: Int, delta_x: Int?) {
    self.mouse(
      event::mouse(
        event::MouseEventType::scroll,
        event::MouseButton::none,
        x,
        y,
        modifiers(),
        scroll_x: delta_x.or(0),
        scroll_y: delta_y,
      ),
    )
  }

  fn frame() Frame {
    Frame{buffer: self.root.state_ref.frame()}
  }

  fn destroy() {
    self.root.state_ref.destroy_test(self.context, self.root)
  }
}

fn assert_contains(actual: Str, expected: Str) Void!Str {
  assertions::assert(actual.contains(expected), "Expected frame text to contain {expected}")
}
