use ard/testing
use ard/unsafe

use cooper/color
use cooper/context
use cooper/core/event_delivery
use cooper/core/node
use cooper/core/paint
use cooper/event
use cooper/geometry
use cooper/selection
use cooper/style as layout_style
use go:github.com/akonwi/cooper/ffi/core/backend/vaxisbridge as bridge
use go:github.com/rockorager/go-uucode as unicode
use go:go.rockorager.dev/vaxis
use go:math
use go:strings

struct TextStyle {
  foreground: color::Color?,
  background: color::Color?,
  bold: Bool,
  dim: Bool,
  italic: Bool,
  underline: Bool,
  blink: Bool,
  reverse: Bool,
  strike: Bool,
  hidden: Bool,
}

enum TextWrap {
  none,
  character,
  word,
}

fn style(
  foreground: color::Color?,
  background: color::Color?,
  bold: Bool?,
  dim: Bool?,
  italic: Bool?,
  underline: Bool?,
  blink: Bool?,
  reverse: Bool?,
  strike: Bool?,
  hidden: Bool?,
) TextStyle {
  TextStyle{
    foreground: foreground,
    background: background,
    bold: bold.or(false),
    dim: dim.or(false),
    italic: italic.or(false),
    underline: underline.or(false),
    blink: blink.or(false),
    reverse: reverse.or(false),
    strike: strike.or(false),
    hidden: hidden.or(false),
  }
}

let default_style = style()

struct SpanStyle {
  foreground: color::Color?,
  background: color::Color?,
  bold: Bool?,
  dim: Bool?,
  italic: Bool?,
  underline: Bool?,
  blink: Bool?,
  reverse: Bool?,
  strike: Bool?,
  hidden: Bool?,
}

struct Span {
  text: Str,
  style: SpanStyle,
  link: Str?,
}

struct StyledText {
  spans: [Span],
}

type TextContent = Str | StyledText

fn span_style(
  foreground: color::Color?,
  background: color::Color?,
  bold: Bool?,
  dim: Bool?,
  italic: Bool?,
  underline: Bool?,
  blink: Bool?,
  reverse: Bool?,
  strike: Bool?,
  hidden: Bool?,
) SpanStyle {
  SpanStyle{
    foreground: foreground,
    background: background,
    bold: bold,
    dim: dim,
    italic: italic,
    underline: underline,
    blink: blink,
    reverse: reverse,
    strike: strike,
    hidden: hidden,
  }
}

private fn valid_link(value: Str) Bool {
  bridge::ValidHyperlink(value)
}

private fn validate_link(value: Str?) {
  match value {
    link => {
      if not valid_link(link) {
        panic("Text span links cannot contain terminal control characters")
      }
    },
    _ => (),
  }
}

fn span(text: Str, style: SpanStyle?, link: Str?) Span {
  validate_link(link)
  Span{text: text, style: style.or(span_style()), link: link}
}

private fn copy_spans(spans: [Span]) [Span] {
  let copied = mut List::new<Span>()
  for value in spans {
    validate_link(value.link)
    copied.push(value)
  }
  copied.@
}

fn styled_text(spans: [Span]) StyledText {
  StyledText{spans: copy_spans(spans)}
}

private struct ContentSnapshot {
  content: Str,
  styled: StyledText,
}

private fn snapshot_content(content: TextContent) ContentSnapshot {
  let styled = match content {
    Str(value) => styled_text([span(value)]),
    StyledText(value) => styled_text(value.spans),
  }
  let parts = mut List::new<Str>()
  for value in styled.spans {
    parts.push(value.text)
  }
  ContentSnapshot{content: strings::Join(parts, ""), styled: styled}
}

private fn default_selection_style(value: mut TextStyle) {
  value.reverse = not value.reverse
}

private fn apply_style_patch(base: TextStyle, patch: fn(mut TextStyle)) TextStyle {
  let selected = mut base
  patch(selected)
  selected.@
}

private fn cell_style(value: TextStyle) paint::CellStyle {
  paint::style(
    foreground: value.foreground,
    background: value.background,
    bold: value.bold,
    dim: value.dim,
    italic: value.italic,
    underline: value.underline,
    blink: value.blink,
    reverse: value.reverse,
    strike: value.strike,
    hidden: value.hidden,
  )
}

private fn same_color(left: color::Color?, right: color::Color?) Bool {
  match left.is_none() and right.is_none() {
    true => true,
    false => {
      let left_color = try left -> _ { false }
      let right_color = try right -> _ { false }

      left_color.red == right_color.red and left_color.green == right_color.green and left_color.blue == right_color.blue
    },
  }
}

private fn same_text_style(left: TextStyle, right: TextStyle) Bool {
  same_color(left.foreground, right.foreground) and same_color(left.background, right.background) and left.bold == right.bold and left.dim == right.dim and left.italic == right.italic and left.underline == right.underline and left.blink == right.blink and left.reverse == right.reverse and left.strike == right.strike and left.hidden == right.hidden
}

private fn same_optional_bool(left: Bool?, right: Bool?) Bool {
  match left {
    left_value => {
      match right {
        right_value => left_value == right_value,
        _ => false,
      }
    },
    _ => right.is_none(),
  }
}

private fn same_optional_str(left: Str?, right: Str?) Bool {
  match left {
    left_value => {
      match right {
        right_value => left_value == right_value,
        _ => false,
      }
    },
    _ => right.is_none(),
  }
}

private fn same_span_style(left: SpanStyle, right: SpanStyle) Bool {
  same_color(left.foreground, right.foreground) and same_color(left.background, right.background) and same_optional_bool(left.bold, right.bold) and same_optional_bool(left.dim, right.dim) and same_optional_bool(left.italic, right.italic) and same_optional_bool(left.underline, right.underline) and same_optional_bool(left.blink, right.blink) and same_optional_bool(left.reverse, right.reverse) and same_optional_bool(left.strike, right.strike) and same_optional_bool(left.hidden, right.hidden)
}

private fn same_styled_text(left: StyledText, right: StyledText) Bool {
  if left.spans.size() != right.spans.size() {
    false
  } else {
    mut same = true
    for value, index in left.spans {
      let other = right.spans.at(index).expect("styled Text comparison span")
      if value.text != other.text or (not same_span_style(value.style, other.style)) or (not same_optional_str(value.link, other.link)) {
        same = false
        break
      }
    }
    same
  }
}

private struct StyleRun {
  start: Int,
  end: Int,
  style: TextStyle,
  selected_style: TextStyle,
  link: Str?,
}

private struct StyleCache {
  runs: [StyleRun],
}

private fn new_style_cache(runs: [StyleRun]) Any {
  (mut StyleCache{runs: runs})
}

private fn cached_style_runs(value: Any) [StyleRun] {
  unsafe::cast<mut StyleCache>(value).expect("Text style cache").runs
}

private fn resolve_span_style(base: TextStyle, configured: SpanStyle) TextStyle {
  let resolved = mut base
  match configured.foreground {
    value => { resolved.foreground = Maybe::new<color::Color>(value) },
    _ => (),
  }
  match configured.background {
    value => { resolved.background = Maybe::new<color::Color>(value) },
    _ => (),
  }
  resolved.bold = configured.bold.or(resolved.bold)
  resolved.dim = configured.dim.or(resolved.dim)
  resolved.italic = configured.italic.or(resolved.italic)
  resolved.underline = configured.underline.or(resolved.underline)
  resolved.blink = configured.blink.or(resolved.blink)
  resolved.reverse = configured.reverse.or(resolved.reverse)
  resolved.strike = configured.strike.or(resolved.strike)
  resolved.hidden = configured.hidden.or(resolved.hidden)
  resolved.@
}

private fn styled_runs(
  content: StyledText,
  base: TextStyle,
  selection_patch: fn(mut TextStyle),
) [StyleRun] {
  let runs = mut List::new<StyleRun>()
  mut offset = 0
  for value in content.spans {
    let end = offset + value.text.size()
    if end > offset {
      let resolved = resolve_span_style(base, value.style)
      runs.push(
        StyleRun{
          start: offset,
          end: end,
          style: resolved,
          selected_style: apply_style_patch(resolved, selection_patch),
          link: value.link,
        },
      )
    }
    offset = end
  }
  runs.@
}

private struct Line {
  text: Str,
  width: Int,
}

private struct Layout {
  lines: [Line],
  width: Int,
  height: Int,
}

private struct SourceGlyph {
  text: Str,
  width: Int,
  source_start: Int,
  source_end: Int,
  offset_start: Int,
  offset_end: Int,
  newline: Bool,
  style_index: Int,
}

private struct VisualGlyph {
  text: Str,
  width: Int,
  source_start: Int,
  source_end: Int,
  offset_start: Int,
  offset_end: Int,
  x: Int,
  y: Int,
  style_index: Int,
}

private struct WordGlyph {
  text: Str,
  start: Int,
  end: Int,
}

private struct SourceRange {
  start: Int,
  end: Int,
}

private enum WordClass {
  line_break,
  whitespace,
  word,
  punctuation,
  symbol,
}

struct SelectedGlyph {
  text: Str,
  x: Int,
  y: Int,
  width: Int,
  style: TextStyle,
}

private fn word_glyphs(content: Str) [WordGlyph] {
  let iterator = mut unicode::NewGraphemeIterator(content)
  let output = mut List::new<WordGlyph>()
  mut reading = true
  while reading {
    match iterator.Next() {
      grapheme => {
        output.push(
          WordGlyph{
            text: content.slice(start: grapheme.Start, end: grapheme.End).or(""),
            start: grapheme.Start,
            end: grapheme.End,
          },
        )
      },
      _ => { reading = false },
    }
  }
  output.@
}

private fn first_rune(value: Str) Rune? {
  value.runes().at(0)
}

private fn basic_word_class(glyph: WordGlyph) WordClass {
  if newline(glyph.text) {
    WordClass::line_break
  } else {
    let rune = try first_rune(glyph.text) -> _ { WordClass::symbol }
    let scalar = Int32::from(rune)
    if unicode::IsSpace(scalar) {
      WordClass::whitespace
    } else if unicode::GeneralCategory(scalar) == unicode::GeneralCategoryPc or unicode::IsLetter(scalar) or unicode::IsNumber(scalar) or unicode::IsMark(scalar) {
      WordClass::word
    } else if unicode::IsPunct(scalar) {
      WordClass::punctuation
    } else {
      WordClass::symbol
    }
  }
}

private fn apostrophe(glyph: WordGlyph) Bool {
  glyph.text == "'" or glyph.text == "’"
}

private fn word_class(glyphs: [WordGlyph], index: Int) WordClass {
  let glyph = glyphs.at(index).expect("word class grapheme")
  if apostrophe(glyph) and index > 0 and index + 1 < glyphs.size() {
    let before = basic_word_class(glyphs.at(index - 1).expect("apostrophe previous"))
    let after = basic_word_class(glyphs.at(index + 1).expect("apostrophe next"))
    if before == WordClass::word and after == WordClass::word {
      WordClass::word
    } else {
      WordClass::punctuation
    }
  } else {
    basic_word_class(glyph)
  }
}

private fn word_source_range(content: Str, source_index: Int) SourceRange? {
  let glyphs = word_glyphs(content)
  mut clicked = -1
  for glyph, index in glyphs {
    if source_index >= glyph.start and source_index < glyph.end {
      clicked = index
      break
    }
  }
  if clicked < 0 {
    Maybe::new<SourceRange>()
  } else {
    let target_class = word_class(glyphs, clicked)
    if target_class == WordClass::line_break {
      Maybe::new<SourceRange>()
    } else {
      mut start = clicked
      while start > 0 and word_class(glyphs, start - 1) == target_class {
        start =- 1
      }
      mut end = clicked + 1
      while end < glyphs.size() and word_class(glyphs, end) == target_class {
        end =+ 1
      }
      Maybe::new<SourceRange>(
        SourceRange{
          start: glyphs.at(start).expect("word range start").start,
          end: glyphs.at(end - 1).expect("word range end").end,
        },
      )
    }
  }
}

private fn source_glyphs(content: Str, runs: [StyleRun], measure: fn(Str) Int) [SourceGlyph] {
  let iterator = mut unicode::NewGraphemeIterator(content)
  let output = mut List::new<SourceGlyph>()
  mut offset = 0
  mut run_index = 0
  mut reading = true
  while reading {
    match iterator.Next() {
      grapheme => {
        mut locating = true
        while locating and run_index < runs.size() {
          let candidate = runs.at(run_index).expect("styled source run cursor")
          if grapheme.Start >= candidate.end {
            run_index =+ 1
          } else {
            locating = false
          }
        }
        let value = content.slice(start: grapheme.Start, end: grapheme.End).or("")
        let _ = runs.at(run_index).expect("styled source glyph run")
        let line_break = newline(value)
        if line_break {
          output.push(
            SourceGlyph{
              text: value,
              width: 1,
              source_start: grapheme.Start,
              source_end: grapheme.End,
              offset_start: offset,
              offset_end: offset + 1,
              newline: true,
              style_index: run_index,
            },
          )
          offset =+ 1
        } else {
          for character in vaxis::Characters(value) {
            mut width = measure(character.Grapheme)
            if width < 0 {
              width = 0
            }
            output.push(
              SourceGlyph{
                text: character.Grapheme,
                width: width,
                source_start: grapheme.Start,
                source_end: grapheme.End,
                offset_start: offset,
                offset_end: offset + width,
                newline: false,
                style_index: run_index,
              },
            )
            offset = offset + width
          }
        }
      },
      _ => { reading = false },
    }
  }
  output.@
}

private fn visual_glyphs(content: Str, layout: Layout, runs: [StyleRun], measure: fn(Str) Int) [VisualGlyph] {
  let source = source_glyphs(content, runs, measure)
  let output = mut List::new<VisualGlyph>()
  mut source_index = 0
  for line, y in layout.lines {
    let iterator = mut unicode::NewGraphemeIterator(line.text)
    mut x = 0
    mut reading = true
    while reading {
      match iterator.Next() {
        displayed => {
          let value = line.text.slice(start: displayed.Start, end: displayed.End).or("")
          mut matched = Maybe::new<SourceGlyph>()
          while source_index < source.size() and (not matched.is_some()) {
            let candidate = source.at(source_index).expect("source glyph mapping")
            source_index =+ 1
            if (not candidate.newline) and candidate.text == value {
              matched = Maybe::new<SourceGlyph>(candidate)
            }
          }
          match matched {
            candidate => {
              output.push(
                VisualGlyph{
                  text: value,
                  width: candidate.width,
                  source_start: candidate.source_start,
                  source_end: candidate.source_end,
                  offset_start: candidate.offset_start,
                  offset_end: candidate.offset_end,
                  x: x,
                  y: y,
                  style_index: candidate.style_index,
                },
              )
              x = x + candidate.width
            },
            _ => { reading = false },
          }
        },
        _ => { reading = false },
      }
    }
  }
  output.@
}

private struct Token {
  text: Str,
  width: Int,
  whitespace: Bool,
  newline: Bool,
}

private fn newline(grapheme: Str) Bool {
  grapheme == "\n" or grapheme == "\r" or grapheme == "\r\n"
}

private fn tokens(content: Str, measure: fn(Str) Int) [Token] {
  let output = mut List::new<Token>()
  mut current = ""
  mut current_width = 0
  mut current_whitespace = false
  mut started = false
  for character in vaxis::Characters(content) {
    let grapheme = character.Grapheme
    if newline(grapheme) {
      if started {
        output.push(
          Token{
            text: current,
            width: current_width,
            whitespace: current_whitespace,
            newline: false,
          },
        )
      }
      output.push(
        Token{
          text: "",
          width: 0,
          whitespace: false,
          newline: true,
        },
      )
      current = ""
      current_width = 0
      started = false
    } else {
      let whitespace = strings::TrimSpace(grapheme).is_empty()
      if started and whitespace != current_whitespace {
        output.push(
          Token{
            text: current,
            width: current_width,
            whitespace: current_whitespace,
            newline: false,
          },
        )
        current = ""
        current_width = 0
        started = false
      }
      if not started {
        current_whitespace = whitespace
        started = true
      }
      current = "{current}{grapheme}"
      current_width = current_width + measure(grapheme)
    }
  }
  if started {
    output.push(
      Token{
        text: current,
        width: current_width,
        whitespace: current_whitespace,
        newline: false,
      },
    )
  }
  output.@
}

private fn push_line(lines: mut [Line], text: Str, width: Int) {
  lines.push(Line{text: text, width: width})
}

private fn finish(lines: mut [Line]) Layout {
  if lines.size() == 0 {
    push_line(lines, "", 0)
  }
  mut width = 0
  for line in lines {
    if line.width > width {
      width = line.width
    }
  }
  Layout{
    lines: lines.@,
    width: width,
    height: lines.size(),
  }
}

private fn unwrapped(content: Str, measure: fn(Str) Int) Layout {
  let lines = mut List::new<Line>()
  mut current = ""
  mut width = 0
  for character in vaxis::Characters(content) {
    let grapheme = character.Grapheme
    if newline(grapheme) {
      push_line(lines, current, width)
      current = ""
      width = 0
    } else {
      current = "{current}{grapheme}"
      width = width + measure(grapheme)
    }
  }
  push_line(lines, current, width)
  finish(lines)
}

private fn character_wrapped(content: Str, requested_limit: Int, measure: fn(Str) Int) Layout {
  mut limit = requested_limit
  if limit < 1 {
    limit = 1
  }
  let lines = mut List::new<Line>()
  mut current = ""
  mut width = 0
  for character in vaxis::Characters(content) {
    let grapheme = character.Grapheme
    if newline(grapheme) {
      push_line(lines, current, width)
      current = ""
      width = 0
    } else {
      let grapheme_width = measure(grapheme)
      if width > 0 and width + grapheme_width > limit {
        push_line(lines, current, width)
        current = ""
        width = 0
      }
      current = "{current}{grapheme}"
      width = width + grapheme_width
    }
  }
  push_line(lines, current, width)
  finish(lines)
}

private fn word_wrapped(content: Str, requested_limit: Int, measure: fn(Str) Int) Layout {
  mut limit = requested_limit
  if limit < 1 {
    limit = 1
  }
  let lines = mut List::new<Line>()
  mut current = ""
  mut width = 0
  mut pending_space = ""
  mut pending_width = 0
  for token in tokens(content, measure) {
    if token.newline {
      if width + pending_width <= limit {
        current = "{current}{pending_space}"
        width = width + pending_width
      }
      push_line(lines, current, width)
      current = ""
      width = 0
      pending_space = ""
      pending_width = 0
    } else if token.whitespace {
      pending_space = token.text
      pending_width = token.width
    } else if width > 0 and width + pending_width + token.width <= limit {
      current = "{current}{pending_space}{token.text}"
      width = width + pending_width + token.width
      pending_space = ""
      pending_width = 0
    } else {
      if width > 0 {
        push_line(lines, current, width)
        current = ""
        width = 0
      }
      pending_space = ""
      pending_width = 0
      if token.width <= limit {
        current = token.text
        width = token.width
      } else {
        for character in vaxis::Characters(token.text) {
          let grapheme = character.Grapheme
          let grapheme_width = measure(grapheme)
          if width > 0 and width + grapheme_width > limit {
            push_line(lines, current, width)
            current = ""
            width = 0
          }
          current = "{current}{grapheme}"
          width = width + grapheme_width
        }
      }
    }
  }
  if width + pending_width <= limit {
    current = "{current}{pending_space}"
    width = width + pending_width
  }
  push_line(lines, current, width)
  finish(lines)
}

private fn layout_text(content: Str, wrap: TextWrap, width: Int, measure: fn(Str) Int) Layout {
  match wrap {
    TextWrap::none => unwrapped(content, measure),
    TextWrap::character => character_wrapped(content, width, measure),
    TextWrap::word => word_wrapped(content, width, measure),
  }
}

private fn point_before(left_x: Int, left_y: Int, right_x: Int, right_y: Int) Bool {
  left_y < right_y or (left_y == right_y and left_x <= right_x)
}

private fn constrained(value: Float32, available: Float32, mode: node::MeasureMode) Float32 {
  match mode {
    node::MeasureMode::exactly => available,
    node::MeasureMode::at_most => {
      if value > available {
        available
      } else {
        value
      }
    },
    node::MeasureMode::undefined => value,
  }
}

private fn paint_visual_glyphs(
  ctx: mut paint::Context,
  glyphs: [VisualGlyph],
  runs: [StyleRun],
  measure: fn(Str) Int,
) {
  mut index = 0
  while index < glyphs.size() {
    let first = glyphs.at(index).expect("visual paint run start")
    let first_run = runs.at(first.style_index).expect("visual paint style run")
    let parts = mut List::new<Str>()
    parts.push(first.text)
    let x = first.x
    let y = first.y
    mut end_x = first.x + first.width
    index =+ 1
    mut collecting = true
    while collecting and index < glyphs.size() {
      let next = glyphs.at(index).expect("visual paint run glyph")
      let next_run = runs.at(next.style_index).expect("visual paint next style run")
      if next.y == y and next.x == end_x and same_text_style(first_run.style, next_run.style) and same_optional_str(first_run.link, next_run.link) {
        parts.push(next.text)
        end_x = end_x + next.width
        index =+ 1
      } else {
        collecting = false
      }
    }
    ctx.write_measured(
      x,
      y,
      strings::Join(parts, ""),
      measure,
      text_style: cell_style(first_run.style),
    )
  }
}

private fn paint_selected_glyphs(
  ctx: mut paint::Context,
  glyphs: [SelectedGlyph],
  measure: fn(Str) Int,
) {
  mut index = 0
  while index < glyphs.size() {
    let first = glyphs.at(index).expect("selected paint run start")
    let parts = mut List::new<Str>()
    parts.push(first.text)
    let x = first.x
    let y = first.y
    mut end_x = first.x + first.width
    index =+ 1
    mut collecting = true
    while collecting and index < glyphs.size() {
      let next = glyphs.at(index).expect("selected paint run glyph")
      if next.y == y and next.x == end_x and same_text_style(first.style, next.style) {
        parts.push(next.text)
        end_x = end_x + next.width
        index =+ 1
      } else {
        collecting = false
      }
    }
    ctx.write_measured(
      x,
      y,
      strings::Join(parts, ""),
      measure,
      text_style: cell_style(first.style),
    )
  }
}

struct Text {
  node_ref: mut node::Node,
  content: Str,
  styled_value: StyledText,
  style_cache: Any,
  wrap_mode: TextWrap,
  text_style: TextStyle,
  selection_patch: fn(mut TextStyle),
  selected_range: selection::Range?,
  selected_text_value: Str,
  selected_glyphs: [SelectedGlyph],
  source_revision: Int,
  width_measurer: fn(Str) Int,
}

fn new(
  ctx: mut context::Context,
  content: TextContent,
  wrap: TextWrap?,
  styles: layout_style::Style?,
  text_style: TextStyle?,
  selectable: Bool?,
  selection_style: (fn(mut TextStyle))?,
) mut Text {
  let snapshot = snapshot_content(content)
  let retained = context::internal_state(ctx).create_node(styles.or(layout_style::new()))
  let base_style = text_style.or(default_style)
  let patch = selection_style.or(default_selection_style)
  let text = mut Text{
    node_ref: retained,
    content: snapshot.content,
    styled_value: snapshot.styled,
    style_cache: new_style_cache(styled_runs(snapshot.styled, base_style, patch)),
    wrap_mode: wrap.or(TextWrap::none),
    text_style: base_style,
    selection_patch: patch,
    selected_range: Maybe::new<selection::Range>(),
    selected_text_value: "",
    selected_glyphs: [],
    source_revision: 1,
    width_measurer: context::internal_state(ctx).width_measurer,
  }
  retained.bind(text)
  retained.set_measure(fn(input: node::MeasureInput) node::MeasureSize {
    mut width_limit = 1
    if input.width_mode != node::MeasureMode::undefined {
      width_limit = node::measure_limit(input.width)
    }
    let measured = layout_text(text.content, text.wrap_mode, width_limit, text.width_measurer)
    node::MeasureSize{
      width: constrained(Float32::from(measured.width), input.width, input.width_mode),
      height: constrained(Float32::from(measured.height), input.height, input.height_mode),
    }
  })
  if selectable.or(true) {
    text.enable_selection()
  }
  text
}

impl node::Renderable for Text {
  fn node() mut node::Node {
    self.node_ref
  }

  fn mount(ctx: node::MountContext) {}

  fn paint(ctx: mut paint::Context) {
    let measured = layout_text(
      self.content,
      self.wrap_mode,
      self.node_ref.layout().screen.width,
      self.width_measurer,
    )
    let runs = cached_style_runs(self.style_cache)
    if runs.size() <= 1 {
      let applied = match runs.at(0) {
        run => run.style,
        _ => self.text_style,
      }
      for line, y in measured.lines {
        ctx.write_measured(
          0,
          y,
          line.text,
          self.width_measurer,
          text_style: cell_style(applied),
        )
      }
    } else {
      paint_visual_glyphs(
        ctx,
        visual_glyphs(self.content, measured, runs, self.width_measurer),
        runs,
        self.width_measurer,
      )
    }
    if self.selected_glyphs.size() > 0 {
      paint_selected_glyphs(ctx, self.selected_glyphs, self.width_measurer)
    }
  }

  fn event(ctx: mut event_delivery::Context) event_delivery::Disposition {
    event_delivery::Disposition::ignored
  }
}

impl Text {
  private fn visual_content() [VisualGlyph] {
    let measured = layout_text(
      self.content,
      self.wrap_mode,
      self.node_ref.layout().screen.width,
      self.width_measurer,
    )
    visual_glyphs(self.content, measured, cached_style_runs(self.style_cache), self.width_measurer)
  }

  private fn expansion_from_source(value: SourceRange) node::SelectionExpansion? {
    mut started = false
    mut anchor_x = 0
    mut anchor_y = 0
    mut focus_x = 0
    mut focus_y = 0
    mut range_start = 0
    mut range_end = 0
    for glyph in self.visual_content() {
      let overlaps = glyph.source_end > value.start and glyph.source_start < value.end
      if overlaps and glyph.width > 0 {
        if not started {
          started = true
          anchor_x = glyph.x
          anchor_y = glyph.y
          range_start = glyph.offset_start
        }
        focus_x = glyph.x + glyph.width - 1
        focus_y = glyph.y
        range_end = glyph.offset_end
      }
    }
    if started {
      Maybe::new<node::SelectionExpansion>(
        node::SelectionExpansion{
          anchor_x: anchor_x,
          anchor_y: anchor_y,
          focus_x: focus_x,
          focus_y: focus_y,
          logical_range: node::SelectionRange{start: range_start, end: range_end},
          source_range: node::SelectionRange{start: value.start, end: value.end},
          source_revision: self.source_revision,
        },
      )
    } else {
      Maybe::new<node::SelectionExpansion>()
    }
  }

  private fn word_expansion(local_x: Int, local_y: Int) node::SelectionExpansion? {
    mut source_start = -1
    for glyph in self.visual_content() {
      if glyph.y == local_y and local_x >= glyph.x and local_x < glyph.x + glyph.width {
        source_start = glyph.source_start
        break
      }
    }
    if source_start < 0 {
      Maybe::new<node::SelectionExpansion>()
    } else {
      match word_source_range(self.content, source_start) {
        value => self.expansion_from_source(value),
        _ => Maybe::new<node::SelectionExpansion>(),
      }
    }
  }

  private fn resolve_expansion(
    logical_range: node::SelectionRange,
    source_range: node::SelectionRange,
    source_revision: Int,
  ) node::SelectionExpansion? {
    if source_revision != self.source_revision {
      Maybe::new<node::SelectionExpansion>()
    } else {
      mut started = false
      mut anchor_x = 0
      mut anchor_y = 0
      mut focus_x = 0
      mut focus_y = 0
      for glyph in self.visual_content() {
        let overlaps = glyph.offset_end > logical_range.start and glyph.offset_start < logical_range.end
        if overlaps and glyph.width > 0 {
          if not started {
            started = true
            anchor_x = glyph.x
            anchor_y = glyph.y
          }
          focus_x = glyph.x + glyph.width - 1
          focus_y = glyph.y
        }
      }
      if started {
        Maybe::new<node::SelectionExpansion>(
          node::SelectionExpansion{
            anchor_x: anchor_x,
            anchor_y: anchor_y,
            focus_x: focus_x,
            focus_y: focus_y,
            logical_range: logical_range,
            source_range: source_range,
            source_revision: source_revision,
          },
        )
      } else {
        Maybe::new<node::SelectionExpansion>()
      }
    }
  }

  private fn mut clear_local_selection() node::SelectionResult {
    self.selected_range = Maybe::new<selection::Range>()
    self.selected_text_value = ""
    self.selected_glyphs = []
    node::empty_selection_result()
  }

  private fn selection_accepts(local_x: Int, local_y: Int) Bool {
    let measured = layout_text(
      self.content,
      self.wrap_mode,
      self.node_ref.layout().screen.width,
      self.width_measurer,
    )
    mut accepted = false
    for glyph in visual_glyphs(self.content, measured, cached_style_runs(self.style_cache), self.width_measurer) {
      if glyph.y == local_y and local_x >= glyph.x and local_x < glyph.x + glyph.width {
        accepted = true
        break
      }
    }
    accepted
  }

  private fn mut apply_local_selection(value: node::LocalSelection?) node::SelectionResult {
    let local = try value -> _ { self.clear_local_selection() }
    let has_logical_range = local.logical_range.is_some()
    if (not local.is_active) or ((not has_logical_range) and local.anchor_x == local.focus_x and local.anchor_y == local.focus_y) {
      self.clear_local_selection()
    } else {
      mut start_x = local.anchor_x
      mut start_y = local.anchor_y
      mut end_x = local.focus_x
      mut end_y = local.focus_y
      if not point_before(start_x, start_y, end_x, end_y) {
        start_x = local.focus_x
        start_y = local.focus_y
        end_x = local.anchor_x
        end_y = local.anchor_y
      }
      let measured = layout_text(
        self.content,
        self.wrap_mode,
        self.node_ref.layout().screen.width,
        self.width_measurer,
      )
      let selected = mut List::new<SelectedGlyph>()
      let fragments = mut List::new<node::SelectionFragment>()
      mut first_source = 0
      mut last_source = 0
      mut start_offset = 0
      mut end_offset = 0
      mut started = false
      mut all_selected_visible = true
      let screen = self.node_ref.layout().screen
      let runs = cached_style_runs(self.style_cache)
      for glyph in visual_glyphs(self.content, measured, runs, self.width_measurer) {
        let glyph_end = glyph.x + glyph.width
        let clip_end = local.clip.x + local.clip.width
        let visible = glyph.y >= local.clip.y and glyph.y < local.clip.y + local.clip.height and glyph.x >= local.clip.x and glyph_end <= clip_end
        let coordinate_selected = (glyph.y > start_y or (glyph.y == start_y and glyph_end > start_x)) and (glyph.y < end_y or (glyph.y == end_y and glyph.x <= end_x))
        let selected_by_range = match local.logical_range {
          range => glyph.offset_end > range.start and glyph.offset_start < range.end,
          _ => coordinate_selected,
        }
        if selected_by_range {
          let selected_style = runs.at(glyph.style_index).expect("selected glyph style run").selected_style
          selected.push(SelectedGlyph{text: glyph.text, x: glyph.x, y: glyph.y, width: glyph.width, style: selected_style})
          if not visible {
            all_selected_visible = false
          }
          if visible {
            fragments.push(
              node::SelectionFragment{
                screen_x: screen.x + glyph.x,
                screen_y: screen.y + glyph.y,
                cell_width: glyph.width,
                text: glyph.text,
              },
            )
          }
          if not started {
            first_source = glyph.source_start
            start_offset = glyph.offset_start
            started = true
          }
          last_source = glyph.source_end
          end_offset = glyph.offset_end
        }
      }
      if not started {
        self.clear_local_selection()
      } else {
        self.selected_range = Maybe::new<selection::Range>(selection::Range{start: start_offset, end: end_offset})
        self.selected_text_value = match local.source_range {
          range => self.content.slice(start: range.start, end: range.end).or(""),
          _ => self.content.slice(start: first_source, end: last_source).or(""),
        }
        self.selected_glyphs = selected.@
        mut source_text = Maybe::new<Str>()
        if all_selected_visible {
          match local.source_range {
            range => { source_text = Maybe::new<Str>(self.content.slice(start: range.start, end: range.end).or("")) },
            _ => (),
          }
        }
        node::SelectionResult{
          has_selection: true,
          start: start_offset,
          end: end_offset,
          source_text: source_text,
          fragments: fragments.@,
        }
      }
    }
  }

  private fn mut enable_selection() {
    self.node_ref.set_selection_callbacks(
      fn(local_x: Int, local_y: Int) Bool {
        self.selection_accepts(local_x, local_y)
      },
      fn(value: node::LocalSelection?) node::SelectionResult {
        self.apply_local_selection(value)
      },
      Maybe::new<fn(Int, Int) node::SelectionExpansion?>(fn(local_x: Int, local_y: Int) node::SelectionExpansion? {
        self.word_expansion(local_x, local_y)
      }),
      Maybe::new<fn(node::SelectionRange, node::SelectionRange, Int) node::SelectionExpansion?>(fn(logical_range: node::SelectionRange, source_range: node::SelectionRange, source_revision: Int) node::SelectionExpansion? {
        self.resolve_expansion(logical_range, source_range, source_revision)
      }),
    )
  }

  fn content() Str {
    self.content
  }

  fn styled_content() StyledText {
    styled_text(self.styled_value.spans)
  }

  fn mut set_content(content: TextContent) {
    self.node_ref.require_live()
    let snapshot = snapshot_content(content)
    if not same_styled_text(self.styled_value, snapshot.styled) {
      let source_changed = self.content != snapshot.content
      if source_changed and self.source_revision == math::MaxInt {
        panic("Text source revision overflow")
      }
      self.content = snapshot.content
      self.styled_value = snapshot.styled
      self.style_cache = new_style_cache(styled_runs(snapshot.styled, self.text_style, self.selection_patch))
      if source_changed {
        self.source_revision =+ 1
        self.node_ref.mark_measure_dirty()
      } else {
        self.node_ref.request_redraw()
      }
    }
  }

  fn wrap() TextWrap {
    self.wrap_mode
  }

  fn mut set_wrap(value: TextWrap) {
    self.node_ref.require_live()
    if self.wrap_mode != value {
      self.wrap_mode = value
      self.node_ref.mark_measure_dirty()
    }
  }

  fn text_style() TextStyle {
    self.text_style
  }

  fn selectable() Bool {
    self.node_ref.is_selectable()
  }

  fn mut set_selectable(value: Bool) {
    self.node_ref.require_live()
    if value and (not self.node_ref.is_selectable()) {
      self.enable_selection()
    } else if (not value) and self.node_ref.is_selectable() {
      self.node_ref.clear_selection_callbacks()
    }
  }

  fn selection() selection::Range? {
    self.selected_range
  }

  fn selected_text() Str {
    self.selected_text_value
  }

  fn mut set_selection_style(patch: fn(mut TextStyle)) {
    self.node_ref.require_live()
    self.selection_patch = patch
    self.style_cache = new_style_cache(styled_runs(self.styled_value, self.text_style, patch))
    self.node_ref.request_redraw()
  }

  fn mut set_text_style(next: TextStyle) {
    self.node_ref.require_live()
    if not same_text_style(self.text_style, next) {
      self.text_style = next
      self.style_cache = new_style_cache(styled_runs(self.styled_value, next, self.selection_patch))
      self.node_ref.request_redraw()
    }
  }

  fn style() layout_style::Style {
    self.node_ref.style()
  }

  fn mut set_style(next: layout_style::Style) {
    self.node_ref.apply_style(next)
  }

  fn layout() geometry::Geometry {
    self.node_ref.layout()
  }

  fn mut on_mouse(handler: fn(mut event::MouseEvent)) fn() {
    self.node_ref.on_mouse(handler)
  }

  fn mut destroy(recursive: Bool?) {
    self.node_ref.destroy(recursive)
  }
}

test fn styled_text_helpers_snapshot_and_resolve_tristate_styles() Void!Str {
  let spans = mut List::new<Span>()
  spans.push(span(""))
  spans.push(span("value", style: span_style(bold: false, hidden: true), link: "https://example.com"))
  let snapshot = styled_text(spans.@)
  spans.set(1, span("changed"))

  try testing::assert(snapshot.spans.size() == 2 and snapshot.spans.at(0).expect("empty span snapshot").text == "", "Expected empty span preserved")
  try testing::assert(snapshot.spans.at(1).expect("copied span").text == "value", "Expected defensive span list copy")
  let resolved = resolve_span_style(style(bold: true, italic: true), snapshot.spans.at(1).expect("resolved span").style)
  try testing::assert((not resolved.bold) and resolved.italic and resolved.hidden, "Expected nullable span attributes to inherit or explicitly disable")
  try testing::assert(valid_link("https://example.com/path"), "Expected ordinary Unicode link data")
  testing::assert(not valid_link("bad\nlink"), "Expected terminal control rejection")
}

test fn word_ranges_group_editor_oriented_unicode_classes() Void!Str {
  let contraction = "don't stop"
  let contraction_range = word_source_range(contraction, 2).expect("contraction word range")
  try testing::assert(contraction.slice(start: contraction_range.start, end: contraction_range.end).or("") == "don't", "Expected internal apostrophe to join a word")

  let whitespace_range = word_source_range(contraction, 5).expect("whitespace word range")
  try testing::assert(contraction.slice(start: whitespace_range.start, end: whitespace_range.end).or("") == " ", "Expected contiguous whitespace run")

  let punctuation = "go...now"
  let punctuation_range = word_source_range(punctuation, 3).expect("punctuation word range")
  try testing::assert(punctuation.slice(start: punctuation_range.start, end: punctuation_range.end).or("") == "...", "Expected contiguous punctuation run")

  let symbols = "a🙂🙂b"
  let symbol_range = word_source_range(symbols, 1).expect("symbol word range")
  try testing::assert(symbols.slice(start: symbol_range.start, end: symbol_range.end).or("") == "🙂🙂", "Expected contiguous symbol run")

  let unicode_word = "你好_one"
  let unicode_range = word_source_range(unicode_word, 0).expect("Unicode word range")
  try testing::assert(unicode_word.slice(start: unicode_range.start, end: unicode_range.end).or("") == unicode_word, "Expected letters and connector punctuation to share a run")
  testing::assert(not word_source_range("a\nb", 1).is_some(), "Expected explicit newline to reject word expansion")
}
