use cooper/box as box_control
use cooper/input as input_control
use cooper/scroll_box as scroll_box_control
use cooper/scrollbar as scrollbar_control
use cooper/selection as selection_value
use cooper/text as text_control

type Box = box_control::Box
type Border = box_control::Border
type Input = input_control::Input
type ScrollBox = scroll_box_control::ScrollBox
type Scrollbar = scrollbar_control::Scrollbar
type ScrollbarOptions = scrollbar_control::Options
type ScrollbarOrientation = scrollbar_control::Orientation
type ScrollbarState = scrollbar_control::State
type ScrollbarTheme = scrollbar_control::Theme
type ScrollbarVisibility = scrollbar_control::Visibility
type Selection = selection_value::Selection
type SelectionRange = selection_value::Range
type Text = text_control::Text
type TextContent = text_control::TextContent
type StyledText = text_control::StyledText
type Span = text_control::Span
type SpanStyle = text_control::SpanStyle
type LinkEvent = text_control::LinkEvent
type TextStyle = text_control::TextStyle
type TextWrap = text_control::TextWrap
type TextOverflow = text_control::TextOverflow

let box = box_control::new
let input = input_control::new
let scroll_box = scroll_box_control::new
let scrollbar = scrollbar_control::new
let scrollbar_options = scrollbar_control::options
let scrollbar_state = scrollbar_control::state
let scrollbar_theme = scrollbar_control::theme
let span = text_control::span
let span_style = text_control::span_style
let styled_text = text_control::styled_text
let text = text_control::new
let text_style = text_control::style
