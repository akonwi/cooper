use ard/testing

struct Color {
  red: Uint8,
  green: Uint8,
  blue: Uint8,
  // When present, the terminal's indexed palette slot is authoritative.
  // This lets applications use colors supplied by the host theme instead of
  // baking in RGB values.
  index: Uint8?,
  // Explicit terminal-default colors are distinct from an omitted color: an
  // omitted background is transparent, while this value fills with the host
  // terminal's default background.
  terminal_default: Bool,
}

private fn channel(value: Int) Uint8 {
  if value < 0 or value > 255 {
    panic("color component must be between 0 and 255")
  }
  Uint8::from(value)
}

fn rgb(red: Int, green: Int, blue: Int) Color {
  Color{
    red: channel(red),
    green: channel(green),
    blue: channel(blue),
    terminal_default: false,
  }
}

// Uses a color from the terminal's 0-255 indexed palette. Slots 0-15 are the
// host theme's ANSI colors; unlike RGB colors, they adapt to that theme.
fn indexed(index: Int) Color {
  Color{
    red: Uint8::from(0),
    green: Uint8::from(0),
    blue: Uint8::from(0),
    index: channel(index),
    terminal_default: false,
  }
}

// Explicitly paints with the host terminal's default color. This differs from
// omitting a color, which preserves the color already present in the buffer.
fn terminal_default() Color {
  Color{
    red: Uint8::from(0),
    green: Uint8::from(0),
    blue: Uint8::from(0),
    terminal_default: true,
  }
}

private fn hex_digit(value: Rune) Int {
  if value >= '0' and value <= '9' {
    value.to_int() - '0'.to_int()
  } else if value >= 'a' and value <= 'f' {
    value.to_int() - 'a'.to_int() + 10
  } else if value >= 'A' and value <= 'F' {
    value.to_int() - 'A'.to_int() + 10
  } else {
    panic("hex color must contain only hexadecimal digits")
  }
}

private fn hex_pair(digits: [Rune], start: Int) Uint8 {
  let high = hex_digit(digits.at(start).expect("validated hex color"))
  let low = hex_digit(digits.at(start + 1).expect("validated hex color"))
  channel(high * 16 + low)
}

fn hex(value: Str) Color {
  mut encoded = value
  if encoded.starts_with("#") {
    encoded = encoded.slice(start: 1).expect("hash is a byte boundary")
  }

  let digits = encoded.runes()
  if digits.size() != 6 {
    panic("hex color must be RRGGBB or #RRGGBB")
  }

  Color{
    red: hex_pair(digits, 0),
    green: hex_pair(digits, 2),
    blue: hex_pair(digits, 4),
    terminal_default: false,
  }
}

test fn color_hex_accepts_prefixed_plain_and_mixed_case_values() Void!Str {
  let prefixed = hex("#1aB2fF")
  try testing::assert(prefixed.red == Uint8::from(26), "Expected parsed red channel")
  try testing::assert(prefixed.green == Uint8::from(178), "Expected parsed green channel")
  try testing::assert(prefixed.blue == Uint8::from(255), "Expected parsed blue channel")

  let plain = hex("2947F0")
  try testing::assert(plain.red == Uint8::from(41), "Expected plain red channel")
  try testing::assert(plain.green == Uint8::from(71), "Expected plain green channel")
  try testing::assert(plain.blue == Uint8::from(240), "Expected plain blue channel")
  testing::assert(
    not plain.index.is_some(),
    "Expected RGB color not to use an indexed palette slot",
  )
}

test fn color_indexed_preserves_host_palette_slot() Void!Str {
  let value = indexed(4)
  try testing::assert(
    value.index.expect("indexed palette slot") == Uint8::from(4),
    "Expected indexed slot",
  )
  try testing::assert(value.red == Uint8::from(0), "Expected indexed color not to encode RGB red")
  try testing::assert(value.green == Uint8::from(0), "Expected indexed color not to encode RGB green")
  testing::assert(value.blue == Uint8::from(0), "Expected indexed color not to encode RGB blue")
}

test fn color_terminal_default_is_an_explicit_paint_value() Void!Str {
  let value = terminal_default()
  try testing::assert(value.terminal_default, "Expected explicit terminal-default color")
  testing::assert(not value.index.is_some(), "Expected terminal default not to use a palette slot")
}
