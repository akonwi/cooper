---
import '../styles/global.css';
const { title = 'Cooper — Terminal interfaces, built in Ard', description = 'Build terminal apps in Ard. Compose stateful components with CUI, or work directly with Cooper’s retained controls.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const current = Astro.url.pathname;
const links = [['Guide', 'guide/'], ['Examples', 'examples/']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="container navigation" aria-label="Main navigation">
        <a class="brand" href={base} aria-label="Cooper home">Cooper <span>for Ard</span></a>
        <div class="nav-links">
          {links.map(([label, path]) => <a href={`${base}${path}`} aria-current={current === `${base}${path}` ? 'page' : undefined}>{label}</a>)}
          <a href="https://github.com/akonwi/cooper">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="container site-footer">
      <span>Cooper <span aria-hidden="true">·</span> Open source, built with Ard.</span>
      <a href="https://ard.run">New to Ard? Meet the language <span aria-hidden="true">↗</span></a>
      <a href="https://github.com/akonwi/cooper/blob/main/LICENSE">BSD 3-Clause</a>
    </footer>
  </body>
</html>
