---
import Page from '../layouts/Page.astro';
import Code from '../components/Code.astro';
const base = import.meta.env.BASE_URL;
const examples = [
  { id: 'tinear', name: 'Tinear', file: 'cui_tinear', tag: 'Components · state · interaction', description: 'An issue board with keyboard navigation, filtering, retained detail tabs, drag and drop, and an animated confirmation toast.', note: 'A static-data adaptation of Tinear. Loading is simulated; changes stay in this process.' },
  { id: 'hacker-news', name: 'Hacker News', file: 'cui_hackernews', tag: 'Async · nested comments · virtual lists', description: 'A read-only client for the official Hacker News API. Browse feeds, open stories, and expand comment threads with bounded fetching and cached results.', note: 'Requires a network connection. No authentication, voting, or posting.' },
  { id: 'components', name: 'Declarative jobs', file: 'declarative_jobs', tag: 'Typed props · local state · keyed identity', description: 'Editable, reorderable job rows demonstrate how components preserve notes, editor state, and focus across keyed moves.', note: 'Start here for a focused introduction to CUI components.' },
  { id: 'animation', name: 'Spring lab', file: 'spring_lab', tag: 'Animation · interruptible motion', description: 'Six spring presets respond to shared targets. Compare bounce, damping, and speed, then redirect them without resetting momentum.', note: 'Uses Cooper’s imperative controls and Runtime-owned springs.' },
  { id: 'virtual-lists', name: 'Virtual comments', file: 'cui_virtual_comments', tag: 'Variable heights · wrapping · scrolling', description: 'Browse 4,000 already-loaded comments with nesting, collapse and expansion, stable-key jumps, and consumer-styled scrollbars.', note: 'No network requests. Offscreen rows unmount; durable state belongs in the model.' },
];
---
<Page title="Examples — Cooper">
  <div class="container examples-page">
    <header class="page-intro"><p class="eyebrow">Made with Cooper</p><h1>Small examples.<br /><span>Real possibilities.</span></h1><p class="lead">Explore complete terminal applications, then read the Ard behind them.</p></header>
    <section class="example-setup prose" aria-labelledby="run-heading"><h2 id="run-heading">Run the examples locally</h2><p>Install <a href="https://ard.run">Ard 0.42.0 or newer</a>, then clone the repository:</p><Code code={'git clone https://github.com/akonwi/cooper.git\ncd cooper/examples'} filename="Terminal" label="Shell" /></section>
    {examples.map(example => <section class="example" id={example.id}>
      <div><p class="eyebrow">{example.tag}</p><h2>{example.name}</h2><p>{example.description}</p><p class="muted">{example.note}</p><a class="text-link" href={`https://github.com/akonwi/cooper/blob/main/examples/${example.file}.ard`}>Read the source <span aria-hidden="true">↗</span></a></div>
      <div>{example.id === 'tinear' && <a href={`${base}tinear.png`}><img class="example-image" src={`${base}tinear.png`} width="2520" height="1008" alt="Tinear’s three-column issue board running in a terminal" loading="lazy" /></a>}<Code code={`ard run ${example.file}.ard`} filename="From cooper/examples" label="Shell" /></div>
    </section>)}
    <p class="more-examples"><a class="text-link" href="https://github.com/akonwi/cooper/blob/main/examples/README.md">Explore the full example gallery <span aria-hidden="true">↗</span></a></p>
  </div>
</Page>
