---
import Page from '../layouts/Page.astro';
import Code from '../components/Code.astro';
import hello from '../../snippets/hello.ard?raw';
import dashboard from '../../../screenshots/dashboard.gif?url';
const base = import.meta.env.BASE_URL;
---
<Page title="Cooper — Terminal UIs for Ard" description="An Ard-native retained-mode terminal UI library with an optional declarative component layer, CUI.">
  <section class="container hero" aria-labelledby="hero-title">
    <h1 id="hero-title">Terminal UIs for <span>Ard.</span></h1>
    <p class="hero-description">A retained-mode terminal UI library with an optional declarative component layer, CUI.</p>
    <div class="actions">
      <a class="button primary" href={`${base}get-started/`}>Get started <span aria-hidden="true">→</span></a>
      <a class="button secondary" href={`${base}examples/`}>Examples</a>
    </div>
  </section>

  <figure class="container showcase">
    <div class="terminal-frame">
      <div class="terminal-title" aria-hidden="true"><span class="terminal-dot"></span><span class="terminal-dot"></span><span class="terminal-dot"></span></div>
      <a class="terminal-image-link" href={dashboard} aria-label="View the dashboard terminal recording at full size">
        <picture>
          <source media="(prefers-reduced-motion: reduce)" srcset={`${base}dashboard.png`} />
          <img src={dashboard} width="1120" height="640" alt="Cooper’s operations dashboard running in a terminal, with service metrics, activity charts, and an event log." fetchpriority="high" />
        </picture>
      </a>
    </div>
  </figure>

  <section class="container code-section" aria-labelledby="code-heading">
    <div class="code-intro">
      <h2 id="code-heading">Example</h2>
      <p>A complete CUI program.</p>
      <a class="text-link" href={`${base}get-started/`}>Setup instructions <span aria-hidden="true">→</span></a>
    </div>
    <div>
      <Code code={hello} filename="main.ard" showHeader={false} />
    </div>
  </section>

</Page>
